class AdditionalDriveSprockets:
    """Axial drive copies; maintain their explicit rigid motion relationships."""
    def __init__(self, document):
        self.doc = document
        self.source = document.getObject("sprocket_16T_01")
        self.wheel = document.getObject("GroundDriveWheel")
        self.group = document.addObject("App::DocumentObjectGroup", "AdditionalDriveSprockets")
        self.group.Label = "Wheel drive sprockets and spare 15T"
        self.copies, self.attachments = [], []
        specifications = (
            ("wheel_shaft_sprocket_64T", self.source, V(620, -30, 0), self.wheel, 64),
            ("sprocket_10T_02", self.source, V(0, -30, 0), self.source, 10),
            ("sprocket_15T_tensioner_02", document.sprocket_15T_tensioner_01, V(193.89230174733 - upper_right_x, -30, -100.0), document.sprocket_15T_tensioner_01, T2),
        )
        for name, source, offset, driver, teeth in specifications:
            obj = create_sprocket(document, name, teeth, PITCH / (2 * math.sin(math.pi / teeth)), PITCH / (2 * math.sin(math.pi / teeth)) - ROLLER_DIAMETER / 2)
            shape = obj.Shape.copy()
            shape.Placement = App.Placement()
            obj.Shape = shape
            obj.Label = "sprocket 15T tensioner 02" if name == "sprocket_15T_tensioner_02" else name
            placement = source.getGlobalPlacement()
            placement.Base = placement.Base + offset
            obj.Placement = placement
            relative = driver.getGlobalPlacement().inverse().multiply(placement)
            obj.addProperty("App::PropertyLink", "MotionDriver", "Drive")
            obj.MotionDriver = driver
            obj.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
            obj.Teeth = teeth
            obj.addProperty("App::PropertyDistance", "SourceYOffset", "Dimensions")
            obj.SourceYOffset = -30.0
            obj.ViewObject.ShapeColor = source.ViewObject.ShapeColor
            obj.ViewObject.LineColor = source.ViewObject.LineColor
            self.group.addObject(obj)
            self.copies.append(obj)
            self.attachments.append((driver, relative))
        self.update()

    def update(self):
        # Only the shaft sprocket is rigidly attached to the wheel. Other copies
        # receive their motion from the wheel chain in WheelShaftDriveChain.update.
        obj = self.copies[0]
        driver, relative = self.attachments[0]
        obj.Placement = driver.getGlobalPlacement().multiply(relative)


additional_drive_sprockets = AdditionalDriveSprockets(doc)
doc.wheel_shaft_sprocket_64T.ViewObject.Transparency = 75
App.additional_drive_sprockets = additional_drive_sprockets
doc.recompute()


def create_offset_chain_link():
    """Visual one-pitch offset link: inner end at X=0, outer end at X=pitch."""
    plates = []
    for inner_z, outer_z in ((inner_plate_z1, outer_plate_z1),
                              (inner_plate_z2, outer_plate_z2)):
        plate = create_link_plate(LINK_PLATE_THICKNESS, inner_z)
        shear = App.Matrix()
        shear.A31 = (outer_z-inner_z) / PITCH
        plates.append(plate.transformGeometry(shear))
    roller = Part.makeCylinder(ROLLER_DIAMETER / 2.0, INNER_WIDTH,
        V(0, 0, SPROCKET_PLATE_THICKNESS / 2.0 - INNER_WIDTH / 2.0))
    pin = Part.makeCylinder(PIN_DIAMETER / 2.0, pin_length,
        V(PITCH, 0, outer_plate_z2 - 0.5))
    return plates[0].fuse(plates[1]).fuse(roller).fuse(pin)


class WheelShaftDriveChain:
    """Pitch-correct chain around the 64T driver, 10T follower and 15T tensioner."""
    def __init__(self, document):
        self.doc = document
        self.left = document.sprocket_10T_02
        self.right = document.wheel_shaft_sprocket_64T
        left, right = self.left.getGlobalPlacement().Base, self.right.getGlobalPlacement().Base
        if abs(left.y - right.y) > 1.0e-6 or abs(left.z - right.z) > 1.0e-6:
            raise ValueError("Wheel-drive sprockets must share a chain plane and height.")
        self.spacing = right.x - left.x
        self.frame = App.Placement(left, App.Rotation(V(1, 0, 0), -90.0))
        radius = PITCH / (2 * math.sin(math.pi / 10))
        if self.spacing <= 2.0 * radius:
            raise ValueError("Wheel-drive sprockets overlap.")
        self.idler = document.sprocket_15T_tensioner_02
        self.idler_x = self.idler.Placement.Base.x - left.x
        self.radius = radius
        self.right_radius = PITCH / (2 * math.sin(math.pi / 64))
        self.idler_radius = PITCH / (2 * math.sin(math.pi / 15))
        self.idler_x = 393.89230174733
        self.idler_height = 143.20924277481575
        self.external_x = self.idler_x - 200.0
        self.external = document.addObject("Part::Feature", "sprocket_15T_tensioner_03")
        self.external.Label = "sprocket 15T tensioner 03"
        shape = self.idler.Shape.copy()
        shape.Placement = App.Placement()
        self.external.Shape = shape
        self.external.Placement = self.idler.Placement
        self.external.ViewObject.ShapeColor = self.idler.ViewObject.ShapeColor
        self.external.ViewObject.LineColor = self.idler.ViewObject.LineColor
        self.external.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
        self.external.Teeth = 15
        self.external.addProperty("App::PropertyString", "ContactSide", "Drive")
        self.external.ContactSide = "Outer surface; reverse-bending tensioner"
        self.external.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.external.WheelSpeedRatio = -64.0 / 15.0
        self.external.addProperty("App::PropertyLink", "MotionDriver", "Drive")
        self.count = 138  # Even count: regular alternating inner and outer links.
        self.external_height = 51.85947458001749  # Preserve tensioner 03.
        low, high = 70.0, 126.87383101592361
        for _ in range(44):
            self.idler_height = (low + high) / 2
            route, distances = make_chain_route(self.build_path(self.idler_height), 0.0)
            _, residual = walk_chain_route(route, distances, 0.0, self.count)
            if residual > 0:
                low = self.idler_height
            else:
                high = self.idler_height
        self.rest = {obj.Name: obj.Placement for obj in (self.left, self.idler, self.external)}
        self.path = self.build_path(self.idler_height)
        self.idler.Placement.Base = self.frame.multVec(V(self.idler_x, self.idler_height, 0))
        self.external.Placement.Base = self.frame.multVec(V(self.external_x, self.external_height, 0))
        self.rest[self.idler.Name] = self.idler.Placement
        self.rest[self.external.Name] = self.external.Placement
        document.AdditionalDriveSprockets.addObject(self.external)
        self.group = document.addObject("App::DocumentObjectGroup", "WheelShaftDriveChain")
        self.group.Label = "Wheel shaft 64T to sprocket 10T_02 chain"
        self.group.addProperty("App::PropertyInteger", "LinkCount", "Chain")
        self.group.LinkCount = self.count
        self.group.addProperty("App::PropertyLength", "Pitch", "Chain")
        self.group.Pitch = PITCH
        self.group.addProperty("App::PropertyLength", "ReturnSpanSag", "Chain")
        self.group.addProperty("App::PropertyLinkList", "Sprockets", "Chain")
        self.group.Sprockets = [self.left, self.external, self.idler, self.right]
        self.external.MotionDriver = self.group
        self.group.addProperty("App::PropertyLink", "MotionDriver", "Drive")
        self.group.MotionDriver = self.right
        self.group.addProperty("App::PropertyLength", "TensionerZShift", "Chain")
        self.group.TensionerZShift = self.idler_height
        self.left.MotionDriver = self.group
        self.idler.MotionDriver = self.group
        self.left.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.left.WheelSpeedRatio = 6.4
        self.idler.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.idler.WheelSpeedRatio = 64.0 / 15.0
        self.links = []
        for index in range(self.count):
            link = document.addObject("Part::Feature", "WheelDriveChainLink_{:03d}".format(index))
            if index == self.count - 1 and self.count % 2:
                link.Shape = create_offset_chain_link()
                link.Label = "Wheel drive chain offset link (one pitch)"
                link.addProperty("App::PropertyString", "LinkType", "Chain")
                link.LinkType = "Offset link (half link)"
                self.group.addProperty("App::PropertyLink", "OffsetLink", "Chain")
                self.group.OffsetLink = link
            else:
                link.Shape = (inner_link if index % 2 == 0 else outer_link).copy()
            link.ViewObject.ShapeColor = (0.72, 0.72, 0.72) if index % 2 == 0 else (0.48, 0.48, 0.48)
            self.group.addObject(link)
            self.links.append(link)
        self.update()

    def build_path(self, height, correction=0.0):
        centres = [V(0, 0, 0), V(self.external_x, self.external_height, 0),
                   V(self.idler_x, height, 0), V(self.spacing, 0, 0)]
        radii = [self.radius + correction, self.idler_radius + correction,
                 self.idler_radius + correction, self.right_radius + correction]
        sides = [1, -1, 1, 1]  # Negative signed radius selects backside tangency.
        tangents = [make_left_outer_tangent(centres[i], centres[(i+1)%4],
                    sides[i]*radii[i], sides[(i+1)%4]*radii[(i+1)%4]) for i in range(4)]
        segments, cursor = [], 0.0
        for i in range(4):
            incoming, outgoing = tangents[(i-1)%4], tangents[i]
            direction = -sides[i]
            start = incoming['normal_angle'] + (math.pi if sides[i]<0 else 0)
            end = outgoing['normal_angle'] + (math.pi if sides[i]<0 else 0)
            sweep = ((end-start)*direction) % (2*math.pi)
            length = radii[i]*sweep
            segments.append(dict(kind='arc', centre=centres[i], radius=radii[i],
                                 start_angle=start, direction=direction, sprocket_index=i,
                                 length=length, start=cursor, end=cursor+length))
            cursor += length
            length = outgoing['length']
            segments.append(dict(kind='straight', start_point=outgoing['start_point'],
                                 end_point=outgoing['end_point'], length=length,
                                 start=cursor, end=cursor+length))
            cursor += length
        return dict(segments=segments, length=cursor)

    def rollers(self, offset):
        # Keep straight spans taut with a tiny polygonal route correction.
        low, high = -0.1, 0.1
        for _ in range(40):
            correction = (low + high) / 2
            route, cumulative = make_chain_route(self.build_path(self.idler_height, correction), 0.0)
            points, residual = walk_chain_route(route, cumulative, offset, self.count)
            if abs(residual) < 1e-8:
                return [V(x, y, 0) for x, y in points[:-1]], correction
            if residual > 0:
                low = correction
            else:
                high = correction
        raise RuntimeError("Unable to close the tensioned wheel chain.")

    def update(self):
        points, sag = self.rollers(animation_offset * 10.0 / T1)
        self.group.ReturnSpanSag = 0.0
        wheel_angle = -360.0 * animation_offset / (PITCH * T1) / 6.4
        for obj, teeth in ((self.left, 10), (self.idler, 15), (self.external, -15)):
            rest = self.rest[obj.Name]
            rotation = App.Rotation(V(0, 1, 0), wheel_angle * 64.0 / teeth)
            obj.Placement = App.Placement(rest.Base, rotation.multiply(rest.Rotation))
        for index, link in enumerate(self.links):
            a, b = points[index], points[(index + 1) % self.count]
            angle = math.degrees(math.atan2(b.y - a.y, b.x - a.x))
            link.Placement = self.frame.multiply(App.Placement(a, App.Rotation(V(0, 0, 1), angle)))


wheel_drive_chain = WheelShaftDriveChain(doc)
App.wheel_drive_chain = wheel_drive_chain
# Consistent colours identify the two complete chain drives.
primary_drive_colour = (1.0, 0.45, 0.0)
wheel_drive_colour = (1.0, 0.85, 0.0)
for obj in links + sprockets:
    obj.ViewObject.ShapeColor = primary_drive_colour
for obj in wheel_drive_chain.links + list(wheel_drive_chain.group.Sprockets):
    obj.ViewObject.ShapeColor = wheel_drive_colour

primary_chain_drive = doc.addObject("App::FeaturePython", "PrimaryChainDrive")
primary_chain_drive.addProperty("App::PropertyLinkList", "Links", "Drive")
primary_chain_drive.Links = links
primary_chain_drive.addProperty("App::PropertyLink", "MotionDriver", "Drive")
primary_chain_drive.MotionDriver = doc.sprocket_16T_01
for obj, driver in ((doc.sprocket_16T_01, doc.sprocket_10T_02), (doc.sprocket_15T_tensioner_01, primary_chain_drive), (doc.sprocket_16T_03, primary_chain_drive)):
    obj.addProperty("App::PropertyLink", "MotionDriver", "Drive")
    obj.MotionDriver = driver
doc.recompute()


class MovingSoilGround:
    """Scroll soil past a stationary machine at the wheel's rolling speed."""
    def __init__(self, document):
        import random
        self.doc = document
        self.wheel = document.getObject("GroundDriveWheel")
        self.axle = self.wheel.getGlobalPlacement().Base
        self.lug_tip_radius = FRONT_DISC_OD / 2.0 - LUG_WELD_OVERLAP + LUG_LENGTH
        self.group = document.addObject("App::DocumentObjectGroup", "MovingGround")
        self.group.Label = "Moving soil — stationary machine"
        for prop, value in (("LugPenetration", 40.0), ("RollingRadius", self.lug_tip_radius - 40.0),
                            ("Travel", 0.0), ("GroundHeight", self.axle.z - self.lug_tip_radius + 40.0)):
            self.group.addProperty("App::PropertyLength", prop, "Ground motion")
            setattr(self.group, prop, value)
        self.group.addProperty("App::PropertyFloat", "RoughnessMultiplier", "Ground motion")
        self.group.RoughnessMultiplier = 3.0
        self.group.setEditorMode("RoughnessMultiplier", 1)
        self.group.addProperty("App::PropertyBool", "Enabled", "Ground motion")
        self.group.Enabled = True
        self.group.addProperty("App::PropertyString", "MotionModel", "Ground motion")
        self.group.MotionModel = "No-slip visual rolling: ground travel = wheel angle (radians) x effective radius. Soil penetration is illustrative; no soil-force simulation."
        for prop in ("RollingRadius", "Travel", "GroundHeight", "MotionModel"):
            self.group.setEditorMode(prop, 1)
        # Size the visible field around the existing machine, not the camera.
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.tile_length = 300.0
        # Double the previous 3900 x 1922 mm soil footprint about its centre.
        self.x_min = -3450.0
        self.tile_count = 26
        self.field_length = 7800.0
        self.y_min, self.y_max = -2437.0, 1407.0
        self.field_width = 3844.0
        self.surface = document.addObject("Part::Feature", "SoilSurface")
        self.surface.Label = "Soil surface"
        self.surface.Shape = Part.makeBox(self.field_length, self.field_width, 150.0,
                                          V(self.x_min, self.y_min, -150.0))
        self.surface.ViewObject.ShapeColor = (0.28, 0.19, 0.11)
        self.surface.ViewObject.Transparency = 50
        self.surface.ViewObject.DisplayMode = "Flat Lines"
        self.surface.ViewObject.LineColor = (0.28, 0.19, 0.11)
        self.group.addObject(self.surface)
        self.tiles = []
        for index in range(self.tile_count):
            rng = random.Random(17041 + index)
            light, dark = [], []
            # Low soil clods and scattered grains supply clear motion cues.
            for j in range(24):
                x = rng.uniform(8.0, self.tile_length - 8.0)
                y = rng.uniform(self.y_min + 8.0, self.y_max - 8.0)
                radius = rng.uniform(2.0, 6.0)
                light.append(Part.makeCylinder(radius, rng.uniform(0.5, 1.8) * 3.0, V(x, y, 0.15)))
                dark.append(Part.makeBox(rng.uniform(8.0, 22.0), rng.uniform(2.0, 6.0), 0.36,
                                        V(rng.uniform(5.0, self.tile_length - 25.0), y, 0.06)))
            objects = []
            for suffix, shapes, colour in (("Clods", light, (0.40, 0.29, 0.18)),
                                            ("Grains", dark, (0.19, 0.125, 0.07))):
                obj = document.addObject("Part::Feature", "SoilTile_{:02d}_{}".format(index, suffix))
                obj.Label = "Moving soil {:02d} {}".format(index + 1, suffix.lower())
                obj.Shape = Part.makeCompound(shapes)
                obj.ViewObject.ShapeColor = colour
                obj.ViewObject.Transparency = 50
                obj.ViewObject.LineColor = colour
                obj.ViewObject.DisplayMode = "Flat Lines"
                self.group.addObject(obj)
                objects.append(obj)
            self.tiles.append(objects)
        self.last_travel = 0.0
        self.update()

    def update(self):
        penetration = max(0.0, min(40.0, self.group.LugPenetration.Value))
        radius = self.lug_tip_radius - penetration
        height = self.axle.z - radius
        # Wheel angle about global Y is -animation_offset/R1. Ground moves
        # opposite the machine's notional travel, along +X for forward playback.
        if self.group.Enabled:
            self.last_travel = animation_offset / (PITCH * T1 / (2 * math.pi)) * radius / 6.4
        travel = self.last_travel
        self.surface.Placement.Base = V(0, 0, height)
        self.group.RollingRadius = radius
        self.group.Travel = abs(travel)
        self.group.GroundHeight = height
        phase = travel % self.field_length
        for index, objects in enumerate(self.tiles):
            x = self.x_min + (index * self.tile_length + phase) % self.field_length
            for obj in objects:
                obj.Placement.Base = V(x, 0, height)


class DuckBillCycleReadout:
    """World-space ZX readout of net soil-relative advance per duck-bill cycle."""
    def __init__(self, document):
        self.doc = document
        self.group = document.addObject("App::DocumentObjectGroup", "DuckBillCycleReadout")
        self.group.Label = "Duck-bill cycle distance (ZX readout)"
        self.group.addProperty("App::PropertyLength", "DistancePerCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyFloat", "WheelTurnsPerDuckBillCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyLink", "CycleDriver", "Cycle measurement")
        self.group.CycleDriver = document.sprocket_16T_03
        self.group.addProperty("App::PropertyString", "Definition", "Cycle measurement")
        self.group.Definition = "Net soil-relative advance per complete duck-bill cycle = 2*pi*T3/T1*(10/64)*rolling radius. Both 16T crank sprockets complete one revolution per cycle; the wheel completes 10/64 of a revolution."
        for prop in ("DistancePerCycle", "WheelTurnsPerDuckBillCycle", "CycleDriver", "Definition"):
            self.group.setEditorMode(prop, 1)
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.x = bounds.XMax - 470.0
        self.y = bounds.YMin - 40.0
        self.z = bounds.ZMax + 35.0
        width, height = 510.0, 145.0
        vertices = [V(self.x, self.y, self.z), V(self.x + width, self.y, self.z),
                    V(self.x + width, self.y, self.z + height), V(self.x, self.y, self.z + height)]
        wire = Part.makePolygon(vertices + [vertices[0]])
        background = document.addObject("Part::Feature", "CycleReadoutBackground")
        background.Shape = Part.Face(wire)
        background.ViewObject.ShapeColor = (0.065, 0.075, 0.085)
        background.ViewObject.LineColor = (0.065, 0.075, 0.085)
        background.ViewObject.DisplayMode = "Flat Lines"
        frame = document.addObject("Part::Feature", "CycleReadoutFrame")
        frame.Shape = wire
        frame.Placement.Base = V(0, -0.1, 0)
        frame.ViewObject.LineColor = (1.0, 1.0, 1.0)
        frame.ViewObject.LineWidth = 2.0
        self.group.addObject(background)
        self.group.addObject(frame)
        candidates = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
            "C:/Windows/Fonts/arial.ttf",
            "/System/Library/Fonts/Supplemental/Arial.ttf",
        ]
        self.font = next((path for path in candidates if os.path.isfile(path)), None)
        if self.font is None:
            raise RuntimeError("A DejaVu Sans, Liberation Sans or Arial font is required for the cycle display.")
        self.make_text("CycleReadoutTitle", "NET SOIL TRAVEL / DUCK-BILL CYCLE", 16.0, 108.0)
        self.value_text = self.make_text("CycleReadoutValue", "Calculating...", 33.0, 53.0)
        self.make_text("CycleReadoutNote", "1 cycle = one duck-bill crank revolution", 12.0, 20.0)
        self.last_text = None

    def text_shape(self, text, size):
        letters = Part.makeWireString(text, os.path.dirname(self.font) + os.sep,
                                      os.path.basename(self.font), size)
        faces = [Part.makeFace(wires, "Part::FaceMakerBullseye") for wires in letters if wires]
        return Part.makeCompound(faces)

    def make_text(self, name, text, size, height):
        obj = self.doc.addObject("Part::Feature", name)
        obj.Label = text
        obj.Shape = self.text_shape(text, size)
        # Font XY -> global XZ; front faces point towards -Y.
        obj.Placement = App.Placement(V(self.x + 20.0, self.y - 0.2, self.z + height),
                                      App.Rotation(V(1, 0, 0), 90.0))
        obj.ViewObject.ShapeColor = (1.0, 1.0, 1.0)
        obj.ViewObject.LineColor = (1.0, 1.0, 1.0)
        obj.ViewObject.DisplayMode = "Flat Lines"
        self.group.addObject(obj)
        return obj

    def update(self):
        if moving_ground is None:
            return
        # R3 is the duck-bill crank sprocket radius, regardless of its old object name.
        ratio = T3 / T1 / 6.4
        distance = 2.0 * math.pi * ratio * moving_ground.group.RollingRadius.Value
        if not moving_ground.group.Enabled:
            distance = 0.0
        self.group.WheelTurnsPerDuckBillCycle = ratio
        self.group.DistancePerCycle = distance
        text = "{:,.1f} mm / cycle".format(distance) if linkage_motion_available else "NO FULL CYCLE"
        if text != self.last_text:
            placement = self.value_text.Placement
            self.value_text.Shape = self.text_shape(text, 33.0)
            self.value_text.Placement = placement
            self.value_text.Label = text
            self.last_text = text


cycle_readout = DuckBillCycleReadout(doc)
App.duck_bill_cycle_readout = cycle_readout
doc.recompute()


# Frame the machine once, BEFORE adding the larger ground field. The animation
# never calls ViewFit or modifies the camera, so the machine remains central.
view = Gui.activeDocument().activeView()
view.setCameraType("Orthographic")
view.viewAxonometric()
view.fitAll()
try:
    camera_node = view.getCameraNode()
    camera_node.height.setValue(camera_node.height.getValue() * 1.20)
except (AttributeError, RuntimeError):
    pass
# Bake the enlarged dash pattern into geometry so the saved FCStd preserves it.
# FreeCAD's Dashed pattern is 0xF00F: eight lit pixels and eight gap pixels.
# Equal 10-pixel dashes and gaps at this initial camera framing.
if duck_bill_tip_motion_outline is not None:
    outline = duck_bill_tip_motion_outline
    outline.addProperty("Part::PropertyPartShape", "FullTrajectory", "Motion envelope")
    outline.FullTrajectory = outline.Shape.copy()
    outline.addProperty("App::PropertyFloat", "DashScaleFactor", "Motion envelope")
    outline.DashScaleFactor = 1.25
    outline.addProperty("App::PropertyFloat", "GapScaleFactor", "Motion envelope")
    outline.GapScaleFactor = outline.DashScaleFactor
    screen_to_world = view.getCameraNode().height.getValue() / max(1, view.getSize()[1])
    dash_length = 8.0 * outline.DashScaleFactor * screen_to_world
    gap_length = dash_length  # Persistent requirement: equal dash and gap lengths.
    camera_inverse = view.getCameraOrientation()
    camera_inverse.invert()
    # Fit a whole number of equal dash-gap pairs around the closed trajectory,
    # avoiding a shortened final dash or an oversized closing gap.
    projected_length = 0.0
    for edge in outline.FullTrajectory.Edges:
        delta = camera_inverse.multVec(edge.Vertexes[-1].Point - edge.Vertexes[0].Point)
        projected_length += math.hypot(delta.x, delta.y)
    pair_count = max(1, int(round(projected_length / (2.0 * dash_length))))
    dash_length = gap_length = projected_length / (2.0 * pair_count)
    pieces, current = [], []
    remaining, visible = dash_length, True
    for edge in outline.FullTrajectory.Edges:
        a, b = edge.Vertexes[0].Point, edge.Vertexes[-1].Point
        projected = camera_inverse.multVec(b - a)
        length = math.hypot(projected.x, projected.y)
        if length < 1e-12:
            continue
        offset = 0.0
        while offset < length - 1e-10:
            take = min(remaining, length - offset)
            first = a + (b-a) * (offset / length)
            last = a + (b-a) * ((offset+take) / length)
            if visible:
                if not current:
                    current.append(first)
                current.append(last)
            offset += take
            remaining -= take
            if remaining < 1e-9:
                if visible and len(current) > 1:
                    pieces.append(Part.makePolygon(current))
                current = []
                visible = not visible
                remaining = dash_length if visible else gap_length
    if len(current) > 1:
        pieces.append(Part.makePolygon(current))
    outline.Shape = Part.makeCompound(pieces)
    outline.ViewObject.DrawStyle = "Solid"  # Gaps are explicit geometry.
    outline.ViewObject.LineWidth = 3.0
    outline.Description += " Blue dashes and gaps are equal at 1.25x the original pattern; line width remains 3. Always keep dash and gap lengths equal."

moving_ground = MovingSoilGround(doc)
App.moving_soil_ground = moving_ground
cycle_readout.update()
# Re-running fitAll after creating ground would frame the field, not the machine.
doc.recompute()




# Stop timers left behind by an earlier execution before making a new one.
# The public handle is deliberately App.sim_timer, so the console command
# ``App.sim_timer.stop()`` always addresses the timer driving this macro.
for timer_name in ("sim_timer", "lugged_wheel_chain_timer"):
    old_timer = getattr(App, timer_name, None)
    if old_timer is not None:
        old_timer.stop()

App.sim_timer = QtCore.QTimer()
App.sim_timer.timeout.connect(update_simulation)
if linkage_motion_available:
    App.sim_timer.start(100)

# Backward-compatible alias for the stop command printed by older versions.
App.lugged_wheel_chain_timer = App.sim_timer
App.Console.PrintMessage(
    ("Stationary machine with wheel-synchronized moving soil running. Stop with: " if linkage_motion_available else "Animation paused: fixed-pin linkage cannot complete a cycle. Timer handle: ") +
    "App.sim_timer.stop()\n"
)
