    shaft.addProperty("App::PropertyLength", "Length", "Dimensions")
    shaft.Diameter = 20.0
    shaft.Length = 60.0
    shaft.ViewObject.ShapeColor = (0.72, 0.74, 0.77)
    return shaft


sprocket_21t_shaft = add_sprocket_21t_shaft(doc)
