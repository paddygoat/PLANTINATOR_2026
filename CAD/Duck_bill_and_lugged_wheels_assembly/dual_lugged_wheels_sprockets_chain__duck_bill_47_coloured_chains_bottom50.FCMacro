    shaft.Label = "16T sprocket shaft (OD20 x 60 mm)"
    # Local Z is the sprocket axis (global Y after the assembly rotation).
    shaft.Shape = Part.makeCylinder(10.0, 60.0,
        V(0, 0, SPROCKET_PLATE_THICKNESS / 2.0 - 30.0), V(0, 0, 1))
