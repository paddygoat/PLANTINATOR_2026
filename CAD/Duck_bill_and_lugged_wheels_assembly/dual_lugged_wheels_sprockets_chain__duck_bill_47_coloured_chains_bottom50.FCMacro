def add_duck_bill(doc):
    existing_names = {obj.Name for obj in doc.Objects}
    with tempfile.TemporaryDirectory(prefix="freecad_duck_bill_") as folder:
        source_path = os.path.join(folder, "duck_bill.FCStd")
        with open(source_path, "wb") as handle:
            handle.write(base64.b64decode(DUCK_BILL_FCSTD_BASE64))
        doc.mergeProject(source_path)
    doc.recompute()
    imported = [obj for obj in doc.Objects if obj.Name not in existing_names]
    visibility = {obj.Name: obj.ViewObject.Visibility for obj in imported}
    child_names = {child.Name for obj in imported
                   for child in getattr(obj, "Group", [])}
    imported_roots = [obj for obj in imported if obj.Name not in child_names]
    if not imported_roots:
        raise RuntimeError("The embedded duck-bill assembly could not be imported.")
    assembly = doc.addObject("App::DocumentObjectGroup", "DuckBillAssembly")
    assembly.Label = "Duck bill (closed / 20 degree overlay)"
    assembly.addProperty("App::PropertyString", "SourceDocument", "Source")
    assembly.SourceDocument = "25_demi_cone_support_brackets_28mm_overlay_20deg_2.FCStd"
    for obj in imported_roots:
        visible = obj.ViewObject.Visibility
        assembly.addObject(obj)
        obj.ViewObject.Visibility = visible
    for obj in imported:
        if "Group" in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    for obj in imported:
        if "Group" not in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    # Rotate in the Z-Y plane about the global X axis and model origin.
    # Cumulative duck-bill rotation: previous -90 degrees plus 180 degrees.
    duck_bill_transform = App.Placement(V(0, 0, 0), App.Rotation(V(1, 0, 0), 90.0))
    for obj in imported:
        if obj.isDerivedFrom("Part::Feature"):
            obj.Placement = duck_bill_transform.multiply(obj.Placement)
    doc.recompute()
    return assembly


# =============================================================================
# Build the combined document
# =============================================================================
doc = App.newDocument("dual_lugged_wheels_sprockets_chain__duck_bill_47_coloured_chains_bottom50")
doc.Label = "dual_lugged_wheels_sprockets_chain__duck_bill_47_coloured_chains_bottom50"
duck_bill_assembly = add_duck_bill(doc)

# The wheel and sprocket_16T_01 have the same X/Y shaft centre.  The wheel is
# offset only in Z by the requested -50 mm.
ground_drive_wheel = create_ground_drive_wheel(doc)

# Pitch-correct roller centres on a sampled route, including a slack return span.
def make_chain_route(path, sag):
    route = []
    longest = max((s for s in path['segments'] if s['kind'] == 'straight'),
                  key=lambda s: s['length'])
    for segment in path['segments']:
        steps = max(8, int(math.ceil(segment['length'] / 0.7)))
        for index in range(steps):
            t = index / float(steps)
            if segment['kind'] == 'arc':
                angle = segment['start_angle'] + segment.get('direction', -1) * t * segment['length'] / segment['radius']
                centre = segment['centre']
                x = centre.x + segment['radius'] * math.cos(angle)
                y = centre.y + segment['radius'] * math.sin(angle)
            else:
                a, b = segment['start_point'], segment['end_point']
                dx, dy = b.x - a.x, b.y - a.y
                x, y = a.x + t * dx, a.y + t * dy
                if segment is longest:
                    # Outward bow with zero displacement/slope at both tangencies.
                    bow = sag * 16.0 * t * t * (1.0 - t) * (1.0 - t)
                    x -= bow * dy / segment['length']
                    y += bow * dx / segment['length']
            route.append((x, y))
    route.append(route[0])
    cumulative = [0.0]
    for a, b in zip(route, route[1:]):
        cumulative.append(cumulative[-1] + math.hypot(b[0] - a[0], b[1] - a[1]))
    return route, cumulative


def walk_chain_route(route, cumulative, start_distance, count):
    from bisect import bisect_right
    length = cumulative[-1]
    segment_count = len(route) - 1
    start = start_distance % length
    segment_index = min(bisect_right(cumulative, start) - 1, segment_count - 1)
    fraction = (start - cumulative[segment_index]) / (cumulative[segment_index + 1] - cumulative[segment_index])
    a, b = route[segment_index], route[segment_index + 1]
    current = (a[0] + fraction * (b[0] - a[0]), a[1] + fraction * (b[1] - a[1]))
    points = [current]
    winding = 0
    end_distance = start
    for _ in range(count):
        for attempt in range(segment_count + 1):
            a, b = route[segment_index], route[segment_index + 1]
            if math.hypot(b[0] - current[0], b[1] - current[1]) >= PITCH:
                dx, dy = b[0] - a[0], b[1] - a[1]
                ax, ay = a[0] - current[0], a[1] - current[1]
                aa = dx * dx + dy * dy
                bb = 2.0 * (ax * dx + ay * dy)
                cc = ax * ax + ay * ay - PITCH * PITCH
                fraction = (-bb + math.sqrt(max(0.0, bb * bb - 4.0 * aa * cc))) / (2.0 * aa)
                current = (a[0] + fraction * dx, a[1] + fraction * dy)
                end_distance = winding * length + cumulative[segment_index] + fraction * math.sqrt(aa)
                points.append(current)
                break
            segment_index += 1
            if segment_index == segment_count:
                segment_index = 0
                winding += 1
        else:
            raise RuntimeError('Unable to place a chain link on this route.')
    return points, end_distance - start - length


# Keep both 16T centres fixed; move the 15T idler in +X to tension the chain.
original_15t_x = 193.89230174733

def solve_taut_idler_x():
    low, high = 204.852256614025, 304.852256614025
    for _ in range(44):
        centre_x = (low + high) / 2.0
        path = build_chain_path(centre_x, third_sprocket_x=230.0)
        route, distances = make_chain_route(path, 0.0)
        _, residual = walk_chain_route(route, distances, 0.0, NUM_LINKS)
        if residual > 0:
            low = centre_x
        else:
            high = centre_x
    return (low + high) / 2.0

target_idler_x = 254.852256614025
NUM_LINKS = int(round(build_chain_path(target_idler_x, 230.0)['length'] / PITCH / 2.0)) * 2
upper_right_x = solve_taut_idler_x()
chain_path = build_chain_path(upper_right_x, third_sprocket_x=230.0)
centres = chain_path["centres"]
path_segments = chain_path["segments"]
arc_segments = chain_path["arc_segments"]
total_chain_length = chain_path["length"]

sprocket_13t = create_sprocket(doc, "sprocket_16T_01", T1, R1, ROOT1)
sprocket_15t = create_sprocket(doc, "sprocket_15T_tensioner_01", T2, R2, ROOT2)
sprocket_21t = create_sprocket(doc, "sprocket_16T_03", T3, R3, ROOT3, bore_diameter=20.0)
sprocket_15t.Label = "sprocket 15T tensioner 01"
sprocket_21t.Label = "sprocket_16T_03"
sprocket_21t.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
sprocket_21t.Teeth = T3
sprocket_13t.Label = "sprocket_16T_01"
sprocket_13t.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
sprocket_13t.Teeth = T1
sprockets = [sprocket_13t, sprocket_15t, sprocket_21t]
for sprocket, centre in zip(sprockets, centres):
    sprocket.Placement.Base = centre

# Chain-link solids and objects.
inner_plate_z1 = SPROCKET_PLATE_THICKNESS / 2.0 + INNER_WIDTH / 2.0
inner_plate_z2 = SPROCKET_PLATE_THICKNESS / 2.0 - INNER_WIDTH / 2.0 - LINK_PLATE_THICKNESS
inner_link = create_link_plate(LINK_PLATE_THICKNESS, inner_plate_z1).fuse(
    create_link_plate(LINK_PLATE_THICKNESS, inner_plate_z2)
).fuse(
    Part.makeCylinder(ROLLER_DIAMETER / 2.0, INNER_WIDTH, V(0, 0, SPROCKET_PLATE_THICKNESS / 2.0 - INNER_WIDTH / 2.0))
).fuse(
    Part.makeCylinder(ROLLER_DIAMETER / 2.0, INNER_WIDTH, V(PITCH, 0, SPROCKET_PLATE_THICKNESS / 2.0 - INNER_WIDTH / 2.0))
)

outer_plate_z1 = inner_plate_z1 + LINK_PLATE_THICKNESS + 0.2
outer_plate_z2 = inner_plate_z2 - LINK_PLATE_THICKNESS - 0.2
pin_length = (outer_plate_z1 - outer_plate_z2) + LINK_PLATE_THICKNESS + 1.0
outer_link = create_link_plate(LINK_PLATE_THICKNESS, outer_plate_z1).fuse(
    create_link_plate(LINK_PLATE_THICKNESS, outer_plate_z2)
).fuse(
    Part.makeCylinder(PIN_DIAMETER / 2.0, pin_length, V(0, 0, outer_plate_z2 - 0.5))
).fuse(
    Part.makeCylinder(PIN_DIAMETER / 2.0, pin_length, V(PITCH, 0, outer_plate_z2 - 0.5))
)

links = []
for index in range(NUM_LINKS):
    link = doc.addObject("Part::Feature", "ChainLink_{:02d}".format(index))
    link.Shape = inner_link if index % 2 == 0 else outer_link
    link.ViewObject.ShapeColor = (0.70, 0.70, 0.70) if index % 2 == 0 else (0.50, 0.50, 0.50)
    links.append(link)

# Preserve the current sprocket and wheel indexing at animation offset zero.
sprocket_phase_offsets = [-174.2159723123364, 167.95958068958453, -90.94856373034806]


# =============================================================================
# Animation: sprocket_16T_01 and the 12-lug wheel are rigidly synchronous
# =============================================================================
animation_offset = 0.0
duck_bill_motion = None
moving_ground = None
cycle_readout = None
additional_drive_sprockets = None
wheel_drive_chain = None
duck_bill_mount = None
arm_two_end_plate = None
arm_two_top_plate = None
arm_two_down_plate = None
arm_two_bottom_plate = None


def solve_chain_rollers(offset):
    """Taut straight spans at fixed centres, with exact roller-to-roller pitch.

    A tiny common pitch-route radius correction closes the discretized roller
    polygon during animation. This does not resize the sprockets or bow a span.
    """
    low, high = -0.1, 0.1
    for _ in range(40):
        sag = (low + high) / 2.0
        route, distances = make_chain_route(build_chain_path(upper_right_x, 230.0, sag), 0.0)
        points, residual = walk_chain_route(route, distances, offset, NUM_LINKS)
        if abs(residual) < 1.0e-8:
            return [V(x, y, 0) for x, y in points[:-1]], sag
        if residual > 0:
            low = sag
        else:
            high = sag
    raise RuntimeError("Unable to close the resized primary chain.")


def apply_simulation_state():
    """Keep fixed sprocket centres and solve a closed chain with exact pitch."""
    roller_points, route_correction = solve_chain_rollers(animation_offset)
    for index, link in enumerate(links):
        p1 = roller_points[index]
        p2 = roller_points[(index + 1) % NUM_LINKS]
        yaw = math.degrees(math.atan2(p2.y - p1.y, p2.x - p1.x))
        link.Placement = App.Placement(p1 + drivetrain_local_shift, App.Rotation(V(0, 0, 1), yaw))

    wheel_angle = -360.0 * animation_offset / (PITCH * T1) / 6.4
    ground_drive_wheel.Placement = App.Placement(
        V(620.0, 0, WHEEL_Z_OFFSET),
        App.Rotation(V(0, 0, 1), sprocket_phase_offsets[0] + WHEEL_PHASE_OFFSET + wheel_angle))
    sprocket_angles = [phase + wheel_angle * 6.4 * T1 / teeth
                       for phase, teeth in zip(sprocket_phase_offsets, (T1, T2, T3))]
    for sprocket, centre, angle in zip(sprockets, centres, sprocket_angles):
        sprocket.Placement = App.Placement(centre + drivetrain_local_shift, App.Rotation(V(0, 0, 1), angle))
    if additional_drive_sprockets is not None:
        additional_drive_sprockets.update()
    if wheel_drive_chain is not None:
        wheel_drive_chain.update()
    if duck_bill_motion is not None:
        duck_bill_motion.update()
    if arm_two_end_plate is not None:
        arm_two_end_plate.Placement = doc.duck_bill_arm_two.getGlobalPlacement()
    if arm_two_top_plate is not None:
        arm_two_top_plate.Placement = doc.duck_bill_arm_two.getGlobalPlacement()
    if arm_two_down_plate is not None:
        arm_two_down_plate.Placement = doc.duck_bill_arm_two.getGlobalPlacement()
    if arm_two_bottom_plate is not None:
        arm_two_bottom_plate.Placement = doc.duck_bill_arm_two.getGlobalPlacement()
    if duck_bill_mount is not None:
        duck_bill_mount.update()
    if moving_ground is not None:
        moving_ground.update()
    if cycle_readout is not None:
        cycle_readout.update()


def update_simulation():
    global animation_offset
    if App.getDocument(doc.Name) is None:
        App.sim_timer.stop()
        return
    animation_offset += 1.0
    try:
        apply_simulation_state()
        Gui.updateGui()
    except Exception as error:
        App.sim_timer.stop()
        App.Console.PrintError("Simulation stopped: {}\n".format(error))


def rotate_complete_assembly(doc):
    """Keep animation in local coordinates inside a rotated assembly container."""
    objects = list(doc.Objects)
    visibility = {obj.Name: obj.ViewObject.Visibility for obj in objects}
    child_names = {child.Name for obj in objects
                   for child in getattr(obj, "Group", [])}
    roots = [obj for obj in objects if not obj.InList]
    assembly = doc.addObject("App::Part", "CompleteAssembly")
    assembly.Label = "Complete assembly (YZ -90 deg)"
    for obj in roots:
        assembly.addObject(obj)
    assembly.Placement = App.Placement(App.Vector(0, 0, 0),
                                       App.Rotation(App.Vector(1, 0, 0), -90.0))
    for obj in objects:
        if "Group" in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    for obj in objects:
        if "Group" not in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    doc.recompute()
    return assembly


complete_assembly = rotate_complete_assembly(doc)

# Convert the global drive translation into the animated assembly coordinates.
drivetrain_local_shift = complete_assembly.getGlobalPlacement().Rotation.inverted().multVec(V(0, -700, 0))


# Translate the duck bill in world coordinates after the complete assembly rotation.
duck_bill_world_shift = App.Placement(V(-250, -300, -200), App.Rotation())
for obj in doc.Objects:
    if obj.Name.startswith(("Closed_0deg_", "Opened_20deg_")) and obj.isDerivedFrom("Part::Feature"):
        parent_placement = obj.getGlobalPlacement().multiply(obj.Placement.inverse())
        obj.Placement = (parent_placement.inverse().multiply(duck_bill_world_shift)
                         .multiply(parent_placement).multiply(obj.Placement))

doc.recompute()
apply_simulation_state()
doc.recompute()

# Fixed plate centered on the drive sprocket axis, +50 mm along global Y.
def add_duck_bill_arm_one(doc):
    sprocket_centre = doc.getObject("sprocket_16T_01").getGlobalPlacement().Base
    centre = sprocket_centre + V(0, 50, 0)
    arm = doc.addObject("Part::Feature", "duck_bill_arm_one")
    arm.Label = "duck_bill_arm_one"
    plate = Part.makeBox(300.0, 6.0, 50.0, V(-150.0, -3.0, -25.0))
    # Positive-X end is x=150: slot-end centres are x=135 and x=25.
    # Cut along Y through the entire 6 mm thickness; slot is centred at z=0.
    hole_near_end = Part.makeCylinder(10.0, 8.0, V(135.0, -4.0, 0), V(0, 1, 0))
    hole_far_end = Part.makeCylinder(10.0, 8.0, V(25.0, -4.0, 0), V(0, 1, 0))
    slot_bridge = Part.makeBox(110.0, 8.0, 20.0, V(25.0, -4.0, -10.0))
    slot_tool = hole_near_end.fuse(hole_far_end).fuse(slot_bridge)
    arm.Shape = plate.cut(slot_tool).removeSplitter()
    arm.addProperty("App::PropertyLength", "SlotDiameter", "Slot")
    arm.addProperty("App::PropertyLength", "NearHoleEndOffset", "Slot")
    arm.addProperty("App::PropertyLength", "FarHoleEndOffset", "Slot")
    arm.SlotDiameter = 20.0
    arm.NearHoleEndOffset = 15.0
    arm.FarHoleEndOffset = 125.0
    arm.Placement = App.Placement(centre, App.Rotation())
    arm.addProperty("App::PropertyLength", "LengthX", "Dimensions")
    arm.addProperty("App::PropertyLength", "ThicknessY", "Dimensions")
    arm.addProperty("App::PropertyLength", "HeightZ", "Dimensions")
    arm.addProperty("App::PropertyDistance", "SprocketOffsetY", "Dimensions")
    arm.LengthX, arm.ThicknessY, arm.HeightZ = 300.0, 6.0, 50.0
    arm.SprocketOffsetY = 50.0
    arm.ViewObject.ShapeColor = (0.65, 0.68, 0.72)
    return arm


duck_bill_arm_one = add_duck_bill_arm_one(doc)
doc.recompute()

# Slot hole centres are x=25 and x=85 in the plate's local coordinates.
def add_duck_bill_arm_one_pin(doc):
    arm = doc.getObject("duck_bill_arm_one")
    pin = doc.addObject("Part::Feature", "duck_bill_arm_one_pin")
    pin.Label = "duck_bill_arm_one_pin"
    pin.Shape = Part.makeCylinder(10.0, 50.0, V(55.0, -25.0, 0), V(0, 1, 0))
    pin.Placement = arm.getGlobalPlacement()
    pin.addProperty("App::PropertyLength", "Diameter", "Dimensions")
    pin.addProperty("App::PropertyLength", "LengthY", "Dimensions")
    pin.Diameter = 20.0
    pin.LengthY = 50.0
    pin.ViewObject.ShapeColor = (0.78, 0.78, 0.80)
    return pin


duck_bill_arm_one_pin = add_duck_bill_arm_one_pin(doc)
doc.recompute()

def add_duck_bill_arm_two(doc):
    # Local X runs from 0 to 520 mm; the hole is at X=15, Z=0.
    pin_centre = doc.getObject("duck_bill_arm_one_pin").Shape.CenterOfMass
    plate = Part.makeBox(520.0, 6.0, 50.0, V(0, -3.0, -25.0))
    hole = Part.makeCylinder(10.0, 8.0, V(15.0, -4.0, 0), V(0, 1, 0))
    arm = doc.addObject("Part::Feature", "duck_bill_arm_two")
    arm.Label = "duck_bill_arm_two"
    arm.Shape = plate.cut(hole).removeSplitter()
    # Adjacent +Y faces touch: 3 mm half-thickness for each plate.
    arm.Placement = App.Placement(pin_centre + V(-15.0, 6.0, 0), App.Rotation())
    for prop, value in (("LengthX", 520.0), ("ThicknessY", 6.0),
                        ("HeightZ", 50.0), ("HoleDiameter", 20.0),
                        ("HoleOffsetX", 15.0)):
        arm.addProperty("App::PropertyLength", prop, "Dimensions")
        setattr(arm, prop, value)
    arm.ViewObject.ShapeColor = (0.55, 0.62, 0.70)
    return arm


duck_bill_arm_two = add_duck_bill_arm_two(doc)
doc.recompute()

def add_duck_bill_arm_two_centre_plates(doc):
    arm = doc.getObject("duck_bill_arm_two")
    result = []
    for suffix, offset_y in (("positive_y", 6.0), ("negative_y", -6.0)):
        plate = doc.addObject("Part::Feature", "duck_bill_arm_two_centre_plate_" + suffix)
        plate.Label = "duck_bill_arm_two_centre_plate_" + suffix
        # Lower edge aligns with the arm at Z=-25; upper edge is Z=75.
        blank = Part.makeBox(50.0, 6.0, 100.0, V(-25.0, -3.0, -25.0))
        hole = Part.makeCylinder(10.0, 8.0, V(0, -4.0, 60.0), V(0, 1, 0))
        plate.Shape = blank.cut(hole).removeSplitter()
        plate.Placement = arm.getGlobalPlacement().multiply(
            App.Placement(V(400.0, offset_y, 0), App.Rotation()))
        for prop, value in (("LengthX", 50.0), ("ThicknessY", 6.0),
                            ("HeightZ", 100.0), ("HoleDiameter", 20.0),
                            ("HoleTopEdgeOffset", 15.0)):
            plate.addProperty("App::PropertyLength", prop, "Dimensions")
            setattr(plate, prop, value)
        plate.ViewObject.ShapeColor = (0.60, 0.66, 0.72)
        result.append(plate)
    return result


duck_bill_arm_two_centre_plates = add_duck_bill_arm_two_centre_plates(doc)
doc.recompute()

def add_sprocket_21t_shaft(doc):
