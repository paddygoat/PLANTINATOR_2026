class MovingSoilGround:
    """Scroll soil past a stationary machine at the wheel's rolling speed."""
    def __init__(self, document):
        import random
        self.doc = document
        self.wheel = document.getObject("GroundDriveWheel")
        self.axle = self.wheel.getGlobalPlacement().Base
        self.lug_tip_radius = FRONT_DISC_OD / 2.0 - LUG_WELD_OVERLAP + LUG_LENGTH
        self.group = document.addObject("App::DocumentObjectGroup", "MovingGround")
        self.group.Label = "Moving soil — stationary machine"
        for prop, value in (("LugPenetration", 40.0), ("RollingRadius", self.lug_tip_radius - 40.0),
                            ("Travel", 0.0), ("GroundHeight", self.axle.z - self.lug_tip_radius + 40.0)):
            self.group.addProperty("App::PropertyLength", prop, "Ground motion")
            setattr(self.group, prop, value)
        self.group.addProperty("App::PropertyFloat", "RoughnessMultiplier", "Ground motion")
        self.group.RoughnessMultiplier = 3.0
        self.group.setEditorMode("RoughnessMultiplier", 1)
        self.group.addProperty("App::PropertyBool", "Enabled", "Ground motion")
        self.group.Enabled = True
        self.group.addProperty("App::PropertyString", "MotionModel", "Ground motion")
        self.group.MotionModel = "No-slip visual rolling: ground travel = wheel angle (radians) x effective radius. Soil penetration is illustrative; no soil-force simulation."
        for prop in ("RollingRadius", "Travel", "GroundHeight", "MotionModel"):
            self.group.setEditorMode(prop, 1)
        # Size the visible field around the existing machine, not the camera.
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.tile_length = 300.0
        # Double the previous 3900 x 1922 mm soil footprint about its centre.
        self.x_min = -3450.0
        self.tile_count = 26
        self.field_length = 7800.0
        self.y_min, self.y_max = -2437.0, 1407.0
        self.field_width = 3844.0
        self.surface = document.addObject("Part::Feature", "SoilSurface")
        self.surface.Label = "Soil surface"
        self.surface.Shape = Part.makeBox(self.field_length, self.field_width, 150.0,
                                          V(self.x_min, self.y_min, -150.0))
        self.surface.ViewObject.ShapeColor = (0.28, 0.19, 0.11)
        self.surface.ViewObject.Transparency = 50
        self.surface.ViewObject.DisplayMode = "Flat Lines"
        self.surface.ViewObject.LineColor = (0.28, 0.19, 0.11)
        self.group.addObject(self.surface)
        self.tiles = []
        for index in range(self.tile_count):
            rng = random.Random(17041 + index)
            light, dark = [], []
            # Low soil clods and scattered grains supply clear motion cues.
            for j in range(24):
                x = rng.uniform(8.0, self.tile_length - 8.0)
                y = rng.uniform(self.y_min + 8.0, self.y_max - 8.0)
                radius = rng.uniform(2.0, 6.0)
                light.append(Part.makeCylinder(radius, rng.uniform(0.5, 1.8) * 3.0, V(x, y, 0.15)))
                dark.append(Part.makeBox(rng.uniform(8.0, 22.0), rng.uniform(2.0, 6.0), 0.36,
                                        V(rng.uniform(5.0, self.tile_length - 25.0), y, 0.06)))
            objects = []
            for suffix, shapes, colour in (("Clods", light, (0.40, 0.29, 0.18)),
                                            ("Grains", dark, (0.19, 0.125, 0.07))):
                obj = document.addObject("Part::Feature", "SoilTile_{:02d}_{}".format(index, suffix))
                obj.Label = "Moving soil {:02d} {}".format(index + 1, suffix.lower())
                obj.Shape = Part.makeCompound(shapes)
                obj.ViewObject.ShapeColor = colour
                obj.ViewObject.Transparency = 50
                obj.ViewObject.LineColor = colour
                obj.ViewObject.DisplayMode = "Flat Lines"
                self.group.addObject(obj)
                objects.append(obj)
            self.tiles.append(objects)
        self.last_travel = 0.0
        self.update()

    def update(self):
        penetration = max(0.0, min(40.0, self.group.LugPenetration.Value))
        radius = self.lug_tip_radius - penetration
        height = self.axle.z - radius
        # Wheel angle about global Y is -animation_offset/R1. Ground moves
        # opposite the machine's notional travel, along +X for forward playback.
        if self.group.Enabled:
            self.last_travel = animation_offset / (PITCH * T1 / (2 * math.pi)) * radius / 6.4
        travel = self.last_travel
        self.surface.Placement.Base = V(0, 0, height)
        self.group.RollingRadius = radius
        self.group.Travel = abs(travel)
        self.group.GroundHeight = height
        phase = travel % self.field_length
        for index, objects in enumerate(self.tiles):
            x = self.x_min + (index * self.tile_length + phase) % self.field_length
            for obj in objects:
                obj.Placement.Base = V(x, 0, height)


class DuckBillCycleReadout:
    """World-space ZX readout of net soil-relative advance per duck-bill cycle."""
    def __init__(self, document):
        self.doc = document
        self.group = document.addObject("App::DocumentObjectGroup", "DuckBillCycleReadout")
        self.group.Label = "Duck-bill cycle distance (ZX readout)"
        self.group.addProperty("App::PropertyLength", "DistancePerCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyFloat", "WheelTurnsPerDuckBillCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyLink", "CycleDriver", "Cycle measurement")
        self.group.CycleDriver = document.sprocket_16T_03
        self.group.addProperty("App::PropertyString", "Definition", "Cycle measurement")
        self.group.Definition = "Net soil-relative advance per complete duck-bill cycle = 2*pi*T3/T1*(10/64)*rolling radius. Both 16T crank sprockets complete one revolution per cycle; the wheel completes 10/64 of a revolution."
        for prop in ("DistancePerCycle", "WheelTurnsPerDuckBillCycle", "CycleDriver", "Definition"):
            self.group.setEditorMode(prop, 1)
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.x = bounds.XMax - 470.0
        self.y = bounds.YMin - 40.0
        self.z = bounds.ZMax + 35.0
        width, height = 510.0, 145.0
        vertices = [V(self.x, self.y, self.z), V(self.x + width, self.y, self.z),
                    V(self.x + width, self.y, self.z + height), V(self.x, self.y, self.z + height)]
        wire = Part.makePolygon(vertices + [vertices[0]])
        background = document.addObject("Part::Feature", "CycleReadoutBackground")
        background.Shape = Part.Face(wire)
        background.ViewObject.ShapeColor = (0.065, 0.075, 0.085)
        background.ViewObject.LineColor = (0.065, 0.075, 0.085)
        background.ViewObject.DisplayMode = "Flat Lines"
        frame = document.addObject("Part::Feature", "CycleReadoutFrame")
        frame.Shape = wire
        frame.Placement.Base = V(0, -0.1, 0)
        frame.ViewObject.LineColor = (1.0, 1.0, 1.0)
        frame.ViewObject.LineWidth = 2.0
        self.group.addObject(background)
        self.group.addObject(frame)
        candidates = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
            "C:/Windows/Fonts/arial.ttf",
            "/System/Library/Fonts/Supplemental/Arial.ttf",
        ]
        self.font = next((path for path in candidates if os.path.isfile(path)), None)
        if self.font is None:
            raise RuntimeError("A DejaVu Sans, Liberation Sans or Arial font is required for the cycle display.")
        self.make_text("CycleReadoutTitle", "NET SOIL TRAVEL / DUCK-BILL CYCLE", 16.0, 108.0)
        self.value_text = self.make_text("CycleReadoutValue", "Calculating...", 33.0, 53.0)
        self.make_text("CycleReadoutNote", "1 cycle = one duck-bill crank revolution", 12.0, 20.0)
        self.last_text = None

    def text_shape(self, text, size):
        letters = Part.makeWireString(text, os.path.dirname(self.font) + os.sep,
                                      os.path.basename(self.font), size)
        faces = [Part.makeFace(wires, "Part::FaceMakerBullseye") for wires in letters if wires]
        return Part.makeCompound(faces)

    def make_text(self, name, text, size, height):
        obj = self.doc.addObject("Part::Feature", name)
        obj.Label = text
        obj.Shape = self.text_shape(text, size)
        # Font XY -> global XZ; front faces point towards -Y.
        obj.Placement = App.Placement(V(self.x + 20.0, self.y - 0.2, self.z + height),
                                      App.Rotation(V(1, 0, 0), 90.0))
        obj.ViewObject.ShapeColor = (1.0, 1.0, 1.0)
        obj.ViewObject.LineColor = (1.0, 1.0, 1.0)
        obj.ViewObject.DisplayMode = "Flat Lines"
        self.group.addObject(obj)
        return obj

    def update(self):
        if moving_ground is None:
            return
        # R3 is the duck-bill crank sprocket radius, regardless of its old object name.
        ratio = T3 / T1 / 6.4
        distance = 2.0 * math.pi * ratio * moving_ground.group.RollingRadius.Value
        if not moving_ground.group.Enabled:
            distance = 0.0
        self.group.WheelTurnsPerDuckBillCycle = ratio
        self.group.DistancePerCycle = distance
        text = "{:,.1f} mm / cycle".format(distance) if linkage_motion_available else "NO FULL CYCLE"
        if text != self.last_text:
            placement = self.value_text.Placement
            self.value_text.Shape = self.text_shape(text, 33.0)
            self.value_text.Placement = placement
            self.value_text.Label = text
            self.last_text = text


cycle_readout = DuckBillCycleReadout(doc) if DISPLAY_DISTANCE_READOUT else None
App.duck_bill_cycle_readout = cycle_readout
doc.recompute()


# Embedded Wilwood geometry: editable plain Python, ordinary construction functions.
def create_wilwood_260_1333(doc):
    """Wilwood 260-1333 pull-type clutch slave cylinder -- layout/reference model.
    Source: supplied DS-751D, 2016-05-02, page 2 Figure 1.
    All dimensions in mm. Axis X; mounting-eye hole along Y; bleed screw up Z.
    The 297 dimension ends at the eye CENTRE, not its outer edge.
    Unspecified dimensions below are drawing-proportioned estimates, not production data.
    Threads are plain nominal-diameter envelopes, not helical threads.
    Run again after editing PARAMETERS to generate another document.
    """
    import math
    import FreeCAD as App
    import Part
    V = App.Vector

    # DRAWING / SPECIFICATION VALUES
    TIP_TO_EYE = 297.0         # Figure 1: 11.7 (297.0)
    BODY_MAX_OD = 34.5         # Figure 1: 1.36 (34.5)
    BORE = 0.875 * 25.4        # specification: 0.875 inch; drawing rounds to 22.2
    ROD_THREAD_OD = 5.0/16*25.4 # 5/16-24 UNF
    EYE_HOLE = 7.9             # Figure 1: .312 (7.9)
    MAX_STROKE = 34.9          # Figure 1; spec's rounded 1.38 in converts to 35.052
    STROKE_POSITION = 0.0      # EDIT: 0 (illustrated extended pose) through 34.9 (pulled)
    INLET_THREAD_OD = 3.0/8*25.4 # illustrated 3/8-24 inverted-flare inlet

    # ESTIMATED EXTERNAL GEOMETRY: editable, scaled from the Figure 1 side view.
    BODY_START = 99.5
    BODY_END = 177.5
    BODY_MAIN_OD = 28.0
    COLLAR_START = 108.5
    COLLAR_LENGTH = 17.0
    PORT_BLOCK_START = 164.0
    BOOT_END_EXTENDED = 227.0
    BOOT_LARGE_RADIUS = 15.8
    BOOT_SMALL_RADIUS = 10.0
    BOOT_WALL = 1.2
    BOOT_FOLDS = 4
    EYE_OUTER_DIAMETER = 22.0
    EYE_THICKNESS = 8.0
    ROD_OD = 7.9
    INLET_X = 170.75
    BLEED_X = 170.75

    if not 0 <= STROKE_POSITION <= MAX_STROKE:
        raise ValueError('STROKE_POSITION must be between 0 and 34.9 mm.')
    assembly=doc.addObject('App::Part','Wilwood2601333')
    assembly.Label='Wilwood 260-1333 - reference geometry'
    for name,value in [('TipToEyeCentre',TIP_TO_EYE),('BodyMaximumDiameter',BODY_MAX_OD),
                       ('BoreDiameter',BORE),('MaximumStroke',MAX_STROKE),
                       ('StrokePosition',STROKE_POSITION),('EyeHoleDiameter',EYE_HOLE)]:
        assembly.addProperty('App::PropertyLength',name,'Drawing dimensions')
        setattr(assembly,name,value);assembly.setEditorMode(name,1)
    assembly.addProperty('App::PropertyString','Source','Reference')
    assembly.Source='DS-751D REV 05-02-16, supplied PDF, page 2 Figure 1'
    assembly.addProperty('App::PropertyString','ModellingNotes','Reference')
    assembly.ModellingNotes='External reference model. Undimensioned axial lengths, fittings, boot and eye exterior are estimated. Threads simplified; seals/piston omitted. Edit macro parameters and rerun.'
    assembly.addProperty('App::PropertyString','StrokeNote','Reference')
    assembly.StrokeNote='Uses drawing 34.9 mm; rounded table value 1.38 inch equals 35.052 mm.'
    body_group=doc.addObject('App::DocumentObjectGroup','CylinderFixedParts');assembly.addObject(body_group)
    rod_group=doc.addObject('App::DocumentObjectGroup','PullRodParts');assembly.addObject(rod_group)
    STEEL=(0.72,0.74,0.77);ALLOY=(0.48,0.50,0.53);BLACK=(0.10,0.11,0.12)
    def add(name,label,shape,colour=STEEL,group=body_group,note='Estimated shape from Figure 1'):
        obj=doc.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape
        obj.addProperty('App::PropertyString','GeometryBasis','Reference');obj.GeometryBasis=note
        group.addObject(obj)
        if App.GuiUp:
            obj.ViewObject.ShapeColor=colour;obj.ViewObject.LineColor=(0.12,0.12,0.12)
        if shape.isNull() or not shape.isValid():raise RuntimeError('Invalid solid: '+name)
        return obj

    def cx(radius,length,x):return Part.makeCylinder(radius,length,V(x,0,0),V(1,0,0))
    def hexagon(af,length,origin,axis):
        radius=af/math.sqrt(3)
        pts=[V(radius*math.cos(i*math.pi/3),radius*math.sin(i*math.pi/3),0) for i in range(6)]
        solid=Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,length))
        solid.Placement=App.Placement(origin,App.Rotation(V(0,0,1),axis))
        return solid

    def hexnut(name,x,length,af,group=body_group):
        shape=hexagon(af,length,V(x,0,0),V(1,0,0)).cut(cx(ROD_THREAD_OD/2,length+2,x-1))
        return add(name,name.replace('_',' '),shape,STEEL,group)

    # Main hollow barrel, large collar, and port end. The hidden piston is not inferred.
    body=cx(BODY_MAIN_OD/2,BODY_END-BODY_START,BODY_START)
    body=body.fuse(cx(BODY_MAX_OD/2,COLLAR_LENGTH,COLLAR_START))
    body=body.fuse(cx(BODY_MAX_OD/2,BODY_END-PORT_BLOCK_START,PORT_BLOCK_START))
    body=body.cut(cx(BORE/2,BODY_END-BODY_START-10,BODY_START+5))
    body=body.cut(cx(ROD_OD/2+0.2,BODY_END-BODY_START+2,BODY_START-1))
    # Side inlet is on the viewer-facing (-Y) side; simplified cylindrical threaded port.
    port=Part.makeCylinder(INLET_THREAD_OD/2,12,V(INLET_X,-23,0),V(0,1,0))
    body=body.cut(port)
    add('CylinderBody','Cylinder body - max OD 34.5, bore 22.225',body.removeSplitter(),ALLOY,
        note='OD 34.5 and bore 0.875 inch stated; axial segments estimated')
    add('ThreadedMountRod','5/16-24 mounting rod (thread envelope)',cx(ROD_THREAD_OD/2,BODY_START+5,0),
        note='5/16-24 thread stated; exposed length estimated')
    hexnut('Mount_adjustment_nut',10,5,12.7)
    hexnut('Mount_lock_nut',15.5,5,12.7)
    hexnut('Body_mount_nut',94.5,5,12.7)
    # Rounded pivot bush next to adjustment nuts.
    bush=cx(8,7.5,21).cut(cx(ROD_THREAD_OD/2+0.1,9.5,20))
    add('PivotBush','Mount pivot bushing',bush)

    # Annular inlet hex boss and opening (no hose fitting inferred).
    boss=hexagon(12.7,4,V(INLET_X,-19,0),V(0,1,0)).cut(port)
    add('InletBoss','3/8-24 inverted-flare inlet (simplified)',boss)
    # Bleeder stack above the body, with a small axial bleed drilling.
    bleed=Part.makeCylinder(4.5,7,V(BLEED_X,0,14),V(0,0,1))
    bleed=bleed.fuse(hexagon(10,7,V(BLEED_X,0,21),V(0,0,1)))
    bleed=bleed.fuse(Part.makeCylinder(2.2,7,V(BLEED_X,0,28),V(0,0,1)))
    bleed=bleed.fuse(Part.makeCone(3,1.5,2,V(BLEED_X,0,35),V(0,0,1)))
    bleed=bleed.cut(Part.makeCylinder(0.7,25,V(BLEED_X,0,13),V(0,0,1)))
    add('BleedScrew','Bleed screw - estimated external detail',bleed)

    # Flexible boot: closed thin-walled revolved bellows follows the selected stroke.
    boot_end=BOOT_END_EXTENDED-STROKE_POSITION
    boot_start=BODY_END
    shoulder_end=boot_start+(boot_end-boot_start)*0.30
    profile=[(boot_start,BOOT_LARGE_RADIUS),(shoulder_end,BOOT_LARGE_RADIUS-1)]
    for i in range(1,BOOT_FOLDS*2+1):
        t=i/(BOOT_FOLDS*2)
        x=shoulder_end+(boot_end-shoulder_end)*t
        radius=(BOOT_LARGE_RADIUS-1)*(1-t)+BOOT_SMALL_RADIUS*t
        if i%2:radius-=2.8
        profile.append((x,radius))
    outer=[V(x,r,0) for x,r in profile]
    inner=[V(x,r-BOOT_WALL,0) for x,r in reversed(profile)]
    points=outer+inner
    boot=Part.Face(Part.makePolygon(points+[points[0]])).revolve(V(0,0,0),V(1,0,0),360)
    add('DustBoot','Flexible dust boot - estimated profile',boot,BLACK)

    # The eye moves toward the cylinder as the pull stroke increases.
    eye_x=TIP_TO_EYE-STROKE_POSITION
    stem=cx(ROD_OD/2,eye_x-8-(BODY_END-8),BODY_END-8)
    add('PullRod','Pull rod',stem,STEEL,rod_group)
    hexnut('Eye_lock_nut',eye_x-40,10,12.7,rod_group)
    eye=Part.makeCylinder(EYE_OUTER_DIAMETER/2,EYE_THICKNESS,V(eye_x,-EYE_THICKNESS/2,0),V(0,1,0))
    neck=cx(5.7,20,eye_x-30)
    eye=eye.fuse(neck)
    hole=Part.makeCylinder(EYE_HOLE/2,EYE_THICKNESS+2,V(eye_x,-EYE_THICKNESS/2-1,0),V(0,1,0))
    eye=eye.cut(hole).removeSplitter()
    add('MountingEye','Rod-end mounting eye - diameter 7.9 hole',eye,STEEL,rod_group,
        note='Hole 7.9 mm stated; exterior and thickness estimated')
    doc.recompute()
    return assembly

def create_wilwood_260_1304(doc):
    """Wilwood 260-1304 -- standalone assembly-layout reference model.
    Source: user-supplied Wilwood 260-1304.png dimensioned side/end drawing.
    Millimetres. X along cylinder toward pushrod, Y transverse, Z upward.
    X=0 is rear housing datum, Z=0 is pushrod centreline.
    Edit parameters and rerun; each run creates a new document.
    Undimensioned geometry is estimated. Bore size and hydraulic internals are not supplied.
    Threads are nominal-diameter envelopes, not helical geometry.
    """
    import math
    import FreeCAD as App
    import Part
    V=App.Vector

    # Stated drawing values (metric callouts used, including their rounding).
    OVERALL_LENGTH=199.3
    REAR_TO_FLANGE_FACE=100.5
    BODY_AND_CAP_HEIGHT=86.4
    CAP_DIAMETER=51.2
    FLANGE_WIDTH=44.5
    MOUNT_HOLE_SPACING=57.1
    MOUNT_HOLE_DIAMETER=10.2
    BOOT_DIAMETER=35.6
    MAX_STROKE=31.8
    PUSHROD_THREAD_DIAMETER=5.0/16.0*25.4 # 5/16-24
    OUTLET_THREAD_DIAMETER=3.0/8.0*25.4  # 3/8-24
    STROKE_POSITION=0.0 # EDIT 0..31.8; positive values push the rod into the housing.

    # Estimated from the drawing; not manufacturer manufacturing dimensions.
    BODY_RADIUS=13.25
    RESERVOIR_DIAMETER=43.0
    RESERVOIR_X=21.5
    RESERVOIR_WALL=2.0
    CAP_HEIGHT=15.5
    FLANGE_THICKNESS=7.5
    FLANGE_TIP_RADIUS=11.7
    BOOT_END=158.5
    BOOT_WALL=1.2
    BOOT_SMALL_RADIUS=6.5
    BOOT_FOLDS=3
    PUSHROD_DIAMETER=7.94
    OUTLET_BASE_X=45.5

    if not 0 <= STROKE_POSITION <= MAX_STROKE:
        raise ValueError('STROKE_POSITION must be between 0 and 31.8 mm.')
    assembly=doc.addObject('App::Part','Wilwood2601304')
    assembly.Label='Wilwood 260-1304 master cylinder'
    for name,val in [('OverallLength',OVERALL_LENGTH),('RearToFlangeFace',REAR_TO_FLANGE_FACE),
                     ('BodyAndCapHeight',BODY_AND_CAP_HEIGHT),('CapDiameter',CAP_DIAMETER),
                     ('FlangeWidth',FLANGE_WIDTH),('MountHoleSpacing',MOUNT_HOLE_SPACING),
                     ('MountHoleDiameter',MOUNT_HOLE_DIAMETER),('BootDiameter',BOOT_DIAMETER),
                     ('MaximumStroke',MAX_STROKE),('StrokePosition',STROKE_POSITION)]:
        assembly.addProperty('App::PropertyLength',name,'Drawing dimensions')
        setattr(assembly,name,val);assembly.setEditorMode(name,1)
    assembly.addProperty('App::PropertyString','Source','Reference')
    assembly.Source='User-supplied Wilwood 260-1304.png, dimensioned side/end views'
    assembly.addProperty('App::PropertyString','ModellingNotes','Reference')
    assembly.ModellingNotes='Reference exterior. Unspecified shapes estimated; no piston/seals or assumed bore. Threads simplified. Edit macro parameters and rerun; properties record generated geometry.'
    assembly.addProperty('App::PropertyString','MountHoleNote','Reference')
    assembly.MountHoleNote='Centres placed symmetrically at Z +/-28.55 for 57.1 spacing; drawing separately rounds centre-to-upper-hole to 28.6.'
    fixed=doc.addObject('App::DocumentObjectGroup','FixedParts');assembly.addObject(fixed)
    moving=doc.addObject('App::DocumentObjectGroup','MovingParts');assembly.addObject(moving)
    ALLOY=(0.55,0.57,0.59);STEEL=(0.75,0.76,0.78);RUBBER=(0.09,0.10,0.11);CAP=(0.15,0.16,0.18)
    def add(name,label,shape,colour=ALLOY,group=fixed,note='Estimated undimensioned exterior from supplied drawing'):
        if shape.isNull() or not shape.isValid() or shape.Volume<=0:raise RuntimeError('Invalid geometry: '+name)
        o=doc.addObject('Part::Feature',name);o.Label=label;o.Shape=shape;group.addObject(o)
        o.addProperty('App::PropertyString','GeometryBasis','Reference');o.GeometryBasis=note
        if App.GuiUp:
            o.ViewObject.ShapeColor=colour;o.ViewObject.LineColor=(0.12,0.12,0.12)
        return o

    def cx(r,length,x):return Part.makeCylinder(r,length,V(x,0,0),V(1,0,0))
    def hex_prism(af,length,origin,axis):
        r=af/math.sqrt(3)
        pts=[V(r*math.cos(i*math.pi/3),r*math.sin(i*math.pi/3),0) for i in range(6)]
        shape=Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,length))
        shape.Placement=App.Placement(origin,App.Rotation(V(0,0,1),axis))
        return shape

    # Rear housing and open reservoir. Hydraulic bore is intentionally not inferred.
    cap_top=BODY_AND_CAP_HEIGHT-BODY_RADIUS
    cap_bottom=cap_top-CAP_HEIGHT
    barrel=cx(BODY_RADIUS,REAR_TO_FLANGE_FACE,0)
    reservoir=Part.makeCylinder(RESERVOIR_DIAMETER/2,cap_bottom,V(RESERVOIR_X,0,0))
    housing=barrel.fuse(reservoir)
    housing=housing.cut(Part.makeCylinder(RESERVOIR_DIAMETER/2-RESERVOIR_WALL,cap_bottom,
                                        V(RESERVOIR_X,0,5)))
    # Small pushrod guide recess, external representation only.
    housing=housing.cut(cx(PUSHROD_DIAMETER/2+0.5,12,REAR_TO_FLANGE_FACE-10))
    axis=V(0.5,0,math.sqrt(3)/2)
    base=V(OUTLET_BASE_X,0,10)
    outlet_boss=Part.makeCylinder(8,14,base,axis)
    housing=housing.fuse(outlet_boss)
    outlet_drill=Part.makeCylinder(OUTLET_THREAD_DIAMETER/2,20,base+axis*2,axis)
    housing=housing.cut(outlet_drill).removeSplitter()
    add('Housing','Cylinder housing and reservoir',housing)

    # End-view mounting flange: width and hole positions specified; outline estimated.
    x=REAR_TO_FLANGE_FACE-FLANGE_THICKNESS
    half=MOUNT_HOLE_SPACING/2;r=FLANGE_TIP_RADIUS;wide=FLANGE_WIDTH/2
    p=lambda y,z:V(x,y,z)
    points=[p(-r,half),p(-wide,10),p(-wide,-10),p(-r,-half)]
    edges=[Part.makeLine(points[i],points[i+1]) for i in range(3)]
    edges.append(Part.Arc(p(-r,-half),p(0,-half-r),p(r,-half)).toShape())
    right=[p(r,-half),p(wide,-10),p(wide,10),p(r,half)]
    edges.extend(Part.makeLine(right[i],right[i+1]) for i in range(3))
    edges.append(Part.Arc(p(r,half),p(0,half+r),p(-r,half)).toShape())
    flange=Part.Face(Part.Wire(edges)).extrude(V(FLANGE_THICKNESS,0,0))
    for z in (-half,half):
        flange=flange.cut(Part.makeCylinder(MOUNT_HOLE_DIAMETER/2,FLANGE_THICKNESS+2,V(x-1,0,z),V(1,0,0)))
    flange=flange.cut(cx(PUSHROD_DIAMETER/2+0.5,FLANGE_THICKNESS+2,x-1))
    add('MountingFlange','Mounting flange - two diameter 10.2 holes at 57.1 centres',flange,
        note='Width 44.5, hole diameter 10.2 and spacing 57.1 stated. Thickness and outline estimated.')

    # Reservoir cap with simple raised ribs; exact outside diameter and total height.
    cap=Part.makeCylinder(CAP_DIAMETER/2-0.8,CAP_HEIGHT,V(RESERVOIR_X,0,cap_bottom))
    for i in range(32):
        a=2*math.pi*i/32;r=CAP_DIAMETER/2-0.8
        rib=Part.makeCylinder(0.8,CAP_HEIGHT-1,V(RESERVOIR_X+r*math.cos(a),r*math.sin(a),cap_bottom+0.5))
        cap=cap.fuse(rib)
    cap=cap.cut(Part.makeCylinder(RESERVOIR_DIAMETER/2-0.7,CAP_HEIGHT-3,V(RESERVOIR_X,0,cap_bottom-0.1)))
    add('ReservoirCap','Reservoir cap - diameter 51.2',cap.removeSplitter(),CAP,
        note='Diameter 51.2 and combined body/cap height 86.4 stated; ribbing and cap height estimated.')

    # Angled outlet represented as a bored hex adapter, not a plugged port.
    outlet=hex_prism(14,9,base+axis*14,axis)
    outlet=outlet.fuse(Part.makeCylinder(OUTLET_THREAD_DIAMETER/2+1,4,base+axis*23,axis))
    outlet=outlet.cut(Part.makeCylinder(OUTLET_THREAD_DIAMETER/2,29,base,axis))
    add('OutletFitting','3/8-24 outlet - simplified thread envelope',outlet,STEEL,
        note='3/8-24 outlet stated. Angle, boss and fitting exterior estimated.')

    # Revolved dust boot, compressed by selected pushrod travel.
    start=REAR_TO_FLANGE_FACE;end=BOOT_END-STROKE_POSITION
    shoulder=start+(end-start)*0.36
    profile=[(start,BOOT_DIAMETER/2),(shoulder,BOOT_DIAMETER/2)]
    for i in range(1,BOOT_FOLDS*2+1):
        t=i/(BOOT_FOLDS*2)
        radius=BOOT_DIAMETER/2 if i%2==0 else BOOT_DIAMETER/2-7
        if i==BOOT_FOLDS*2:radius=BOOT_SMALL_RADIUS
        profile.append((shoulder+(end-shoulder)*t,radius))
    outer=[V(xx,rr,0) for xx,rr in profile]
    inner=[V(xx,rr-BOOT_WALL,0) for xx,rr in reversed(profile)]
    loop=outer+inner
    boot=Part.Face(Part.makePolygon(loop+[loop[0]])).revolve(V(),V(1,0,0),360)
    add('DustBoot','Dust boot - maximum diameter 35.6',boot,RUBBER,
        note='Diameter 35.6 stated; fold profile and flexible compression estimated.')
    rod_end=OVERALL_LENGTH-STROKE_POSITION
    rod=cx(PUSHROD_DIAMETER/2,rod_end-(REAR_TO_FLANGE_FACE-10),REAR_TO_FLANGE_FACE-10)
    add('Pushrod','5/16-24 pushrod (plain thread envelope)',rod,STEEL,moving,
        note='5/16-24 end thread and stroke 31.8 stated; unthreaded segment estimated.')
    nut_start=rod_end-15
    nut=hex_prism(12.7,5,V(nut_start,0,0),V(1,0,0)).cut(cx(PUSHROD_THREAD_DIAMETER/2,7,nut_start-1))
    add('PushrodLocknut','Pushrod locknut',nut,STEEL,moving)
    doc.recompute()
    return assembly

# Place the two reference components above the machine's left side in XZ.
# Their geometry is embedded as ordinary Python above; no external file is read.
_machine_bounds = App.BoundBox()
for _obj in list(doc.Objects):
    if _obj.isDerivedFrom('Part::Feature') and not _obj.Name.startswith('CycleReadout') and not _obj.Shape.isNull():
        _shape = _obj.Shape.copy()
        _parent = _obj.getGlobalPlacement().multiply(_obj.Placement.inverse())
        _shape.Placement = _parent.multiply(_shape.Placement)
        _machine_bounds.add(_shape.BoundBox)
wilwood_reference_parts = doc.addObject('App::Part','WilwoodReferenceParts')
wilwood_reference_parts.Label = 'Wilwood cylinders - upper left reference parts'
wilwood_slave = create_wilwood_260_1333(doc)
wilwood_master = create_wilwood_260_1304(doc)
wilwood_reference_parts.addObject(wilwood_slave)
wilwood_reference_parts.addObject(wilwood_master)
wilwood_slave.Placement = App.Placement(V(_machine_bounds.XMin+10,-515,_machine_bounds.ZMax+90),App.Rotation())
wilwood_master.Placement = App.Placement(V(_machine_bounds.XMin+10,-515,_machine_bounds.ZMax+220),App.Rotation())
doc.recompute()


# Apply the display choice after all assembly groups have been populated.
# Group additions may restore visibility during construction.
if not DISPLAY_DUCK_BILL_OPEN_20DEG:
    doc.Opened_20deg.ViewObject.Visibility = False
    for obj in doc.Objects:
        if obj.Name.startswith("Opened_20deg_"):
            obj.ViewObject.Visibility = False


# Frame the machine once, BEFORE adding the larger ground field. The animation
# never calls ViewFit or modifies the camera, so the machine remains central.
view = Gui.activeDocument().activeView()
view.setCameraType("Orthographic")
view.viewAxonometric()
view.fitAll()
try:
    camera_node = view.getCameraNode()
    camera_node.height.setValue(camera_node.height.getValue() * 1.20)
except (AttributeError, RuntimeError):
    pass
# Bake the enlarged dash pattern into geometry so the saved FCStd preserves it.
# FreeCAD's Dashed pattern is 0xF00F: eight lit pixels and eight gap pixels.
# Equal 10-pixel dashes and gaps at this initial camera framing.
if duck_bill_tip_motion_outline is not None:
    outline = duck_bill_tip_motion_outline
    outline.addProperty("Part::PropertyPartShape", "FullTrajectory", "Motion envelope")
    outline.FullTrajectory = outline.Shape.copy()
    outline.addProperty("App::PropertyFloat", "DashScaleFactor", "Motion envelope")
    outline.DashScaleFactor = 1.25
    outline.addProperty("App::PropertyFloat", "GapScaleFactor", "Motion envelope")
    outline.GapScaleFactor = outline.DashScaleFactor
    screen_to_world = view.getCameraNode().height.getValue() / max(1, view.getSize()[1])
    dash_length = 8.0 * outline.DashScaleFactor * screen_to_world
    gap_length = dash_length  # Persistent requirement: equal dash and gap lengths.
    camera_inverse = view.getCameraOrientation()
    camera_inverse.invert()
    # Fit a whole number of equal dash-gap pairs around the closed trajectory,
    # avoiding a shortened final dash or an oversized closing gap.
    projected_length = 0.0
    for edge in outline.FullTrajectory.Edges:
        delta = camera_inverse.multVec(edge.Vertexes[-1].Point - edge.Vertexes[0].Point)
        projected_length += math.hypot(delta.x, delta.y)
    pair_count = max(1, int(round(projected_length / (2.0 * dash_length))))
    dash_length = gap_length = projected_length / (2.0 * pair_count)
    pieces, current = [], []
    remaining, visible = dash_length, True
    for edge in outline.FullTrajectory.Edges:
        a, b = edge.Vertexes[0].Point, edge.Vertexes[-1].Point
        projected = camera_inverse.multVec(b - a)
        length = math.hypot(projected.x, projected.y)
        if length < 1e-12:
            continue
        offset = 0.0
        while offset < length - 1e-10:
            take = min(remaining, length - offset)
            first = a + (b-a) * (offset / length)
            last = a + (b-a) * ((offset+take) / length)
            if visible:
                if not current:
                    current.append(first)
                current.append(last)
            offset += take
            remaining -= take
            if remaining < 1e-9:
                if visible and len(current) > 1:
                    pieces.append(Part.makePolygon(current))
                current = []
                visible = not visible
                remaining = dash_length if visible else gap_length
    if len(current) > 1:
        pieces.append(Part.makePolygon(current))
    outline.Shape = Part.makeCompound(pieces)
    outline.ViewObject.DrawStyle = "Solid"  # Gaps are explicit geometry.
    outline.ViewObject.LineWidth = 3.0
    outline.Description += " Blue dashes and gaps are equal at 1.25x the original pattern; line width remains 3. Always keep dash and gap lengths equal."

moving_ground = MovingSoilGround(doc)
App.moving_soil_ground = moving_ground
if cycle_readout is not None:
    cycle_readout.update()
# Re-running fitAll after creating ground would frame the field, not the machine.
doc.recompute()




# Stop timers left behind by an earlier execution before making a new one.
# The public handle is deliberately App.sim_timer, so the console command
# ``App.sim_timer.stop()`` always addresses the timer driving this macro.
for timer_name in ("sim_timer", "lugged_wheel_chain_timer"):
    old_timer = getattr(App, timer_name, None)
    if old_timer is not None:
        old_timer.stop()

App.sim_timer = QtCore.QTimer()
App.sim_timer.timeout.connect(update_simulation)
if linkage_motion_available:
    App.sim_timer.start(100)

# Backward-compatible alias for the stop command printed by older versions.
App.lugged_wheel_chain_timer = App.sim_timer
App.Console.PrintMessage(
    ("Stationary machine with wheel-synchronized moving soil running. Stop with: " if linkage_motion_available else "Animation paused: fixed-pin linkage cannot complete a cycle. Timer handle: ") +
    "App.sim_timer.stop()\n"
)
