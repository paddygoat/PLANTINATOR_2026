    end_hole = Part.makeCylinder(10.0, 8.0, V(95.0, -4.0, 0), V(0, 1, 0))
    plate.Shape = blank.cut(centre_hole.fuse(end_hole)).removeSplitter()
    # Adjacent to the +Y sprocket face, with the shaft through the centre hole.
    plate.Placement = App.Placement(
        shaft_centre + V(0, SPROCKET_PLATE_THICKNESS / 2.0 + 3.0 + 20.0, 0), App.Rotation())
    for prop, value in (("LengthX", 220.0), ("ThicknessY", 6.0),
                        ("HeightZ", 50.0), ("HoleDiameter", 20.0),
                        ("EndHoleOffset", 15.0)):
