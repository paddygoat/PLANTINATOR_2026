"""
FreeCAD macro: 12-lug ground-drive wheel with synchronized 13T sprocket

Assembly rules implemented here
-------------------------------
* The ground-drive wheel is an App::Part located at (0, 0, -50) mm.
* The 13T sprocket is centred at (0, 0, 0) mm.
* Both rotate about the global Z axis with exactly the same angle on every
  animation update (1:1 shaft synchronisation).
* The 15T and 21T sprockets and the 114-link chain uses recalculated chain
  kinematics.  The wheel is driven directly from sprocket_16T_01, not by an
  inferred wheel/sprocket pitch ratio.
"""

# Display options: edit this value and rerun the macro.
DISPLAY_DISTANCE_READOUT = False  # True shows the cycle-distance readout.
DISPLAY_DUCK_BILL_OPEN_20DEG = False  # True shows the orange 20-degree overlay.

import math
import os
import FreeCAD as App
import FreeCADGui as Gui
import Part

try:
    from PySide import QtCore
except ImportError:
    try:
        from PySide2 import QtCore
    except ImportError:
        from PySide6 import QtCore


# =============================================================================
# Assembly and wheel dimensions (mm)
# =============================================================================
WHEEL_Z_OFFSET = -50.0
WHEEL_CENTRE_SPACING = 850.0  # centres of the rim + rear-disc envelopes
WHEEL_PHASE_OFFSET = 0.0  # Change only to index the wheel relative to the shaft.

FRONT_DISC_OD = 590.0
FRONT_DISC_THK = 6.0
RIM_OD = 550.0
RIM_WIDTH = 74.0
RIM_WALL_THK = 6.0
REAR_DISC_THK = 6.0
REAR_BOSS_OD = 40.0
REAR_BOSS_LENGTH = 7.0

LUG_COUNT = 12
LUG_LENGTH = 90.0              # radial blade length
LUG_WIDTH = 40.0               # axial blade depth
LUG_THK = 6.0                  # tangential plate thickness
LUG_WELD_OVERLAP = 50.0        # radial length within the front-disc radius
LUG_START_ANGLE = 0.0
LUG_SKEW_ANGLE = 0.0
LUG_OUTER_CHAMFER = 10.0
LUG_HOLE_DIA = 12.0            # visual estimate; change if measured
LUG_HOLE_END_OFFSET = 18.0
LUG_FLANGE_THK = 6.0

STEP_HEIGHT = 12.0             # rearward depth of each step; also 45-degree radial run
OUTER_STEP_RADIUS = 200.0    # outer start of first chamfer
INNER_STEP_RADIUS = 105.0    # outer start of second chamfer

BOSS_OD = 50.0
BOSS_LENGTH = 30.0
CENTRE_BORE_DIA = 30.0
BOSS_CROSS_HOLE_DIA = 12.0
SHAFT_OD = 30.0
# Stub retains the +Y boss end; trim the former shaft from its -Y end.
SHAFT_LENGTH = 180.0
BOLT_DIA = 12.0
BOLT_LENGTH = 70.0           # under-head length; visual M12 fastener
FASTENER_AF = 19.0          # simplified hex head and nut, across flats
BOLT_HEAD_HEIGHT = 7.5
NUT_HEIGHT = 10.0


# =============================================================================
# Sprocket and chain dimensions (mm)
# =============================================================================
T1 = 16
T2 = 15
T3 = 16  # Match the arm-one drive sprocket
PITCH = 12.700
ROLLER_DIAMETER = 7.77
SPROCKET_BORE_DIAMETER = 10.0
SPROCKET_PLATE_THICKNESS = 4.25
NUM_LINKS = 110
THIRD_SPROCKET_SPACING = 294.0  # Arm-three pivot lowered 46 mm

INNER_WIDTH = 5.72
PIN_DIAMETER = 3.28
LINK_PLATE_THICKNESS = 1.3

R1 = PITCH / (2.0 * math.sin(math.pi / T1))
R2 = PITCH / (2.0 * math.sin(math.pi / T2))
R3 = PITCH / (2.0 * math.sin(math.pi / T3))
ROOT1 = R1 - ROLLER_DIAMETER / 2.0
ROOT2 = R2 - ROLLER_DIAMETER / 2.0
ROOT3 = R3 - ROLLER_DIAMETER / 2.0

V = App.Vector


# =============================================================================
# Wheel geometry
# =============================================================================
def annulus(outer_diameter, inner_diameter, height, z0):
    outer = Part.makeCylinder(outer_diameter / 2.0, height, V(0, 0, z0))
    inner = Part.makeCylinder(
        inner_diameter / 2.0, height + 2.0, V(0, 0, z0 - 1.0)
    )
    return outer.cut(inner)


def make_front_disc():
    """Revolve a disc with two 12 mm rearward drops and 45-degree ramps.

    Each step radius marks the outer start of its ramp. Equal radial and
    axial runs give 45 degrees. The rear profile follows the front profile
    at FRONT_DISC_THK behind it, keeping material beneath all three levels.
    """
    outer = FRONT_DISC_OD / 2.0
    bore = CENTRE_BORE_DIA / 2.0
    depth = STEP_HEIGHT
    if not (depth > 0.0 and FRONT_DISC_THK > 0.0 and
            outer > OUTER_STEP_RADIUS > OUTER_STEP_RADIUS - depth >
            INNER_STEP_RADIUS > INNER_STEP_RADIUS - depth > bore):
        raise ValueError("Disc step radii, depth and bore must leave three flat lands.")
    front = [
        (outer, FRONT_DISC_THK),
        (OUTER_STEP_RADIUS, FRONT_DISC_THK),
        (OUTER_STEP_RADIUS - depth, FRONT_DISC_THK - depth),
        (INNER_STEP_RADIUS, FRONT_DISC_THK - depth),
        (INNER_STEP_RADIUS - depth, FRONT_DISC_THK - 2.0 * depth),
        (bore, FRONT_DISC_THK - 2.0 * depth),
    ]
    back = [(r, z - FRONT_DISC_THK) for r, z in reversed(front)]
    points = [V(r, 0, z) for r, z in front + back]
    points.append(points[0])
    return Part.Face(Part.makePolygon(points)).revolve(V(0, 0, 0), V(0, 0, 1), 360)


def plate_from_xz(points, y0, thickness):
    """Extrude an X-Z plate profile in the tangential (+Y) direction."""
    wire_points = [V(x, y0, z) for x, z in points]
    wire_points.append(wire_points[0])
    return Part.Face(Part.makePolygon(wire_points)).extrude(V(0, thickness, 0))


def add_wheel_feature(doc, parent, name, label, shape, colour):
    obj = doc.addObject("Part::Feature", name)
    obj.Label = label
    obj.Shape = shape
    obj.ViewObject.ShapeColor = colour
    obj.ViewObject.LineColor = (0.15, 0.15, 0.15)
    parent.addObject(obj)
    return obj


def make_drive_lug(angle_deg):
    """Build one of the 12 front-side bent, radial traction cleats.

    The standing blade is 90 mm radial x 40 mm axial and is normal to the
    front disc.  Its separate flat flange is welded to the front (+Z) face of
    the 590 mm disc.  The whole lug is then indexed around global Z.
    """
    disc_radius = FRONT_DISC_OD / 2.0
    radial_start = disc_radius - LUG_WELD_OVERLAP
    radial_end = radial_start + LUG_LENGTH
    axial_front = FRONT_DISC_THK + LUG_WIDTH

    blade_profile = [
        (radial_start, FRONT_DISC_THK),
        (radial_end - LUG_OUTER_CHAMFER, FRONT_DISC_THK),
        (radial_end, FRONT_DISC_THK + LUG_OUTER_CHAMFER),
        (radial_end, axial_front - LUG_OUTER_CHAMFER),
        (radial_end - LUG_OUTER_CHAMFER, axial_front),
        # Chamfer the inner-end corner on the edge away from the wheel disc.
        (radial_start + LUG_OUTER_CHAMFER, axial_front),
        (radial_start, axial_front - LUG_OUTER_CHAMFER),
    ]
    blade = plate_from_xz(blade_profile, -LUG_THK / 2.0, LUG_THK)

    if LUG_HOLE_DIA > 0.0:
        hole_x = radial_end - LUG_HOLE_END_OFFSET
        hole = Part.makeCylinder(
            LUG_HOLE_DIA / 2.0,
            LUG_THK + 2.0,
            V(hole_x, -LUG_THK / 2.0 - 1.0, FRONT_DISC_THK + LUG_WIDTH / 2.0),
            V(0, 1, 0),
        )
        blade = blade.cut(hole)

    flange = Part.makeBox(
        LUG_WELD_OVERLAP,
        LUG_WIDTH,
        LUG_FLANGE_THK,
        V(radial_start, -LUG_WIDTH / 2.0, FRONT_DISC_THK),
    )
    lug = blade.fuse(flange)
    lug.rotate(V(0, 0, 0), V(0, 0, 1), angle_deg + LUG_SKEW_ANGLE)
    return lug


def hex_prism_x(x0, centre_z, across_flats, length):
    """Simplified hex fastener along local X; no helical thread geometry."""
    radius = across_flats / math.sqrt(3.0)
    points = [V(x0, radius * math.cos(i * math.pi / 3.0),
                centre_z + radius * math.sin(i * math.pi / 3.0))
              for i in range(6)]
    points.append(points[0])
    return Part.Face(Part.makePolygon(points)).extrude(V(length, 0, 0))


def create_ground_drive_wheel(doc):
    """Create the wheel as one movable App::Part, locally centred on the origin."""
    wheel = doc.addObject("App::Part", "GroundDriveWheel")
    wheel.Label = "Twin 12-lug wheels — 850 mm centres, shared shaft"

    disc = make_front_disc()
    add_wheel_feature(
        doc, wheel, "WheelFrontDisc", "Front disc — two rearward 12 mm steps, 45 degree chamfers", disc,
        (0.35, 0.72, 0.56),
    )

    rim = annulus(RIM_OD, RIM_OD - 2.0 * RIM_WALL_THK, RIM_WIDTH, -RIM_WIDTH)
    add_wheel_feature(
        doc, wheel, "WheelRearRim", "Rear rim — 550 mm OD x 74 mm", rim,
        (0.30, 0.55, 0.43),
    )

    # Closing plate sits against the far end of the rim and extends rearward.
    rear_disc = annulus(RIM_OD, CENTRE_BORE_DIA, REAR_DISC_THK,
                        -RIM_WIDTH - REAR_DISC_THK)
    add_wheel_feature(
        doc, wheel, "WheelRearDisc", "Rear closing disc — 550 mm OD x 6 mm, 30 mm bore",
        rear_disc, (0.35, 0.72, 0.56),
    )

    # Rear boss projects outward (-Z) from the closing disc.
    rear_boss = annulus(REAR_BOSS_OD, CENTRE_BORE_DIA, REAR_BOSS_LENGTH,
                        -RIM_WIDTH - REAR_DISC_THK - REAR_BOSS_LENGTH)
    add_wheel_feature(
        doc, wheel, "WheelRearBoss", "Rear boss — OD 40, ID 30, length 7 mm",
        rear_boss, (0.42, 0.30, 0.18),
    )

    # Plain boss seated directly on the recessed centre of the disc.
    hub_z = FRONT_DISC_THK - 2.0 * STEP_HEIGHT
    cross_z = hub_z + BOSS_LENGTH / 2.0
    boss = annulus(BOSS_OD, CENTRE_BORE_DIA, BOSS_LENGTH, hub_z)
    cross_hole = Part.makeCylinder(
        BOSS_CROSS_HOLE_DIA / 2.0, BOSS_OD + 2.0,
        V(-BOSS_OD / 2.0 - 1.0, 0, cross_z), V(1, 0, 0),
    )
    boss = boss.cut(cross_hole)
    add_wheel_feature(
        doc, wheel, "WheelCentreBoss", "Plain boss — OD 50, ID 30, length 30 mm", boss,
        (0.42, 0.30, 0.18),
    )

    # Solid shaft: deliberately NOT cut by cross_hole or by the bolt.
    # End the shaft at the front (+Z) face of the boss.
    shaft = Part.makeCylinder(
        SHAFT_OD / 2.0, SHAFT_LENGTH, V(0, 0, hub_z + BOSS_LENGTH - SHAFT_LENGTH)
    )
    add_wheel_feature(
        doc, wheel, "WheelShaft", "shaft stubb 01", shaft,
        (0.65, 0.67, 0.70),
    )

    # M12 visual assembly: nominal shank/bore, simplified hex head and nut.
    # The bolt intentionally intersects the undrilled shaft at this design stage.
    bolt_start = -BOSS_OD / 2.0
    bolt_shank = Part.makeCylinder(
        BOLT_DIA / 2.0, BOLT_LENGTH, V(bolt_start, 0, cross_z), V(1, 0, 0)
    )
    bolt_head = hex_prism_x(bolt_start - BOLT_HEAD_HEIGHT, cross_z,
                            FASTENER_AF, BOLT_HEAD_HEIGHT)
    add_wheel_feature(
        doc, wheel, "WheelLockBolt", "M12 x 70 locking bolt — simplified threads", 
        bolt_shank.fuse(bolt_head), (0.72, 0.74, 0.77),
    )
    nut_x = BOSS_OD / 2.0
    nut = hex_prism_x(nut_x, cross_z, FASTENER_AF, NUT_HEIGHT)
    nut = nut.cut(Part.makeCylinder(BOLT_DIA / 2.0, NUT_HEIGHT + 2.0,
                                   V(nut_x - 1.0, 0, cross_z), V(1, 0, 0)))
    add_wheel_feature(
        doc, wheel, "WheelLockNut", "M12 locking nut — simplified threads", nut,
        (0.62, 0.64, 0.67),
    )

    lug_group = doc.addObject("App::DocumentObjectGroup", "WheelLugs")
    lug_group.Label = "12 front-side bent radial lugs — 30 degree pitch"
    wheel.addObject(lug_group)
    pitch_angle = 360.0 / LUG_COUNT
    for number in range(LUG_COUNT):
        angle = LUG_START_ANGLE + number * pitch_angle
        lug = doc.addObject("Part::Feature", "WheelLug_{:02d}".format(number + 1))
        lug.Label = "Wheel lug {:02d} — {:.1f} degrees".format(number + 1, angle)
        lug.Shape = make_drive_lug(angle)
        lug.ViewObject.ShapeColor = (0.60, 0.28, 0.16)
        lug.ViewObject.LineColor = (0.15, 0.10, 0.08)
        lug_group.addObject(lug)

    # Both rim + rear-disc envelopes are RIM_WIDTH + REAR_DISC_THK deep.
    # Flipping local Z moves the second envelope centre toward +Z, so its
    # origin needs the centre spacing PLUS one complete envelope depth.
    second_z = -WHEEL_CENTRE_SPACING - RIM_WIDTH - REAR_DISC_THK
    # Snapshot before cloning; FreeCAD and the headless viewer expose these
    # collections under different names. Copy only Part::Feature solids:
    # groups can expose an aggregate Shape but have no ShapeColor.
    originals = list(doc.Objects if hasattr(doc, "Objects") else doc.objects)
    for original in originals:
        if (original.TypeId != "Part::Feature" or
                not original.Name.startswith("Wheel") or
                original.Name == "WheelShaft" or not hasattr(original, "Shape")):
            continue
        copied_shape = original.Shape.copy()
        copied_shape.rotate(V(0, 0, 0), V(0, 1, 0), 180.0)
        copied_shape.translate(V(0, 0, second_z))
        add_wheel_feature(
            doc, wheel, "WheelSecond" + original.Name[5:],
            "Second wheel — " + original.Label, copied_shape,
            original.ViewObject.ShapeColor,
        )

    # Mirror the first stub using the same symmetry as the two wheel assemblies.
    second_stub = shaft.copy()
    second_stub.rotate(V(0, 0, 0), V(0, 1, 0), 180.0)
    second_stub.translate(V(0, 0, second_z))
    add_wheel_feature(doc, wheel, "WheelShaft02", "shaft stubb 02", second_stub,
                      (0.65, 0.67, 0.70))

    # This is the requested -50 mm Z movement.  Child geometry remains local,
    # so one rotation of this container drives every wheel component together.
    wheel.Placement = App.Placement(V(620.0, 0, WHEEL_Z_OFFSET), App.Rotation())
    # Apply the requested transparency to both wheels and their lugs.
    for obj in doc.Objects:
        if obj.isDerivedFrom("Part::Feature") and obj.Name.startswith("Wheel"):
            obj.ViewObject.Transparency = 100
    return wheel


# =============================================================================
# Three-sprocket chain geometry and path
# =============================================================================
def make_left_outer_tangent(start_center, end_center, start_radius, end_radius):
    dx = end_center.x - start_center.x
    dy = end_center.y - start_center.y
    centre_distance = math.hypot(dx, dy)
    radius_difference = end_radius - start_radius
    if centre_distance <= abs(radius_difference):
        raise ValueError("Sprocket centres are too close for an external chain tangent.")

    ux = dx / centre_distance
    uy = dy / centre_distance
    left_x = -uy
    left_y = ux
    normal_parallel = -radius_difference / centre_distance
    normal_perpendicular = math.sqrt(1.0 - normal_parallel * normal_parallel)
    nx = normal_parallel * ux + normal_perpendicular * left_x
    ny = normal_parallel * uy + normal_perpendicular * left_y

    return {
        "start_point": V(start_center.x + start_radius * nx, start_center.y + start_radius * ny, 0),
        "end_point": V(end_center.x + end_radius * nx, end_center.y + end_radius * ny, 0),
        "normal_angle": math.atan2(ny, nx),
        "length": math.sqrt(centre_distance * centre_distance - radius_difference * radius_difference),
    }


def build_chain_path(upper_right_x, third_sprocket_x=0.0, radius_correction=0.0):
    centres = [V(0, 0, 0), V(upper_right_x, -100.0, 0), V(third_sprocket_x, -THIRD_SPROCKET_SPACING, 0)]
    radii = [R1 + radius_correction, R2 + radius_correction, R3 + radius_correction]
    tangents = [
        make_left_outer_tangent(centres[i], centres[(i + 1) % 3], radii[i], radii[(i + 1) % 3])
        for i in range(3)
    ]
    segments = []
    arc_segments = [None, None, None]
    path_distance = 0.0
    two_pi = 2.0 * math.pi

    for i in range(3):
        incoming = tangents[(i - 1) % 3]
        outgoing = tangents[i]
        arc_start = incoming["normal_angle"]
        arc_end = outgoing["normal_angle"]
        clockwise_sweep = (arc_start - arc_end) % two_pi
        arc_length = radii[i] * clockwise_sweep
        arc = {
            "kind": "arc", "sprocket_index": i, "start": path_distance,
            "end": path_distance + arc_length, "centre": centres[i],
            "radius": radii[i], "start_angle": arc_start, "length": arc_length,
        }
        segments.append(arc)
        arc_segments[i] = arc
        path_distance += arc_length

        straight = {
            "kind": "straight", "start": path_distance,
            "end": path_distance + outgoing["length"],
            "start_point": outgoing["start_point"], "end_point": outgoing["end_point"],
            "length": outgoing["length"],
        }
        segments.append(straight)
        path_distance += outgoing["length"]

    return {"centres": centres, "segments": segments, "arc_segments": arc_segments, "length": path_distance}


def create_sprocket(doc, name, teeth, pitch_radius, root_radius, bore_diameter=SPROCKET_BORE_DIAMETER):
    outer_radius = pitch_radius + 2.3
    sprocket = Part.makeCylinder(outer_radius, SPROCKET_PLATE_THICKNESS)
    scale_y = 0.85

    p_root = V(root_radius, 0, 0)
    p_a = V(pitch_radius - 1.6, 2.77 * scale_y, 0)
    p_b = V(pitch_radius - 1.6, -2.77 * scale_y, 0)
    p_up = V(pitch_radius + 1.75, 4.5 * scale_y, 0)
    p_low = V(pitch_radius + 1.75, -4.5 * scale_y, 0)
    p_3 = V(pitch_radius + 5.1, 5.5 * scale_y, 0)
    p_4 = V(pitch_radius + 5.1, -5.5 * scale_y, 0)

    arc_root = Part.Arc(p_b, p_root, p_a).toShape()
    arc_up = Part.Arc(p_a, p_up, p_3).toShape()
    arc_low = Part.Arc(p_4, p_low, p_b).toShape()
    line_out = Part.LineSegment(p_3, p_4).toShape()
    wedge = Part.Face(Part.Wire([arc_root, arc_up, line_out, arc_low])).extrude(
        V(0, 0, SPROCKET_PLATE_THICKNESS + 2.0)
    )
    wedge.translate(V(0, 0, -1.0))

    for index in range(teeth):
        cutter = wedge.copy()
        cutter.rotate(V(0, 0, 0), V(0, 0, 1), index * 360.0 / teeth)
        sprocket = sprocket.cut(cutter)

    bore = Part.makeCylinder(bore_diameter / 2.0, SPROCKET_PLATE_THICKNESS + 2.0, V(0, 0, -1.0))
    obj = doc.addObject("Part::Feature", name)
    obj.Label = name.replace("_", " ")
    obj.Shape = sprocket.cut(bore)
    obj.ViewObject.ShapeColor = (0.20, 0.20, 0.20)
    return obj


def create_link_plate(thickness, z_offset):
    radius = 4.0
    cyl1 = Part.makeCylinder(radius, thickness, V(0, 0, z_offset))
    cyl2 = Part.makeCylinder(radius, thickness, V(PITCH, 0, z_offset))
    box = Part.makeBox(PITCH, radius * 2.0, thickness, V(0, -radius, z_offset))
    return cyl1.fuse(cyl2).fuse(box)


def get_path_pos(distance, segments, total_length):
    distance = distance % total_length
    for segment in segments:
        if distance < segment["end"]:
            local = distance - segment["start"]
            if segment["kind"] == "arc":
                angle = segment["start_angle"] - local / segment["radius"]
                centre = segment["centre"]
                return V(
                    centre.x + segment["radius"] * math.cos(angle),
                    centre.y + segment["radius"] * math.sin(angle), 0,
                )
            return segment["start_point"] + (
                segment["end_point"] - segment["start_point"]
            ) * (local / segment["length"])

    first = segments[0]
    return first["centre"] + V(
        first["radius"] * math.cos(first["start_angle"]),
        first["radius"] * math.sin(first["start_angle"]), 0,
    )


# The supplied FCStd is embedded to keep this macro self-contained. Its saved
# closed/open overlay, placements, groups and appearance are preserved exactly.
# This is a static duck-bill assembly; wheel/chain animation remains independent.
# Duck-bill construction recovered from the original version-25 modelling macro.
# All surfaces, solids, holes, hardware and overlay poses are constructed below.
# Persistent user preference: use readable Python geometry only; no encoded payloads.
# Preserve the saved duck-bill colours and visibility as readable RGB values.
DUCK_BILL_VIEW_STYLES = [
    ((0.2, 0.43137254901960786, 0.7215686274509804), (0.2, 0.43137254901960786, 0.7215686274509804), 70, True, ['Closed_0deg_Port_Plug_Front', 'Closed_0deg_ClevisSpacer1', 'Closed_0deg_ClevisSpacer2', 'Closed_0deg_ClevisActuatingPin', 'Closed_0deg_ClevisPinWasher', 'Closed_0deg_ClevisPinNut', 'Closed_0deg_RightLowerPivotBolt', 'Closed_0deg_RightLowerPivotNut', 'Closed_0deg_RightLowerJamNut', 'Closed_0deg_RightThreadedTieRod', 'Closed_0deg_DetailedCylinderBody', 'Closed_0deg_DetailedPistonRodAssembly', 'Closed_0deg_DetailedClevisBracket', 'Closed_0deg_Port_Plug_Rear', 'Closed_0deg_FoldedSheet', 'Closed_0deg_LeftLowerJamNut', 'Closed_0deg_LeftThreadedTieRod', 'Closed_0deg_RightUpperRodEnd', 'Closed_0deg_RightUpperBall', 'Closed_0deg_RightUpperSpacer', 'Closed_0deg_RightUpperWasher', 'Closed_0deg_FoldedSheet_Rotated', 'Closed_0deg_LeftLowerRodEnd', 'Closed_0deg_LeftLowerBall', 'Closed_0deg_LeftLowerSpacer', 'Closed_0deg_LeftLowerWasher', 'Closed_0deg_LeftLowerPivotBolt', 'Closed_0deg_LeftLowerPivotNut', 'Closed_0deg_ContinuousFlange_Rotated', 'Closed_0deg_LeftUpperRodEnd', 'Closed_0deg_LeftUpperBall', 'Closed_0deg_LeftUpperSpacer', 'Closed_0deg_LeftUpperWasher', 'Closed_0deg_LeftUpperPivotBolt', 'Closed_0deg_LeftUpperPivotNut', 'Closed_0deg_LeftUpperJamNut', 'Closed_0deg_RightUpperPivotBolt', 'Closed_0deg_RightUpperPivotNut', 'Closed_0deg_RightUpperJamNut', 'Closed_0deg_RightLowerRodEnd', 'Closed_0deg_RightLowerBall', 'Closed_0deg_RightLowerSpacer', 'Closed_0deg_RightLowerWasher', 'Closed_0deg_ContinuousFlange']),
    ((0.2, 0.6509803921568628, 0.45098039215686275), (0.12156862745098039, 0.4, 0.25098039215686274), 0, True, ['Closed_0deg_cylinder_base_pin', 'Closed_0deg_FixedSupportBracketLeftA', 'Closed_0deg_FixedBearingSleeveLeftA', 'Closed_0deg_FixedGreaseNippleLeftA', 'Closed_0deg_FixedSupportBracketLeftB', 'Closed_0deg_FixedBearingSleeveLeftB', 'Closed_0deg_FixedGreaseNippleLeftB', 'Closed_0deg_FixedSupportBracketRightA', 'Closed_0deg_FixedBearingSleeveRightA', 'Closed_0deg_FixedGreaseNippleRightA', 'Closed_0deg_FixedSupportBracketRightB', 'Closed_0deg_FixedBearingSleeveRightB', 'Closed_0deg_FixedGreaseNippleRightB', 'Closed_0deg_cone_rotation_pivot_1', 'Closed_0deg_cone_rotation_pivot_2']),
    ((1.0, 1.0, 1.0), (0.7490196078431373, 0.7490196078431373, 0.7490196078431373), 50, True, ['Closed_0deg_RoundHopper', 'Closed_0deg_HopperBaseBand']),
    ((0.2, 0.6509803921568628, 0.45098039215686275), (0.34901960784313724, 0.34901960784313724, 0.34901960784313724), 0, True, ['Closed_0deg_SteelOuterBand']),
    ((0.9411764705882353, 0.43137254901960786, 0.12156862745098039), (0.9411764705882353, 0.43137254901960786, 0.12156862745098039), 40, True, ['Opened_20deg_FoldedSheet', 'Opened_20deg_ContinuousFlange', 'Opened_20deg_FoldedSheet_Rotated', 'Opened_20deg_ContinuousFlange_Rotated', 'Opened_20deg_LeftUpperRodEnd', 'Opened_20deg_LeftUpperBall', 'Opened_20deg_LeftUpperSpacer', 'Opened_20deg_LeftUpperWasher', 'Opened_20deg_LeftUpperPivotBolt', 'Opened_20deg_LeftUpperPivotNut', 'Opened_20deg_LeftUpperJamNut', 'Opened_20deg_LeftLowerRodEnd', 'Opened_20deg_LeftLowerBall', 'Opened_20deg_LeftLowerSpacer', 'Opened_20deg_LeftLowerWasher', 'Opened_20deg_LeftLowerPivotBolt', 'Opened_20deg_LeftLowerPivotNut', 'Opened_20deg_LeftLowerJamNut', 'Opened_20deg_LeftThreadedTieRod', 'Opened_20deg_RightUpperRodEnd', 'Opened_20deg_RightUpperBall', 'Opened_20deg_RightUpperSpacer', 'Opened_20deg_RightUpperWasher', 'Opened_20deg_RightUpperPivotBolt', 'Opened_20deg_RightUpperPivotNut', 'Opened_20deg_RightUpperJamNut', 'Opened_20deg_RightLowerRodEnd', 'Opened_20deg_RightLowerBall', 'Opened_20deg_RightLowerSpacer', 'Opened_20deg_RightLowerWasher', 'Opened_20deg_RightLowerPivotBolt', 'Opened_20deg_RightLowerPivotNut', 'Opened_20deg_RightLowerJamNut', 'Opened_20deg_RightThreadedTieRod', 'Opened_20deg_DetailedCylinderBody', 'Opened_20deg_DetailedPistonRodAssembly', 'Opened_20deg_DetailedClevisBracket', 'Opened_20deg_Port_Plug_Rear', 'Opened_20deg_Port_Plug_Front', 'Opened_20deg_ClevisSpacer1', 'Opened_20deg_ClevisSpacer2', 'Opened_20deg_ClevisActuatingPin', 'Opened_20deg_ClevisPinWasher', 'Opened_20deg_ClevisPinNut']),
    ((0.792156862745098, 0.6588235294117647, 0.4392156862745098), (0.4, 0.30196078431372547, 0.1607843137254902), 40, True, ['Opened_20deg_Bracket1', 'Opened_20deg_Bracket2', 'Opened_20deg_WeldedPivotTube', 'Opened_20deg_HorizontalTubeBracket', 'Opened_20deg_Bracket1_Rotated', 'Opened_20deg_Bracket2_Rotated', 'Opened_20deg_WeldedPivotTube_Rotated', 'Opened_20deg_HorizontalTubeBracket_Rotated']),
    ((0.792156862745098, 0.6588235294117647, 0.4392156862745098), (0.4, 0.30196078431372547, 0.1607843137254902), 70, True, ['Closed_0deg_Bracket2', 'Closed_0deg_WeldedPivotTube', 'Closed_0deg_HorizontalTubeBracket', 'Closed_0deg_Bracket1_Rotated', 'Closed_0deg_Bracket2_Rotated', 'Closed_0deg_WeldedPivotTube_Rotated', 'Closed_0deg_HorizontalTubeBracket_Rotated', 'Closed_0deg_Bracket1']),
    ((0.2, 0.6509803921568628, 0.45098039215686275), (0.12156862745098039, 0.4, 0.25098039215686274), 0, False, ['Opened_20deg_cone_rotation_pivot_1', 'Opened_20deg_cone_rotation_pivot_2', 'Opened_20deg_cylinder_base_pin', 'Opened_20deg_FixedSupportBracketLeftA', 'Opened_20deg_FixedBearingSleeveLeftA', 'Opened_20deg_FixedGreaseNippleLeftA', 'Opened_20deg_FixedSupportBracketLeftB', 'Opened_20deg_FixedBearingSleeveLeftB', 'Opened_20deg_FixedGreaseNippleLeftB', 'Opened_20deg_FixedSupportBracketRightA', 'Opened_20deg_FixedBearingSleeveRightA', 'Opened_20deg_FixedGreaseNippleRightA', 'Opened_20deg_FixedSupportBracketRightB', 'Opened_20deg_FixedBearingSleeveRightB', 'Opened_20deg_FixedGreaseNippleRightB']),
    ((1.0, 1.0, 1.0), (0.7490196078431373, 0.7490196078431373, 0.7490196078431373), 50, False, ['Opened_20deg_RoundHopper', 'Opened_20deg_HopperBaseBand']),
    ((0.2, 0.6509803921568628, 0.45098039215686275), (0.34901960784313724, 0.34901960784313724, 0.34901960784313724), 0, False, ['Opened_20deg_SteelOuterBand']),
]

def create_duck_bill_geometry(destination):
    # Standalone comparison: complete closed and 20-degree mechanism in side view.
    # Both poses share identical fixed pivot locations. All dimensions in mm.
    import FreeCAD as App
    import os

    # Root profile trimmed for at least 1 mm band clearance through 25 degrees.
    # 0 = outer hole; 1, 2, 3 move inward in 15 mm steps.
    # Selecting another hole also relocates the rear mount to retain a vertical start.
    CLEVIS_HOLE_INDEX = 0

    def build_pose(requested_angle):
        # FreeCAD macro: four-panel demi-cone; dimensions in mm.
        # Standalone: uses only built-in FreeCAD/Part and Python modules.
        # Dimensions refer to the theoretical sheet mid-surface.
        import math
        import os
        import FreeCAD as App
        import Part
        
        SLANT_LENGTH = 180.0
        RIM_CHORD = 50.0                 # straight chord, NOT circular arc length
        THICKNESS = 2.0
        SLOT_WIDTH = 0.3                 # nominal material removed before bending
        TIP_KEEP = 30.0
        RIM_KEEP = 20.0                 # measured along each bend from its rim corner
        SLOTS_PER_BEND = 3
        PANELS = 4
        FLANGE_WIDTH = 25.0             # horizontal distance normal to each straight rim edge
        FLANGE_THICKNESS = 2.0
        BRACKET_WIDTH = 20.0
        BRACKET_LENGTH = 60.0          # extended 10 mm below the lowest hole
        BRACKET_THICKNESS = 3.0
        BRACKET_TOP_RADIUS = 5.0
        BRACKET_HOLE_DIAMETER = 6.0
        BRACKET_HOLE_FROM_TOP = 10.0
        BRACKET_HOLE_SPACING = 15.0     # centre-to-centre downwards
        BRACKET_HOLE_COUNT = 3
        BRACKET_BELOW_FLANGE = 3.0
        MOUNT_SLOT_LENGTH = 20.2        # along Y, perpendicular to open-back line
        MOUNT_SLOT_WIDTH = 3.2          # along X
        MOUNT_SLOT_X = 63.5             # mirrored centres at +/- X
        MOUNT_SLOT_Y = 45.0             # from open-back line Y=0; estimated from screenshot
        # Blank means save beside this macro (fallback: FreeCAD macro directory).
        OUTPUT_DIR = ""
        # Illustrative female rod ends, not a manufacturer's dimensioned part.
        ROD_END_EYE_OD = 16.0
        ROD_END_HOUSING_WIDTH = 6.0
        ROD_END_BALL_WIDTH = 8.0
        ROD_END_BALL_RADIUS = 5.0
        ROD_END_EYE_TO_MOUTH = 25.0
        ROD_END_SHANK_OD = 9.0
        ROD_THREAD_DIAMETER = 6.0
        ROD_THREAD_ENGAGEMENT = 10.0
        ROD_END_SPACER = 1.0
        PIVOT_OFFSET = 20.0         # each half outward: 40 mm additional separation
        PIVOT_BOSS_RADIUS = 12.0    # 9 mm material beyond the 6 mm hole
        PLAIN_BAR_LENGTH = 150.0
        PLAIN_BAR_DIAMETER = 6.0
        CYL_BASE_Y=-201.0  # corrected cylinder: retain 7 mm initial extension
        CYL_BASE_X=63.5
        CYL_BASE_HEIGHT_OFFSET=0.0   # rear pin level with clevis pin at zero degrees
        CYL_STROKE=25.0              # retained operating envelope from previous model
        CYL_REAR_PIN_DIAMETER=10.0   # catalogue rear bore is 10; clevis pin stays 6
        RIGHT_TIE_SPACER=1.0         # standard tie-rod mounting restored; clevis uses other top hole
        OPENING_ANGLE_DEG = requested_angle         # original (+Y) half; driven half solved from fixed links
        
        L = SLANT_LENGTH
        C = RIM_CHORD
        if PANELS != 4 or SLOTS_PER_BEND < 1:
            raise ValueError("This macro requires four panels and at least one slot.")
        if not (0 < C < 2*L and 0 < TIP_KEEP < L and 0 < RIM_KEEP < L-TIP_KEEP and THICKNESS > 0 and SLOT_WIDTH > 0):
            raise ValueError("Invalid dimensions.")
        alpha = 2 * math.asin(C / (2*L))
        radius = C / (2*math.sin(math.pi/(2*PANELS)))
        if radius >= L:
            raise ValueError("Rim too large for the sloping length.")
        height = math.sqrt(L*L - radius*radius)
        # Equal slot lengths and equal internal bridges; both end margins stay intact.
        pitch_piece = (L - TIP_KEEP - RIM_KEEP) / (2*SLOTS_PER_BEND - 1)
        intervals = [(TIP_KEEP + 2*i*pitch_piece,
                      TIP_KEEP + (2*i+1)*pitch_piece) for i in range(SLOTS_PER_BEND)]
        angles = [math.pi/2 + (i-PANELS/2)*alpha for i in range(PANELS+1)]
        V = App.Vector
        origin = V(0,0,0)
        rim = [V(L*math.cos(a), L*math.sin(a), 0) for a in angles]
        
        def face(points):
            return Part.Face(Part.makePolygon(points + [points[0]]))
        
        uncut = face([origin] + rim)
        cutters = []
        for a in angles[1:-1]:
            u, v = V(math.cos(a),math.sin(a),0), V(-math.sin(a),math.cos(a),0)
            for start, end in intervals:
                # All slots are enclosed; preserve the solid rim margin.
                end_tool = end
                cutters.append(face([u*start-v*(SLOT_WIDTH/2),
                                     u*end_tool-v*(SLOT_WIDTH/2),
                                     u*end_tool+v*(SLOT_WIDTH/2),
                                     u*start+v*(SLOT_WIDTH/2)]))
        
        def perforate(shape):
            for cutter in cutters:
                shape = shape.cut(cutter)
            return shape.removeSplitter()
        
        flat = perforate(uncut)
        if not flat.isValid() or len(flat.Faces) != 1:
            raise RuntimeError("Flat pattern is not a valid connected face.")
        
        def feature(doc, name, label, shape):
            obj = doc.addObject("Part::Feature", name)
            obj.Label = label
            obj.Shape = shape
            return obj
        
        def parameters(obj):
            for name, val in [("SlantLength",L), ("RimChord",C),
                              ("SheetThickness",THICKNESS), ("SlotWidth",SLOT_WIDTH),
                              ("TipKeep",TIP_KEEP), ("RimKeep",RIM_KEEP),
                              ("SlotAndBridgeLength",pitch_piece),
                              ("RimRadius",radius), ("AxialHeight",height)]:
                obj.addProperty("App::PropertyLength",name,"Design reference")
                setattr(obj,name,val)
                obj.setEditorMode(name,1)
            obj.addProperty("App::PropertyString","ModelNotes","Design reference")
            obj.ModelNotes = "Edit constants in macro and rerun; dimensions on mid-surface; ideal sharp bends, no bend allowance."
        
        # Exact isometric mapping of the four perforated triangular mid-surfaces.
        fold_rim = [V(radius*math.cos(i*math.pi/PANELS),
                      radius*math.sin(i*math.pi/PANELS),height) for i in range(PANELS+1)]
        panels = []
        mid_faces = []
        normals = []
        for i in range(PANELS):
            triangle = perforate(face([origin,rim[i],rim[i+1]]))
            a = angles[i]
            # Local 2D basis: radial u and in-plane perpendicular v.
            U = fold_rim[i]*(1/L)
            W = fold_rim[i+1]*(1/L)
            T = (W-U*math.cos(alpha))*(1/math.sin(alpha))
            N = U.cross(T)
            N.normalize()
            normals.append(N)
            ex = U*math.cos(a)-T*math.sin(a)
            ey = U*math.sin(a)+T*math.cos(a)
            matrix = App.Matrix()
            matrix.A11,matrix.A21,matrix.A31 = ex.x,ex.y,ex.z
            matrix.A12,matrix.A22,matrix.A32 = ey.x,ey.y,ey.z
            matrix.A13,matrix.A23,matrix.A33 = N.x,N.y,N.z
            triangle.transformShape(matrix,True)
            mid_faces.append(triangle.copy())
            # Add thickness NORMAL to the panel. This gives a square-cut 2 mm
            # rim instead of the former ~5.91 mm vertically extruded rim wall.
            # Start with an oversized planar patch; trim its sides in the shared
            # radial miter planes so adjacent panels meet without gaps/overlaps.
            margin = 10*THICKNESS
            m = (rim[i]+rim[i+1])*0.5
            along = m*(1/m.Length)
            across = rim[i+1]-rim[i]
            across.normalize()
            half_width = C/2 + margin
            patch = face([m-across*half_width, m+across*half_width,
                          -along*margin+across*half_width,
                          -along*margin-across*half_width])
            patch.transformShape(matrix,True)
            patch.translate(N*(-THICKNESS/2))
            solid = patch.extrude(N*THICKNESS)
            reach = 4*L
            lo, hi = i*math.pi/PANELS, (i+1)*math.pi/PANELS
            wedge = face([V(0,0,-reach),
                          V(reach*math.cos(lo),reach*math.sin(lo),-reach),
                          V(reach*math.cos(hi),reach*math.sin(hi),-reach)])
            solid = solid.common(wedge.extrude(V(0,0,2*reach)))
            # Keep the existing developed slot geometry across the miter planes.
            # Axial tool sweeps make adjoining half-slots meet.
            # All slots stop before the rim, leaving the specified solid margin.
            for slot_angle in angles[1:-1]:
                u = V(math.cos(slot_angle),math.sin(slot_angle),0)
                v = V(-math.sin(slot_angle),math.cos(slot_angle),0)
                for start,end in intervals:
                    end_tool = end
                    tool = face([u*start-v*(SLOT_WIDTH/2),
                                 u*end_tool-v*(SLOT_WIDTH/2),
                                 u*end_tool+v*(SLOT_WIDTH/2),
                                 u*start+v*(SLOT_WIDTH/2)])
                    tool.transformShape(matrix,True)
                    depth = 4*THICKNESS/abs(N.z)
                    tool.translate(V(0,0,-depth/2))
                    solid = solid.cut(tool.extrude(V(0,0,depth)))
            panels.append(solid.removeSplitter())
        
        folded = panels[0]
        for p in panels[1:]:
            folded = folded.fuse(p)
        folded = folded.removeSplitter()
        if not folded.isValid() or len(folded.Solids) != 1:
            raise RuntimeError("Folded model must be one valid connected solid.")
        # One continuous horizontal polygonal half-ring fitted to the OUTSIDE of the
        # actual square-cut cone rim, rather than to its theoretical mid-surface.
        # Nominal edge-to-edge contact for welding; no joint clearance/weld bead.
        if FLANGE_WIDTH <= 0 or FLANGE_THICKNESS <= 0:
            raise ValueError("Flange dimensions must be positive.")
        half_step = math.pi/(2*PANELS)
        apothem = radius*math.cos(half_step)
        normal_z = abs(normals[0].z)
        normal_horizontal = math.sqrt(1-normal_z*normal_z)
        inner_apothem = apothem + THICKNESS*normal_horizontal/2
        outer_apothem = inner_apothem + FLANGE_WIDTH
        inner_radius = inner_apothem/math.cos(half_step)
        outer_radius = outer_apothem/math.cos(half_step)
        flange_bottom_z = height - THICKNESS*normal_z/2
        inner_chord = 2*inner_apothem*math.tan(half_step)
        outer_chord = 2*outer_apothem*math.tan(half_step)
        
        # A single closed ten-vertex contour: outer chain then reversed inner
        # chain. The open back remains open; there are NO internal miter cuts.
        outer_points = [V(outer_radius*math.cos(i*math.pi/PANELS),
                          outer_radius*math.sin(i*math.pi/PANELS),0)
                        for i in range(PANELS+1)]
        inner_points = [V(inner_radius*math.cos(i*math.pi/PANELS),
                          inner_radius*math.sin(i*math.pi/PANELS),0)
                        for i in range(PANELS+1)]
        cut_points = outer_points + list(reversed(inner_points))
        flange_uncut = face(cut_points)
        flange_flat = flange_uncut.copy()
        mount_slot_polygons = []
        for slot_x in (-MOUNT_SLOT_X,MOUNT_SLOT_X):
            hx,hy = MOUNT_SLOT_WIDTH/2,MOUNT_SLOT_LENGTH/2
            if min(hx,hy) <= 0:
                raise ValueError("Mounting slot dimensions must be positive.")
            points = [V(slot_x-hx,MOUNT_SLOT_Y-hy,0),V(slot_x+hx,MOUNT_SLOT_Y-hy,0),
                      V(slot_x+hx,MOUNT_SLOT_Y+hy,0),V(slot_x-hx,MOUNT_SLOT_Y+hy,0)]
            cutter = face(points)
            if abs(cutter.common(flange_uncut).Area-cutter.Area)>1e-7:
                raise ValueError("Mounting slot is not fully inside the flange.")
            mount_slot_polygons.append(points)
            flange_flat = flange_flat.cut(cutter)
        flange_flat = flange_flat.removeSplitter()
        if not flange_flat.isValid() or len(flange_flat.Faces)!=1 or len(flange_flat.Wires)!=3:
            raise RuntimeError("Expected one connected flange face with two enclosed slots.")
        flange_solid = flange_flat.extrude(V(0,0,FLANGE_THICKNESS))
        flange_solid.translate(V(0,0,flange_bottom_z))
        if not flange_solid.isValid() or len(flange_solid.Solids) != 1:
            raise RuntimeError("Continuous flange must be one valid solid.")
        
        doc = App.newDocument("DemiConeSideView", hidden=True, temp=True)
        cone_obj = feature(doc,"FoldedSheet","Demi-cone - 2 mm steel, enclosed slots",folded)
        parameters(cone_obj)
        flange_obj = feature(doc,"ContinuousFlange","One-piece flange - two 20.2 x 3.2 mm mounting slots",flange_solid)
        for name,value in [("Width",FLANGE_WIDTH),("Thickness",FLANGE_THICKNESS),
                           ("MountSlotLength",MOUNT_SLOT_LENGTH),("MountSlotWidth",MOUNT_SLOT_WIDTH),
                           ("MountSlotCentreX",MOUNT_SLOT_X),("MountSlotCentreY",MOUNT_SLOT_Y),
                           ("InnerFacetLength",inner_chord),("OuterFacetLength",outer_chord)]:
            flange_obj.addProperty("App::PropertyLength",name,"Flange dimensions")
            setattr(flange_obj,name,value)
            flange_obj.setEditorMode(name,1)
        cut_obj = feature(doc,"FlangeCutLayout","Flange cutting outline with two enclosed mounting slots",flange_flat)
        cut_obj.Visibility = False
        # Bracket flat profile: X = width, Y = length, Z = thickness.
        # The two rounded corners are at the hole/top end only.
        w,h,t,r = BRACKET_WIDTH,BRACKET_LENGTH,BRACKET_THICKNESS,BRACKET_TOP_RADIUS
        if not (0 < 2*r <= w and r < h and 0 < t < MOUNT_SLOT_WIDTH and w < MOUNT_SLOT_LENGTH):
            raise ValueError("Invalid bracket dimensions or bracket does not fit mounting slots.")
        hole_y = h-BRACKET_HOLE_FROM_TOP
        hole_r = BRACKET_HOLE_DIAMETER/2
        hole_centres_y = [hole_y-i*BRACKET_HOLE_SPACING for i in range(BRACKET_HOLE_COUNT)]
        if BRACKET_HOLE_SPACING <= BRACKET_HOLE_DIAMETER:
            raise ValueError("Bracket holes must not overlap.")
        if any(min(y,h-y,w/2) <= hole_r for y in hole_centres_y):
            raise ValueError("Bracket hole must be enclosed inside the profile.")
        a,b,c,d,e,f = V(0,0,0),V(w,0,0),V(w,h-r,0),V(w-r,h,0),V(r,h,0),V(0,h-r,0)
        q = r/math.sqrt(2)
        outline = Part.Wire([Part.makeLine(a,b),Part.makeLine(b,c),
                            Part.Arc(c,V(w-r+q,h-r+q,0),d).toShape(),
                            Part.makeLine(d,e),
                            Part.Arc(e,V(r-q,h-r+q,0),f).toShape(),
                            Part.makeLine(f,a)])
        bracket_outline_face = Part.Face(outline)
        # Broad ear with rounded end supports the relocated middle pivot.
        boss_x=w/2+PIVOT_OFFSET
        boss_y=hole_centres_y[1]
        lo=boss_y-PIVOT_BOSS_RADIUS
        hi=boss_y+PIVOT_BOSS_RADIUS
        p1,p2,p3,p4=V(w,lo,0),V(boss_x,lo,0),V(boss_x,hi,0),V(w,hi,0)
        outline=Part.Wire([Part.makeLine(a,b),Part.makeLine(b,p1),
            Part.makeLine(p1,p2),Part.Arc(p2,V(boss_x+PIVOT_BOSS_RADIUS,boss_y,0),p3).toShape(),
            Part.makeLine(p3,p4),Part.makeLine(p4,c),
            Part.Arc(c,V(w-r+q,h-r+q,0),d).toShape(),Part.makeLine(d,e),
            Part.Arc(e,V(r-q,h-r+q,0),f).toShape(),Part.makeLine(f,a)])
        bracket_outline_face=Part.Face(outline)
        bracket_flat = bracket_outline_face.copy()
        for hole_index,centre_y in enumerate(hole_centres_y):
            centre_x=boss_x if hole_index==1 else w/2
            hole_face = Part.Face(Part.Wire([Part.makeCircle(hole_r,V(centre_x,centre_y,0))]))
            bracket_flat = bracket_flat.cut(hole_face)
        if not bracket_flat.isValid() or len(bracket_flat.Wires)!=1+BRACKET_HOLE_COUNT:
            raise RuntimeError("Bracket profile or hole is invalid.")
        bracket_blank = bracket_flat.extrude(V(0,0,t))
        bracket_objects = []
        bracket_solids = []
        for i,slot_x in enumerate((-MOUNT_SLOT_X,MOUNT_SLOT_X),1):
            # local X -> world Y, local Y -> world Z, local Z -> world X.
            matrix = App.Matrix()
            matrix.A11,matrix.A21,matrix.A31 = 0,1,0
            matrix.A12,matrix.A22,matrix.A32 = 0,0,1
            matrix.A13,matrix.A23,matrix.A33 = 1,0,0
            matrix.A14 = slot_x-t/2
            matrix.A24 = MOUNT_SLOT_Y-w/2
            matrix.A34 = flange_bottom_z-BRACKET_BELOW_FLANGE
            solid = bracket_blank.copy()
            solid.transformShape(matrix,True)
            if not solid.isValid() or len(solid.Solids)!=1:
                raise RuntimeError("Invalid installed bracket.")
            bracket = feature(doc,"Bracket%d"%i,"Upright bracket %d - 20 mm offset pivot, R12 support ear, 3 mm thick"%i,solid)
            for name,value in [("PivotOffset",PIVOT_OFFSET),("PivotBossRadius",PIVOT_BOSS_RADIUS),("Width",w),("Length",h),("Thickness",t),("TopRadius",r),
                               ("HoleDiameter",BRACKET_HOLE_DIAMETER),
                               ("HoleFromTop",BRACKET_HOLE_FROM_TOP),
                               ("HoleSpacing",BRACKET_HOLE_SPACING),
                               ("BelowFlange",BRACKET_BELOW_FLANGE)]:
                bracket.addProperty("App::PropertyLength",name,"Bracket dimensions")
                setattr(bracket,name,value)
                bracket.setEditorMode(name,1)
            bracket_objects.append(bracket)
            bracket_solids.append(solid)
        # Pair the complete demi-cone assemblies about their shared Z axis.
        # Their original open-back boundary is Y=0, so rotation alone mates them.
        # Keep both cones and flanges separate, including their shared butt seams.
        # Tube ends butt against the inner bracket faces; part belongs to the
        # moving welded half, not the fixed pivot group. Weld beads omitted.
        tube_length=2*MOUNT_SLOT_X-BRACKET_THICKNESS
        tube_start=V(-tube_length/2,MOUNT_SLOT_Y+PIVOT_OFFSET,
                     flange_bottom_z-BRACKET_BELOW_FLANGE+hole_centres_y[1])
        tube_shape=Part.makeCylinder(9,tube_length,tube_start,V(1,0,0)).cut(
            Part.makeCylinder(7,tube_length,tube_start,V(1,0,0)))
        pivot_tube=feature(doc,"WeldedPivotTube","Welded pivot tube - OD18 ID14 x 124 mm",tube_shape)
        for key,val in [("OutsideDiameter",18),("InsideDiameter",14),("Length",tube_length)]:
            pivot_tube.addProperty("App::PropertyLength",key,"Tube dimensions")
            setattr(pivot_tube,key,val)
            pivot_tube.setEditorMode(key,1)
        # Horizontal projecting arm, vertical YZ plate; duplicate on other half.
        # 84 x 24 x 6 envelope, R6 corners, hole 10 from far end and top.
        arm_x=0.0  # centred along the 124 mm tube axis
        arm_y=MOUNT_SLOT_Y+PIVOT_OFFSET-9.0  # total inward shift
        arm_z=tube_start.z
        arm=Part.makeBox(6,84,24,V(arm_x-3,arm_y,arm_z-12))
        corner_edges=[ed for ed in arm.Edges if abs(ed.Length-6)<1e-7]
        arm=arm.makeFillet(6,corner_edges)
        arm=arm.cut(Part.makeCylinder(9,8,V(arm_x-4,MOUNT_SLOT_Y+PIVOT_OFFSET,arm_z),V(1,0,0)))
        # Trim the inner root edge to clear the fixed band throughout opening.
        arm=arm.cut(Part.makeBox(20,100,100,V(-10,60.59-100,arm_z-50))).removeSplitter()
        # Four Ø10 holes, 15 mm pitch; nearest centre 20 mm from tube axis.
        # A fifth hole would intersect the Ø18 tube.
        for offset in (74,59,44,29):
            arm=arm.cut(Part.makeCylinder(5,8,V(arm_x-4,arm_y+offset,arm_z+2),V(1,0,0)))
        arm=arm.removeSplitter()
        horizontal_arm=feature(doc,"HorizontalTubeBracket","Horizontal tube bracket - 84 x 24 x 6, four holes dia 10 at 15 pitch",arm)
        original_objects = [cone_obj,flange_obj]+bracket_objects+[pivot_tube,horizontal_arm]
        original_group = doc.addObject("App::DocumentObjectGroup","OriginalHalf")
        original_group.Label = "Half A - original assembly"
        rotated_group = doc.addObject("App::DocumentObjectGroup","RotatedHalf")
        rotated_group.Label = "Half B - rotated 180 degrees about Z"
        rotated_objects = []
        for original in original_objects:
            original_group.addObject(original)
            rotated_shape = original.Shape.copy()
            rotated_shape.rotate(V(0,0,0),V(0,0,1),180)
            duplicate = feature(doc,original.Name+"_Rotated",original.Label+" - rotated half",rotated_shape)
            for prop in original.PropertiesList:
                if original.getTypeIdOfProperty(prop)=="App::PropertyLength":
                    duplicate.addProperty("App::PropertyLength",prop,"Design reference")
                    setattr(duplicate,prop,getattr(original,prop))
                    duplicate.setEditorMode(prop,1)
            rotated_group.addObject(duplicate)
            rotated_objects.append(duplicate)
        assembly_objects = original_objects+rotated_objects
        for component in assembly_objects:
            if not component.Shape.isValid() or len(component.Shape.Solids)!=1:
                raise RuntimeError("Every assembly component must be one valid solid.")
        # Two tie rods: same-X side connections from ORIGINAL upper holes
        # (Y positive) to ROTATED lower holes (Y negative). Eyes mount outboard.
        tie_objects = []
        tie_endpoints = []
        axis_z = V(0,0,1)
        def hardware(group,name,label,shape,color=(0.68,0.70,0.73)):
            shape = shape.removeSplitter()
            if not shape.isValid() or len(shape.Solids)!=1:
                raise RuntimeError("Invalid tie-rod component: "+name)
            obj = feature(doc,name,label,shape)
            group.addObject(obj)
            if App.GuiUp:
                obj.ViewObject.ShapeColor = color
            tie_objects.append(obj)
            return obj
        
        def ring(radius,bore,length,start,axis):
            return Part.makeCylinder(radius,length,start,axis).cut(
                   Part.makeCylinder(bore,length+2,start-axis,axis))
        
        def hex_nut(start,axis,thickness,across_flats=10.0):
            ref = V(0,0,1) if abs(axis.z)<0.9 else V(1,0,0)
            ex = axis.cross(ref);ex.normalize()
            ey = axis.cross(ex);ey.normalize()
            rr = across_flats/math.sqrt(3)
            points = [start+ex*(rr*math.cos(i*math.pi/3))+ey*(rr*math.sin(i*math.pi/3)) for i in range(6)]
            return face(points).extrude(axis*thickness).cut(
                Part.makeCylinder(ROD_THREAD_DIAMETER/2,thickness+2,start-axis,axis))
        
        bracket_bottom_z = flange_bottom_z-BRACKET_BELOW_FLANGE
        upper_z = bracket_bottom_z+hole_centres_y[0]
        lower_z = bracket_bottom_z+hole_centres_y[-1]
        # Fixed X-axis pivots moved outward 20 mm on each half.
        pivot_z = bracket_bottom_z+hole_centres_y[1]
        pivot_original = V(0,MOUNT_SLOT_Y+PIVOT_OFFSET,pivot_z)
        pivot_rotated = V(0,-MOUNT_SLOT_Y-PIVOT_OFFSET,pivot_z)
        input_angle = math.radians(OPENING_ANGLE_DEG)
        upper_arm = upper_z-pivot_z
        lower_arm = pivot_z-lower_z
        fixed_link_length = math.hypot(2*MOUNT_SLOT_Y,upper_z-lower_z)
        if min(upper_arm,lower_arm) <= 0:
            raise ValueError("Upper and lower link holes must straddle the fixed middle pivots.")
        # In the YZ plane, solve the circle-circle closure equation for the
        # follower. Choose the branch connected continuously to the closed pose.
        # A is the original upper hole relative to the follower's fixed pivot.
        distance_y = 2*(MOUNT_SLOT_Y+PIVOT_OFFSET)-PIVOT_OFFSET*math.cos(input_angle)-upper_arm*math.sin(input_angle)
        distance_z = -PIVOT_OFFSET*math.sin(input_angle)+upper_arm*math.cos(input_angle)
        # Follower lower-hole vector at zero: (offset, -lower_arm).
        cc = PIVOT_OFFSET*distance_y-lower_arm*distance_z
        ss = lower_arm*distance_y+PIVOT_OFFSET*distance_z
        rhs = (distance_y**2+distance_z**2+PIVOT_OFFSET**2+lower_arm**2-fixed_link_length**2)/2
        radius=math.hypot(cc,ss)
        if abs(rhs)>radius+1e-9:
            raise ValueError("Requested input angle cannot satisfy the fixed-link constraint.")
        phase=math.atan2(ss,cc)
        root=math.acos(max(-1,min(1,rhs/radius)))
        candidates=[(a+math.pi)%(2*math.pi)-math.pi for a in (phase+root,phase-root)]
        follower_angle=min(candidates,key=abs)
        follower_degrees = math.degrees(follower_angle)
        def rotate_point_x(point,pivot,degrees):
            return pivot+App.Rotation(V(1,0,0),degrees).multVec(point-pivot)
        for members,pivot,degrees in [(original_objects,pivot_original,OPENING_ANGLE_DEG),
                                      (rotated_objects,pivot_rotated,follower_degrees)]:
            for member in members:
                shape=member.Shape.copy()
                shape.rotate(pivot,V(1,0,0),degrees)
                member.Shape=shape
        original_group.Label = "Original half (+Y) - outward %.6f degrees"%OPENING_ANGLE_DEG
        rotated_group.Label = "Rotated half (-Y) - outward %.6f degrees"%abs(follower_degrees)
        for group,angle in [(original_group,OPENING_ANGLE_DEG),(rotated_group,follower_degrees)]:
            group.addProperty("App::PropertyAngle","AngleAboutPositiveX","Kinematics")
            group.AngleAboutPositiveX=angle
            group.setEditorMode("AngleAboutPositiveX",1)
        for side,side_name in [(-1,"Left"),(1,"Right")]:
            axis = V(side,0,0)
            group = doc.addObject("App::DocumentObjectGroup","TieRod"+side_name)
            group.Label = side_name+" tie rod - original upper to rotated lower"
            stand_off=RIGHT_TIE_SPACER if side>0 else ROD_END_SPACER
            eye_x = side*(MOUNT_SLOT_X+BRACKET_THICKNESS/2+stand_off+ROD_END_BALL_WIDTH/2)
            A = V(eye_x,MOUNT_SLOT_Y,upper_z)
            B = V(eye_x,-MOUNT_SLOT_Y,lower_z)
            A = rotate_point_x(A,pivot_original,OPENING_ANGLE_DEG)
            B = rotate_point_x(B,pivot_rotated,follower_degrees)
            if abs((B-A).Length-fixed_link_length)>1e-7:
                raise RuntimeError("Fixed tie-rod length constraint failed.")
            separation = (B-A).Length
            direction = (B-A)*(1/separation)
            tie_endpoints.append((A,B))
            if separation <= 2*ROD_END_EYE_TO_MOUTH+6:
                raise ValueError("Selected rod ends are too long for the hole spacing.")
            group.addProperty("App::PropertyLength","EyeCentreDistance","Dimensions")
            group.EyeCentreDistance = separation
            group.setEditorMode("EyeCentreDistance",1)
            group.addProperty("App::PropertyString","ModelNotes","Dimensions")
            group.ModelNotes = "Illustrative 6 mm bore female rod ends; assumed external sizes; smooth nominal M6 threads; no motion simulation."
            for end_name,centre,towards in [("Upper",A,direction),("Lower",B,-direction)]:
                key = side_name+end_name
                eye = Part.makeCylinder(ROD_END_EYE_OD/2,ROD_END_HOUSING_WIDTH,
                                       centre-axis*(ROD_END_HOUSING_WIDTH/2),axis)
                boss = Part.makeCylinder(ROD_END_SHANK_OD/2,ROD_END_EYE_TO_MOUTH-6,
                                        centre+towards*6,towards)
                housing = eye.fuse(boss).cut(Part.makeSphere(ROD_END_BALL_RADIUS+0.05,centre,axis))
                female_start = centre+towards*(ROD_END_EYE_TO_MOUTH-ROD_THREAD_ENGAGEMENT)
                housing = housing.cut(Part.makeCylinder(ROD_THREAD_DIAMETER/2,
                                      ROD_THREAD_ENGAGEMENT+1,female_start,towards))
                hardware(group,key+"RodEnd","Female rod end housing - "+key,housing)
                ball = Part.makeSphere(ROD_END_BALL_RADIUS,centre,axis).common(
                    Part.makeCylinder(ROD_END_BALL_RADIUS+1,ROD_END_BALL_WIDTH,
                                      centre-axis*(ROD_END_BALL_WIDTH/2),axis))
                ball = ball.cut(Part.makeCylinder(BRACKET_HOLE_DIAMETER/2,
                            ROD_END_BALL_WIDTH+2,centre-axis*(ROD_END_BALL_WIDTH/2+1),axis))
                hardware(group,key+"Ball","Spherical insert - 6 mm bore - "+key,ball,(0.82,0.84,0.87))
                # Spacer touches only the inner ball insert, clear of the housing.
                bracket_outer = V(side*(MOUNT_SLOT_X+BRACKET_THICKNESS/2),centre.y,centre.z)
                hardware(group,key+"Spacer","1 mm stand-off spacer - "+key,
                         ring(5,3.1,stand_off,bracket_outer,axis))
                washer_start = centre+axis*(ROD_END_BALL_WIDTH/2)
                hardware(group,key+"Washer","Outer washer - "+key,ring(5,3.1,1,washer_start,axis))
                bracket_inner = V(side*(MOUNT_SLOT_X-BRACKET_THICKNESS/2),centre.y,centre.z)
                grip = (washer_start+axis-bracket_inner).Length
                bolt_shaft = Part.makeCylinder(3,grip+3,bracket_inner,axis)
                # Unthreaded simplified hex-head pivot bolt. Exact 6 mm nominal bore.
                ref = V(0,0,1);ex=axis.cross(ref);ex.normalize();ey=axis.cross(ex)
                start=bracket_inner-axis*3
                pts=[start+ex*(5.773502692*math.cos(i*math.pi/3))+ey*(5.773502692*math.sin(i*math.pi/3)) for i in range(6)]
                bolt = bolt_shaft.fuse(face(pts).extrude(axis*3))
                hardware(group,key+"PivotBolt","Nominal M6 pivot bolt - "+key,bolt,(0.52,0.55,0.59))
                hardware(group,key+"PivotNut","Nominal M6 pivot nut - "+key,hex_nut(washer_start+axis,axis,3))
                hardware(group,key+"JamNut","Nominal M6 tie-rod jam nut - "+key,
                         hex_nut(centre+towards*ROD_END_EYE_TO_MOUTH,towards,3))
            stud_start = A+direction*(ROD_END_EYE_TO_MOUTH-ROD_THREAD_ENGAGEMENT)
            stud_length = separation-2*(ROD_END_EYE_TO_MOUTH-ROD_THREAD_ENGAGEMENT)
            stud = hardware(group,side_name+"ThreadedTieRod","M6 tie rod - nominal threads - "+side_name,
                            Part.makeCylinder(ROD_THREAD_DIAMETER/2,stud_length,stud_start,direction),(0.50,0.53,0.57))
            stud.addProperty("App::PropertyLength","NominalLength","Dimensions")
            stud.NominalLength = stud_length
            stud.setEditorMode("NominalLength",1)
        assembly_objects += tie_objects
        # Straight bars follow the existing middle-hole axes, parallel to X.
        # One bar crosses each demi-cone half; both are centred on X=0.
        if PLAIN_BAR_LENGTH <= 2*MOUNT_SLOT_X+BRACKET_THICKNESS:
            raise ValueError("Plain bars must extend beyond both outer bracket faces.")
        if not (0 < PLAIN_BAR_DIAMETER <= BRACKET_HOLE_DIAMETER):
            raise ValueError("Plain bars must fit the bracket hole diameter.")
        plain_bar_group = doc.addObject("App::DocumentObjectGroup","cone_rotation_pivots")
        plain_bar_group.Label = "cone_rotation_pivots"
        plain_bar_objects = []
        middle_hole_z = bracket_bottom_z+hole_centres_y[1]
        bar_projection = PLAIN_BAR_LENGTH/2-MOUNT_SLOT_X-BRACKET_THICKNESS/2
        for index,bar_y in enumerate((MOUNT_SLOT_Y+PIVOT_OFFSET,-MOUNT_SLOT_Y-PIVOT_OFFSET),1):
            bar_shape = Part.makeCylinder(PLAIN_BAR_DIAMETER/2,PLAIN_BAR_LENGTH,
                                          V(-PLAIN_BAR_LENGTH/2,bar_y,middle_hole_z),V(1,0,0))
            bar = feature(doc,"cone_rotation_pivot_%d"%index,"cone_rotation_pivot_%d - fixed 150 x diameter 6 mm"%index,bar_shape)
            for name,value in [("Length",PLAIN_BAR_LENGTH),("Diameter",PLAIN_BAR_DIAMETER),
                               ("EndProjection",bar_projection)]:
                bar.addProperty("App::PropertyLength",name,"Bar dimensions")
                setattr(bar,name,value)
                bar.setEditorMode(name,1)
            plain_bar_group.addObject(bar)
            plain_bar_objects.append(bar)
            if App.GuiUp:
                bar.ViewObject.ShapeColor = (0.75,0.77,0.80)
        assembly_objects += plain_bar_objects
        # Flowfit 71220/25 catalogue envelope, local axis Z.
        # Rear pin Z=9; body front=116; thread start=127; thread end=145.
        # E=118 excludes the M10 thread and custom clevis. Clevis pin=158.
        # Custom clevis updated to 10 mm pin. Taper/plug details illustrative.
        # Source: https://www.flowfitonline.com/products/mini-double-acting-hydraulic-cylinder-20mm-bore-x-12mm-rod-x-25mm-stroke
        # Fixed rear mount and swivelling cylinder solved for every pose.
        # LHS new bracket: fixed rear mount above pin; cylinder vertical at zero.
        # 22 mm initial extension permits retraction as the new arm rises.
        if CLEVIS_HOLE_INDEX not in (0,1,2,3):
            raise ValueError("CLEVIS_HOLE_INDEX must be 0, 1, 2 or 3.")
        closed_clevis=V(0,-(MOUNT_SLOT_Y+PIVOT_OFFSET-9+74-15*CLEVIS_HOLE_INDEX),pivot_z+2)
        cylinder_base=closed_clevis+V(0,0,149+22)
        clevis_centre=rotate_point_x(closed_clevis,pivot_rotated,follower_degrees)
        cyl_axis=clevis_centre-cylinder_base
        pin_distance=cyl_axis.Length;cyl_axis.normalize()
        extension=pin_distance-149.0
        if not (0<=extension<=CYL_STROKE):
            raise ValueError("Required extension exceeds the retained 25 mm operating envelope.")
        # Local X is the transverse pin direction, local Y faces upwards.
        xx=V(-1,0,0);yy=cyl_axis.cross(xx);yy.normalize()
        trans=App.Matrix()
        trans.A11,trans.A21,trans.A31=xx.x,xx.y,xx.z
        trans.A12,trans.A22,trans.A32=yy.x,yy.y,yy.z
        trans.A13,trans.A23,trans.A33=cyl_axis.x,cyl_axis.y,cyl_axis.z
        shift=cylinder_base-cyl_axis*9
        trans.A14,trans.A24,trans.A34=shift.x,shift.y,shift.z
        cyl_group=doc.addObject("App::DocumentObjectGroup","Detailed_Mini_Hydraulic_Cylinder_with_Clevis")
        cyl_group.Label="Detailed_Mini_Hydraulic_Cylinder_with_Clevis - %.3f mm extension"%extension
        def add_detail(name,label,shape,local=True):
            shape=shape.copy()
            if local:shape.transformShape(trans,True)
            if not shape.isValid():raise RuntimeError("Invalid detailed component: "+name)
            obj=feature(doc,name,label,shape)
            cyl_group.addObject(obj);assembly_objects.append(obj)
            return obj
        # G=28, F=35, H=47, I=60, C=9, D=10.
        barrel=Part.makeCylinder(14,56)
        collar=Part.makeCylinder(17.5,48,V(0,0,56))
        taper=Part.makeCone(17.5,8.5,12,V(0,0,104))
        body=barrel.fuse(collar).fuse(taper).cut(
            Part.makeCylinder(5,40,V(-20,0,9),V(1,0,0))).removeSplitter()
        def port(z,radius):
            return Part.makeCylinder(6,2,V(0,radius-1,z),V(0,1,0)).fuse(
                Part.makeCylinder(5,3,V(0,radius+1,z),V(0,1,0)))
        # J=15 from rear pin; K=23.5 back from body front. 1/8 BSP nominal.
        rear_plug=port(24,14);front_plug=port(92.5,17.5)
        # Relieve the concealed plug seating volumes, retaining the visible source shape.
        body=body.cut(rear_plug).cut(front_plug).removeSplitter()
        body_obj=add_detail("DetailedCylinderBody","Flowfit 71220/25 - corrected catalogue envelope",body)
        for name,val in [("Extension",extension),("PinToEye",pin_distance),("RearBore",10),
                         ("ClevisBore",10),("RetractedPinDistance",149)]:
            body_obj.addProperty("App::PropertyLength",name,"Reference dimensions")
            setattr(body_obj,name,val);body_obj.setEditorMode(name,1)
        body_obj.addProperty("App::PropertyString","SourceFile","Reference dimensions")
        body_obj.SourceFile="Flowfit 71220/25 dimensional drawing; custom clevis retained"
        # Extend the exposed rod only; body stays rigid and swivels on its base pin.
        rod=Part.makeCylinder(6,11+extension,V(0,0,116))
        thread=Part.makeCylinder(5,18,V(0,0,127+extension))
        points=[V(8*math.cos(i*math.pi/3),8*math.sin(i*math.pi/3),129+extension) for i in range(6)]
        nut=face(points).extrude(V(0,0,5)).cut(Part.makeCylinder(5,5,V(0,0,129+extension)))
        full_rod=rod.fuse(thread).fuse(nut).removeSplitter()
        add_detail("DetailedPistonRodAssembly","Piston rod - 12 mm, M10 x 18 mm, 25 mm stroke",full_rod)
        clevis_base=Part.makeCylinder(8,8)
        clevis_fork=Part.makeBox(16,16,16,V(-8,-8,8))
        clevis_top=Part.makeCylinder(8,16,V(-8,0,24),V(1,0,0))
        clevis=clevis_base.fuse(clevis_fork).fuse(clevis_top).cut(
            Part.makeBox(8,18,26,V(-4,-9,10))).cut(
            Part.makeCylinder(5,20,V(-10,0,24),V(1,0,0))).cut(
            Part.makeCylinder(5,12)).removeSplitter()
        clevis.translate(V(0,0,134+extension))
        add_detail("DetailedClevisBracket","Clevis_Bracket - 8 mm fork gap, 10 mm pin",clevis)
        add_detail("Port_Plug_Rear","Red rear port plug",rear_plug)
        add_detail("Port_Plug_Front","Red front port plug",front_plug)
        # Centre 6 mm arm in 8 mm fork with two 1 mm spacers.
        for k,x in enumerate((-4,3),1):
            add_detail("ClevisSpacer%d"%k,"Clevis spacer - 1 mm",
                ring(7,5.1,1,V(x,clevis_centre.y,clevis_centre.z),V(1,0,0)),False)
        add_detail("ClevisActuatingPin","10 mm pin through new horizontal bracket and clevis",
            Part.makeCylinder(8,3,V(-11,clevis_centre.y,clevis_centre.z),V(1,0,0)).fuse(
            Part.makeCylinder(5,20,V(-8,clevis_centre.y,clevis_centre.z),V(1,0,0))),False)
        add_detail("ClevisPinWasher","10 mm clevis pin washer",
            ring(8,5.1,1,V(8,clevis_centre.y,clevis_centre.z),V(1,0,0)),False)
        # M10 nut simplified with exact nominal bore.
        # Existing helper is M6; make this nut explicitly for the M10 pin.
        pts=[V(9,clevis_centre.y+9*math.cos(i*math.pi/3),clevis_centre.z+9*math.sin(i*math.pi/3)) for i in range(6)]
        nut_shape=face(pts).extrude(V(3,0,0)).cut(Part.makeCylinder(5,3,V(9,clevis_centre.y,clevis_centre.z),V(1,0,0)))
        add_detail("ClevisPinNut","M10 clevis pin nut",nut_shape,False)
        add_detail("cylinder_base_pin","Fixed rear swivel pin - 10 mm in catalogue 10 mm bore",
            Part.makeCylinder(CYL_REAR_PIN_DIAMETER/2,50,cylinder_base-V(25,0,0),V(1,0,0)),False)
        # Welded tubes rotate with their respective bracket assemblies.
        # Circular coaxial tubes retain the same visible outline as they rotate.
        for obj in assembly_objects:
            moving_tube=obj.Name.startswith("WeldedPivotTube")
            if moving_tube:
                obj.addProperty("App::PropertyString","Attachment","Assembly")
                obj.Attachment="Welded to both brackets of this cone half"
                obj.addProperty("App::PropertyAngle","RotationAboutPivot","Assembly")
                obj.RotationAboutPivot=follower_degrees if "Rotated" in obj.Name else OPENING_ANGLE_DEG
            if App.GuiUp:
                if moving_tube or obj.Name.startswith(("Bracket","HorizontalTubeBracket")):
                    obj.ViewObject.ShapeColor=(202/255.0,168/255.0,112/255.0)
                elif obj.Name.startswith("cone_rotation_pivot_"):
                    obj.ViewObject.ShapeColor=(0.20,0.65,0.45)
        # Fixed vertical hopper: outside radii; true 3 mm normal wall thickness.
        band_z=flange_bottom_z+FLANGE_THICKNESS+4.0  # entire hopper assembly raised 4 mm
        hopper_z=band_z+40.0
        hopper_height=110.0
        radial_wall=3.0*math.sqrt(1.0+(22.0/hopper_height)**2)
        outer=Part.makeCone(53,75,hopper_height,V(0,0,hopper_z))
        inner=Part.makeCone(53-radial_wall,75-radial_wall,hopper_height,V(0,0,hopper_z))
        # External strengthening rim: 5 mm downward from the existing top.
        # Tapered inner contact follows the hopper, leaving its opening unchanged.
        rim_z=hopper_z+hopper_height-5.0
        rim_inner_bottom=75.0-(75.0-53.0)*5.0/hopper_height
        rim=Part.makeCylinder(78,5,V(0,0,rim_z)).cut(
            Part.makeCone(rim_inner_bottom,75,5,V(0,0,rim_z)))
        hopper_shape=outer.cut(inner).fuse(rim).removeSplitter()
        if not hopper_shape.isValid() or len(hopper_shape.Solids)!=1:
            raise RuntimeError("Invalid strengthened hopper")
        hopper=feature(doc,"RoundHopper","Fixed hopper with R78 x 5 strengthening rim",hopper_shape)
        for key,value in [("RimOutsideRadius",78),("RimDepth",5),("Height",110),("BottomOuterRadius",53),("TopOuterRadius",75),("WallThickness",3),("LowerRimZ",hopper_z)]:
            hopper.addProperty("App::PropertyLength",key,"Hopper dimensions")
            setattr(hopper,key,value)
        hopper.addProperty("App::PropertyString","MountingReference","Hopper dimensions")
        hopper.MountingReference="Fixed; cone base 44 mm above flange top; both lower bands start 4 mm above flange top"
        if App.GuiUp:
            hopper.ViewObject.ShapeColor=(1.0,1.0,1.0)
            hopper.ViewObject.Transparency=50
        assembly_objects.append(hopper)
        for name,label,ri,ro,transparent in [
            ("HopperBaseBand","Hopper base band - H40, R50 to R53, wall 3",50.0,53.0,True),
            ("SteelOuterBand","Steel outer band - H40, R53 to R55, wall 2",53.0,55.0,False)]:
            band_height=40.0
            shape=Part.makeCylinder(ro,band_height,V(0,0,band_z)).cut(Part.makeCylinder(ri,band_height,V(0,0,band_z)))
            band=feature(doc,name,label,shape)
            for key,value in [("Height",band_height),("InsideRadius",ri),("OutsideRadius",ro),("WallThickness",ro-ri)]:
                band.addProperty("App::PropertyLength",key,"Band dimensions")
                setattr(band,key,value)
            if App.GuiUp:
                band.ViewObject.ShapeColor=(1.,1.,1.) if transparent else (0.20,0.65,0.45)
                band.ViewObject.Transparency=50 if transparent else 0
            assembly_objects.append(band)
        # Fixed bearing supports: pair at X=-40,+40 (80 mm centres).
        # Sleeves welded centrally in 3 mm plates: 11 mm projects each face.
        # Grease nipples are illustrative M6 straight fittings, radial +Z.
        fixed_supports=doc.addObject("App::DocumentObjectGroup","FixedSleeveSupports")
        for side in [-1, 1]:
            for x in (-40.0,40.0):
                y=side*(MOUNT_SLOT_Y+PIVOT_OFFSET)
                origin=V(x-1.5,y,pivot_z)
                boss=Part.makeCylinder(14,3,origin,V(1,0,0))
                root=Part.makeBox(3,abs(y),28,V(x-1.5,min(0,y),pivot_z-14))
                plate=boss.fuse(root)
                # Cope against band OD, preserving face contact for welding.
                plate=plate.cut(Part.makeCylinder(55,200,V(0,0,pivot_z-100)))
                plate=plate.cut(Part.makeCylinder(12,5,V(x-2.5,y,pivot_z),V(1,0,0))).removeSplitter()
                sleeve=Part.makeCylinder(12,25,V(x-12.5,y,pivot_z),V(1,0,0)).cut(
                    Part.makeCylinder(9.1,25,V(x-12.5,y,pivot_z),V(1,0,0)))
                gx=x+7.5  # offset along sleeve to clear the support plate
                # Nominal threaded M6 grease port into sleeve bore.
                sleeve=sleeve.cut(Part.makeCylinder(3,6,V(gx,y,pivot_z+8),V(0,0,1))).removeSplitter()
                nipple=Part.makeCylinder(3,4,V(gx,y,pivot_z+10))
                hexpts=[V(gx+4*math.cos(i*math.pi/3),y+4*math.sin(i*math.pi/3),pivot_z+14) for i in range(6)]
                nipple=nipple.fuse(face(hexpts).extrude(V(0,0,3)))
                nipple=nipple.fuse(Part.makeCone(3,2,3,V(gx,y,pivot_z+17)))
                nipple=nipple.fuse(Part.makeSphere(2.5,V(gx,y,pivot_z+21)))
                nipple=nipple.fuse(Part.makeCylinder(2,2,V(gx,y,pivot_z+19)))
                nipple=nipple.cut(Part.makeCylinder(.75,15,V(gx,y,pivot_z+9))).removeSplitter()
                suffix=("Left" if side<0 else "Right")+("A" if x<0 else "B")
                for prefix,label,shape in [
                    ("FixedSupportBracket","Fixed bracket 28 mm high x 3 mm thick, 80 mm pair spacing",plate),
                    ("FixedBearingSleeve","Fixed sleeve OD24 ID18.2 x25",sleeve),
                    ("FixedGreaseNipple","Illustrative straight M6 grease nipple",nipple)]:
                    if not shape.isValid() or len(shape.Solids)!=1:
                        raise RuntimeError("Invalid sleeve support: "+prefix+suffix)
                    obj=feature(doc,prefix+suffix,label+" - "+suffix,shape)
                    fixed_supports.addObject(obj)
                    assembly_objects.append(obj)
                    if App.GuiUp:obj.ViewObject.ShapeColor=(0.20,0.65,0.45)
        return doc, assembly_objects, follower_degrees

    overlay_doc = destination

    pose_groups = []
    pose_objects = []
    follower_angles = []
    for angle,group_name,color in [(0.0,"Closed_0deg",(0.20,0.43,0.72)),
                                    (20.0,"Opened_20deg",(0.94,0.43,0.12))]:
        source_doc,source_objects,follower = build_pose(angle)
        group = overlay_doc.addObject("App::DocumentObjectGroup",group_name)
        group.Label = ("CLOSED 0 deg - blue" if angle==0 else "OPEN 20 deg - orange (follower %.3f deg)"%abs(follower))
        group.addProperty("App::PropertyAngle","InputOpening","Comparison")
        group.InputOpening=angle
        group.addProperty("App::PropertyAngle","FollowerOpening","Comparison")
        group.FollowerOpening=abs(follower)
        group.setEditorMode("InputOpening",1)
        group.setEditorMode("FollowerOpening",1)
        copies=[]
        for source_obj in source_objects:
            obj = overlay_doc.addObject("Part::Feature",group_name+"_"+source_obj.Name)
            obj.Label = source_obj.Label+" [%g deg]"%angle
            obj.Shape = source_obj.Shape.copy()
            for prop in ["Extension","PinToEye","RearBore","ClevisBore","RetractedPinDistance","OutsideDiameter","InsideDiameter","Length"]:
                if prop in source_obj.PropertiesList:
                    obj.addProperty("App::PropertyLength",prop,"Reference dimensions")
                    setattr(obj,prop,getattr(source_obj,prop))
            if "Attachment" in source_obj.PropertiesList:
                obj.addProperty("App::PropertyString","Attachment","Assembly")
                obj.Attachment=source_obj.Attachment
                obj.addProperty("App::PropertyAngle","RotationAboutPivot","Assembly")
                obj.RotationAboutPivot=source_obj.RotationAboutPivot
            group.addObject(obj)
            copies.append(obj)
            is_pivot = source_obj.Name.startswith(("cone_rotation_pivot_","FixedSupportBracket","FixedBearingSleeve","FixedGreaseNipple")) or source_obj.Name in ("cylinder_base_pin","RoundHopper","HopperBaseBand","SteelOuterBand")
            # Both complete states retain the fixed bars; draw the coincident
            # opened copy hidden to avoid two surfaces fighting for the same pixels.
            obj.Visibility = not (is_pivot and angle!=0)
            if App.GuiUp:
                obj.ViewObject.ShapeColor = color
                obj.ViewObject.LineColor = color
                obj.ViewObject.Transparency = 70 if angle==0 else 40
                obj.ViewObject.DisplayMode = "Flat Lines"
                obj.ViewObject.LineWidth = 1.5
                if source_obj.Name.startswith(("WeldedPivotTube","Bracket","HorizontalTubeBracket")):
                    obj.ViewObject.ShapeColor=(202/255.0,168/255.0,112/255.0)
                    obj.ViewObject.LineColor=(0.40,0.30,0.16)
                if is_pivot:
                    obj.ViewObject.ShapeColor=(0.20,0.65,0.45)
                    obj.ViewObject.LineColor=(0.12,0.40,0.25)
                    obj.ViewObject.Transparency=0
                if source_obj.Name in ("RoundHopper","HopperBaseBand"):
                    obj.ViewObject.ShapeColor=(1.0,1.0,1.0)
                    obj.ViewObject.LineColor=(0.75,0.75,0.75)
                    obj.ViewObject.Transparency=50
                if source_obj.Name=="SteelOuterBand":
                    obj.ViewObject.ShapeColor=(0.20,0.65,0.45)
                    obj.ViewObject.LineColor=(.35,.35,.35)
                    obj.ViewObject.Transparency=0
        pose_groups.append(group)
        pose_objects.append(copies)
        follower_angles.append(follower)
        App.closeDocument(source_doc.Name)
    App.setActiveDocument(overlay_doc.Name)
    overlay_doc.recompute()



def add_duck_bill(doc):
    existing_names = {obj.Name for obj in doc.Objects}
    create_duck_bill_geometry(doc)
    for colour, line_colour, transparency, visible, names in DUCK_BILL_VIEW_STYLES:
        for name in names:
            obj = doc.getObject(name)
            obj.ViewObject.ShapeColor = colour
            obj.ViewObject.LineColor = line_colour
            obj.ViewObject.Transparency = transparency
            obj.ViewObject.Visibility = visible
    doc.recompute()
    imported = [obj for obj in doc.Objects if obj.Name not in existing_names]
    visibility = {obj.Name: obj.ViewObject.Visibility for obj in imported}
    child_names = {child.Name for obj in imported
                   for child in getattr(obj, "Group", [])}
    imported_roots = [obj for obj in imported if obj.Name not in child_names]
    if not imported_roots:
        raise RuntimeError("The Python duck-bill geometry could not be constructed.")
    assembly = doc.addObject("App::DocumentObjectGroup", "DuckBillAssembly")
    assembly.Label = "Duck bill (closed / 20 degree overlay)"
    assembly.addProperty("App::PropertyString", "SourceDocument", "Source")
    assembly.SourceDocument = "Plain Python geometry from 25_demi_cone_support_brackets_28mm_overlay_20deg.FCMacro"
    for obj in imported_roots:
        visible = obj.ViewObject.Visibility
        assembly.addObject(obj)
        obj.ViewObject.Visibility = visible
    for obj in imported:
        if "Group" in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    for obj in imported:
        if "Group" not in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    # Rotate in the Z-Y plane about the global X axis and model origin.
    # Cumulative duck-bill rotation: previous -90 degrees plus 180 degrees.
    duck_bill_transform = App.Placement(V(0, 0, 0), App.Rotation(V(1, 0, 0), 90.0))
    for obj in imported:
        if obj.isDerivedFrom("Part::Feature"):
            obj.Placement = duck_bill_transform.multiply(obj.Placement)
    doc.recompute()
    return assembly


