def carousel_support_feature(name,label,shape,cyan=True):
    obj=doc.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape
    obj.ViewObject.ShapeColor=(0.0,1.0,1.0) if cyan else (0.7,0.7,0.72)
    obj.ViewObject.Transparency=50 if cyan else 0
    carousel_support_group.addObject(obj);return obj
def carousel_hex(x,y,z,af,height):
    r=af/math.sqrt(3)
    pts=[V(x+r*math.cos(i*math.pi/3),y+r*math.sin(i*math.pi/3),z) for i in range(6)]
    return Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,height))
for _i in (1,2):
    _housing=doc.getObject('CarouselHorizontalBearing%02dHousing'%_i)
    _bb=_housing.Shape.cleaned().BoundBox;_cx=_bb.Center.x;_cy=_bb.Center.y;_z=_bb.ZMax
    _bar=Part.makeBox(80,16,16,V(_cx-40,_cy-8,_z))
    for _x in (_cx-31.5,_cx+31.5):_bar=_bar.cut(Part.makeCylinder(3.5,18,V(_x,_cy,_z-1)))
    carousel_support_feature('CarouselBearingCrossbar%02d'%_i,'cyan_Carousel_bearing_16x16_crossbar_%02d'%_i,_bar)
    _post_height=doc.CarouselBearingTopPlate6mm.Shape.BoundBox.ZMin-(_z+16)
    carousel_support_feature('CarouselBearingPost%02d'%_i,'cyan_Carousel_bearing_16x16_vertical_post_%02d'%_i,Part.makeBox(16,16,_post_height,V(_cx-8,_cy-8,_z+16)))
    for _j,_x in enumerate((_cx-31.5,_cx+31.5),1):
        _stem='CarouselBearingMount%02d_%02d'%(_i,_j)
        # M6 x 35, 10 mm AF head and nut; plain shank / simplified threads.
        _seat=_z-7-1.6
        _bolt=Part.makeCylinder(3,35,V(_x,_cy,_seat)).fuse(carousel_hex(_x,_cy,_seat-4,10,4))
        _o=carousel_support_feature(_stem+'Bolt','grey_Carousel_M6x35_bolt_%02d_%02d'%(_i,_j),_bolt,False)
        _o.addProperty('App::PropertyString','FastenerSpecification','Dimensions');_o.FastenerSpecification='M6 x 35 hex bolt; simplified threads'
        for _k,_wz in enumerate((_seat,_z+16),1):
            _wash=Part.makeCylinder(6,1.6,V(_x,_cy,_wz)).cut(Part.makeCylinder(3.2,1.6,V(_x,_cy,_wz)))
            carousel_support_feature(_stem+'Washer%d'%_k,'grey_Carousel_M6_washer_%02d_%02d_%d'%(_i,_j,_k),_wash,False)
        _nut=carousel_hex(_x,_cy,_z+17.6,10,5).cut(Part.makeCylinder(3,5,V(_x,_cy,_z+17.6)))
        carousel_support_feature(_stem+'Nut','grey_Carousel_M6_nut_%02d_%02d'%(_i,_j),_nut,False)
doc.recompute()

# Version 221: 20 x 20 x 3 SHS between carousel plate and fixed release disc.
def carousel_rounded_prism_221(width,radius,height):
    s=Part.makeBox(width-2*radius,width,height,V(-width/2+radius,-width/2,0)).fuse(Part.makeBox(width,width-2*radius,height,V(-width/2,-width/2+radius,0)))
    for x in (-width/2+radius,width/2-radius):
        for y in (-width/2+radius,width/2-radius):s=s.fuse(Part.makeCylinder(radius,height,V(x,y,0)))
    return s.removeSplitter()
