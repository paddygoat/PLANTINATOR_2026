# Version 209: upright ID16 bearing pairs on 134 mm green-tensioner shafts.
class GreenTensionerMounts209:
    def __init__(self,document):
        self.doc=document;self.items=[]
        self.group=document.addObject('App::DocumentObjectGroup','GreenTensionerShaftBearings')
        self.group.Label='blue_Green tensioner OD16 x 134 shafts and ID16 bearings'
        templates=[('Housing','UpperWheelPlummerHousing01',False),('OuterRace','UpperWheelPlummerOuterRace01',False),('Insert','UpperWheelPlummerInsert01',True),('GreaseNipple','UpperWheelPlummerGrease01',False),('GrubScrew1','UpperWheelPlummerGrub01_1',True),('GrubScrew2','UpperWheelPlummerGrub01_2',True)]
        for duplicate in (False,True):
            driver=document.getObject('upper_wheel_tensioner_12T_01'+('_copy' if duplicate else ''))
            stem=('Duplicate_' if duplicate else '')+'GreenTensioner'
            pose=driver.getGlobalPlacement();bounds=driver.Shape.BoundBox
            direction=-1 if duplicate else 1
            outside=bounds.YMax if duplicate else bounds.YMin
            inside=bounds.YMin if duplicate else bounds.YMax
            end=outside+direction*134
            shaft=document.addObject('Part::Feature',stem+'Shaft16')
            shaft.Label='blue_OD16x134_green_tensioner_shaft'+('_duplicate' if duplicate else '')
            shaft.Shape=Part.makeCylinder(8,134,V(0,0,0),V(0,1,0))
            shaft.ViewObject.ShapeColor=document.duck_bill_arm_one_shaft.ViewObject.ShapeColor;shaft.ViewObject.Transparency=50;self.group.addObject(shaft)
            for key,value in [('Diameter',16),('Length',134)]:
                shaft.addProperty('App::PropertyLength',key,'Dimensions');setattr(shaft,key,value)
            bearings=[]
            for index,cy in ((1,inside+direction*30),(2,end-direction*20)):
                unit=document.addObject('App::DocumentObjectGroup',stem+'Bearing%02d'%index)
                unit.Label='magenta_ID16_green_tensioner_bearing_%02d'%index+('_duplicate' if duplicate else '')
                self.group.addObject(unit)
                for key,value in [('BoreDiameter',16),('BaseWidth',76),('BaseDepth',40),('CentreHeight',30.2),('BoltCentres',52)]:
                    unit.addProperty('App::PropertyLength',key,'Catalogue');setattr(unit,key,value)
                unit.addProperty('App::PropertyVector','BearingCentre','Mounting');parts=[]
                for key,template,rotating in templates:
                    ref=document.getObject(template);obj=document.addObject('Part::Feature',stem+'Bearing%02d'%index+key)
                    obj.Label='magenta_ID16_green_tensioner_%02d_'%index+key+('_duplicate' if duplicate else '')
                    shape=ref.Shape.copy();shape.Placement=App.Placement();obj.Shape=shape
                    obj.ViewObject.ShapeColor=ref.ViewObject.ShapeColor;obj.ViewObject.Transparency=50;unit.addObject(obj);parts.append((obj,rotating))
                bearings.append((unit,parts,cy))
            self.items.append((driver,shaft,outside,end,bearings,pose.Rotation))
        self.update()
    def update(self):
        for driver,shaft,outside,end,bearings,rest in self.items:
            pose=driver.getGlobalPlacement();axis=pose.Base;spin=pose.Rotation.multiply(rest.inverted())
            shaft.Placement=App.Placement(V(axis.x,min(outside,end),axis.z),App.Rotation())
            for unit,parts,cy in bearings:
                centre=V(axis.x,cy,axis.z);unit.BearingCentre=centre
                for obj,rotating in parts:obj.Placement=App.Placement(centre,spin if rotating else App.Rotation())

