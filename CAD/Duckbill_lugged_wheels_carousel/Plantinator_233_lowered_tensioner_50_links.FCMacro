for _cy in _rows:
    for _dx in (-31.5,31.5):
        _solidplate=_solidplate.cut(carousel_slot_232(_old_axis.x+_dx-_setting,_old_axis.x+_dx,_cy,7,_z-7,8))
_solidplate.transformShape(_mount.toMatrix())
_solidplate=_solidplate.cut(Part.makeBox(200,300,400,V(389.8,_pb233.YMin-50,-50))).removeSplitter()
_solidplate.translate(V(0,0,-_drop));_plate.Shape=_solidplate;_plate.Placement=_solidplate.Placement
_plate.BearingUphillSetting=_setting;_plate.ChainSlotLength=0;_plate.ChainSlotWidth=0
_plate.ChainReliefNote='Central chain relief completely closed in version233; only four bearing-adjustment slots remain.'
_plate.addProperty('App::PropertyLength','DownwardTranslation233','Dimensions');_plate.DownwardTranslation233=_drop
_delta=V(-_q*(_setting-_previous_setting),0,_q*(_setting-_previous_setting)-_drop)
for _obj in doc.CarouselTensionerAdjustmentHardware.Group:
    _pose=_obj.Placement;_pose.Base=_pose.Base+_delta;_obj.Placement=_pose
# Rebuild and lengthen the mitred vertical box while retaining the fixed shaft passage.
_box=doc.CarouselTensionerVerticalSHS;_bb233=_box.Shape.cleaned().BoundBox
_new_intercept=_old_axis.x+_old_axis.z-22/_q-_drop
_bottom=_new_intercept-_bb233.XMax
_shs=frame225_shs(_bb233.ZMax-_bottom);_shs.translate(V(_bb233.Center.x,_bb233.Center.y,_bottom))
_x0=_bb233.XMin-100;_x1=_bb233.XMax+100
_pts=[V(_x0,_bb233.YMin-1,-1000),V(_x1,_bb233.YMin-1,-1000),V(_x1,_bb233.YMin-1,_new_intercept-_x1),V(_x0,_bb233.YMin-1,_new_intercept-_x0)]
_wedge=Part.Face(Part.makePolygon(_pts+[_pts[0]])).extrude(V(0,_bb233.YLength+2,0))
_shs=_shs.cut(_wedge)
_sb=doc.upper_wheel_shaft.Shape.cleaned().BoundBox
_shs=_shs.cut(Part.makeCylinder(10,52,V(_sb.Center.x,_bb233.YMin-1,_sb.Center.z),V(0,1,0))).removeSplitter()
_box.Shape=_shs;_box.Placement=_shs.Placement;_box.Length=_shs.cleaned().BoundBox.ZLength
for _obj in (doc.CarouselTensionerGussetX,doc.CarouselTensionerGussetY):
    _pose=_obj.Placement;_pose.Base=_pose.Base+V(0,0,-_drop);_obj.Placement=_pose
doc.recompute()

# Stop timers left behind by an earlier execution before making a new one.
# The public handle is deliberately App.sim_timer, so the console command
# ``App.sim_timer.stop()`` always addresses the timer driving this macro.
for timer_name in ("sim_timer", "lugged_wheel_chain_timer"):
    old_timer = getattr(App, timer_name, None)
    if old_timer is not None:
        old_timer.stop()

App.sim_timer = QtCore.QTimer()
App.sim_timer.timeout.connect(update_simulation)
if linkage_motion_available and not STOP_ANIMATION:
    App.sim_timer.start(100)
else:
    App.sim_timer.stop()

# Reapply visibility after all model construction and display updates.
moving_ground.update()

# Backward-compatible alias for the stop command printed by older versions.
App.lugged_wheel_chain_timer = App.sim_timer
App.Console.PrintMessage(
    ("Animation stopped by STOP_ANIMATION option. Timer handle: " if STOP_ANIMATION else ("Stationary machine animation running. Stop with: " if linkage_motion_available else "Animation paused: fixed-pin linkage cannot complete a cycle. Timer handle: ")) +
    "App.sim_timer.stop()\n"
)

# Paste into FreeCAD's Python console to rewind the entire mechanism, reset
# the seedling to its initial height and restart the existing 100 ms timer.
App.Console.PrintMessage(
    "Reset and restart with: App.sim_timer.stop(); App.reset_duck_bill_simulation(); App.sim_timer.start(100)\n"
)
