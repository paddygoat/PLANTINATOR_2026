def add_sprocket_rim_disc(doc, name="sprocket_16T_rim_disc", initial_angle=25.0):
    parent_disc = doc.sprocket_16T_shaft_disc
    # Angle in the XZ view: zero at +X, positive toward +Z.
    radius = 63.9291692265395  # Calculated for 20-degree input-jaw opening.
    a = math.radians(initial_angle)
    centre = parent_disc.Shape.Solids[0].CenterOfMass + V(radius*math.cos(a),0,radius*math.sin(a))
    disc = doc.addObject("Part::Feature",name)
    disc.Label = "16T rim disc - OD100 x6 at %g degrees" % initial_angle
    disc.Shape = Part.makeCylinder(50.0,6.0,V(0,-3,0),V(0,1,0))
    disc.Placement = App.Placement(centre,App.Rotation())
    for prop,value in (("OutsideDiameter",100.0),("Thickness",6.0),("CentreRadius",63.9291692265395)):
        disc.addProperty("App::PropertyLength",prop,"Dimensions");setattr(disc,prop,value)
    disc.addProperty("App::PropertyAngle","InitialAngle","Attachment");disc.InitialAngle=initial_angle
    disc.addProperty("App::PropertyLinkHidden","MotionDriver","Attachment");disc.MotionDriver=parent_disc
    disc.ViewObject.ShapeColor=parent_disc.ViewObject.ShapeColor
    return disc


sprocket_rim_disc = add_sprocket_rim_disc(doc)
sprocket_rim_disc_02 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_02", 15.0)
sprocket_rim_disc_03 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_03", 5.0)
sprocket_rim_disc_04 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_04", -5.0)
sprocket_rim_disc_05 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_05", -15.0)
sprocket_rim_disc_06 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_06", -25.0)
sprocket_rim_disc_07 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_07", -35.0)
sprocket_rim_disc_08 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_08", -45.0)
sprocket_rim_disc_09 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_09", -55.0)
sprocket_rim_disc_10 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_10", -65.0)
sprocket_rim_disc_11 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_11", -75.0)
sprocket_rim_disc_12 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_12", -85.0)
sprocket_rim_disc_13 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_13", -95.0)
sprocket_rim_disc_14 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_14", -105.0)
sprocket_rim_disc_15 = add_sprocket_rim_disc(doc, "sprocket_16T_rim_disc_15", -115.0)
