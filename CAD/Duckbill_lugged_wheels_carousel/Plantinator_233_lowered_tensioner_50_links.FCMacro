def apply_colour_tree_labels(document):
    blue=(0.20,0.43,0.72)
    for name in DUCK_BILL_BLUE_PARTS:
        obj=document.getObject(name)
        obj.ViewObject.ShapeColor=blue
        obj.ViewObject.DiffuseColor=[blue]
    changes=[]
    for name,colour in sorted(COLOUR_LABEL_PREFIXES.items(),key=lambda p:(p[1],p[0])):
        obj=document.getObject(name)
        if obj is None:
            raise RuntimeError('Missing colour-labelled component: '+name)
        if 'ColourLabelOriginal' not in obj.PropertiesList:
            obj.addProperty('App::PropertyString','ColourLabelOriginal','Appearance')
            obj.ColourLabelOriginal=obj.Label
        old=obj.ColourLabelOriginal
        obj.Label=colour+'_'+old
        changes.append((colour,name,old,obj.Label))
    return changes

colour_label_changes=apply_colour_tree_labels(doc)
doc.recompute()

# Version 161: a parallel, phase-locked copy of the complete duck-bill mechanism.
# Geometry remains the readable Python construction above. Native App::Links reuse
# those solids; no serialized geometry payload or additional motion solver is used.
class DuplicateDuckBillMechanism:
    def __init__(self,document):
        self.doc=document
        self.translation=App.Placement(V(0,275,0),App.Rotation())
        self.group=document.addObject('App::DocumentObjectGroup','DuplicateDuckBillMechanism')
        self.group.Label='Duplicate duck-bill mechanism (+275 mm Y)'
        self.group.addProperty('App::PropertyDistance','OffsetY','Duplicate');self.group.OffsetY=275.0
        self.group.addProperty('App::PropertyString','Motion','Duplicate')
        self.group.Motion='Same phase and motion as original; every global pose translated +275 mm Y.'
        self.group.addProperty('App::PropertyString','ClearanceStatus','Duplicate')
        self.group.ClearanceStatus='No interference or hose-clearance sweep performed for this duplicate.'
        categories=[
            ('YellowDrive','yellow_Duplicate drive - 64T, 10T and two 15T tensioners',
             ['AdditionalDriveSprockets','WheelShaftDriveChain']),
            ('OrangeDrive','orange_Duplicate drive and hydraulic cam',
             ['sprocket_16T_01','sprocket_15T_tensioner_01','sprocket_16T_03',
              'sprocket_16T_smooth_cam_disc']+[o.Name for o in document.Objects
              if o.Name.startswith('ChainLink_') or o.Name=='sprocket_16T_shaft_disc'
              or o.Name.startswith('sprocket_16T_rim_disc')]),
            ('Arms','blue_Duplicate arms, plates and pivot pins',list(DUCK_BILL_BLUE_PARTS)),
            ('Master','Duplicate Wilwood master cylinder',['WilwoodReferenceParts']),
            ('Slider','Duplicate bushed cam slider and mounting bracket',['MasterCamSlider']),
            ('DuckBill','Duplicate duck bill, slave cylinder and mounting hardware',['DuckBillAssembly']),
            ('Springs','Duplicate cone return springs, loops and supports',['DuckBillConeReturnSprings']),
            ('Hose','Duplicate hydraulic hose and adapters',['WilwoodFlexibleHose','MasterHoseAdapter','SlaveHoseAdapter']),
            ('Trajectory','blue_Duplicate closed-tip trajectory',['DuckBillTipMotionOutline']),
        ]
        self.pairs=[];seen=set()
        def leaves(obj,ancestors=()):
            if obj.isDerivedFrom('Part::Feature'):
                yield obj,ancestors
            elif 'Group' in obj.PropertiesList:
                for child in obj.Group:
                    yield from leaves(child,ancestors+(obj,))
        for key,label,roots in categories:
            subgroup=document.addObject('App::DocumentObjectGroup','DuplicateDuckBill'+key)
            subgroup.Label=label;self.group.addObject(subgroup)
            for name in roots:
                source=document.getObject(name)
                if source is None:raise RuntimeError('Missing duplicate source '+name)
                for original,ancestors in leaves(source):
                    if original.Name in seen:continue
                    seen.add(original.Name)
                    obj=document.addObject('App::Link','Duplicate_'+original.Name)
                    obj.setLink(original)
                    obj.LinkTransform=False
                    obj.Label=original.Label+'_duplicate'
                    subgroup.addObject(obj)
                    # This is a world-space copy, not a child of the original assembly.
                    obj.LinkPlacement=self.translation.multiply(original.getGlobalPlacement())
                    self.pairs.append((original,obj,ancestors))
        self.group.addProperty('App::PropertyInteger','ComponentCount','Duplicate')
        self.group.ComponentCount=len(self.pairs)
        self.yellow_names={o.Name for o in document.DuplicateDuckBillYellowDrive.Group}
        document.DuplicateDuckBillYellowDrive.addProperty("App::PropertyDistance","AdditionalOffsetY","Mounting")
        document.DuplicateDuckBillYellowDrive.AdditionalOffsetY=DUPLICATE_YELLOW_DRIVE_Y_SHIFT
        self.update()

    def update(self):
        for source,copy,ancestors in self.pairs:
            copy.LinkPlacement=self.translation.multiply(source.getGlobalPlacement())
            if copy.Name in self.yellow_names:
                pose=copy.LinkPlacement
                pose.Base=pose.Base+V(0,DUPLICATE_YELLOW_DRIVE_Y_SHIFT,0)
                copy.LinkPlacement=pose
            # Hidden original cams, 20-degree overlay and disabled springs stay hidden.
            copy.Visibility=(not HIDE_DUPLICATE_DUCK_BILL_MECH and source.Visibility
                             and all(parent.Visibility for parent in ancestors))
        self.group.Visibility=not HIDE_DUPLICATE_DUCK_BILL_MECH
        if duplicate_duck_bill_rotation is not None:
            duplicate_duck_bill_rotation.update()
        if duplicate_opposite_side_drive is not None:
            duplicate_opposite_side_drive.update()
        if duplicate_hydraulic_hose is not None:
            duplicate_hydraulic_hose.update()


duplicate_duck_bill_mech=DuplicateDuckBillMechanism(doc)
App.duplicate_duck_bill_mech=duplicate_duck_bill_mech

def set_duplicate_duck_bill_hidden(hidden=True):
    global HIDE_DUPLICATE_DUCK_BILL_MECH
    HIDE_DUPLICATE_DUCK_BILL_MECH=bool(hidden)
    duplicate_duck_bill_mech.update()

App.set_duplicate_duck_bill_hidden=set_duplicate_duck_bill_hidden
doc.recompute()

# Independent native hose shape: the other 459 duplicate components remain linked.
class DuplicateHydraulicHose(FlexibleHydraulicHose):
    def __init__(self,document,mechanism):
        self.doc=document
        old=document.getObject('Duplicate_WilwoodFlexibleHose')
        parent=next(g for g in mechanism.group.Group if old in g.Group)
        label=old.Label
        mechanism.pairs=[p for p in mechanism.pairs if p[1]!=old]
        document.removeObject(old.Name)
        self.hose=document.addObject('Part::Feature','Duplicate_WilwoodFlexibleHose')
        self.hose.Label=label;parent.addObject(self.hose)
        for name,value in [('OutsideDiameter',8.0),('InsideDiameter',4.0),('NominalLength',950.0),
                           ('CurrentLength',0.0),('MaximumOverallLength',1000.0),
                           ('LoopYOffset',DUPLICATE_HOSE_LOOP_Y_OFFSET)]:
            self.hose.addProperty('App::PropertyLength',name,'Hose');setattr(self.hose,name,value)
        self.hose.addProperty('App::PropertyString','Notes','Hose')
        self.hose.Notes='Independent duplicate route: loop midpoint offset +300 mm Y; moving ports fixed to duplicate mechanism. 950 mm hose plus two 20 mm adapters = 990 mm. No interference checks.'
        self.hose.ViewObject.ShapeColor=document.WilwoodFlexibleHose.ViewObject.ShapeColor
        self.hose.ViewObject.LineColor=document.WilwoodFlexibleHose.ViewObject.LineColor
        self.hose.ViewObject.Transparency=document.WilwoodFlexibleHose.ViewObject.Transparency
        self.fittings=[]  # Existing duplicate adapters already follow the original ports +275Y.
        self.target_length=950.0
        self.update()

    def ports(self):
        first,fa,last,la=flexible_hydraulic_hose.ports()
        offset=V(0,275,0)
        if duplicate_opposite_side_drive is not None:
            first=duplicate_opposite_side_drive.reflect_point(first+offset)-offset
            fa=duplicate_opposite_side_drive.reflect_vector(fa)
        if duplicate_duck_bill_rotation is not None:
            last,la=duplicate_duck_bill_rotation.slave_port()
            return first+offset,fa,last,la
        return first+offset,fa,last+offset,la

    def route(self,first,fa,last,la,height):
        start=first+fa*20;end=last+la*20
        tilt=App.Rotation(V(1,0,0),HYDRAULIC_HOSE_TILT_DEG)
        middle=(start+end)*0.5+tilt.multVec(V(0,-50,height))+V(0,DUPLICATE_HOSE_LOOP_Y_OFFSET,0)
        if duplicate_duck_bill_rotation is not None:
            old_first,old_fa,old_last,old_la=flexible_hydraulic_hose.ports()
            reference_y=((old_first+old_fa*20).y+(old_last+old_la*20).y)/2+275
            middle.y=reference_y+tilt.multVec(V(0,-50,height)).y+DUPLICATE_HOSE_LOOP_Y_OFFSET
        edges=[self.bezier([start,start+fa*100,middle-V(160,0,0),middle]),
               self.bezier([middle,middle+V(160,0,0),end+la*100,end])]
        return Part.Wire(edges)

    def update(self):
        super().update()
        self.hose.Visibility=not HIDE_DUPLICATE_DUCK_BILL_MECH and self.doc.WilwoodFlexibleHose.Visibility


duplicate_hydraulic_hose=DuplicateHydraulicHose(doc,duplicate_duck_bill_mech)
App.duplicate_hydraulic_hose=duplicate_hydraulic_hose
doc.recompute()

# Version 163: turn the complete duplicate duck-bill head and its springs.
# This is based on version 162; the cancelled opposite-bracket change is absent.
class DuplicateDuckBillRotation:
    def __init__(self,document,mechanism):
        self.doc,self.mechanism=document,mechanism
        self.arm=document.duck_bill_arm_two
        rest=mechanism.translation.multiply(self.arm.getGlobalPlacement())
        band=document.Closed_0deg_SteelOuterBand
        shape=band.Shape.copy();shape.Placement=App.Placement()
        # Global Z axis through the centre of the fixed circular band in this
        # initial pose. The resulting mounting rotation then follows arm two.
        centre_local=V(0,0,(shape.BoundBox.ZMin+shape.BoundBox.ZMax)/2)
        pivot=mechanism.translation.multVec(band.getGlobalPlacement().multVec(centre_local))
        mounting_turn=App.Rotation(V(0,0,1),180)
        # Preserve the Z reversal, then correct its reflected cone tilt about Y.
        # Use both CLOSED material tip points, independent of hydraulic opening.
        h=slave_hydraulic_motion;outline=document.DuckBillTipMotionOutline
        first=h.relative['Closed_0deg_FoldedSheet'].multVec(outline.TipLocalPoint)
        second=h.relative['Closed_0deg_FoldedSheet_Rotated'].multVec(outline.SecondTipLocalPoint)
        tip=rest.multVec(h.frame.multVec((first+second)*.5))
        original_axis=tip-pivot;turned_axis=mounting_turn.multVec(original_axis)
        self.alignment_angle=math.degrees(math.atan2(turned_axis.cross(original_axis).y,turned_axis.dot(original_axis)))
        correction=App.Rotation(V(0,1,0),self.alignment_angle)
        turn=correction.multiply(mounting_turn)
        world=App.Placement(pivot-turn.multVec(pivot),turn)
        self.local_turn=rest.inverse().multiply(world).multiply(rest)
        self.initial_pivot=pivot
        self.targets=list(document.DuplicateDuckBillDuckBill.Group)+list(document.DuplicateDuckBillSprings.Group)
        self.targets.append(document.Duplicate_SlaveHoseAdapter)
        self.state=document.addObject('App::FeaturePython','DuplicateDuckBillRotation')
        self.state.Label='Duplicate duck-bill head - 180 degrees Z with ZX alignment'
        self.state.addProperty('App::PropertyAngle','AlignmentTiltY','Mounting');self.state.AlignmentTiltY=self.alignment_angle
        self.state.addProperty('App::PropertyVector','InitialPivot','Mounting');self.state.InitialPivot=pivot
        self.state.addProperty('App::PropertyAngle','RotationAngle','Mounting');self.state.RotationAngle=180
        self.state.addProperty('App::PropertyLinkListGlobal','RotatedParts','Mounting');self.state.RotatedParts=self.targets
        self.state.addProperty('App::PropertyPlacement','ArmRelativeRotation','Mounting');self.state.ArmRelativeRotation=self.local_turn
        self.rebuild_closed_trajectory()
        self.update()

    def world_turn(self):
        arm=self.mechanism.translation.multiply(self.arm.getGlobalPlacement())
        return arm.multiply(self.local_turn).multiply(arm.inverse())

    def update(self):
        turn=self.world_turn()
        # The baseline duplicate updater has just copied every original pose.
        for copy in self.targets:
            source=copy.LinkedObject
            copy.LinkPlacement=turn.multiply(self.mechanism.translation).multiply(source.getGlobalPlacement())
        self.outline.Visibility=not HIDE_DUPLICATE_DUCK_BILL_MECH and self.doc.DuckBillTipMotionOutline.Visibility

    def slave_port(self):
        source=self.doc.Closed_0deg_InletBoss
        pose=self.doc.Duplicate_Closed_0deg_InletBoss.Placement
        local=V(-10,-130,source.RearMountPoint.z-12.0-170.75)
        return pose.multVec(local),pose.Rotation.multVec(V(-1,0,0))

    def rebuild_closed_trajectory(self):
        source=self.doc.DuckBillTipMotionOutline
        old=self.doc.Duplicate_DuckBillTipMotionOutline
        name,label=old.Name,old.Label;parent=self.doc.DuplicateDuckBillTrajectory
        self.mechanism.pairs=[p for p in self.mechanism.pairs if p[1]!=old]
        self.doc.removeObject(name)
        self.outline=self.doc.addObject('Part::Feature',name);self.outline.Label=label;parent.addObject(self.outline)
        h=slave_hydraulic_motion;motion=duck_bill_motion
        # Both material tip points are taken at CLOSED jaws, regardless of
        # hydraulic stroke at construction or during later animation.
        first=h.relative['Closed_0deg_FoldedSheet'].multVec(source.TipLocalPoint)
        second=h.relative['Closed_0deg_FoldedSheet_Rotated'].multVec(source.SecondTipLocalPoint)
        self.closed_tip_in_arm=self.local_turn.multVec(h.frame.multVec((first+second)*.5))
        saved_slot,saved_angle=motion.slot_x,motion.arm_angle;points=[]
        try:
            for step in range(721):
                angle=-step*.5;rotation=App.Rotation(V(0,1,0),angle)
                target=motion.driver_rest.Base+rotation.multVec(motion.d0-motion.driver_rest.Base)
                guide_rotation=App.Rotation(V(0,1,0),angle*T3/T1);centre=motion.guide_driver_rest.Base
                guide=App.Placement(centre-guide_rotation.multVec(centre),guide_rotation).multiply(motion.guide_rest)
                motion.solve_follower(target,guide)
                arm_rotation=App.Rotation(V(0,1,0),-math.degrees(motion.arm_angle))
                a=guide.multVec(V(motion.fixed_pin_x,6,0))
                arm=App.Placement(a-arm_rotation.multVec(motion.a0),arm_rotation).multiply(motion.rest['duck_bill_arm_two'])
                points.append(self.mechanism.translation.multVec(arm.multVec(self.closed_tip_in_arm)))
        finally:motion.slot_x,motion.arm_angle=saved_slot,saved_angle
        if (points[-1]-points[0]).Length>1e-6:raise RuntimeError('Rotated duplicate closed-tip path did not close.')
        points[-1]=points[0];self.outline.Shape=Part.makePolygon(points)
        for prop in ('DisplayMode','LineColor','DrawStyle','PointColor','LineWidth','Selectable'):
            setattr(self.outline.ViewObject,prop,getattr(source.ViewObject,prop))
        self.outline.addProperty('App::PropertyString','TrackingMode','Motion envelope')
        self.outline.TrackingMode='Rotated duplicate midpoint of both CLOSED tips only; opening excluded. Same blue dash/gap style and line width.'


duplicate_duck_bill_rotation=DuplicateDuckBillRotation(doc,duplicate_duck_bill_mech)
App.duplicate_duck_bill_rotation=duplicate_duck_bill_rotation
duplicate_duck_bill_mech.group.Motion='Parallel drive stays phase-locked; complete duplicate duck-bill head, slave and return-spring assembly retains 180 degrees Z mounting turn plus fixed Y tilt correction for coincident cone centreline and tip midpoint in ZX, rigidly carried by arm two.'
duplicate_duck_bill_mech.update()
doc.recompute()

# UCPA202-16 upright threaded-base plummer blocks. Catalogue dimensions mm.
# Housing contours, race internals and uncut screw threads are reference detail.
class UpperWheelPlummerBlocks:
    def __init__(self, document, shaft):
        self.shaft=shaft; self.moving=[]; self.fixed=[]
        self.group=document.addObject('App::DocumentObjectGroup','UpperWheelPlummerBlocks')
        self.group.Label='magenta_Upper wheel shaft plummer blocks'
        def feature(name,label,shape,position):
            obj=document.addObject('Part::Feature',name);obj.Label='magenta_'+label
            obj.Shape=shape;obj.Placement=position
            obj.ViewObject.ShapeColor=(1.0,0.0,1.0);obj.ViewObject.LineColor=(.35,0.0,.35)
            obj.ViewObject.Transparency=50;self.group.addObject(obj)
            return obj
        for index,distance in enumerate((58.0,shaft.Length.Value-58.0,233.0,468.0),1):
            centre=shaft.getGlobalPlacement().multVec(V(0,0,distance))
            # Mount rotated -90 degrees from the previous inverted pose, feet toward -X.
            fixed_pose=App.Placement(centre,App.Rotation(V(0,1,0),90))
            # Front profile in X/Z; fixed base at Z=-h, shaft axis global Y.
            base=Part.makeBox(76,40,11,V(-38,-20,-30.2))
            points=[V(-38,-12,-19.2),V(-25,-12,0),V(-20,-12,15),V(0,-12,25),V(20,-12,15),V(25,-12,0),V(38,-12,-19.2)]
            points.append(points[0])
            web=Part.Face(Part.makePolygon(points)).extrude(V(0,24,0))
            crown=Part.makeCylinder(25,24,V(0,-12,0),V(0,1,0))
            housing=base.fuse(web).fuse(crown)
            housing=housing.cut(Part.makeCylinder(20,42,V(0,-21,0),V(0,1,0)))
            # Two blind M10 reference bores (threads simplified), D=13 depth.
            for x in (-26,26):
                housing=housing.cut(Part.makeCylinder(5,13,V(x,0,-30.2),V(0,0,1)))
            housing=housing.removeSplitter()
            obj=feature('UpperWheelPlummerHousing%02d'%index,'Upper wheel plummer block %02d - UCPA202-16 housing'%index,housing,fixed_pose)
            for key,value in [('BoreDiameter',16),('CentreHeight',30.2),('BaseWidth',76),('BaseDepth',40),('BoltCentres',52),('MountHoleDepth',13),('DistanceFromNegativeYEnd',distance)]:
                obj.addProperty('App::PropertyLength',key,'Catalogue');setattr(obj,key,value)
            obj.addProperty('App::PropertyString','MountingThread','Catalogue');obj.MountingThread='2 x M10, blind depth 13 mm; threads simplified'
            obj.addProperty('App::PropertyVector','BearingCentre','Mounting');obj.BearingCentre=centre
            self.fixed.append(obj)
            # Sealed outer race stays stationary; inner collar rotates with shaft.
            outer=Part.makeCylinder(20,24,V(0,-12,0),V(0,1,0)).cut(Part.makeCylinder(13,24,V(0,-12,0),V(0,1,0)))
            self.fixed.append(feature('UpperWheelPlummerOuterRace%02d'%index,'Upper wheel plummer block %02d - sealed outer race'%index,outer,fixed_pose))
            inner=Part.makeCylinder(13,31,V(0,-12.7,0),V(0,1,0)).cut(Part.makeCylinder(8,31,V(0,-12.7,0),V(0,1,0)))
            collar=feature('UpperWheelPlummerInsert%02d'%index,'Upper wheel plummer block %02d - rotating insert ID16'%index,inner,fixed_pose)
            collar.addProperty('App::PropertyLength','InsertWidth','Catalogue');collar.InsertWidth=31
            collar.addProperty('App::PropertyLength','FaceToCentre','Catalogue');collar.FaceToCentre=12.7
            collar.addProperty('App::PropertyLinkHidden','MotionDriver','Motion');collar.MotionDriver=shaft
            self.moving.append((collar,shaft.getGlobalPlacement().inverse().multiply(fixed_pose)))
            # Two simplified flush grub screws in the extended inner collar.
            for j,angle in enumerate((0,120),1):
                direction=V(math.sin(math.radians(angle)),0,math.cos(math.radians(angle)))
                screw=Part.makeCylinder(2,3,V(0,15,0)+direction*10,direction)
                item=feature('UpperWheelPlummerGrub%02d_%d'%(index,j),'Upper wheel plummer block %02d - grub screw %d'%(index,j),screw,fixed_pose)
                self.moving.append((item,shaft.getGlobalPlacement().inverse().multiply(fixed_pose)))
            # Shortened grease fitting: 30% of the previous nominal 19 mm length.
            direction=V(1,0,1);direction.normalize()
            nipple=Part.makeCylinder(2.5,19.0*PLUMMER_GREASE_NIPPLE_LENGTH_FACTOR,V(0,0,0)+direction*24,direction)
            # Trim fitting to the specified top elevation, 62-30.2=31.8.
            nipple=nipple.common(Part.makeBox(100,100,100,V(-50,-50,-68.2)))
            self.fixed.append(feature('UpperWheelPlummerGrease%02d'%index,'Upper wheel plummer block %02d - grease nipple'%index,nipple,fixed_pose))
        self.update()
    def update(self):
        pose=self.shaft.getGlobalPlacement()
        for obj,relative in self.moving:obj.Placement=pose.multiply(relative)

upper_wheel_plummer_blocks=UpperWheelPlummerBlocks(doc,doc.upper_wheel_shaft)
doc.recompute()

# Fixed bridge plates rest on the upward-facing housing feet.
plummer_mount_plates=doc.addObject('App::DocumentObjectGroup','UpperWheelPlummerMountPlates')
plummer_mount_plates.Label='cyan_Upper wheel plummer mounting plates'
for first,second in ((1,3),(2,4)):
    h1=doc.getObject('UpperWheelPlummerHousing%02d'%first)
    h2=doc.getObject('UpperWheelPlummerHousing%02d'%second)
    c1,c2=h1.BearingCentre,h2.BearingCentre
    y0=min(c1.y,c2.y)-20.0
    length=abs(c2.y-c1.y)+40.0
    # Version 229: retain the existing plate extent while moving bearing 03 and its holes.
    if first==1:length+=55.0
    z=c1.z+30.2
    shape=Part.makeBox(76.0,length,6.0)
    # Four diameter11 clearance holes for the housings' M10 screws.
    for centre in (c1,c2):
        for x in (12.0,64.0):
            shape=shape.cut(Part.makeCylinder(5.5,6.0,V(x,centre.y-y0,0)))
    obj=doc.addObject('Part::Feature','UpperWheelPlummerPlate%02d_%02d'%(first,second))
    obj.Label='cyan_Upper wheel plummer plate %02d-%02d'%(first,second)
    obj.Shape=shape.removeSplitter()
    # Rotate -90 degrees about the fixed Y shaft axis; mating face stays flush.
    turn=App.Rotation(V(0,1,0),-90)
    pivot=V(c1.x,0,c1.z)
    world_turn=App.Placement(pivot-turn.multVec(pivot),turn)
    obj.Placement=world_turn.multiply(App.Placement(V(c1.x-38.0,y0,z),App.Rotation()))
    obj.ViewObject.ShapeColor=(0.0,1.0,1.0)
    obj.ViewObject.Transparency=50
    for key,value in [('Width',76.0),('Length',length),('Thickness',6.0),('HoleDiameter',11.0),('HolePitch',52.0)]:
        obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
    obj.addProperty('App::PropertyLinkListGlobal','MountedHousings','Mounting');obj.MountedHousings=[h1,h2]
    plummer_mount_plates.addObject(obj)
doc.recompute()

class ShaftStubPlummerBlocks:
    def __init__(self, document):
        self.moving=[]; self.fixed=[]
        self.group=document.addObject('App::DocumentObjectGroup','ShaftStubPlummerBlocks')
        self.group.Label='magenta_Shaft stubb UCPA206 plummer blocks'
        def feature(name,label,shape,position):
            obj=document.addObject('Part::Feature',name);obj.Label='magenta_'+label
            obj.Shape=shape;obj.Placement=position
            obj.ViewObject.ShapeColor=(1.0,0.0,1.0);obj.ViewObject.LineColor=(.35,0.0,.35)
            obj.ViewObject.Transparency=50;self.group.addObject(obj)
            return obj
        # One extra unit per shaft: corresponding inward faces 85 mm apart.
        for index,(shaft,side,outward_offset) in enumerate((
                (document.WheelShaft,1,0.0),(document.WheelShaft02,2,0.0),
                (document.WheelShaft,1,85.0),(document.WheelShaft02,2,85.0)),1):
            shape=shaft.Shape.copy();shape.Placement=shaft.getGlobalPlacement()
            box=shape.BoundBox
            # Original insert faces are flush with shaft ends; new units offset outward.
            inward=box.YMin if side==1 else box.YMax
            centre=V((box.XMin+box.XMax)/2,inward+((15.9+outward_offset) if side==1 else -(15.9+outward_offset)),(box.ZMin+box.ZMax)/2)
            fixed_pose=App.Placement(centre,App.Rotation(V(0,0,1),0 if side==1 else 180))
            # Front profile in X/Z; fixed base at Z=-h, shaft axis global Y.
            base=Part.makeBox(94,50,12,V(-47,-25,-42.9))
            points=[V(-47,-15,-30.9),V(-34,-15,0),V(-27,-15,20),V(0,-15,34),V(27,-15,20),V(34,-15,0),V(47,-15,-30.9)]
            points.append(points[0])
            web=Part.Face(Part.makePolygon(points)).extrude(V(0,30,0))
            crown=Part.makeCylinder(34,30,V(0,-15,0),V(0,1,0))
            housing=base.fuse(web).fuse(crown)
            housing=housing.cut(Part.makeCylinder(29,52,V(0,-26,0),V(0,1,0)))
            # Two blind M14 reference bores (threads simplified), D=18 depth.
            for x in (-33,33):
                housing=housing.cut(Part.makeCylinder(7,18,V(x,0,-42.9),V(0,0,1)))
            housing=housing.removeSplitter()
            obj=feature('ShaftStubPlummerHousing%02d'%index,'Shaft stubb plummer block %02d - UCPA206 housing'%index,housing,fixed_pose)
            for key,value in [('BoreDiameter',30),('CentreHeight',42.9),('BaseWidth',94),('BaseDepth',50),('BoltCentres',66),('MountHoleDepth',18),('InwardFaceOffset',15.9),('OutwardOffsetFromFirstBlock',outward_offset)]:
                obj.addProperty('App::PropertyLength',key,'Catalogue');setattr(obj,key,value)
            obj.addProperty('App::PropertyString','MountingThread','Catalogue');obj.MountingThread='2 x M14, blind depth 18 mm; threads simplified'
            obj.addProperty('App::PropertyVector','BearingCentre','Mounting');obj.BearingCentre=centre
            self.fixed.append(obj)
            # Sealed outer race stays stationary; inner collar rotates with shaft.
            outer=Part.makeCylinder(29,30,V(0,-15,0),V(0,1,0)).cut(Part.makeCylinder(21,30,V(0,-15,0),V(0,1,0)))
            self.fixed.append(feature('ShaftStubPlummerOuterRace%02d'%index,'Shaft stubb plummer block %02d - sealed outer race'%index,outer,fixed_pose))
            inner=Part.makeCylinder(21,38.1,V(0,-15.9,0),V(0,1,0)).cut(Part.makeCylinder(15,38.1,V(0,-15.9,0),V(0,1,0)))
            collar=feature('ShaftStubPlummerInsert%02d'%index,'Shaft stubb plummer block %02d - rotating insert ID30'%index,inner,fixed_pose)
            collar.addProperty('App::PropertyLength','InsertWidth','Catalogue');collar.InsertWidth=38.1
            collar.addProperty('App::PropertyLength','FaceToCentre','Catalogue');collar.FaceToCentre=15.9
            collar.addProperty('App::PropertyLinkHidden','MotionDriver','Motion');collar.MotionDriver=shaft
            self.moving.append((collar,shaft,shaft.getGlobalPlacement().inverse().multiply(fixed_pose)))
            # Two simplified flush grub screws in the extended inner collar.
            for j,angle in enumerate((0,120),1):
                direction=V(math.sin(math.radians(angle)),0,math.cos(math.radians(angle)))
                screw=Part.makeCylinder(2,3,V(0,19,0)+direction*18,direction)
                item=feature('ShaftStubPlummerGrub%02d_%d'%(index,j),'Shaft stubb plummer block %02d - grub screw %d'%(index,j),screw,fixed_pose)
                self.moving.append((item,shaft,shaft.getGlobalPlacement().inverse().multiply(fixed_pose)))
            # UCPA206 grease fitting, simplified; catalogue overall height 84 mm.
            direction=V(1,0,1);direction.normalize()
            nipple=Part.makeCylinder(2.5,23.0,V(0,0,0)+direction*33,direction)
            # Trim fitting to the specified top elevation, 84-42.9=41.1.
            nipple=nipple.common(Part.makeBox(100,100,100,V(-50,-50,-58.9)))
            self.fixed.append(feature('ShaftStubPlummerGrease%02d'%index,'Shaft stubb plummer block %02d - grease nipple'%index,nipple,fixed_pose))
        self.update()
    def update(self):
        for obj,shaft,relative in self.moving:obj.Placement=shaft.getGlobalPlacement().multiply(relative)

