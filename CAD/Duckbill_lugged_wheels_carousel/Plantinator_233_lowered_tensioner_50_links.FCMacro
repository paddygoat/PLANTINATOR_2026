carousel_bearing_supports_214 = None

def apply_simulation_state():
    """Keep fixed sprocket centres and solve a closed chain with exact pitch."""
    if cam_shaft_revision_189 is not None:
        cam_shaft_revision_189.restore()
    if arm_three_axial_188 is not None:
        arm_three_axial_188.restore()
    roller_points, route_correction = solve_chain_rollers(animation_offset)
    for index, link in enumerate(links):
        p1 = roller_points[index]
        p2 = roller_points[(index + 1) % NUM_LINKS]
        yaw = math.degrees(math.atan2(p2.y - p1.y, p2.x - p1.x))
        link.Placement = App.Placement(p1 + drivetrain_local_shift, App.Rotation(V(0, 0, 1), yaw))

    wheel_angle = -360.0 * animation_offset / (PITCH * T1) / 6.4
    ground_drive_wheel.Placement = App.Placement(
        V(620.0, 0, WHEEL_Z_OFFSET),
        App.Rotation(V(0, 0, 1), sprocket_phase_offsets[0] + WHEEL_PHASE_OFFSET + wheel_angle))
    sprocket_angles = [phase + wheel_angle * 6.4 * T1 / teeth
                       for phase, teeth in zip(sprocket_phase_offsets, (T1, T2, T3))]
    for sprocket, centre, angle in zip(sprockets, centres, sprocket_angles):
        sprocket.Placement = App.Placement(centre + drivetrain_local_shift, App.Rotation(V(0, 0, 1), angle))
    if additional_drive_sprockets is not None:
        additional_drive_sprockets.update()
    if wheel_drive_chain is not None:
        wheel_drive_chain.update()
    if upper_wheel_drive is not None:
        upper_wheel_drive.update()
    if centre_green_drive is not None:
        centre_green_drive.update()
    if upper_wheel_shaft is not None:
        upper_wheel_shaft.update()
    if shaft_stub_plummer_blocks is not None:
        shaft_stub_plummer_blocks.update()
    if upper_wheel_plummer_blocks is not None:
        upper_wheel_plummer_blocks.update()
    if carousel_chain_drive is not None:
        carousel_chain_drive.update()
    if carousel_horiz_shaft is not None:
        carousel_horiz_shaft.update()
    if carousel_drive is not None:
        carousel_drive.update()
    if duck_bill_motion is not None:
        duck_bill_motion.update()
    if arm_one_drive_shaft is not None:
        arm_one_drive_shaft.update()
    if master_cam_motion is not None:
        master_cam_motion.update()
    if duck_bill_mount is not None:
        duck_bill_mount.update()
    if slave_hydraulic_motion is not None:
        slave_hydraulic_motion.update()
    if cone_return_springs is not None:
        cone_return_springs.update()
    if flexible_hydraulic_hose is not None:
        flexible_hydraulic_hose.update()
    if moving_ground is not None:
        moving_ground.update()
    if cycle_readout is not None:
        cycle_readout.update()
    if seedling_drop is not None:
        seedling_drop.update()
    if seedling_flower is not None:
        seedling_flower.update()
    if duplicate_duck_bill_mech is not None:
        duplicate_duck_bill_mech.update()
    if arm_one_plummer_blocks is not None:
        arm_one_plummer_blocks.update()
    if arm_one_plummer_mounts is not None:
        arm_one_plummer_mounts.update()
    if arm_three_axial_188 is not None:
        arm_three_axial_188.apply()
    if cam_shaft_revision_189 is not None:
        cam_shaft_revision_189.apply()
    if cam_shaft_bearing_pairs_190 is not None:
        cam_shaft_bearing_pairs_190.update()
    if tensioner_shaft_bearings_196 is not None:
        tensioner_shaft_bearings_196.update()
    if tensioner_bearing_mounts_199 is not None:
        tensioner_bearing_mounts_199.update()
    if yellow_tensioner_bearings_201 is not None:
        yellow_tensioner_bearings_201.update()
    if yellow_tensioner_mounts_202 is not None:
        yellow_tensioner_mounts_202.update()
    if green_tensioner_mounts_209 is not None:
        green_tensioner_mounts_209.update()
    if carousel_bearing_supports_214 is not None:
        carousel_bearing_supports_214.update()
    if 'update_carousel_flange_222' in globals():update_carousel_flange_222()


def update_simulation():
    global animation_offset
    if App.getDocument(doc.Name) is None:
        App.sim_timer.stop()
        return
    animation_offset += 1.0
    try:
        apply_simulation_state()
        Gui.updateGui()
    except Exception as error:
        App.sim_timer.stop()
        App.Console.PrintError("Simulation stopped: {}\n".format(error))


def rotate_complete_assembly(doc):
    """Keep animation in local coordinates inside a rotated assembly container."""
    objects = list(doc.Objects)
    visibility = {obj.Name: obj.ViewObject.Visibility for obj in objects}
    child_names = {child.Name for obj in objects
                   for child in getattr(obj, "Group", [])}
    roots = [obj for obj in objects if not obj.InList]
    assembly = doc.addObject("App::Part", "CompleteAssembly")
    assembly.Label = "Complete assembly (YZ -90 deg)"
    for obj in roots:
        assembly.addObject(obj)
    assembly.Placement = App.Placement(App.Vector(0, 0, 0),
                                       App.Rotation(App.Vector(1, 0, 0), -90.0))
    for obj in objects:
        if "Group" in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    for obj in objects:
        if "Group" not in obj.PropertiesList:
            obj.ViewObject.Visibility = visibility[obj.Name]
    doc.recompute()
    return assembly


complete_assembly = rotate_complete_assembly(doc)

# Convert the global drive translation into the animated assembly coordinates.
drivetrain_local_shift = complete_assembly.getGlobalPlacement().Rotation.inverted().multVec(V(0, -700, 0))


# Translate the duck bill in world coordinates after the complete assembly rotation.
duck_bill_world_shift = App.Placement(V(-250, -300, -200), App.Rotation())
for obj in doc.Objects:
    if obj.Name.startswith(("Closed_0deg_", "Opened_20deg_")) and obj.isDerivedFrom("Part::Feature"):
        parent_placement = obj.getGlobalPlacement().multiply(obj.Placement.inverse())
        obj.Placement = (parent_placement.inverse().multiply(duck_bill_world_shift)
                         .multiply(parent_placement).multiply(obj.Placement))

doc.recompute()
apply_simulation_state()
doc.recompute()

# Fixed plate centered on the drive sprocket axis, +50 mm along global Y.
def add_duck_bill_arm_one(doc):
    sprocket_centre = doc.getObject("sprocket_16T_01").getGlobalPlacement().Base
    centre = sprocket_centre + V(0, 50, 0)
    arm = doc.addObject("Part::Feature", "duck_bill_arm_one")
    arm.Label = "duck_bill_arm_one"
    plate = Part.makeBox(300.0, 6.0, 50.0, V(-150.0, -3.0, -25.0))
    # Positive-X end is x=150: slot-end centres are x=135 and x=25.
    # Cut along Y through the entire 6 mm thickness; slot is centred at z=0.
    hole_near_end = Part.makeCylinder(10.0, 8.0, V(135.0, -4.0, 0), V(0, 1, 0))
    hole_far_end = Part.makeCylinder(10.0, 8.0, V(25.0, -4.0, 0), V(0, 1, 0))
    slot_bridge = Part.makeBox(110.0, 8.0, 20.0, V(25.0, -4.0, -10.0))
    slot_tool = hole_near_end.fuse(hole_far_end).fuse(slot_bridge)
    pivot_bore = Part.makeCylinder(ARM_ONE_SHAFT_DIAMETER / 2.0, 8.0, V(0, -4, 0), V(0, 1, 0))
    arm.Shape = plate.cut(slot_tool).cut(pivot_bore).removeSplitter()
    arm.addProperty("App::PropertyLength", "PivotBoreDiameter", "Dimensions")
    arm.PivotBoreDiameter = ARM_ONE_SHAFT_DIAMETER
    arm.addProperty("App::PropertyLength", "SlotDiameter", "Slot")
    arm.addProperty("App::PropertyLength", "NearHoleEndOffset", "Slot")
    arm.addProperty("App::PropertyLength", "FarHoleEndOffset", "Slot")
    arm.SlotDiameter = 20.0
    arm.NearHoleEndOffset = 15.0
    arm.FarHoleEndOffset = 125.0
    arm.Placement = App.Placement(centre, App.Rotation())
    arm.addProperty("App::PropertyLength", "LengthX", "Dimensions")
    arm.addProperty("App::PropertyLength", "ThicknessY", "Dimensions")
    arm.addProperty("App::PropertyLength", "HeightZ", "Dimensions")
    arm.addProperty("App::PropertyDistance", "SprocketOffsetY", "Dimensions")
    arm.LengthX, arm.ThicknessY, arm.HeightZ = 300.0, 6.0, 50.0
    arm.SprocketOffsetY = 50.0
    arm.ViewObject.ShapeColor = (0.65, 0.68, 0.72)
    return arm


