def frame225_rounded_prism(width,radius,length):
    result=Part.makeBox(width-2*radius,width,length,V(-width/2+radius,-width/2,0)).fuse(Part.makeBox(width,width-2*radius,length,V(-width/2,-width/2+radius,0)))
    for x in (-width/2+radius,width/2-radius):
        for y in (-width/2+radius,width/2-radius):result=result.fuse(Part.makeCylinder(radius,length,V(x,y,0)))
    return result.removeSplitter()
def frame225_shs(length):
