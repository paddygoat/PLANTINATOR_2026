# Version 210: green tensioner bearing plates and rail supports.
def add_green_bearing_plates_210(document):
    group=document.addObject('App::DocumentObjectGroup','GreenTensionerPlateSupports')
    group.Label='cyan_Green tensioner plates, studs and SHS supports'
    def wire(size,r,offset=0):
        def p(x,y):return V(x+offset,y+offset,0)
        def arc(x,y,a,b):
            def point(t):return p(x+r*math.cos(t),y+r*math.sin(t))
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([Part.makeLine(p(r,0),p(size-r,0)),arc(size-r,r,-math.pi/2,0),Part.makeLine(p(size,r),p(size,size-r)),arc(size-r,size-r,0,math.pi/2),Part.makeLine(p(size-r,size),p(r,size)),arc(r,size-r,math.pi/2,math.pi),Part.makeLine(p(0,size-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
    section=Part.Face(wire(50,12)).cut(Part.Face(wire(38,6,6)))
    for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        stem=prefix+'GreenTensioner';houses=[document.getObject(stem+'Bearing%02dHousing'%i) for i in (1,2)]
        boxes=[h.Shape.BoundBox for h in houses];rb=document.getObject(railname).Shape.BoundBox
        cx=boxes[0].Center.x;top=boxes[0].ZMin;bottom=top-6
        y0=min(min(b.YMin for b in boxes),rb.YMin);y1=max(max(b.YMax for b in boxes),rb.YMax)
        centres=[(cx+dx,b.Center.y) for b in boxes for dx in (-26,26)]
        def add(name,label,shape,colour,trans=0):
            obj=document.addObject('Part::Feature',stem+name);obj.Label=label+('_duplicate' if prefix else '')
            obj.Shape=shape;obj.ViewObject.ShapeColor=colour;obj.ViewObject.Transparency=trans;group.addObject(obj);return obj
        shape=Part.makeBox(76,y1-y0,6,V(cx-38,y0,bottom))
        for x,y in centres:shape=shape.cut(Part.makeCylinder(5.5,8,V(x,y,bottom-1)))
        plate=add('PairPlate','cyan_ID16_green_tensioner_pair_plate_6mm',shape.removeSplitter(),(0.0,1.0,1.0),50)
        for key,value in [('Width',76),('Length',y1-y0),('Thickness',6),('HoleDiameter',11)]:
            plate.addProperty('App::PropertyLength',key,'Dimensions');setattr(plate,key,value)
        for i,(x,y) in enumerate(centres,1):
            stud=add('MountStud%02d'%i,'grey_M10x30_green_tensioner_stud_%02d'%i,Part.makeCylinder(5,30,V(x,y,top-18)),(.65,.67,.7))
            for key,value in [('Diameter',10),('Length',30),('Engagement',12)]:
                stud.addProperty('App::PropertyLength',key,'Dimensions');setattr(stud,key,value)
            stud.addProperty('App::PropertyString','Thread','Dimensions');stud.Thread='M10; simplified threads'
            washer=Part.makeCylinder(10,2,V(x,y,bottom-2)).cut(Part.makeCylinder(5.5,2,V(x,y,bottom-2)))
            add('MountWasher%02d'%i,'grey_M10_green_tensioner_washer_%02d'%i,washer,(.75,.77,.8))
            r=17/math.sqrt(3);pts=[V(x+r*math.cos(math.radians(30+60*j)),y+r*math.sin(math.radians(30+60*j)),bottom-10) for j in range(6)]
            nut=Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,8)).cut(Part.makeCylinder(5,8,V(x,y,bottom-10)))
            add('MountNut%02d'%i,'grey_M10_green_tensioner_nut_%02d'%i,nut,(.7,.72,.75))
        support=section.extrude(V(0,0,bottom-rb.ZMax));support.translate(V(cx-25,rb.Center.y-25,rb.ZMax))
        # Open-topped clearance pockets preserve access to mounting nuts and studs.
        for x,y in centres:support=support.cut(Part.makeCylinder(12,21,V(x,y,bottom-20)))
        obj=add('VerticalSHS','cyan_50x50x6_green_tensioner_vertical_support',support.removeSplitter(),(0.0,1.0,1.0),50)
        for key,value in [('SectionSize',50),('WallThickness',6),('Length',bottom-rb.ZMax),('HardwareClearanceRadius',12),('ClearanceDepth',20)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyLinkGlobal','Rail','Mounting');obj.Rail=document.getObject(railname)
    document.recompute()
add_green_bearing_plates_210(doc)

# Version 211: 40x40x3 supports outside the rails, ending at rail underside.
def revise_green_supports_211(document):
    def wire(size,r,offset=0):
        def p(x,y):return V(x+offset,y+offset,0)
        def arc(x,y,a,b):
            def point(t):return p(x+r*math.cos(t),y+r*math.sin(t))
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([Part.makeLine(p(r,0),p(size-r,0)),arc(size-r,r,-math.pi/2,0),Part.makeLine(p(size,r),p(size,size-r)),arc(size-r,size-r,0,math.pi/2),Part.makeLine(p(size-r,size),p(r,size)),arc(r,size-r,math.pi/2,math.pi),Part.makeLine(p(0,size-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
    section=Part.Face(wire(40,6)).cut(Part.Face(wire(34,3,3)))
    for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        obj=document.getObject(prefix+'GreenTensionerVerticalSHS');plate=document.getObject(prefix+'GreenTensionerPairPlate');rail=document.getObject(railname)
        rb=rail.Shape.BoundBox;pb=plate.Shape.BoundBox;old=obj.Shape.BoundBox
        # Resize toward the old inward Y face, then shift outward exactly 50 mm.
        y0=old.YMin+50 if prefix else old.YMax-40-50
        height=pb.ZMin-rb.ZMin
        shape=section.extrude(V(0,0,height));shape.translate(V(old.Center.x-20,y0,rb.ZMin))
        obj.Shape=shape;obj.Placement=shape.Placement
        obj.Label='cyan_40x40x3_green_tensioner_vertical_support'+('_duplicate' if prefix else '')
        obj.SectionSize=40;obj.WallThickness=3;obj.Length=height
        for key in ('HardwareClearanceRadius','ClearanceDepth'):
            if key in obj.PropertiesList:obj.removeProperty(key)
        for key,value in [('OutsideCornerRadius',6),('InsideCornerRadius',3)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyString','Positioning','Mounting');obj.Positioning='Inner Y face retained while resizing; shifted 50 mm outward; lower end flush with rail lower edge'
    document.recompute()
revise_green_supports_211(doc)

# Version 212: shortened supports on rail-top plates, gussets and long bearing slots.
def revise_green_mounts_212(document):
    group=document.addObject('App::DocumentObjectGroup','GreenTensionerFootPlates')
    group.Label='cyan_Green tensioner rail-top plates and gussets'
    for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        stem=prefix+'GreenTensioner';support=document.getObject(stem+'VerticalSHS');plate=document.getObject(stem+'PairPlate');rail=document.getObject(railname)
        sb=support.Shape.BoundBox;pb=plate.Shape.BoundBox;rb=rail.Shape.BoundBox
        # Keep the support top fixed; remove 56 mm from its lower end.
        clip=Part.makeBox(sb.XLength+2,sb.YLength+2,sb.ZLength-56,V(sb.XMin-1,sb.YMin-1,sb.ZMin+56))
        shortened=support.Shape.common(clip).removeSplitter()
        support.Shape=shortened;support.Placement=shortened.Placement;support.Length=sb.ZLength-56
        support.Positioning='Upper end retained; lower end shortened 56 mm, seated on 6 mm rail-top plate'
        def add(name,label,shape):
            obj=document.addObject('Part::Feature',stem+name);obj.Label=label+('_duplicate' if prefix else '')
            obj.Shape=shape;obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50;group.addObject(obj);return obj
        ymin=min(sb.YMin,rb.YMin);ymax=max(sb.YMax,rb.YMax)
        foot=add('FootPlate','cyan_green_tensioner_rail_top_plate_6mm',Part.makeBox(40,ymax-ymin,6,V(sb.XMin,ymin,rb.ZMax)))
        for key,value in [('Width',40),('Length',ymax-ymin),('Thickness',6)]:
            foot.addProperty('App::PropertyLength',key,'Dimensions');setattr(foot,key,value)
        edge=rb.YMax if prefix else rb.YMin;outward=1 if prefix else -1
        x=sb.Center.x-1.5;z=rb.ZMax
        pts=[V(x,edge,z),V(x,edge+outward*25,z),V(x,edge,z-25)]
        gusset=add('FootGusset','cyan_green_tensioner_25x25x3_gusset',Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(3,0,0)))
        for key,value in [('LegLength',25),('Thickness',3)]:
            gusset.addProperty('App::PropertyLength',key,'Dimensions');setattr(gusset,key,value)
        xmin=pb.XMin-50;xmax=pb.XMax
        shape=Part.makeBox(xmax-xmin,pb.YLength,6,V(xmin,pb.YMin,pb.ZMin))
        slot_start=xmin+12;slot_end=xmax-12
        for i in (1,2):
            cy=document.getObject(stem+'Bearing%02dHousing'%i).Shape.BoundBox.Center.y
            cutter=Part.makeCylinder(5.5,8,V(slot_start,cy,pb.ZMin-1)).fuse(Part.makeCylinder(5.5,8,V(slot_end,cy,pb.ZMin-1))).fuse(Part.makeBox(slot_end-slot_start,11,8,V(slot_start,cy-5.5,pb.ZMin-1)))
            shape=shape.cut(cutter)
        shape=shape.removeSplitter();plate.Shape=shape;plate.Placement=shape.Placement;plate.Width=xmax-xmin
        plate.Label='cyan_ID16_green_tensioner_pair_slotted_plate_6mm'+('_duplicate' if prefix else '')
        for key,value in [('SlotWidth',11),('SlotOverallLength',slot_end-slot_start+11),('SlotEndMargin',6.5),('ExtensionNegativeX',50)]:
            plate.addProperty('App::PropertyLength',key,'Dimensions');setattr(plate,key,value)
        plate.addProperty('App::PropertyInteger','SlotCount','Dimensions');plate.SlotCount=2
        plate.addProperty('App::PropertyString','SlotDirection','Dimensions');plate.SlotDirection='Global X'
    document.recompute()
revise_green_mounts_212(doc)

# Version 213: trim facing ends of orange and green tensioner plates by 10 mm.
def separate_tensioner_plates_213(document):
    for prefix in ('','Duplicate_'):
        orange=document.getObject(prefix+'TensionerSlottedPlate');pose=orange.Placement
        old=orange.Shape.copy();old.Placement=App.Placement();b=old.BoundBox
        shape=Part.makeBox(b.XLength-10,b.YLength,6,V(b.XMin,b.YMin,b.ZMin))
        direction=-1 if prefix else 1
        for y in (0,direction*70):
            slot=Part.makeCylinder(5.5,8,V(-26,y,b.ZMin-1)).fuse(Part.makeCylinder(5.5,8,V(70,y,b.ZMin-1))).fuse(Part.makeBox(96,11,8,V(-26,y-5.5,b.ZMin-1)))
            shape=shape.cut(slot)
        orange.Shape=shape.removeSplitter();orange.Placement=pose
        orange.Length=120;orange.SlotOverallLength=107;orange.SlotTravel=44
        green=document.getObject(prefix+'GreenTensionerPairPlate');b=green.Shape.BoundBox
        xmin=b.XMin+10;start=xmin+12;end=b.XMax-12
        shape=Part.makeBox(b.XLength-10,b.YLength,6,V(xmin,b.YMin,b.ZMin))
        for i in (1,2):
            cy=document.getObject(prefix+'GreenTensionerBearing%02dHousing'%i).Shape.BoundBox.Center.y
            slot=Part.makeCylinder(5.5,8,V(start,cy,b.ZMin-1)).fuse(Part.makeCylinder(5.5,8,V(end,cy,b.ZMin-1))).fuse(Part.makeBox(end-start,11,8,V(start,cy-5.5,b.ZMin-1)))
            shape=shape.cut(slot)
        shape=shape.removeSplitter();green.Shape=shape;green.Placement=shape.Placement
        green.Width=b.XLength-10;green.ExtensionNegativeX=40;green.SlotOverallLength=end-start+11
    document.recompute()
separate_tensioner_plates_213(doc)

def carousel_sskp002_shapes():
    # SSKP002 catalogue mounting envelope; unspecified casting/insert details simplified.
    y=-8.0
    pts=[V(-40,y,-22),V(40,y,-22),V(40,y,-15),V(24,y,-15),V(21,y,0)]
    edges=[Part.makeLine(a,b) for a,b in zip(pts,pts[1:])]
    edges.append(Part.Arc(V(21,y,0),V(0,y,21),V(-21,y,0)).toShape())
    tail=[V(-21,y,0),V(-24,y,-15),V(-40,y,-15),V(-40,y,-22)]
    edges.extend(Part.makeLine(a,b) for a,b in zip(tail,tail[1:]))
    housing=Part.Face(Part.Wire(edges)).extrude(V(0,16,0))
    housing=housing.cut(Part.makeCylinder(15,18,V(0,-9,0),V(0,1,0)))
    for x in (-31.5,31.5):housing=housing.cut(Part.makeCylinder(3.5,9,V(x,0,-23),V(0,0,1)))
    race=Part.makeCylinder(15,12,V(0,-6,0),V(0,1,0)).cut(Part.makeCylinder(12,12,V(0,-6,0),V(0,1,0)))
    insert=Part.makeCylinder(12,16.5,V(0,-4.5,0),V(0,1,0)).cut(Part.makeCylinder(7.5,16.5,V(0,-4.5,0),V(0,1,0)))
    screws=[]
    for dx,dz in ((0,1),(-0.866025403784,-0.5)):
        direction=V(dx,0,dz)
        screw=Part.makeCylinder(1.5,3,V(dx*10,9,dz*10),direction)
        insert=insert.cut(screw);screws.append(screw)
    return dict(Housing=housing,OuterRace=race,Insert=insert,GrubScrew1=screws[0],GrubScrew2=screws[1])

# Version 218: SSKP002 ID15 bearings on both carousel shafts; horizontal pair inverted.
class CarouselBearingSupports214:
    def __init__(self,document):
        self.doc=document;self.items=[]
        self.group=document.addObject('App::DocumentObjectGroup','CarouselID12BearingSupports')
        self.group.Label='blue_Carousel OD15 shafts and SSKP002 bearing supports'
        drive=document.carousel_horiz_sprocket_20T;gear=document.carousel_horiz_bevel_gear_30T;idler=document.carousel_chain_tensioner_10T
        db=drive.Shape.BoundBox;gb=gear.Shape.BoundBox;ib=idler.Shape.BoundBox
        specs=[('CarouselHorizontal',drive,min(db.YMin,gb.YMin)-50,max(db.YMax,gb.YMax)+50),('CarouselTensioner',idler,ib.Center.y-50,ib.Center.y+50)]
        templates=[('Housing','UpperWheelPlummerHousing01',False),('OuterRace','UpperWheelPlummerOuterRace01',False),('Insert','UpperWheelPlummerInsert01',True),('GreaseNipple','UpperWheelPlummerGrease01',False),('GrubScrew1','UpperWheelPlummerGrub01_1',True),('GrubScrew2','UpperWheelPlummerGrub01_2',True)]
        for stem,driver,y0,y1 in specs:
            diameter=15
            centres=(y0+35,y1-35) if stem=='CarouselHorizontal' else (y0+20,y1-20)
            if stem=='CarouselHorizontal':y0,y1=centres[0]-8,centres[1]+12
            shaft=document.addObject('Part::Feature',stem+'Shaft'+str(diameter));shaft.Label='blue_OD%d_'%diameter+stem+'_shaft'
            shaft.Shape=Part.makeCylinder(diameter/2.0,y1-y0,V(0,0,0),V(0,1,0));shaft.ViewObject.ShapeColor=document.duck_bill_arm_one_shaft.ViewObject.ShapeColor;shaft.ViewObject.Transparency=50;self.group.addObject(shaft)
            for key,value in [('Diameter',diameter),('Length',y1-y0)]:
                shaft.addProperty('App::PropertyLength',key,'Dimensions');setattr(shaft,key,value)
            if stem=='CarouselHorizontal':
                seat_start=gear.getGlobalPlacement().Base.y+gear.MountingDistance.Value-gear.OverallLength.Value+gear.FrontOffsetS.Value
                seat_length=gear.BoreLength.Value
                shaft.Shape=shaft.Shape.fuse(Part.makeCylinder(8,seat_length,V(0,seat_start-y0,0),V(0,1,0))).removeSplitter()
                for key,value in [('GearSeatDiameter',16),('GearSeatLength',seat_length),('GearSeatOffset',seat_start-y0)]:
                    shaft.addProperty('App::PropertyLength',key,'Dimensions');setattr(shaft,key,value)
                shaft.Label='blue_OD15_CarouselHorizontal_shaft_with_OD16_bevel_seat'
            slim=True
            kp_shapes=carousel_sskp002_shapes() if slim else {}
            designation='SSKP002' if slim else 'UCPA201'
            pairs=[]
            for index,cy in enumerate(centres,1):
                unit=document.addObject('App::DocumentObjectGroup',stem+'Bearing%02d'%index)
                unit.Label='magenta_'+designation+'_ID%d_'%diameter+stem+'_%02d'%index;self.group.addObject(unit)
                for key,value in [('BoreDiameter',12),('CentreHeight',30.2),('BaseWidth',76),('BaseDepth',40),('BoltCentres',52),('BaseThickness',11),('OverallHeight',62),('MountHoleDepth',13),('InsertWidth',31),('FaceToCentre',12.7)]:
                    unit.addProperty('App::PropertyLength',key,'Catalogue');setattr(unit,key,value)
                if slim:
                    for key,value in [('BoreDiameter',15),('CentreHeight',22),('BaseWidth',80),('BaseDepth',16),('BoltCentres',63),('BaseThickness',7),('OverallHeight',43),('InsertWidth',16.5),('FaceToCentre',4.5)]:setattr(unit,key,value)
                    unit.addProperty('App::PropertyString','Material','Catalogue');unit.Material='304 Stainless Steel'
                    unit.removeProperty('MountHoleDepth')
                    unit.addProperty('App::PropertyLength','MountHoleDiameter','Catalogue');unit.MountHoleDiameter=7
                unit.addProperty('App::PropertyString','MountingThread','Catalogue');unit.MountingThread='2 x M10 blind, 13 mm depth; simplified threads'
                unit.addProperty('App::PropertyString','SpecificationSource','Catalogue');unit.SpecificationSource='User ID12_plummer_block/ID12_plummer_block.txt and sch_ucpa200.webp; cast contour and insert internals simplified'
                if slim:
                    unit.MountingThread='2 x diameter 7 mm through holes for M6 bolts'
                    unit.SpecificationSource='User ID15_SS_slim_plummer_block/ID15_SS_slim_plummer_block.txt and supplied drawings; casting contour and unspecified insert diameters simplified'
                unit.addProperty('App::PropertyVector','BearingCentre','Mounting');parts=[]
                for key,template,rotating in templates:
                    if slim and key=='GreaseNipple':continue
                    ref=document.getObject(template);shape=ref.Shape.copy();shape.Placement=App.Placement()
                    if key=='Insert':shape=Part.makeCylinder(13,31,V(0,-12.7,0),V(0,1,0)).cut(Part.makeCylinder(6,31,V(0,-12.7,0),V(0,1,0)))
                    if slim:shape=kp_shapes[key].copy()
                    obj=document.addObject('Part::Feature',stem+'Bearing%02d'%index+key);obj.Label='magenta_'+designation+'_ID%d_'%diameter+stem+'_%02d_'%index+key
                    obj.Shape=shape;obj.ViewObject.ShapeColor=ref.ViewObject.ShapeColor;obj.ViewObject.Transparency=50;unit.addObject(obj);parts.append((obj,rotating))
                pairs.append((unit,parts,cy))
            self.items.append((driver,shaft,y0,y1,pairs,driver.getGlobalPlacement().Rotation))
        self.update()
    def update(self):
        for driver,shaft,y0,y1,pairs,rest in self.items:
            pose=driver.getGlobalPlacement();axis=pose.Base;spin=pose.Rotation.multiply(rest.inverted())
            shaft.Placement=App.Placement(V(axis.x,y0,axis.z),App.Rotation())
            for unit,parts,cy in pairs:
                centre=V(axis.x,cy,axis.z);unit.BearingCentre=centre
                mounting=App.Rotation(V(0,1,0),180) if driver==self.doc.carousel_horiz_sprocket_20T else App.Rotation(V(0,1,0),carousel_tensioner_mount_angle_231)
                for obj,rotating in parts:obj.Placement=App.Placement(centre,spin.multiply(mounting) if rotating else mounting)
carousel_bearing_supports_214=CarouselBearingSupports214(doc)
App.carousel_bearing_supports_214=carousel_bearing_supports_214
