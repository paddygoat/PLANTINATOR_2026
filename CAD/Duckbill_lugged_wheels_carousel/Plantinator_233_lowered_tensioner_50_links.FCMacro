def add_duck_bill_arm_three(doc):
    shaft = doc.getObject("Sprocket_21T_Shaft")
    shaft_centre = shaft.Shape.CenterOfMass
    plate = doc.addObject("Part::Feature", "duck_bill_arm_three")
    plate.Label = "duck_bill_arm_three"
    blank = Part.makeBox(220.0, 6.0, 50.0, V(-110.0, -3.0, -25.0))
    centre_hole = Part.makeCylinder(10.0, 8.0, V(0, -4.0, 0), V(0, 1, 0))
    end_hole = Part.makeCylinder(10.0, 8.0, V(95.0, -4.0, 0), V(0, 1, 0))
    plate.Shape = blank.cut(centre_hole.fuse(end_hole)).removeSplitter()
    # Adjacent to the +Y sprocket face, with the shaft through the centre hole.
    plate.Placement = App.Placement(
        shaft_centre + V(0, SPROCKET_PLATE_THICKNESS / 2.0 + 3.0 + 20.0, 0), App.Rotation())
    for prop, value in (("LengthX", 220.0), ("ThicknessY", 6.0),
                        ("HeightZ", 50.0), ("HoleDiameter", 20.0),
                        ("EndHoleOffset", 15.0)):
        plate.addProperty("App::PropertyLength", prop, "Dimensions")
        setattr(plate, prop, value)
    plate.ViewObject.ShapeColor = (0.58, 0.65, 0.72)
    return plate


duck_bill_arm_three = add_duck_bill_arm_three(doc)
doc.recompute()

def add_duck_bill_arm_three_end_shaft(doc):
    arm = doc.getObject("duck_bill_arm_three")
    shaft = doc.addObject("Part::Feature", "duck_bill_arm_three_end_shaft")
    shaft.Label = "duck_bill_arm_three_end_shaft"
    # End-hole shaft moved another +20 mm along Y; remains rigid with arm three.
    shaft.Shape = Part.makeCylinder(10.0, 60.0, V(95.0, -8.25, 0), V(0, 1, 0))
    shaft.Placement = arm.getGlobalPlacement()
    shaft.addProperty("App::PropertyLength", "Diameter", "Dimensions")
    shaft.addProperty("App::PropertyLength", "LengthY", "Dimensions")
    shaft.Diameter = 20.0
    shaft.LengthY = 60.0
    shaft.ViewObject.ShapeColor = (0.72, 0.74, 0.77)
    return shaft


duck_bill_arm_three_end_shaft = add_duck_bill_arm_three_end_shaft(doc)
doc.recompute()

def add_duck_bill_arm_two_centre_shaft(doc):
    first = doc.getObject("duck_bill_arm_two_centre_plate_positive_y")
    second = doc.getObject("duck_bill_arm_two_centre_plate_negative_y")
    first_hole = first.getGlobalPlacement().multVec(V(0, 0, 60.0))
    second_hole = second.getGlobalPlacement().multVec(V(0, 0, 60.0))
    centre = (first_hole + second_hole) * 0.5
    shaft = doc.addObject("Part::Feature", "duck_bill_arm_two_centre_shaft")
    shaft.Label = "duck_bill_arm_two_centre_shaft"
    shaft.Shape = Part.makeCylinder(10.0, 60.0, V(0, -30.0, 0), V(0, 1, 0))
    shaft.Placement = App.Placement(centre, App.Rotation())
    shaft.addProperty("App::PropertyLength", "Diameter", "Dimensions")
    shaft.addProperty("App::PropertyLength", "LengthY", "Dimensions")
    shaft.Diameter = 20.0
    shaft.LengthY = 60.0
    shaft.ViewObject.ShapeColor = (0.72, 0.74, 0.77)
    return shaft


duck_bill_arm_two_centre_shaft = add_duck_bill_arm_two_centre_shaft(doc)
doc.recompute()

def add_duck_bill_connecting_plate(doc):
    shaft_a = doc.getObject("duck_bill_arm_two_centre_shaft")
    shaft_b = doc.getObject("duck_bill_arm_three_end_shaft")
    a, b = shaft_a.Shape.CenterOfMass, shaft_b.Shape.CenterOfMass
    direction = V(b.x - a.x, 0, b.z - a.z)
    distance = direction.Length
    if distance <= 20.0:
        raise ValueError("Shaft axes are too close for separate 20 mm holes.")
    direction = direction / distance
    length = 313.5930182497448  # Preserve the existing connecting plate
    # Both shaft axes run along Y: align holes in X/Z on a common Y plane.
    support_positive = doc.getObject("duck_bill_arm_two_centre_plate_positive_y")
    support_negative = doc.getObject("duck_bill_arm_two_centre_plate_negative_y")
    plate_y = (support_positive.Shape.BoundBox.YMin
               + support_negative.Shape.BoundBox.YMax) / 2.0
    hole_a = V(a.x, plate_y, a.z)
    angle = math.degrees(math.atan2(-direction.z, direction.x))
    blank = Part.makeBox(length, 6.0, 50.0, V(0, -3.0, -25.0))
    first_hole = Part.makeCylinder(10.0, 8.0, V(15.0, -4.0, 0), V(0, 1, 0))
    last_hole = Part.makeCylinder(10.0, 8.0, V(length - 15.0, -4.0, 0), V(0, 1, 0))
    plate = doc.addObject("Part::Feature", "duck_bill_connecting_plate")
    plate.Label = "duck_bill_connecting_plate"
    plate.Shape = blank.cut(first_hole.fuse(last_hole)).removeSplitter()
    plate.Placement = App.Placement(hole_a - direction * 15.0, App.Rotation(V(0, 1, 0), angle))
    for prop, value in (("Length", length), ("Width", 50.0),
                        ("ThicknessY", 6.0), ("HoleDiameter", 20.0),
                        ("HoleEndOffset", 15.0), ("HoleCentreDistance", length - 30.0)):
        plate.addProperty("App::PropertyLength", prop, "Dimensions")
        setattr(plate, prop, value)
    plate.ViewObject.ShapeColor = (0.66, 0.70, 0.76)
    return plate


duck_bill_connecting_plate = add_duck_bill_connecting_plate(doc)
doc.recompute()

class DuckBillLinkageMotion:
    """Fixed pin 65 mm inward from the outer slot end; arm two pivots on it without any sliding.

    Persistent design requirement: the arm-one pin is always rigidly fixed at
    70 mm along arm one, 65 mm inward from the far slot end. Do not restore the earlier sliding solver.
    """
    def __init__(self, document):
        self.doc = document
        self.driver = document.getObject("sprocket_16T_03")
        self.crank_names = ("Sprocket_21T_Shaft", "sprocket_16T_shaft_disc", "sprocket_16T_rim_disc", "sprocket_16T_rim_disc_02", "sprocket_16T_rim_disc_03", "sprocket_16T_rim_disc_04", "sprocket_16T_rim_disc_05", "sprocket_16T_rim_disc_06", "sprocket_16T_rim_disc_07", "sprocket_16T_rim_disc_08", "sprocket_16T_rim_disc_09", "sprocket_16T_rim_disc_10", "sprocket_16T_rim_disc_11", "sprocket_16T_rim_disc_12", "sprocket_16T_rim_disc_13", "sprocket_16T_rim_disc_14", "sprocket_16T_rim_disc_15", "duck_bill_arm_three",
                            "duck_bill_arm_three_end_shaft")
        self.follower_names = ("duck_bill_arm_two",
                               "duck_bill_arm_two_centre_plate_positive_y",
                               "duck_bill_arm_two_centre_plate_negative_y",
                               "duck_bill_arm_two_centre_shaft")
        self.rest = {name: document.getObject(name).getGlobalPlacement()
                     for name in self.crank_names + self.follower_names}
        self.driver_rest = self.driver.getGlobalPlacement()
        self.a0 = document.duck_bill_arm_two.getGlobalPlacement().multVec(V(15, 0, 0))
        self.b0 = document.duck_bill_arm_two_centre_shaft.Shape.CenterOfMass
        self.d0 = document.duck_bill_arm_three_end_shaft.Shape.CenterOfMass
        self.arm_vector = self.b0 - self.a0
        self.arm_radius = math.hypot(self.arm_vector.x, self.arm_vector.z)
        self.connector = document.duck_bill_connecting_plate
        self.connector_length = self.connector.HoleCentreDistance.Value
        self.connector_y = self.connector.getGlobalPlacement().Base.y
        self.guide = document.duck_bill_arm_one
        self.guide_rest = self.guide.getGlobalPlacement()
        self.guide_driver = document.sprocket_16T_01
        self.guide_driver_rest = self.guide_driver.getGlobalPlacement()
        self.slot_min, self.slot_max = 25.0, 135.0
        self.fixed_pin_x = 70.0
        self.guide_pin = document.duck_bill_arm_one_pin
        initial_pin_centre = self.guide_rest.inverse().multVec(self.guide_pin.Shape.CenterOfMass)
        pin_shift = App.Placement(V(self.fixed_pin_x, 0, 0) - initial_pin_centre, App.Rotation())
        self.guide_pin_relative = pin_shift.multiply(self.guide_rest.inverse()).multiply(self.guide_pin.getGlobalPlacement())
        # Start 65 mm inward from the outer slot end; preserve the existing connecting-plate length.
        self.slot_x = self.fixed_pin_x
        initial_pin = self.guide_rest.multVec(V(self.slot_x, 6.0, 0))
        dx, dz = self.d0.x - initial_pin.x, self.d0.z - initial_pin.z
        distance = math.hypot(dx, dz)
        cosine = (self.arm_radius ** 2 + distance ** 2 - self.connector_length ** 2) / (2.0 * self.arm_radius * distance)
        if abs(cosine) > 1.0 + 1.0e-9:
            raise ValueError("The linkage cannot reach the fixed pin position.")
        opening = math.acos(max(-1.0, min(1.0, cosine)))
        bearing = math.atan2(dz, dx) - math.atan2(self.arm_vector.z, self.arm_vector.x)
        choices = [(bearing + sign * opening + math.pi) % (2.0 * math.pi) - math.pi for sign in (-1, 1)]
        self.initial_arm_angle = min(choices, key=abs)
        self.arm_angle = self.initial_arm_angle
        self.last_driver_delta = 0.0
        self.state = document.addObject("App::FeaturePython", "DuckBillMotion")
        self.state.Label = "Duck bill motion (fixed pin 65 mm inward)"
        for prop in ("DriverAngle", "ArmTwoAngle"):
            self.state.addProperty("App::PropertyAngle", prop, "Motion")
        for prop in ("SlotPosition", "SlotMinimum", "SlotMaximum", "ClosureError"):
            self.state.addProperty("App::PropertyLength", prop, "Motion")
        self.state.SlotMinimum, self.state.SlotMaximum = 25.0, 135.0
        self.state.addProperty("App::PropertyString", "MotionModel", "Joints")
        self.state.MotionModel = "Fixed pin 65 mm inward from the outer slot end (70 mm); arm two freely pivots on the pin but cannot slide. Run the matching FCMacro to animate."
        self.state.addProperty("App::PropertyLinkGlobal", "Driver", "Joints")
        self.state.Driver = self.driver
        self.state.addProperty("App::PropertyBool", "PinFixedAtOuterEnd", "Joints")
        self.state.PinFixedAtOuterEnd = False
        self.state.addProperty("App::PropertyBool", "PinFixedInSlot", "Joints")
        self.state.PinFixedInSlot = True
        self.state.setEditorMode("PinFixedInSlot", 1)
        self.state.setEditorMode("PinFixedAtOuterEnd", 1)
        self.state.addProperty("App::PropertyLinkGlobal", "FixedSlotPin", "Joints")
        self.state.FixedSlotPin = self.guide_pin
        self.state.setEditorMode("FixedSlotPin", 1)
        self.state.addProperty("App::PropertyLinkListGlobal", "RigidCrank", "Joints")
        self.state.RigidCrank = [document.getObject(n) for n in self.crank_names]
        self.state.addProperty("App::PropertyLinkListGlobal", "RigidArmTwo", "Joints")
        self.state.RigidArmTwo = [document.getObject(n) for n in self.follower_names]
        self.state.addProperty("App::PropertyLinkListGlobal", "RevolutePins", "Joints")
        self.state.RevolutePins = [document.duck_bill_arm_three_end_shaft,
                                   document.duck_bill_arm_two_centre_shaft]
        self.state.addProperty("App::PropertyLinkGlobal", "ConnectingPlate", "Joints")
        self.state.ConnectingPlate = self.connector
        self.state.addProperty("App::PropertyLinkGlobal", "SlottedGuide", "Joints")
        self.state.SlottedGuide = document.duck_bill_arm_one
        self.state.addProperty("App::PropertyLinkGlobal", "SlotDriver", "Joints")
        self.state.SlotDriver = document.sprocket_16T_01
        self.state.setEditorMode("SlotDriver", 1)
        for prop in ("DriverAngle", "ArmTwoAngle", "SlotPosition", "SlotMinimum",
                     "SlotMaximum", "ClosureError", "MotionModel", "Driver",
                     "RigidCrank", "RigidArmTwo", "RevolutePins", "ConnectingPlate", "SlottedGuide"):
            self.state.setEditorMode(prop, 1)

    def set_world(self, obj, placement):
        parent = obj.getGlobalPlacement().multiply(obj.Placement.inverse())
        obj.Placement = parent.inverse().multiply(placement)

    def solve_follower(self, target, slot_frame):
        # Permanent constraint: no translation of the pin within the slot.
        self.slot_x = self.fixed_pin_x
        a = slot_frame.multVec(V(self.fixed_pin_x, 6.0, 0))
        dx, dz = target.x - a.x, target.z - a.z
        distance = math.hypot(dx, dz)
        if distance < 1.0e-10:
            raise RuntimeError("The fixed-pin linkage has coincident joint centres.")
        cosine = (self.arm_radius ** 2 + distance ** 2 - self.connector_length ** 2) / (2.0 * self.arm_radius * distance)
        if abs(cosine) > 1.0 + 1.0e-9:
            raise RuntimeError("The fixed-pin linkage cannot reach this crank position.")
        opening = math.acos(max(-1.0, min(1.0, cosine)))
        bearing = math.atan2(dz, dx) - math.atan2(self.arm_vector.z, self.arm_vector.x)
        candidates = [bearing - opening, bearing + opening]
        changes = [math.atan2(math.sin(candidate - self.arm_angle), math.cos(candidate - self.arm_angle)) for candidate in candidates]
        self.arm_angle += min(changes, key=abs)

    def update(self):
        # The global drive axis is +Y; use its actual placement delta for rigid parts.
        driver_delta = self.driver.getGlobalPlacement().multiply(self.driver_rest.inverse())
        target_delta = -animation_offset / (PITCH * T3 / (2 * math.pi))
        # Small continuation steps preserve the pose branch even when scrubbing.
        steps = max(1, int(math.ceil(abs(target_delta - self.last_driver_delta) / math.radians(1.0))))
        driver_centre = self.driver_rest.Base
        for i in range(1, steps + 1):
            delta = self.last_driver_delta + (target_delta - self.last_driver_delta) * i / steps
            rotation = App.Rotation(V(0, 1, 0), math.degrees(delta))
            target = driver_centre + rotation.multVec(self.d0 - driver_centre)
            guide_rotation = App.Rotation(V(0, 1, 0), math.degrees(delta * T3 / T1))
            guide_centre = self.guide_driver_rest.Base
            guide_delta = App.Placement(guide_centre - guide_rotation.multVec(guide_centre), guide_rotation)
            slot_frame = guide_delta.multiply(self.guide_rest)
            self.solve_follower(target, slot_frame)
        self.last_driver_delta = target_delta
        for name in self.crank_names:
            self.set_world(self.doc.getObject(name), driver_delta.multiply(self.rest[name]))
        rotation = App.Rotation(V(0, 1, 0), -math.degrees(self.arm_angle))
        guide_delta = self.guide_driver.getGlobalPlacement().multiply(self.guide_driver_rest.inverse())
        slot_frame = guide_delta.multiply(self.guide_rest)
        self.set_world(self.guide, slot_frame)
        self.set_world(self.guide_pin, slot_frame.multiply(self.guide_pin_relative))
        a = slot_frame.multVec(V(self.slot_x, 6.0, 0))
        follower_delta = App.Placement(a - rotation.multVec(self.a0), rotation)
        for name in self.follower_names:
            self.set_world(self.doc.getObject(name), follower_delta.multiply(self.rest[name]))
        b = follower_delta.multVec(self.b0)
        d = driver_delta.multVec(self.d0)
        direction = V(d.x - b.x, 0, d.z - b.z)
        distance = direction.Length
        self.state.ClosureError = abs(distance - self.connector_length)
        if self.state.ClosureError.Value > 1.0e-6:
            raise RuntimeError("Duck-bill connecting plate lost pin alignment.")
        direction = direction / distance
        angle = math.degrees(math.atan2(-direction.z, direction.x))
        start = V(b.x, self.connector_y, b.z) - direction * 15.0
        self.set_world(self.connector, App.Placement(start, App.Rotation(V(0, 1, 0), angle)))
        self.state.DriverAngle = math.degrees(target_delta)
        self.state.ArmTwoAngle = math.degrees(self.arm_angle)
        self.state.SlotPosition = self.slot_x

    def reset(self):
        self.slot_x, self.arm_angle, self.last_driver_delta = self.fixed_pin_x, self.initial_arm_angle, 0.0


# Shift the linkage before capturing its rest poses. Mounted duck-bill parts,
# slave cylinder, spring hardware and the closed-tip path inherit this move.
DUCK_BILL_SHIFTED_LINKAGE_NAMES = (
    'duck_bill_arm_one', 'duck_bill_arm_one_pin', 'duck_bill_arm_two',
    'duck_bill_arm_two_centre_plate_positive_y', 'duck_bill_arm_two_centre_plate_negative_y',
    'Sprocket_21T_Shaft', 'duck_bill_arm_three', 'duck_bill_arm_three_end_shaft',
    'duck_bill_arm_two_centre_shaft', 'duck_bill_connecting_plate')
for name in DUCK_BILL_SHIFTED_LINKAGE_NAMES:
    obj=doc.getObject(name)
    parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
    shifted=App.Placement(V(0,DUCK_BILL_LINKAGE_Y_SHIFT,0),App.Rotation()).multiply(obj.getGlobalPlacement())
    obj.Placement=parent.inverse().multiply(shifted)
doc.duck_bill_arm_one.SprocketOffsetY=50.0+DUCK_BILL_LINKAGE_Y_SHIFT

duck_bill_motion = DuckBillLinkageMotion(doc)
duck_bill_motion.update()
doc.recompute()


def reset_simulation():
    global animation_offset
    animation_offset = 0.0
    carousel_chain_drive.rotation_tracker.reset()
    carousel_drive.rotation_tracker.reset()
    duck_bill_motion.reset()
    apply_simulation_state()
    if seedling_drop is not None:seedling_drop.reset()
    if seedling_flower is not None:seedling_flower.reset()
    doc.recompute()


# Console access to the geometric linkage and a reproducible neutral pose.
App.duck_bill_motion = duck_bill_motion
App.reset_duck_bill_simulation = reset_simulation


class ArmTwoDuckBillMount:
    """Rigidly carry both duck-bill display configurations beyond arm two."""
    def __init__(self, document):
        self.doc = document
        self.arm = document.getObject("duck_bill_arm_two")
        self.arm_rest = self.arm.getGlobalPlacement()
        self.axis_position = 950.0  # Preserve the existing nominal mount reference.
        mount_point = self.arm_rest.multVec(V(self.axis_position, 0, 0)) + V(-50.0, 0, -270.0)
        self.mount_local = self.arm_rest.inverse().multVec(mount_point)
        # The imported model's datum has retained this world translation.
        # Move that datum to the attachment point without reorienting the model
        # in the initial pose; thereafter it follows all arm motion rigidly.
        old_datum = duck_bill_world_shift.Base
        translation = App.Placement(mount_point - old_datum, App.Rotation())
        self.parts = [obj for obj in document.Objects
                      if obj.Name.startswith(("Closed_0deg_", "Opened_20deg_"))
                      and obj.isDerivedFrom("Part::Feature")]
        if not self.parts:
            raise RuntimeError("Expected both complete duck-bill configurations.")
        self.relative = {
            obj.Name: self.arm_rest.inverse().multiply(translation).multiply(obj.getGlobalPlacement())
            for obj in self.parts
        }
