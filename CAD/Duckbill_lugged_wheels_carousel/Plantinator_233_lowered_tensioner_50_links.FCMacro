SEEDLING_SOIL_ANCHOR = [145, 853.7719335184878, 206.66465575372698]

class SeedlingDrop:
    """Lightweight upright gravity/contact visualisation, not a deformable-plant solver."""
    def __init__(self,document):
        self.doc=document;self.tube=document.Carousel_tube_06
        self.frames=[r[0] for r in SEEDLING_DROP_PATH]
        self.group=document.addObject('App::DocumentObjectGroup','SeedlingDrop')
        self.group.Label='Seedling drop into tube 06'
        self.group.addProperty('App::PropertyBool','Enabled','Animation');self.group.Enabled=ANIMATE_SEEDLING_DROP
        self.group.addProperty('App::PropertyString','Stage','Animation')
        self.group.addProperty('App::PropertyString','Contact','Animation')
        self.group.addProperty('App::PropertyString','Model','Animation')
        self.group.Model='Lightweight replay of offline upright gravity/contact simulation for version157. Three hinged plain leaves; native-solid checks at recorded poses. No flexible-leaf or force model. Root plug top finishes10 mm below soil and then follows soil. Regenerate path after geometry/timing changes.'
        self.group.addProperty('App::PropertyFloat','Gravity','Animation');self.group.Gravity=9810.0
        self.group.addProperty('App::PropertyLength','InsertionDepth','Animation');self.group.InsertionDepth=50
        self.group.addProperty('App::PropertyLength','InitialHeight','Dimensions');self.group.InitialHeight=100
        self.group.addProperty('App::PropertyLength','LeafEnvelopeDiameter','Dimensions');self.group.LeafEnvelopeDiameter=120
        self.group.addProperty('App::PropertyLinkGlobal','Tube','Animation');self.group.Tube=self.tube
        self.length=60/math.sin(math.radians(80))
        self.joint_z=100-self.length*math.cos(math.radians(80))-.25*math.sin(math.radians(80))
        self.parts=[]
        def feature(name,label,shape,colour):
            o=document.addObject('Part::Feature',name);o.Label=label;o.Shape=shape
            o.ViewObject.ShapeColor=colour;o.ViewObject.Transparency=50
            self.group.addObject(o);self.parts.append(o);return o
        self.plug=feature('Seedling_root_plug','Seedling black root plug - 30 x 30 x 30 mm',Part.makeBox(30,30,30,V(-15,-15,0)),(0.03,.03,.03))
        self.stem=feature('Seedling_stem','Seedling green stem',Part.makeCylinder(1,self.joint_z-30,V(0,0,30)),(.15,.65,.15))
        points=[V(0,0,-.25),V(self.length*.48,9,-.25),V(self.length,0,-.25),V(self.length*.48,-9,-.25),V(0,0,-.25)]
        blade=Part.Face(Part.makePolygon(points)).extrude(V(0,0,.5))
        self.leaves=[]
        for i in range(3):
            leaf=feature('Seedling_leaf_%02d'%(i+1),'Seedling hinged leaf %02d'%(i+1),blade.copy(),(.15,.65,.15))
            leaf.addProperty('App::PropertyAngle','AngleToStem','Animation');leaf.AngleToStem=80
            self.leaves.append(leaf)
        self.leaf_shape=blade
        for prop in ('Gravity','InsertionDepth','InitialHeight','LeafEnvelopeDiameter','Stage','Contact','Model'):self.group.setEditorMode(prop,1)
        self.reset()

    def visibility(self):
        enabled=bool(ANIMATE_SEEDLING_DROP and self.group.Enabled)
        for o in self.parts:o.ViewObject.Visibility=enabled
        return enabled

    def reset(self):
        row=SEEDLING_DROP_PATH[0]
        self.pos=V(*row[1:4]);self.angles=list(row[4:7]);self.landed=False
        self.group.Stage='Initial guided drop';self.group.Contact=''
        self.place();self.visibility()

    def leaf_at(self,p,index,angle):
        pose=App.Placement(p+V(0,0,self.joint_z),App.Rotation(V(0,0,1),index*120).multiply(App.Rotation(V(0,1,0),angle-90)))
        return pose

    def place(self):
        pose=App.Placement(self.pos,App.Rotation())
        self.plug.Placement=pose;self.stem.Placement=pose
        for i,o in enumerate(self.leaves):
            o.Placement=self.leaf_at(self.pos,i,self.angles[i]);o.AngleToStem=self.angles[i]

    def update(self):
        if not self.visibility():return
        import bisect
        offset=max(0.0,float(animation_offset))
        index=max(0,min(len(SEEDLING_DROP_PATH)-1,bisect.bisect_right(self.frames,offset)-1))
        a=SEEDLING_DROP_PATH[index];b=SEEDLING_DROP_PATH[min(index+1,len(SEEDLING_DROP_PATH)-1)]
        fraction=0.0 if a[0]==b[0] else min(1.0,(offset-a[0])/(b[0]-a[0]))
        values=[a[k]+(b[k]-a[k])*fraction for k in range(1,7)]
        self.pos=V(*values[:3]);self.angles=values[3:]
        self.landed=offset>=SEEDLING_SOIL_ANCHOR[0]
        if self.landed:
            self.pos.x=SEEDLING_SOIL_ANCHOR[1]+moving_ground.last_travel-SEEDLING_SOIL_ANCHOR[2]
            self.pos.z=moving_ground.surface.getGlobalPlacement().Base.z-30-ROOT_BLOCK_DEPTH
            self.group.Stage='Planted in moving soil'
        elif self.pos.z>=self.tube.Placement.Base.z+12-50:self.group.Stage='Initial guided drop'
        elif self.pos.z>=self.tube.Placement.Base.z+6-CAROUSEL_TUBE_LENGTH-.1:self.group.Stage='Inside tube / supported by flapper'
        else:self.group.Stage='Gravity drop / mechanism contact'
        self.group.Contact=a[7]
        self.place()


class SeedlingGravityDrop:
    """Lightweight upright gravity/contact visualisation, not a deformable-plant solver."""
    def __init__(self,document):
        self.doc=document;self.tube=document.Carousel_tube_06
        self.colliders=[o for o in document.Objects if o.isDerivedFrom('Part::Feature') and
            not o.Shape.isNull() and len(o.Shape.Solids)>0 and o.ViewObject.Visibility and
            not o.Name.startswith(('Soil','Opened_20deg_'))]
        self.group=document.addObject('App::DocumentObjectGroup','SeedlingDrop')
        self.group.Label='Seedling drop into tube 06'
        self.group.addProperty('App::PropertyBool','Enabled','Animation');self.group.Enabled=ANIMATE_SEEDLING_DROP
        self.group.addProperty('App::PropertyString','Stage','Animation')
        self.group.addProperty('App::PropertyString','Contact','Animation')
        self.group.addProperty('App::PropertyString','Model','Animation')
        self.group.Model='Upright gravity/contact visualisation; rigid30 mm plug, hinged leaves. Native-solid contact checks against visible mechanism solids. No flexible-leaf, friction, impact or soil-force model. Soil capture places plug top ROOT_BLOCK_DEPTH below soil.'
        self.group.addProperty('App::PropertyFloat','Gravity','Animation');self.group.Gravity=9810.0
        self.group.addProperty('App::PropertyLength','InsertionDepth','Animation');self.group.InsertionDepth=50
        self.group.addProperty('App::PropertyLength','InitialHeight','Dimensions');self.group.InitialHeight=100
        self.group.addProperty('App::PropertyLength','LeafEnvelopeDiameter','Dimensions');self.group.LeafEnvelopeDiameter=120
        self.group.addProperty('App::PropertyLinkGlobal','Tube','Animation');self.group.Tube=self.tube
        self.length=60/math.sin(math.radians(80))
        self.joint_z=100-self.length*math.cos(math.radians(80))-.25*math.sin(math.radians(80))
        self.parts=[]
        def feature(name,label,shape,colour):
            o=document.addObject('Part::Feature',name);o.Label=label;o.Shape=shape
            o.ViewObject.ShapeColor=colour;o.ViewObject.Transparency=50
            self.group.addObject(o);self.parts.append(o);return o
        self.plug=feature('Seedling_root_plug','Seedling black root plug30 x30 x30',Part.makeBox(30,30,30,V(-15,-15,0)),(0.03,.03,.03))
        self.stem=feature('Seedling_stem','Seedling green stem',Part.makeCylinder(1,self.joint_z-30,V(0,0,30)),(.15,.65,.15))
        points=[V(0,0,-.25),V(self.length*.48,9,-.25),V(self.length,0,-.25),V(self.length*.48,-9,-.25),V(0,0,-.25)]
        blade=Part.Face(Part.makePolygon(points)).extrude(V(0,0,.5))
        self.leaves=[]
        for i in range(3):
            leaf=feature('Seedling_leaf_%02d'%(i+1),'Seedling hinged leaf%02d'%(i+1),blade.copy(),(.15,.65,.15))
            leaf.addProperty('App::PropertyAngle','AngleToStem','Animation');leaf.AngleToStem=80
            self.leaves.append(leaf)
        self.body=Part.makeCompound([self.plug.Shape.copy(),self.stem.Shape.copy()])
        self.leaf_shape=blade
        self.reset()

    def tube_centre(self):
        return self.tube.getGlobalPlacement().Base

    def reset(self):
        centre=self.tube_centre();self.pos=V(centre.x,centre.y,self.doc.Carousel_disc.Shape.BoundBox.ZMax+SEEDLING_START_HEIGHT)
        self.vz=0.0;self.guided=True;self.landed=False;self.support=None;self.support_anchor=None
        self.last_tube=centre;self.last_offset=float(animation_offset);self.elapsed=0.0
        self.angles=[80.0]*3;self.near=[];self.contact_count=0
        self.group.Stage='Initial guided drop';self.group.Contact=''
        self.place();self.visibility()

    def visibility(self):
        enabled=bool(ANIMATE_SEEDLING_DROP and self.group.Enabled)
        for o in self.parts:o.ViewObject.Visibility=enabled
        return enabled

    @staticmethod
    def intersects(a,b):
        return a.intersect(b)

    def scene(self):
        region=App.BoundBox(self.pos.x-140,self.pos.y-140,self.pos.z-max(180,abs(self.vz)*getattr(self,"sweep_dt",.1)+9810*getattr(self,"sweep_dt",.1)**2+30),self.pos.x+140,self.pos.y+140,self.pos.z+190)
        self.near=[]
        for o in self.colliders:
            if not o.ViewObject.Visibility:continue
            sh=o.Shape.copy();sh.Placement=o.getGlobalPlacement()
            if region.intersect(sh.BoundBox):self.near.append((o,sh))

    def hit(self,shape):
        bb=shape.BoundBox
        for o,sh in self.near:
            if bb.intersect(sh.BoundBox) and shape.common(sh).Volume>1e-6:return o
        return None

    def body_at(self,p):
        sh=self.body.copy();sh.Placement=App.Placement(p,App.Rotation());return sh

    def leaf_at(self,p,index,angle):
        pose=App.Placement(p+V(0,0,self.joint_z),App.Rotation(V(0,0,1),index*120).multiply(App.Rotation(V(0,1,0),angle-90)))
        sh=self.leaf_shape.copy();sh.Placement=pose;return sh,pose

    def choose_leaves(self,p):
        chosen=[]
        for index in range(3):
            # Fold up toward the stem, retaining the widest collision-free angle.
            found=None
            for angle in range(int(min(80,self.angles[index]+5)),-1,-5):
                sh,pose=self.leaf_at(p,index,angle)
                if self.hit(sh) is None:found=float(angle);break
            if found is None:return None
            chosen.append(found)
        return chosen

    def place(self):
        pose=App.Placement(self.pos,App.Rotation())
        self.plug.Placement=pose;self.stem.Placement=pose
        for i,o in enumerate(self.leaves):
            sh,p=self.leaf_at(self.pos,i,self.angles[i]);o.Placement=p;o.AngleToStem=self.angles[i]

    def update(self):
        offset=float(animation_offset)
        if offset<self.last_offset-1e-9:self.reset()
        delta=offset-self.last_offset;self.last_offset=offset
        if not self.visibility() or delta<=0:return
        dt=min(0.5,delta*0.1)  # Existing timer: one offset unit per100 ms.
        self.elapsed+=dt;self.sweep_dt=dt
        if self.landed:
            self.pos.x=self.soil_x+moving_ground.last_travel-self.soil_travel
            self.pos.z=moving_ground.surface.getGlobalPlacement().Base.z-30-ROOT_BLOCK_DEPTH
            self.group.Stage='Planted in moving soil'
            self.scene()
            free_angles=self.choose_leaves(self.pos)
            if free_angles is not None:self.angles=free_angles
            self.place();return
        centre=self.tube_centre();top=centre.z+12;bottom=centre.z+6-CAROUSEL_TUBE_LENGTH
        oldpos=V(self.pos)
        if self.guided:
            self.pos.x=centre.x;self.pos.y=centre.y
        elif self.support is not None:
            if self.support.Name=='Flapper_disc_06':
                self.pos.x+=centre.x-self.last_tube.x;self.pos.y+=centre.y-self.last_tube.y
            elif self.support_anchor is not None:
                now=self.support.getGlobalPlacement().multVec(self.support_anchor)
                shift=now-self.support_point
                self.pos.x+=shift.x;self.pos.y+=shift.y;self.pos.z+=max(0,shift.z)
        self.last_tube=centre
        # Tube-wall contact constrains the plug's circumscribed footprint only.
        if bottom<=self.pos.z<=top:
            dx=self.pos.x-centre.x;dy=self.pos.y-centre.y;rr=math.hypot(dx,dy)
            limit=45-math.sqrt(2)*15-.2
            if rr>limit:self.pos.x=centre.x+dx*limit/rr;self.pos.y=centre.y+dy*limit/rr
        self.scene()
        waiting=(self.support is not None and self.support.Name=='Flapper_disc_06' and not self.support.Open)
        previous_support=self.support
        self.support=None;remaining=dt
        if waiting and self.hit(self.body_at(self.pos)) is None:
            self.support=previous_support;self.vz=0;remaining=0
        while remaining>1e-9:
            step=min(remaining,0.02,10.0/max(1.0,abs(self.vz)+200));remaining-=step
            self.vz-=self.group.Gravity*step
            dz=self.vz*step
            trial=self.pos+V(0,0,dz)
            if self.guided and trial.z<top-50:trial.z=top-50;dz=trial.z-self.pos.z
            floor=moving_ground.surface.getGlobalPlacement().Base.z
            trial.z=max(trial.z,floor-30-ROOT_BLOCK_DEPTH)
            dz=trial.z-self.pos.z
            obstacle=self.hit(self.body_at(trial))
            if obstacle is None:
                self.pos=trial
                if trial.z<=floor-30-ROOT_BLOCK_DEPTH+1e-9:
                    self.landed=True
                    self.soil_x=self.pos.x;self.soil_travel=moving_ground.last_travel;self.vz=0
                    self.group.Stage='Planted in moving soil';break
            else:
                lo=0.0;hi=1.0
                for _ in range(12):
                    fraction=(lo+hi)/2
                    if self.hit(self.body_at(self.pos+V(0,0,dz*fraction))) is None:lo=fraction
                    else:hi=fraction
                self.pos+=V(0,0,dz*lo)
                self.vz=0;self.support=obstacle;self.contact_count+=1
                # Allow a gravity-driven slide down inclined surfaces.
                for dx,dy in ((1.5,0),(-1.5,0),(0,1.5),(0,-1.5)):
                    slide=self.pos+V(dx,dy,-.4)
                    if self.hit(self.body_at(slide)) is None:
                        self.pos=slide;self.support=None;break
                break
            if self.guided and self.pos.z<=top-50:
                self.guided=False;self.group.Stage='Gravity drop / mechanism contact'
        angles=self.choose_leaves(self.pos)
        if angles is None:
            self.pos=oldpos;self.vz=0;self.landed=False;self.group.Contact='Leaf obstruction: holding position'
        else:
            self.angles=angles
            self.group.Contact=self.support.Label if self.support else ''
        if self.support is not None:
            self.support_anchor=self.support.getGlobalPlacement().inverse().multVec(self.pos)
            self.support_point=V(self.pos)
        else:self.support_anchor=None
        self.place()


if ROOT_BLOCK_DEPTH < 0 or SEEDLING_START_HEIGHT < 0:
    raise ValueError('Seedling start height and root-block depth must be non-negative.')
if ROOT_BLOCK_DEPTH == 10 and SEEDLING_START_HEIGHT == 200:
    seedling_drop=SeedlingDrop(doc)
else:
    seedling_drop=SeedlingGravityDrop(doc)
    App.Console.PrintMessage('Custom seedling dimensions: live contact solving enabled; animation may run slower.\n')
seedling_drop.group.addProperty('App::PropertyLength','RootBlockDepth','Dimensions')
seedling_drop.group.RootBlockDepth=ROOT_BLOCK_DEPTH
seedling_drop.group.addProperty('App::PropertyLength','StartHeightAboveDisc','Dimensions')
seedling_drop.group.StartHeightAboveDisc=SEEDLING_START_HEIGHT
seedling_drop.group.setEditorMode('RootBlockDepth',1)
seedling_drop.group.setEditorMode('StartHeightAboveDisc',1)
App.seedling_drop=seedling_drop

class SeedlingFlower:
    """Two reusable native shapes; animation changes link transforms only."""
    def __init__(self, document, seed):
        self.seed=seed
        self.growth_seconds=float(PLANT_GROWTH_RATE)
        if not math.isfinite(self.growth_seconds) or self.growth_seconds<=0:
            raise ValueError('PLANT_GROWTH_RATE must be a positive duration in seconds.')
        self.group=document.addObject('App::DocumentObjectGroup','SeedlingFlower')
        self.group.Label='Seedling yellow flower - 5 petals, diameter 50 mm'
        seed.group.addObject(self.group)
        for kind,name,value in (('App::PropertyLength','Diameter',50.0),
                                ('App::PropertyInteger','Petals',5),
                                ('App::PropertyFloat','GrowthSeconds',self.growth_seconds),
                                ('App::PropertyLength','StemExtension',60.0)):
            self.group.addProperty(kind,name,'Flower');setattr(self.group,name,value)
            self.group.setEditorMode(name,1)
        self.group.addProperty('App::PropertyFloat','GrowthFraction','Flower')
        self.group.setEditorMode('GrowthFraction',1)
        self.group.addProperty('App::PropertyString','Facing','Flower');self.group.Facing='Global +X'
        self.group.setEditorMode('Facing',1)
        def source(name,label,shape,colour):
            obj=document.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape
            obj.ViewObject.ShapeColor=colour;obj.ViewObject.Transparency=50
            obj.ViewObject.DisplayMode='Flat Lines';obj.ViewObject.LineColor=colour
            self.group.addObject(obj);obj.Visibility=False
            return obj
        self.stem_source=source('Seedling_flower_stem_source','Flower stem reference (hidden)',
                                Part.makeCylinder(1,60),(.15,.65,.15))
        petals=[]
        # Five coarse, flat petals lie in YZ. Tip radius 25 gives diameter 50.
        # The small centre projects toward +X, defining the front of the bloom.
        for i in range(5):
            angle=2*math.pi*i/5
            points=[]
            for radial,tangent in ((2,0),(13,-6.5),(25,0),(13,6.5),(2,0)):
                points.append(V(0,radial*math.cos(angle)-tangent*math.sin(angle),
                                  radial*math.sin(angle)+tangent*math.cos(angle)))
            petals.append(Part.Face(Part.makePolygon(points)).extrude(V(.8,0,0)))
        petals.append(Part.makeCylinder(3,1.2,V(0,0,0),V(1,0,0)))
        self.bloom_source=source('Seedling_flower_source','Five-petal flower reference (hidden)',
                                 Part.makeCompound(petals),(1.0,.85,.02))
        # Per-face colours preserve a single reusable bloom shape/link.
        # Compound order is five yellow petal solids followed by the orange centre.
        colours=[]
        for index,shape in enumerate(petals):
            colour=(1.0,.85,.02) if index<5 else (1.0,.40,.02)
            colours.extend([colour]*len(shape.Faces))
        self.bloom_source.ViewObject.DiffuseColor=colours
        def linked(name,label,original):
            obj=document.addObject('App::Link',name);obj.Label=label;obj.setLink(original)
            self.group.addObject(obj);obj.Visibility=False
            return obj
        self.stem=linked('Seedling_flower_stem','Growing flower stem',self.stem_source)
        self.bloom=linked('Seedling_yellow_flower','Yellow flower - 5 petals, diameter 50 mm',self.bloom_source)
        self.reset()

    def reset(self):
        self.landed_at=None;self.last_offset=float(animation_offset)
        self.stem.Visibility=False;self.bloom.Visibility=False
        self.group.GrowthFraction=0.0

    @staticmethod
    def smooth(value):
        t=max(0.0,min(1.0,value));return t*t*(3.0-2.0*t)

    def update(self):
        offset=float(animation_offset)
        if offset<self.last_offset or not self.seed.landed:self.reset()
        self.last_offset=offset
        if not (ANIMATE_SEEDLING_DROP and self.seed.group.Enabled and self.seed.landed):
            self.stem.Visibility=False;self.bloom.Visibility=False;return
        if self.landed_at is None:
            self.landed_at=(float(SEEDLING_SOIL_ANCHOR[0]) if isinstance(self.seed,SeedlingDrop) else offset)
        age=max(0.0,(offset-self.landed_at)*.1)
        # First two thirds grow the stem; final third opens the flower.
        stem_seconds=self.growth_seconds*2.0/3.0
        bloom_seconds=self.growth_seconds/3.0
        stalk=self.smooth(age/stem_seconds)
        bloom=self.smooth((age-stem_seconds)/bloom_seconds)
        base=self.seed.pos+V(0,0,self.seed.joint_z)
        self.stem.Placement=App.Placement(base,App.Rotation())
        self.bloom.Placement=App.Placement(base+V(0,0,60*stalk),App.Rotation())
        self.stem.ScaleVector=V(1,1,max(1e-5,stalk))
        self.bloom.Scale=max(1e-5,bloom)
        self.stem.Visibility=stalk>1e-6;self.bloom.Visibility=bloom>1e-6
        self.group.GrowthFraction=min(1.0,age/self.growth_seconds)


seedling_flower=SeedlingFlower(doc,seedling_drop)
App.seedling_flower=seedling_flower
doc.recompute()


