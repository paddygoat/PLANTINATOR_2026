    plate.EdgePreparation='Square 90 degree edge aligned with projected outer rail face; rounded rail corner remains clear'

bracket=doc.Closed_0deg_HorizontalTubeBracket
pose=bracket.Placement;old=bracket.Shape.copy();old.Placement=App.Placement();bounds=old.BoundBox
cylinders=[f.Surface for f in old.Faces if isinstance(f.Surface,Part.Cylinder)]
tube=next(c for c in cylinders if abs(c.Radius-9)<1e-6)
holes=sorted({round(c.Center.y,8) for c in cylinders if abs(c.Radius-5)<1e-6})
arm_y=tube.Center.y-9;arm_z=tube.Center.z
arm=Part.makeBox(6,69,24,V(-3,arm_y,arm_z-12))
arm=arm.makeFillet(6,[e for e in arm.Edges if abs(e.Length-6)<1e-7])
arm=arm.cut(Part.makeCylinder(9,8,V(-4,tube.Center.y,arm_z),V(1,0,0)))
arm=arm.cut(Part.makeBox(20,100,100,V(-10,bounds.YMin-100,arm_z-50)))
for y in holes[:-1]:arm=arm.cut(Part.makeCylinder(5,8,V(-4,y,arm_z+2),V(1,0,0)))
bracket.Shape=arm.removeSplitter();bracket.Placement=pose
bracket.Label=bracket.Label.replace('84 x 24 x 6','69 x 24 x 6').replace('four holes','three holes')
if 'ColourLabelOriginal' in bracket.PropertiesList:bracket.ColourLabelOriginal=bracket.ColourLabelOriginal.replace('84 x 24 x 6','69 x 24 x 6').replace('four holes','three holes')
for key,value in [('NominalLength',69),('HoleDiameter',10),('HolePitch',15)]:
    bracket.addProperty('App::PropertyLength',key,'Dimensions');setattr(bracket,key,value)
bracket.addProperty('App::PropertyInteger','HoleCount','Dimensions');bracket.HoleCount=3
doc.Duplicate_Closed_0deg_HorizontalTubeBracket.Label=bracket.Label+'_duplicate'
