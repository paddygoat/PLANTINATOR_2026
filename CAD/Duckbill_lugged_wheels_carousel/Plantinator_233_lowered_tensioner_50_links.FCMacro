def square_yellow_plate_ends_204(document):
    for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        stem=prefix+'YellowTensioner03';plate=document.getObject(stem+'SlottedPlate');rail=document.getObject(railname)
        pose=plate.Placement;bounds=plate.Shape.BoundBox;rb=rail.Shape.BoundBox
        end_y=rb.YMax+2 if prefix else rb.YMin-2
        ymin=end_y if prefix else bounds.YMin
        ymax=bounds.YMax if prefix else end_y
        local=Part.makeBox(130,ymax-ymin,6,V(-38,ymin-pose.Base.y,-36.2))
        direction=-1 if prefix else 1
        for y in (0,direction*40):
            slot=Part.makeCylinder(5.5,8,V(-26,y,-37.2)).fuse(Part.makeCylinder(5.5,8,V(80,y,-37.2))).fuse(Part.makeBox(106,11,8,V(-26,y-5.5,-37.2)))
            local=local.cut(slot)
        plate.Shape=local.removeSplitter();plate.Placement=pose;plate.Width=ymax-ymin;plate.RailExtension=plate.Width.Value-80
        plate.addProperty('App::PropertyLength','NominalWeldGap','Welding');plate.NominalWeldGap=2
        plate.addProperty('App::PropertyString','EdgePreparation','Welding');plate.EdgePreparation='Square 90 degree edge; gap measured from projected outside rail face'
    document.recompute()
