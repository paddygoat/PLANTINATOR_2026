# Version 203: centred 02 slots, rail-fitting extensions and vertical supports.
def add_yellow_rail_mounts_203(document):
    for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        rail=document.getObject(railname);rb=rail.Shape.BoundBox
        # Seat a 6 mm web beyond the R12 outside corner on the flat underside.
        end_y=rb.YMax-18 if prefix else rb.YMin+18
        for number in (2,3):
            stem=prefix+'YellowTensioner%02d'%number
            plate=document.getObject(stem+'SlottedPlate');saved=plate.Placement
            if number==2:
                saved.Base.x-=27
                plate.Placement=saved;plate.AdjustmentX=27
            bounds=plate.Shape.BoundBox
            extension=(bounds.YMin-end_y) if prefix else (end_y-bounds.YMax)
            ymin=end_y if prefix else bounds.YMin
            ymax=bounds.YMax if prefix else end_y
            local=Part.makeBox(130,ymax-ymin,6,V(-38,ymin-saved.Base.y,-36.2))
            direction=-1 if prefix else 1
            for y in (0,direction*40):
                slot=Part.makeCylinder(5.5,8,V(-26,y,-37.2)).fuse(Part.makeCylinder(5.5,8,V(80,y,-37.2))).fuse(Part.makeBox(106,11,8,V(-26,y-5.5,-37.2)))
                local=local.cut(slot)
            if number==3:
                cutter=rail.Shape.copy();cutter.Placement=saved.inverse().multiply(cutter.Placement)
                local=local.cut(cutter)
            plate.Shape=local.removeSplitter();plate.Placement=saved;plate.Width=ymax-ymin
            plate.addProperty('App::PropertyLength','RailExtension','Dimensions');plate.RailExtension=extension
            if number==2:
                z0=bounds.ZMax;z1=rb.ZMin
                support_y=end_y if prefix else end_y-6
                support=document.addObject('Part::Feature',stem+'VerticalRailSupport')
                support.Label='cyan_ID16_yellow_tensioner_02_vertical_rail_plate_6mm'+('_duplicate' if prefix else '')
                support.Shape=Part.makeBox(bounds.XLength,6,z1-z0,V(bounds.XMin,support_y,z0))
                support.ViewObject.ShapeColor=(0.0,1.0,1.0);support.ViewObject.Transparency=50
                for key,value in [('Length',bounds.XLength),('Thickness',6),('Height',z1-z0)]:
                    support.addProperty('App::PropertyLength',key,'Dimensions');setattr(support,key,value)
                document.getObject(stem+'SlottedMount').addObject(support)
                support.Visibility=plate.Visibility
    document.recompute()
add_yellow_rail_mounts_203(doc)

