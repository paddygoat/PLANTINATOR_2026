# L50x50x6, length190: explicit inside root radius6, in millimetres.
# Horizontal top bears against housing base; vertical leg is on inward Y side.
shaft_stub_angles=doc.addObject('App::DocumentObjectGroup','ShaftStubBearingAngles')
shaft_stub_angles.Label='cyan_ID30 pillow block mounting angles'
def make_bearing_angle():
    def p(y,z):return V(0,y,z)
    points=[p(0,0),p(50,0),p(50,-6),p(12,-6)]
    edges=[Part.makeLine(a,b) for a,b in zip(points,points[1:])]
    # Concave 90 degree root arc, tangent to both inner leg faces.
    edges.append(Part.Arc(p(12,-6),p(12-6/math.sqrt(2),-12+6/math.sqrt(2)),p(6,-12)).toShape())
    rest=[p(6,-12),p(6,-50),p(0,-50),p(0,0)]
    edges.extend(Part.makeLine(a,b) for a,b in zip(rest,rest[1:]))
    return Part.Face(Part.Wire(edges)).extrude(V(190,0,0))
for index in range(1,5):
    housing=doc.getObject('ShaftStubPlummerHousing%02d'%index)
    centre=housing.BearingCentre
    # Shafts01/03 on positiveY side of centre;02/04 on negativeY side.
    positive_side=index in (1,3)
    shape=make_bearing_angle()
    if not positive_side:
        # Mirror only Y, retaining downward legs and +X end alignment.
        shape=shape.mirror(V(0,0,0),V(0,1,0))
    origin=V(centre.x+47-190,centre.y-25 if positive_side else centre.y+25,centre.z-42.9)
    obj=doc.addObject('Part::Feature','ShaftStubBearingAngle%02d'%index)
    obj.Label='cyan_ID30 pillow block %02d - L50x50x6 mounting angle'%index
    # Two M14 clearance bores align with the housing's threaded mount holes.
    for dx in (-33.0,33.0):
        local=V(centre.x+dx-origin.x,centre.y-origin.y,-60)
        shape=shape.cut(Part.makeCylinder(7.5,70,local,V(0,0,1)))
    obj.Shape=shape.removeSplitter();obj.Placement=App.Placement(origin,App.Rotation())
    obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
    for key,value in [('LegWidth',50),('Thickness',6),('Length',190),('InsideRadius',6),('MountHoleDiameter',15),('MountHolePitch',66)]:
        obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
    obj.addProperty('App::PropertyLinkGlobal','Housing','Mounting');obj.Housing=housing
    shaft_stub_angles.addObject(obj)
doc.recompute()

# M14 studs preserve the catalogue's blind threaded housing holes.
# Threads are represented by nominal cylinders; dimensions in millimetres.
stubb_angle_fixings=doc.addObject('App::DocumentObjectGroup','ShaftStubAngleFixings')
stubb_angle_fixings.Label='grey_ID30 angle M14 studs washers and nuts'
def add_stubb_fixing(name,label,shape):
    obj=doc.addObject('Part::Feature',name);obj.Label='grey_'+label;obj.Shape=shape
    obj.ViewObject.ShapeColor=(0.65,0.67,0.70)
    obj.ViewObject.Transparency=0;stubb_angle_fixings.addObject(obj)
    return obj
for index in range(1,5):
    h=doc.getObject('ShaftStubPlummerHousing%02d'%index);c=h.BearingCentre
    base_z=c.z-42.9
    for j,dx in enumerate((-33.0,33.0),1):
        x,y=c.x+dx,c.y
        # 16 mm thread engagement, 24 mm below the housing base; overall40.
        stud=Part.makeCylinder(7,40,V(x,y,base_z+16),V(0,0,-1))
        obj=add_stubb_fixing('ShaftStubAngleStud%02d_%d'%(index,j),'ID30 angle %02d M14 stud %d'%(index,j),stud)
        for key,value in [('Diameter',14),('Length',40),('ThreadEngagement',16)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M14 coarse, nominal thread envelope (helix omitted)'
        washer_z=base_z-6-2.5
        washer=Part.makeCylinder(14,2.5,V(x,y,washer_z)).cut(Part.makeCylinder(7.5,2.5,V(x,y,washer_z)))
        add_stubb_fixing('ShaftStubAngleWasher%02d_%d'%(index,j),'ID30 angle %02d M14 washer %d'%(index,j),washer)
        nut_z=washer_z-12
        radius=22/math.sqrt(3)
        pts=[V(x+radius*math.cos(math.radians(30+60*k)),y+radius*math.sin(math.radians(30+60*k)),nut_z) for k in range(6)]
        pts.append(pts[0])
        nut=Part.Face(Part.makePolygon(pts)).extrude(V(0,0,12)).cut(Part.makeCylinder(7,12,V(x,y,nut_z)))
        obj=add_stubb_fixing('ShaftStubAngleNut%02d_%d'%(index,j),'ID30 angle %02d M14 nut %d'%(index,j),nut)
        obj.addProperty('App::PropertyLength','AcrossFlats','Dimensions');obj.AcrossFlats=22
        obj.addProperty('App::PropertyLength','Height','Dimensions');obj.Height=12
doc.recompute()

# Frame geometry from correct_frame_02.FCMacro, embedded as readable modelling
# code. Four finished parts; no dependency on its original FCStd repair source.
def add_corrected_frame_02(document):
    group=document.addObject('App::DocumentObjectGroup','CorrectedFrame02')
    group.Label='cyan_Corrected frame 02'
    def rounded_wire(size,radius):
        V=lambda x,y,z: App.Vector(z,x,y)
        s=size;r=radius
        def arc(x,y,a,b):
            def point(t):return V(x+r*math.cos(t),y+r*math.sin(t),0)
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([
            Part.makeLine(V(r,0,0),V(s-r,0,0)),arc(s-r,r,-math.pi/2,0),
            Part.makeLine(V(s,r,0),V(s,s-r,0)),arc(s-r,s-r,0,math.pi/2),
            Part.makeLine(V(s-r,s,0),V(r,s,0)),arc(r,s-r,math.pi/2,math.pi),
            Part.makeLine(V(0,s-r,0),V(0,r,0)),arc(r,r,math.pi,3*math.pi/2)])
    outer=Part.Face(rounded_wire(50,12))
    inner=Part.Face(rounded_wire(38,6));inner.translate(V(0,6,6))
    section=outer.cut(inner)
    tube=section.extrude(V(500,0,0))
    # Profile constructed directly in world YZ; extrusion runs along +X.
    cyan=document.UpperWheelPlummerPlate01_03.ViewObject.ShapeColor
    for name,label,shape,base in (
        ('Frame02Box01','cyan_50x50x6_box_01',tube.copy(),V(-29,-287,-93)),
        ('Frame02Box02','cyan_50x50x6_box_02',tube.copy(),V(-29,-794,-93)),
        ('Frame02Plate01','cyan_angle_plate_01',Part.makeBox(6,135,50),V(471,-879,-93)),
        ('Frame02Plate02','cyan_angle_plate_02',Part.makeBox(6,135,50),V(471,-287,-93))):
        obj=document.addObject('Part::Feature',name);obj.Label=label
        obj.Shape=shape;obj.Placement=App.Placement(base,App.Rotation())
        obj.ViewObject.ShapeColor=cyan;obj.ViewObject.Transparency=50
        obj.addProperty('App::PropertyString','SourceMacro','Frame');obj.SourceMacro='correct_frame_02.FCMacro, finished geometry reconstructed in plain Python'
        if 'Box' in name:
            dims=[('SectionSize',50),('WallThickness',6),('OutsideCornerRadius',12),('InsideCornerRadius',6),('Length',500)]
        else:dims=[('Length',135),('Height',50),('Thickness',6)]
        for key,value in dims:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        group.addObject(obj)
    document.recompute()
    return group
corrected_frame_02=add_corrected_frame_02(doc)

# Upright portal in rounded SHS50x50x6, R12/R6, with true 45-degree mitres.
def add_frame_portal(document):
    group=document.addObject('App::DocumentObjectGroup','Frame02MitredPortal')
    group.Label='cyan_Frame 02 mitred uprights and crossmember'
    def section(origin,u,v):
        def wire(size,r,offset):
            def p(x,y):return origin+u*(x+offset)+v*(y+offset)
            def arc(x,y,a,b):
                def point(t):return p(x+r*math.cos(t),y+r*math.sin(t))
                return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
            s=size
            return Part.Wire([Part.makeLine(p(r,0),p(s-r,0)),arc(s-r,r,-math.pi/2,0),
                Part.makeLine(p(s,r),p(s,s-r)),arc(s-r,s-r,0,math.pi/2),
                Part.makeLine(p(s-r,s),p(r,s)),arc(r,s-r,math.pi/2,math.pi),
                Part.makeLine(p(0,s-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
        return Part.Face(wire(50,12,0)).cut(Part.Face(wire(38,6,6)))
    rail1=document.Frame02Box01.Shape.BoundBox;rail2=document.Frame02Box02.Shape.BoundBox
    centre_x=rail1.XMin+150.0;x0=centre_x-25
    base_z=rail1.ZMax;top_z=base_z+210.0;beam_bottom=top_z-50
    outer_low=rail2.YMin;outer_high=rail1.YMax
    def prism(points):
        vertices=[V(x0-1,y,z) for y,z in points];vertices.append(vertices[0])
        return Part.Face(Part.makePolygon(vertices)).extrude(V(52,0,0))
    # Complementary planes slope one-to-one in Y/Z (45 degrees).
    upper1=prism([(rail1.YMin,base_z),(rail1.YMax,base_z),(rail1.YMax,top_z),(rail1.YMin,beam_bottom)])
    upper2=prism([(rail2.YMin,base_z),(rail2.YMax,base_z),(rail2.YMax,beam_bottom),(rail2.YMin,top_z)])
    beam_mask=prism([(outer_low,top_z),(outer_high,top_z),(outer_high-50,beam_bottom),(outer_low+50,beam_bottom)])
    upright1=section(V(x0,rail1.YMin,base_z),V(1,0,0),V(0,1,0)).extrude(V(0,0,210)).common(upper1)
    upright2=section(V(x0,rail2.YMin,base_z),V(1,0,0),V(0,1,0)).extrude(V(0,0,210)).common(upper2)
    beam=section(V(x0,outer_low,beam_bottom),V(1,0,0),V(0,0,1)).extrude(V(0,outer_high-outer_low,0)).common(beam_mask)
    for name,label,shape,count,length in (
        ('Frame02Upright01','cyan_50x50x6_upright_01',upright1,1,210),
        ('Frame02Upright02','cyan_50x50x6_upright_02',upright2,1,210),
        ('Frame02TopCrossmember','cyan_50x50x6_top_crossmember',beam,2,outer_high-outer_low)):
        obj=document.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape.removeSplitter()
        obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
        for key,value in [('SectionSize',50),('WallThickness',6),('OutsideCornerRadius',12),('InsideCornerRadius',6),('LongPointLength',length),('UprightCentreFromFreeEnd',150)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyAngle','MitreAngle','Dimensions');obj.MitreAngle=45
        obj.addProperty('App::PropertyInteger','MitredEnds','Dimensions');obj.MitredEnds=count
        group.addObject(obj)
    document.recompute()
    return group
frame_02_portal=add_frame_portal(doc)

# Opposite-side duplicate mounting across arm two's centre plane.
# Mirror native local geometry and conjugate rotations; source parts are unchanged.
class DuplicateOppositeSideDrive:
    def __init__(self,document,mechanism):
        self.doc=document;self.mechanism=mechanism;self.items=[]
        self.plane_y=document.Duplicate_duck_bill_arm_two.LinkPlacement.Base.y
        names=set()
        for group_name in ('DuplicateDuckBillOrangeDrive','DuplicateDuckBillMaster','DuplicateDuckBillSlider'):
            names.update(o.Name for o in document.getObject(group_name).Group)
        names.update('Duplicate_'+n for n in ('Sprocket_21T_Shaft','duck_bill_arm_three','duck_bill_arm_one_shaft','duck_bill_arm_one','duck_bill_arm_three_end_shaft','duck_bill_arm_one_pin','MasterHoseAdapter'))
        selected=[p for p in mechanism.pairs if p[1].Name in names]
        mechanism.pairs=[p for p in mechanism.pairs if p[1].Name not in names]
        for source,old,ancestors in selected:
            name,label=old.Name,old.Label
            parents=[o for o in old.InList if 'Group' in o.PropertiesList and old in o.Group]
            document.removeObject(name)
            obj=document.addObject('Part::Feature',name);obj.Label=label
            obj.ViewObject.ShapeColor=source.ViewObject.ShapeColor
            obj.ViewObject.LineColor=source.ViewObject.LineColor
            obj.ViewObject.Transparency=source.ViewObject.Transparency
            obj.addProperty('App::PropertyLinkHidden','MotionDriver','Motion');obj.MotionDriver=source
            for parent in parents:parent.addObject(obj)
            self.items.append([source,obj,ancestors,None])
        self.state=document.addObject('App::FeaturePython','DuplicateOppositeSideDrive')
        self.state.Label='Duplicate drive - opposite side of arm two'
        self.state.addProperty('App::PropertyDistance','MirrorPlaneY','Mounting');self.state.MirrorPlaneY=self.plane_y
        self.state.addProperty('App::PropertyLinkListGlobal','MovedParts','Mounting');self.state.MovedParts=[i[1] for i in self.items]
        self.update()
    def reflect_point(self,p):return V(p.x,2*self.plane_y-p.y,p.z)
    def reflect_vector(self,p):return V(p.x,-p.y,p.z)
    def update(self):
        for item in self.items:
            source,obj,ancestors,old_hash=item
            shape=source.Shape.copy();shape.Placement=App.Placement()
            code=shape.hashCode()
            if code!=old_hash:
                obj.Shape=shape.mirror(V(0,0,0),V(0,1,0));item[3]=code
            pose=self.mechanism.translation.multiply(source.getGlobalPlacement())
            matrix=pose.Rotation.toMatrix()
            # M R M is a proper rotation for M=diag(1,-1,1).
            matrix.A12=-matrix.A12;matrix.A21=-matrix.A21
            matrix.A23=-matrix.A23;matrix.A32=-matrix.A32
            obj.Placement=App.Placement(self.reflect_point(pose.Base),App.Rotation(matrix))
            obj.Visibility=(not HIDE_DUPLICATE_DUCK_BILL_MECH and source.Visibility and all(p.Visibility for p in ancestors))

duplicate_opposite_side_drive=DuplicateOppositeSideDrive(doc,duplicate_duck_bill_mech)
App.duplicate_opposite_side_drive=duplicate_opposite_side_drive
duplicate_duck_bill_mech.update()
# Keep the portal as a rigid three-part unit; translate +15 mm X only.
for obj in doc.Frame02MitredPortal.Group:
    placement=obj.Placement;placement.Base=placement.Base+V(15,0,0);obj.Placement=placement
doc.recompute()

# Version 183: paired inverted UCPA/SNP20 units on both arm-one drive shafts.
# Catalogue controls the envelope and mounting dimensions. Unspecified cast
# contours, seal details, grease fitting and screw threads are simplified.
class ArmOnePlummerBlocks:
    def __init__(self, document):
        self.document=document
        self.units=[]
        self.group=document.addObject('App::DocumentObjectGroup','ArmOnePlummerBlocks')
        self.group.Label='magenta_Arm one shaft inverted UCPA20 plummer blocks'
        base=Part.makeBox(76,40,11,V(-38,-20,-30.2))
        outline=[V(-38,-12,-19.2),V(-25,-12,0),V(-20,-12,15),
                 V(0,-12,25),V(20,-12,15),V(25,-12,0),V(38,-12,-19.2)]
        web=Part.Face(Part.makePolygon(outline+[outline[0]])).extrude(V(0,24,0))
        housing=base.fuse(web).fuse(Part.makeCylinder(25,24,V(0,-12,0),V(0,1,0)))
        housing=housing.cut(Part.makeCylinder(20,42,V(0,-21,0),V(0,1,0)))
        for x in (-26,26):
            housing=housing.cut(Part.makeCylinder(5,13,V(x,0,-30.2),V(0,0,1)))
        housing=housing.removeSplitter()
        race=Part.makeCylinder(20,24,V(0,-12,0),V(0,1,0)).cut(
             Part.makeCylinder(13,24,V(0,-12,0),V(0,1,0)))
        insert=Part.makeCylinder(13,31,V(0,-12.7,0),V(0,1,0)).cut(
               Part.makeCylinder(10,31,V(0,-12.7,0),V(0,1,0)))
        direction=V(1,0,1);direction.normalize()
        # 45-degree grease fitting, overall height w=62 from mounting face.
        nipple=Part.makeCylinder(2.5,23,V(0,0,0)+direction*24,direction)
        nipple=nipple.common(Part.makeBox(100,100,100,V(-50,-50,-68.2)))
        for suffix,outward_offset in (('',0.0),('_duplicate',0.0),('_outward',56.0),('_duplicate_outward',56.0)):
            prefix='Duplicate_' if suffix.startswith('_duplicate') else ''
            shaft=document.getObject(prefix+'duck_bill_arm_one_shaft')
            orange=document.getObject(prefix+'sprocket_16T_01')
            yellow=document.getObject(prefix+'sprocket_10T_02')
            group=document.addObject('App::DocumentObjectGroup','ArmOnePlummerUnit'+suffix)
            group.Label='magenta_UCPA20_arm_one'+suffix
            self.group.addObject(group)
            for key,value in [('BoreDiameter',20),('CentreHeight',30.2),('BaseWidth',76),
                              ('BaseDepth',40),('BoltCentres',52),('BaseThickness',11),
                              ('OverallHeight',62),('MountHoleDepth',13),('InsertWidth',31),
                              ('FaceToCentre',12.7),('OrangeSprocketGap',5+outward_offset),
                              ('OutwardOffset',outward_offset)]:
                group.addProperty('App::PropertyLength',key,'Catalogue');setattr(group,key,value)
            group.addProperty('App::PropertyString','MountingThread','Catalogue')
            group.MountingThread='2 x M10 blind tapped holes, depth 13 mm (threads simplified)'
            group.addProperty('App::PropertyString','GeometryNotes','Catalogue')
            group.GeometryNotes='UCPA / SNP20; specified dimensions exact; unspecified cast contours and internal bearing details approximate.'
            group.addProperty('App::PropertyLinkGlobal','Shaft','Mounting');group.Shaft=shaft
            group.addProperty('App::PropertyLinkGlobal','OrangeSprocket','Mounting');group.OrangeSprocket=orange
            group.addProperty('App::PropertyLinkGlobal','YellowSprocket','Mounting');group.YellowSprocket=yellow
            group.addProperty('App::PropertyVector','BearingCentre','Mounting')
            fixed=[];moving=[]
            def add(key,shape,colour,rotating=False):
                obj=document.addObject('Part::Feature','ArmOnePlummer'+key+suffix)
                obj.Label=('magenta_' if key=='Housing' else 'grey_')+'UCPA20_'+key+suffix
                obj.Shape=shape.copy();obj.ViewObject.ShapeColor=colour
                group.addObject(obj)
                (moving if rotating else fixed).append(obj)
                return obj
            add('Housing',housing,(1.0,0.0,1.0))
            add('SealedRace',race,(0.22,0.24,0.26))
            add('Insert',insert,(0.72,0.74,0.77),True)
            add('GreaseNipple',nipple,(0.8,0.8,0.82))
            for j,angle in enumerate((0,120),1):
                radial=V(math.sin(math.radians(angle)),0,math.cos(math.radians(angle)))
                screw=Part.makeCylinder(2,3,V(0,15,0)+radial*10,radial)
                add('GrubScrew%d'%j,screw,(0.3,0.3,0.32),True)
            self.units.append((group,shaft,orange,yellow,fixed,moving,shaft.getGlobalPlacement().Rotation))
        self.update()

    @staticmethod
    def world_shape(obj):
        shape=obj.Shape.copy()
        pose=obj.LinkPlacement if obj.TypeId=='App::Link' else obj.getGlobalPlacement()
        shape.Placement=pose.multiply(obj.Placement.inverse()).multiply(shape.Placement)
        return shape

    def update(self):
        for group,shaft,orange,yellow,fixed,moving,rest_rotation in self.units:
            orange_box=self.world_shape(orange).BoundBox
            yellow_box=self.world_shape(yellow).BoundBox
            shaft_box=self.world_shape(shaft).BoundBox
            toward=1 if yellow_box.Center.y>orange_box.Center.y else -1
            orange_face=orange_box.YMax if toward>0 else orange_box.YMin
            centre=V(shaft_box.Center.x,orange_face+toward*(5+40/2+group.OutwardOffset.Value),shaft_box.Center.z)
            far_face=centre.y+toward*20
            yellow_face=yellow_box.YMin if toward>0 else yellow_box.YMax
            if toward*(yellow_face-far_face)<-1e-6:
                raise ValueError('UCPA20 does not fit between the arm-one sprockets')
            if centre.y-20<shaft_box.YMin-1e-6 or centre.y+20>shaft_box.YMax+1e-6:
                raise ValueError('UCPA20 bearing lies beyond arm-one shaft')
            group.BearingCentre=centre
            pose=App.Placement(centre,App.Rotation(V(1,0,0),180))
            for obj in fixed:obj.Placement=pose
            rotation=shaft.getGlobalPlacement().Rotation.multiply(rest_rotation.inverted())
            for obj in moving:obj.Placement=App.Placement(centre,rotation.multiply(pose.Rotation))
            for obj in fixed+moving:obj.Visibility=(not HIDE_DUPLICATE_DUCK_BILL_MECH or not shaft.Name.startswith('Duplicate_'))

arm_one_plummer_blocks=ArmOnePlummerBlocks(doc)
App.arm_one_plummer_blocks=arm_one_plummer_blocks
doc.recompute()

# Version 185: 6 mm bridge plates and M10 hardware for both UCPA20 pairs.
class ArmOnePlummerMounts:
    def __init__(self, document):
        self.items=[]
        self.group=document.addObject('App::DocumentObjectGroup','ArmOnePlummerMounts')
        self.group.Label='cyan_Arm one plummer mounting plates and M10 hardware'
        for suffix in ('','_duplicate'):
            first=document.getObject('ArmOnePlummerHousing'+suffix)
            second=document.getObject('ArmOnePlummerHousing'+suffix+'_outward')
            boxes=[obj.Shape.BoundBox for obj in (first,second)]
            xmin=min(b.XMin for b in boxes);xmax=max(b.XMax for b in boxes)
            ymin=min(b.YMin for b in boxes);ymax=max(b.YMax for b in boxes)
            top=boxes[0].ZMax
            assert abs(top-boxes[1].ZMax)<1e-6
            origin=V(xmin,ymin,top)
            centres=[(b.Center.x+dx-xmin,b.Center.y-ymin) for b in boxes for dx in (-26,26)]
            group=document.addObject('App::DocumentObjectGroup','ArmOnePlummerMount'+suffix)
            group.Label='cyan_UCPA20_pair_mount'+suffix;self.group.addObject(group)
            objects=[]
            def feature(name,label,shape,colour):
                obj=document.addObject('Part::Feature',name+suffix);obj.Label=label+suffix
                obj.Shape=shape;obj.Placement=App.Placement(origin,App.Rotation())
                obj.ViewObject.ShapeColor=colour;group.addObject(obj);objects.append(obj)
                return obj
            plate=Part.makeBox(xmax-xmin,ymax-ymin,6)
            for x,y in centres:plate=plate.cut(Part.makeCylinder(5.5,8,V(x,y,-1)))
            obj=feature('ArmOnePlummerMountPlate','cyan_UCPA20_pair_mounting_plate_6mm',plate,(0.0,1.0,1.0))
            for key,value in [('Thickness',6),('Width',xmax-xmin),('Length',ymax-ymin),('HoleDiameter',11),('HolePitchX',52),('HolePitchY',56)]:
                obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
            for index,(x,y) in enumerate(centres,1):
                # M10 x 30 reference stud: 12 mm engagement in 13 mm blind hole.
                stud=Part.makeCylinder(5,30,V(x,y,-12))
                obj=feature('ArmOnePlummerStud%02d'%index,'grey_UCPA20_M10x30_stud_%02d'%index,stud,(.65,.67,.7))
                for key,value in [('Diameter',10),('Length',30),('HousingEngagement',12)]:
                    obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; simplified nominal cylinder, no helical thread'
                washer=Part.makeCylinder(10,2,V(x,y,6)).cut(Part.makeCylinder(5.5,2,V(x,y,6)))
                feature('ArmOnePlummerWasher%02d'%index,'grey_UCPA20_M10_washer_%02d'%index,washer,(.75,.77,.8))
                radius=17/math.sqrt(3)
                points=[V(x+radius*math.cos(math.radians(30+60*j)),y+radius*math.sin(math.radians(30+60*j)),8) for j in range(6)]
                nut=Part.Face(Part.makePolygon(points+[points[0]])).extrude(V(0,0,8))
                nut=nut.cut(Part.makeCylinder(5,8,V(x,y,8)))
                obj=feature('ArmOnePlummerNut%02d'%index,'grey_UCPA20_M10_nut_%02d'%index,nut,(.7,.72,.75))
                for key,value in [('AcrossFlats',17),('Height',8)]:
                    obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; thread simplified'
            self.items.append((first,first.Placement.Base,origin,objects))
        self.update()
    def update(self):
        for housing,rest,origin,objects in self.items:
            for obj in objects:
                obj.Placement=App.Placement(origin+housing.Placement.Base-rest,App.Rotation())
                obj.Visibility=housing.Visibility

arm_one_plummer_mounts=ArmOnePlummerMounts(doc)
App.arm_one_plummer_mounts=arm_one_plummer_mounts
for unit in doc.ArmOnePlummerBlocks.Group:
    for obj in unit.Group:obj.ViewObject.Transparency=50
doc.SoilSurface.ViewObject.Transparency=0
for obj in doc.Objects:
    if obj.Name.startswith('SoilTile_'):obj.ViewObject.Transparency=0
doc.recompute()

# Version 186: OD40 x 3 pipe braces; 105.8 mm upright centreline height.
def add_arm_one_pipe_supports(document):
    group=document.addObject('App::DocumentObjectGroup','ArmOnePipeSupports')
    group.Label='cyan_Arm one OD40x3 mitred pipe supports'
    beam=document.Frame02TopCrossmember.Shape
    frame=beam.fuse(document.Frame02Upright01.Shape).fuse(document.Frame02Upright02.Shape)
    beam_box=beam.BoundBox
    target_z=(beam_box.ZMin+beam_box.ZMax)/2
    for suffix in ('','_duplicate'):
        plate=document.getObject('ArmOnePlummerMountPlate'+suffix)
        plate.ViewObject.Transparency=50
        box=plate.Shape.BoundBox
        cx,cy,z0=box.Center.x,box.Center.y,box.ZMax
        height=target_z-z0
        run=beam_box.XMin-cx
        # Work in global coordinates; two complementary half-spaces make
        # an exact 45-degree butt joint at the centreline intersection.
        def prism(points):
            verts=[V(cx+x,cy-30,z0+z) for x,z in points]
            return Part.Face(Part.makePolygon(verts+[verts[0]])).extrude(V(0,60,0))
        lower=prism([(-30,-1),(run+30,-1),(run+30,height-run-30),(-30,height+30)])
        upper=prism([(-30,height+30),(run+30,height-run-30),(run+30,height+40),(-30,height+40)])
        upright=Part.makeCylinder(20,height+21,V(cx,cy,z0)).cut(Part.makeCylinder(17,height+23,V(cx,cy,z0-1)))
        upright=upright.common(lower).removeSplitter()
        # Extend beyond the nominal plane, then trim to the actual rounded
        # crossmember/upright surfaces. Keep only the elbow-connected solid.
        horizontal=Part.makeCylinder(20,run+45,V(cx-21,cy,target_z),V(1,0,0))
        horizontal=horizontal.cut(Part.makeCylinder(17,run+47,V(cx-22,cy,target_z),V(1,0,0)))
        horizontal=horizontal.common(upper).cut(frame)
        candidates=[s for s in horizontal.Solids if s.BoundBox.XMin<cx]
        if len(candidates)!=1:raise RuntimeError('Expected one elbow-connected horizontal pipe')
        horizontal=candidates[0].removeSplitter()
        for name,label,shape,axis,length in (
            ('ArmOnePipeUpright','cyan_R20x3_upright_pipe',upright,V(0,0,1),height),
            ('ArmOnePipeHorizontal','cyan_R20x3_horizontal_pipe',horizontal,V(1,0,0),run)):
            obj=document.addObject('Part::Feature',name+suffix);obj.Label=label+suffix;obj.Shape=shape
            obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
            group.addObject(obj)
            for key,value in [('OutsideRadius',20),('WallThickness',3),('CentrelineLength',length)]:
                obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
            obj.addProperty('App::PropertyAngle','MitreAngle','Dimensions');obj.MitreAngle=45
            obj.addProperty('App::PropertyVector','AxisDirection','Dimensions');obj.AxisDirection=axis
            obj.addProperty('App::PropertyString','EndDetail','Dimensions')
            obj.EndDetail='45 degree elbow mitre; '+('square foot on plate; centreline length excludes 20 mm mitre long point' if name.endswith('Upright') else 'frame end trimmed to actual crossmember and upright outer surfaces')
    document.recompute()
    return group
arm_one_pipe_supports=add_arm_one_pipe_supports(doc)

# Version 188, based on version 186: matching arm-three axial adjustments on both sides.
# Keep the connecting plates, end pins and orange drives at v186 poses.
class ArmThreeAxialAdjustment188:
    def __init__(self, document):
        self.arm=document.duck_bill_arm_three
        self.shaft=document.Sprocket_21T_Shaft
        connector=document.duck_bill_connecting_plate
        self.offset=connector.Shape.BoundBox.YMin-self.arm.Shape.BoundBox.YMax
        self.original_shape=self.shaft.Shape.copy();self.original_shape.Placement=App.Placement()
        self.original_length=self.shaft.Length.Value
        pose=self.shaft.getGlobalPlacement()
        bounds=self.shaft.Shape.BoundBox
        # Finish the shaft flush with the arm/connector mating face.
        # This avoids carrying the old 1.875 mm overhang into the connector.
        self.extension_length=connector.Shape.BoundBox.YMin-bounds.YMax
        extension=Part.makeCylinder(10,self.extension_length,V(bounds.Center.x,bounds.YMax,bounds.Center.z),V(0,1,0))
        extension.Placement=pose.inverse().multiply(extension.Placement)
        self.extended_shape=self.original_shape.fuse(extension).removeSplitter()
        if not self.extended_shape.isValid() or len(self.extended_shape.Solids)!=1:
            raise RuntimeError('Invalid extended arm-three drive shaft')
        self.duplicate_arm=document.Duplicate_duck_bill_arm_three
        self.duplicate_shaft=document.Duplicate_Sprocket_21T_Shaft
        self.duplicate_original_shape=self.duplicate_shaft.Shape.copy();self.duplicate_original_shape.Placement=App.Placement()
        self.duplicate_extended_shape=self.extended_shape.mirror(V(0,0,0),V(0,1,0))
        if 'Length' not in self.duplicate_shaft.PropertiesList:
            self.duplicate_shaft.addProperty('App::PropertyLength','Length','Dimensions')
        self.duplicate_arm.addProperty('App::PropertyDistance','AxialShift188','Dimensions');self.duplicate_arm.AxialShift188=-self.offset
        self.saved_duplicate_pose=None
        self.saved_arm_pose=None
        self.shaft.Label='blue_16T sprocket shaft (OD20 x %g mm)'%(self.original_length+self.extension_length)
        self.duplicate_shaft.Label=self.shaft.Label+'_duplicate'
        self.arm.addProperty('App::PropertyDistance','AxialShift188','Dimensions');self.arm.AxialShift188=self.offset
        self.apply()
    def set_shaft(self,shape,length):
        pose=self.shaft.Placement
        self.shaft.Shape=shape.copy();self.shaft.Placement=pose;self.shaft.Length=length
    def set_duplicate_shaft(self,shape,length):
        pose=self.duplicate_shaft.Placement
        self.duplicate_shaft.Shape=shape.copy();self.duplicate_shaft.Placement=pose;self.duplicate_shaft.Length=length
    def restore(self):
        if self.saved_arm_pose is not None:
            self.arm.Placement=self.saved_arm_pose;self.saved_arm_pose=None
            self.set_shaft(self.original_shape,self.original_length)
            self.duplicate_arm.Placement=self.saved_duplicate_pose;self.saved_duplicate_pose=None
            self.set_duplicate_shaft(self.duplicate_original_shape,self.original_length)
    def apply(self):
        self.restore()
        self.saved_arm_pose=self.arm.Placement
        world=self.arm.getGlobalPlacement()
        parent=world.multiply(self.arm.Placement.inverse())
        world.Base=world.Base+V(0,self.offset,0)
        self.arm.Placement=parent.inverse().multiply(world)
        self.set_shaft(self.extended_shape,self.original_length+self.extension_length)
        self.saved_duplicate_pose=self.duplicate_arm.Placement
        pose=self.duplicate_arm.Placement;pose.Base=pose.Base-V(0,self.offset,0)
        self.duplicate_arm.Placement=pose
        self.set_duplicate_shaft(self.duplicate_extended_shape,self.original_length+self.extension_length)

arm_three_axial_188=ArmThreeAxialAdjustment188(doc)
App.arm_three_axial_188=arm_three_axial_188
doc.recompute()

# Version 189: mirrored drive/master offsets, flush pins and cam-shaft bearings.
class CamShaftRevision189:
    def __init__(self,document):
        self.doc=document;self.saved=[];self.shafts=[];self.bearings=[]
        self.group=document.addObject('App::DocumentObjectGroup','CamShaftPlummerBlocks')
        self.group.Label='magenta_Upright ID20 cam shaft plummer blocks'
        def local_shape(obj):
            s=obj.Shape.copy();s.Placement=App.Placement();return s
        for prefix in ('','Duplicate_'):
            shaft=document.getObject(prefix+'Sprocket_21T_Shaft');pose=shaft.getGlobalPlacement()
            direction=1 if prefix else -1
            original=local_shape(shaft);bounds=shaft.Shape.BoundBox
            start=V(pose.Base.x,bounds.YMax if prefix else bounds.YMin,pose.Base.z)
            extension=Part.makeCylinder(10,50,start,V(0,direction,0))
            extension.Placement=pose.inverse().multiply(extension.Placement)
            extended=original.fuse(extension).removeSplitter()
            self.shafts.append((shaft,original,extended))
            shaft.Label='blue_16T sprocket shaft (OD20 x 130.875 mm)'+('_duplicate' if prefix else '')
            unit=document.addObject('App::DocumentObjectGroup',prefix+'CamShaftPlummerUnit')
            unit.Label='magenta_UCPA20_cam_shaft'+('_duplicate' if prefix else '')
            self.group.addObject(unit)
            for key,value in [('BoreDiameter',20),('CentreHeight',30.2),('BaseWidth',76),('BaseDepth',40),('BoltCentres',52),('BaseThickness',11),('OverallHeight',62),('MountHoleDepth',13),('InsertWidth',31),('FaceToCentre',12.7)]:
                unit.addProperty('App::PropertyLength',key,'Catalogue');setattr(unit,key,value)
            unit.addProperty('App::PropertyString','MountingThread','Catalogue');unit.MountingThread='2 x M10 blind holes, 13 mm deep; threads simplified'
            unit.addProperty('App::PropertyVector','BearingCentre','Mounting')
            fixed=[];moving=[]
            for key in ('Housing','SealedRace','Insert','GreaseNipple','GrubScrew1','GrubScrew2'):
                ref=document.getObject('ArmOnePlummer'+key)
                obj=document.addObject('Part::Feature',prefix+'CamShaftPlummer'+key)
                obj.Label=('magenta_' if key=='Housing' else 'grey_')+'UCPA20_cam_shaft_'+key+('_duplicate' if prefix else '')
                obj.Shape=local_shape(ref);obj.ViewObject.ShapeColor=ref.ViewObject.ShapeColor;obj.ViewObject.Transparency=50
                unit.addObject(obj)
                (moving if key in ('Insert','GrubScrew1','GrubScrew2') else fixed).append(obj)
            self.bearings.append((prefix,shaft,unit,fixed,moving,pose.Rotation))
        self.apply()
    @staticmethod
    def world(obj):
        return obj.LinkPlacement if obj.TypeId=='App::Link' else obj.getGlobalPlacement()
    @classmethod
    def world_shape(cls,obj):
        s=obj.Shape.copy();s.Placement=cls.world(obj).multiply(obj.Placement.inverse()).multiply(s.Placement);return s
    @staticmethod
    def set_shape(obj,shape):
        pose=obj.Placement;obj.Shape=shape.copy();obj.Placement=pose
    def move(self,obj,dy):
        self.saved.append((obj,obj.Placement))
        world=self.world(obj);parent=world.multiply(obj.Placement.inverse());world.Base+=V(0,dy,0)
        obj.Placement=parent.inverse().multiply(world)
    @staticmethod
    def leaves(obj):
        if obj.isDerivedFrom('Part::Feature'):return [obj]
        result=[]
        for child in getattr(obj,'Group',[]):result.extend(CamShaftRevision189.leaves(child))
        return result
    def restore(self):
        for obj,pose in reversed(self.saved):obj.Placement=pose
        self.saved=[]
        for shaft,original,extended in self.shafts:
            self.set_shape(shaft,original);shaft.Length=80.875
    def apply(self):
        self.restore()
        for prefix in ('','Duplicate_'):
            outward=1 if prefix else -1
            # Preserve pin lengths; place the outward end at the arm's outer face.
            for pin_name,arm_name in (('duck_bill_arm_one_pin','duck_bill_arm_one'),('duck_bill_arm_three_end_shaft','duck_bill_arm_three')):
                pin=self.doc.getObject(prefix+pin_name);arm=self.doc.getObject(prefix+arm_name)
                pb=self.world_shape(pin).BoundBox;ab=self.world_shape(arm).BoundBox
                self.move(pin,(ab.YMax-pb.YMax) if prefix else (ab.YMin-pb.YMin))
            drive=[self.doc.getObject(prefix+n) for n in ('sprocket_16T_01','sprocket_15T_tensioner_01','sprocket_16T_03')]
            drive += [o for o in self.doc.Objects if o.Name.startswith(prefix+'ChainLink_')]
            for obj in drive:self.move(obj,-outward*20)
            # Shift the smooth cam and its retained, hidden original disc set.
            cams=[self.doc.getObject(prefix+'sprocket_16T_smooth_cam_disc')]
            cams += [self.doc.getObject(prefix+'sprocket_16T_shaft_disc')]
            cams += [o for o in self.doc.Objects if o.Name.startswith(prefix+'sprocket_16T_rim_disc')]
            for obj in cams:self.move(obj,outward*50)
            if prefix:
                master=self.leaves(self.doc.DuplicateDuckBillMaster)
                slider=self.leaves(self.doc.DuplicateDuckBillSlider)
            else:
                master=[self.doc.WilwoodReferenceParts]
                slider=self.leaves(self.doc.MasterCamSlider)
            for obj in master+slider:self.move(obj,outward*50)
            if prefix:self.move(self.doc.Duplicate_MasterHoseAdapter,outward*50)
        for shaft,original,extended in self.shafts:
            self.set_shape(shaft,extended);shaft.Length=130.875
        for prefix,shaft,unit,fixed,moving,rest_rotation in self.bearings:
            sb=self.world_shape(self.doc.getObject(prefix+'sprocket_16T_03')).BoundBox
            cb=self.world_shape(self.doc.getObject(prefix+'sprocket_16T_smooth_cam_disc')).BoundBox
            axis=shaft.getGlobalPlacement().Base
            centre=V(axis.x,(sb.YMax+cb.YMin)/2 if prefix else (cb.YMax+sb.YMin)/2,axis.z)
            unit.BearingCentre=centre
            for obj in fixed:obj.Placement=App.Placement(centre,App.Rotation())
            rotation=shaft.getGlobalPlacement().Rotation.multiply(rest_rotation.inverted())
            for obj in moving:obj.Placement=App.Placement(centre,rotation)
            for obj in fixed+moving:obj.Visibility=(not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH)
        # Existing hose solvers preserve the moving slave ports and hose length.
        flexible_hydraulic_hose.update()
        duplicate_hydraulic_hose.update()

cam_shaft_revision_189=CamShaftRevision189(doc)
App.cam_shaft_revision_189=cam_shaft_revision_189
doc.recompute()

# Version 190: touching pairs of cam-shaft UCPA20 units and underside plates.
class CamShaftBearingPairs190:
    def __init__(self,document):
        self.doc=document;self.units=[]
        self.group=document.addObject('App::DocumentObjectGroup','CamShaftBearingPairMounts')
        self.group.Label='cyan_Cam shaft bearing pair plates and M10 hardware'
        for prefix in ('','Duplicate_'):
            shaft=document.getObject(prefix+'Sprocket_21T_Shaft')
            original=document.getObject(prefix+'CamShaftPlummerUnit')
            inner=document.addObject('App::DocumentObjectGroup',prefix+'CamShaftPlummerUnitInward')
            inner.Label='magenta_UCPA20_cam_shaft_inward'+('_duplicate' if prefix else '')
            document.CamShaftPlummerBlocks.addObject(inner)
            for prop in original.PropertiesList:
                if original.getGroupOfProperty(prop) in ('Catalogue','Mounting'):
                    inner.addProperty(original.getTypeIdOfProperty(prop),prop,original.getGroupOfProperty(prop))
                    setattr(inner,prop,getattr(original,prop))
            inner.addProperty('App::PropertyAngle','RotationZ','Mounting');inner.RotationZ=180
            clones=[]
            for obj in original.Group:
                copy=document.addObject('Part::Feature',obj.Name+'Inward')
                copy.Label=obj.Label+'_inward';shape=obj.Shape.copy();shape.Placement=App.Placement();copy.Shape=shape
                copy.ViewObject.ShapeColor=obj.ViewObject.ShapeColor;copy.ViewObject.Transparency=50
                inner.addObject(copy);clones.append((obj,copy))
            mount=document.addObject('App::DocumentObjectGroup',prefix+'CamShaftPairMount')
            mount.Label='cyan_Cam_shaft_pair_mount'+('_duplicate' if prefix else '')
            self.group.addObject(mount)
            hardware=[]
            def add(name,label,shape,colour):
                obj=document.addObject('Part::Feature',prefix+name);obj.Label=label+('_duplicate' if prefix else '')
                obj.Shape=shape;obj.ViewObject.ShapeColor=colour;mount.addObject(obj);hardware.append(obj);return obj
            centres=[(x,y) for y in (20,60) for x in (12,64)]
            plate=Part.makeBox(76,80,6,V(0,0,-6))
            for x,y in centres:plate=plate.cut(Part.makeCylinder(5.5,8,V(x,y,-7)))
            obj=add('CamShaftPairPlate','cyan_Cam_shaft_pair_plate_6mm',plate,(0.0,1.0,1.0));obj.ViewObject.Transparency=50
            for key,value in [('Width',76),('Length',80),('Thickness',6),('HoleDiameter',11),('HolePitchX',52),('HolePitchY',40)]:
                obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
            for i,(x,y) in enumerate(centres,1):
                stud=Part.makeCylinder(5,30,V(x,y,-18))
                obj=add('CamShaftPairStud%02d'%i,'grey_M10x30_cam_shaft_stud_%02d'%i,stud,(.65,.67,.7))
                for key,value in [('Diameter',10),('Length',30),('Engagement',12)]:
                    obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; threads simplified'
                washer=Part.makeCylinder(10,2,V(x,y,-8)).cut(Part.makeCylinder(5.5,2,V(x,y,-8)))
                add('CamShaftPairWasher%02d'%i,'grey_M10_cam_shaft_washer_%02d'%i,washer,(.75,.77,.8))
                radius=17/math.sqrt(3)
                points=[V(x+radius*math.cos(math.radians(30+60*j)),y+radius*math.sin(math.radians(30+60*j)),-16) for j in range(6)]
                nut=Part.Face(Part.makePolygon(points+[points[0]])).extrude(V(0,0,8)).cut(Part.makeCylinder(5,8,V(x,y,-16)))
                obj=add('CamShaftPairNut%02d'%i,'grey_M10_cam_shaft_nut_%02d'%i,nut,(.7,.72,.75))
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; 17 mm across flats, 8 mm high; threads simplified'
            self.units.append((prefix,shaft,original,inner,clones,hardware))
        for obj in document.Objects:
            if obj.isDerivedFrom('Part::Feature') and 'Plummer' in obj.Name and not any(word in obj.Name for word in ('Mount','Plate','Stud','Nut','Washer')):
                obj.ViewObject.Transparency=50
        self.update()
    def update(self):
        for prefix,shaft,original,inner,clones,hardware in self.units:
            sb=self.doc.getObject(prefix+'sprocket_16T_03').Shape.copy()
            sprocket=self.doc.getObject(prefix+'sprocket_16T_03')
            sb.Placement=sprocket.getGlobalPlacement().multiply(sprocket.Placement.inverse()).multiply(sb.Placement)
            sb=sb.BoundBox;cb=self.doc.getObject(prefix+'sprocket_16T_smooth_cam_disc').Shape.BoundBox
            outward=1 if prefix else -1
            midpoint=(sb.YMax+cb.YMin)/2 if prefix else (cb.YMax+sb.YMin)/2
            axis=shaft.getGlobalPlacement().Base
            centre=V(axis.x,midpoint+outward*23,axis.z)
            inner_centre=centre-V(0,outward*40,0)
            original.BearingCentre=centre;inner.BearingCentre=inner_centre
            for old,new in clones:
                pose=old.Placement;pose.Base=centre;old.Placement=pose
                # Preserve the running insert angle; the entire added unit is turned 180 Z.
                new.Placement=App.Placement(inner_centre,pose.Rotation.multiply(App.Rotation(V(0,0,1),180)))
                old.ViewObject.Transparency=50;new.ViewObject.Transparency=50;new.Visibility=old.Visibility
            origin=V(axis.x-38,min(centre.y,inner_centre.y)-20,axis.z-30.2)
            for obj in hardware:
                obj.Placement=App.Placement(origin,App.Rotation())
                obj.Visibility=not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH

cam_shaft_bearing_pairs_190=CamShaftBearingPairs190(doc)
