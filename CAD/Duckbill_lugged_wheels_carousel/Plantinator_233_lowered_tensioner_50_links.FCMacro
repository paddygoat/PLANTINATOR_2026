def add_sprocket_shaft_disc(doc):
    shaft = doc.Sprocket_21T_Shaft
    disc = doc.addObject("Part::Feature", "sprocket_16T_shaft_disc")
    disc.Label = "16T shaft disc - OD176 x6, bore20"
    # Arm three sits on +Y. Put the disc at the opposite (-Y) shaft end,
    # with its outside face flush with the shaft end and all 6 mm engaged.
    start = SPROCKET_PLATE_THICKNESS/2.0 - shaft.Length.Value/2.0
    disc.Shape = Part.makeCylinder(88.0,6.0,V(0,0,start)).cut(
        Part.makeCylinder(shaft.Diameter.Value/2.0,8.0,V(0,0,start-1.0)))
    disc.Placement = shaft.getGlobalPlacement()
    for prop,value in (("OutsideDiameter",176.0),("Thickness",6.0),("BoreDiameter",shaft.Diameter.Value)):
        disc.addProperty("App::PropertyLength",prop,"Dimensions")
        setattr(disc,prop,value)
    disc.addProperty("App::PropertyLinkHidden","MotionDriver","Attachment")
    disc.MotionDriver = shaft
    disc.ViewObject.ShapeColor=(0.72,0.74,0.77)
    return disc


