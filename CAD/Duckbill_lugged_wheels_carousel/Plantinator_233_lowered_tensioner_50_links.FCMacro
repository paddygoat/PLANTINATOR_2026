# Version 191: downward OD40x3 supports beneath both cam-bearing plates.
def add_cam_bearing_pipe_supports_191(document):
    group=document.addObject('App::DocumentObjectGroup','CamBearingPipeSupports')
    group.Label='cyan_Cam bearing plate OD40x3 mitred supports'
    frame=document.Frame02TopCrossmember.Shape.fuse(document.Frame02Upright01.Shape).fuse(document.Frame02Upright02.Shape)
    bb=document.Frame02TopCrossmember.Shape.BoundBox
    target_z=(bb.ZMin+bb.ZMax)/2
    for prefix in ('','Duplicate_'):
        plate=document.getObject(prefix+'CamShaftPairPlate');box=plate.Shape.BoundBox
        origin=V(box.Center.x,box.Center.y,box.ZMin)
        height=origin.z-target_z;run=origin.x-bb.XMax
        # Rotate a local +Z/+X elbow by 180 degrees about Y: down, then -X.
        pose=App.Placement(origin,App.Rotation(V(0,1,0),180))
        def prism(points):
            verts=[V(x,-30,z) for x,z in points]
            return Part.Face(Part.makePolygon(verts+[verts[0]])).extrude(V(0,60,0))
        lower=prism([(-30,-1),(run+30,-1),(run+30,height-run-30),(-30,height+30)])
        upper=prism([(-30,height+30),(run+30,height-run-30),(run+30,height+40),(-30,height+40)])
        vertical=Part.makeCylinder(20,height+21).cut(Part.makeCylinder(17,height+23,V(0,0,-1))).common(lower).removeSplitter()
        horizontal=Part.makeCylinder(20,run+45,V(-21,0,height),V(1,0,0)).cut(Part.makeCylinder(17,run+47,V(-22,0,height),V(1,0,0))).common(upper)
        vertical.Placement=pose;horizontal.Placement=pose
        trimmed=horizontal.cut(frame)
        candidates=[s for s in trimmed.Solids if s.BoundBox.XMax>origin.x]
        if len(candidates)!=1:raise RuntimeError('Expected one pipe solid adjoining the mitre')
        horizontal=candidates[0].removeSplitter()
        for name,label,shape,length,axis in (
            ('CamBearingVerticalPipe','cyan_R20x3_cam_bearing_vertical_pipe',vertical,height,V(0,0,-1)),
            ('CamBearingHorizontalPipe','cyan_R20x3_cam_bearing_horizontal_pipe',horizontal,run,V(-1,0,0))):
            obj=document.addObject('Part::Feature',prefix+name);obj.Label=label+('_duplicate' if prefix else '')
            obj.Shape=shape;obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
            group.addObject(obj)
            for key,value in [('OutsideDiameter',40),('WallThickness',3),('CentrelineLength',length),('NominalLongPointLength',length+20)]:
                obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
            obj.addProperty('App::PropertyAngle','MitreAngle','Dimensions');obj.MitreAngle=45
            obj.addProperty('App::PropertyVector','AxisDirection','Dimensions');obj.AxisDirection=axis
            obj.addProperty('App::PropertyString','EndDetail','Dimensions')
            obj.EndDetail='45 degree elbow mitre; '+('square end centred against underside of plate' if name.endswith('VerticalPipe') else 'opposite end fitted to actual rounded frame surfaces; axis at crossmember mid-height')
    document.recompute()
    return group
cam_bearing_pipe_supports_191=add_cam_bearing_pipe_supports_191(doc)

# Version 192: vertical SHS50x50x6 master mounting plate supports.
def add_master_frame_supports_192(document):
    group=document.addObject('App::DocumentObjectGroup','MasterMountVerticalSupports')
    group.Label='cyan_50x50x6 master mounting plate vertical supports'
    def wire(size,r,offset=0):
        def p(x,y):return V(x+offset,y+offset,0)
        def arc(x,y,a,b):
            def point(t):return p(x+r*math.cos(t),y+r*math.sin(t))
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([Part.makeLine(p(r,0),p(size-r,0)),arc(size-r,r,-math.pi/2,0),
            Part.makeLine(p(size,r),p(size,size-r)),arc(size-r,size-r,0,math.pi/2),
            Part.makeLine(p(size-r,size),p(r,size)),arc(r,size-r,math.pi/2,math.pi),
            Part.makeLine(p(0,size-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
    section=Part.Face(wire(50,12)).cut(Part.Face(wire(38,6,6)))
    for prefix,rail_name in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
        plate=document.getObject(prefix+'MasterSliderFrame');rail=document.getObject(rail_name)
        pb=plate.Shape.BoundBox;rb=rail.Shape.BoundBox
        xmin=max(pb.XMin,rb.XMin);xmax=min(pb.XMax,rb.XMax)
        if xmax-xmin<50:raise RuntimeError('Insufficient overlap for vertical 50 mm support')
        cx=(xmin+xmax)/2;cy=rb.Center.y
        z0=rb.ZMax;length=pb.ZMin-z0
        obj=document.addObject('Part::Feature',prefix+'MasterMountVerticalSHS')
        obj.Label='cyan_50x50x6_master_mount_vertical_support'+('_duplicate' if prefix else '')
        obj.Shape=section.extrude(V(0,0,length));obj.Placement=App.Placement(V(cx-25,cy-25,z0),App.Rotation())
        obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50;group.addObject(obj)
        for key,value in [('SectionSize',50),('WallThickness',6),('OutsideCornerRadius',12),('InsideCornerRadius',6),('Length',length)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyLinkGlobal','UpperMount','Mounting');obj.UpperMount=plate
        obj.addProperty('App::PropertyLinkGlobal','LowerRail','Mounting');obj.LowerRail=rail
    document.recompute()
    return group
master_mount_vertical_supports_192=add_master_frame_supports_192(doc)

# Version 193: horizontal SHS50x50x6 upper-wheel plate braces.
def add_upper_wheel_plate_braces_193(document):
    group=document.addObject('App::DocumentObjectGroup','UpperWheelPlateHorizontalBraces')
    group.Label='cyan_50x50x6 upper wheel plate horizontal braces'
    def wire(size,r,offset=0):
        def p(y,z):return V(0,y+offset,z+offset)
        def arc(y,z,a,b):
            def point(t):return p(y+r*math.cos(t),z+r*math.sin(t))
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([Part.makeLine(p(r,0),p(size-r,0)),arc(size-r,r,-math.pi/2,0),
            Part.makeLine(p(size,r),p(size,size-r)),arc(size-r,size-r,0,math.pi/2),
            Part.makeLine(p(size-r,size),p(r,size)),arc(r,size-r,math.pi/2,math.pi),
            Part.makeLine(p(0,size-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
    section=Part.Face(wire(50,12)).cut(Part.Face(wire(38,6,6)))
    for prefix,plate_name in (('','UpperWheelPlummerPlate01_03'),('Duplicate_','UpperWheelPlummerPlate02_04')):
        plate=document.getObject(plate_name);support=document.getObject(prefix+'MasterMountVerticalSHS')
        pb=plate.Shape.BoundBox;sb=support.Shape.BoundBox
        cy=sb.Center.y;cz=pb.Center.z;x0=sb.XMax;length=pb.XMin-x0
        if length<=0 or cy-25<pb.YMin or cy+25>pb.YMax:raise RuntimeError('Horizontal brace does not fit the plate')
        obj=document.addObject('Part::Feature',prefix+'UpperWheelPlateHorizontalSHS')
        obj.Label='cyan_50x50x6_upper_wheel_plate_horizontal_brace'+('_duplicate' if prefix else '')
        obj.Shape=section.extrude(V(length,0,0));obj.Placement=App.Placement(V(x0,cy-25,cz-25),App.Rotation())
        obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50;group.addObject(obj)
        for key,value in [('SectionSize',50),('WallThickness',6),('OutsideCornerRadius',12),('InsideCornerRadius',6),('Length',length)]:
            obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
        obj.addProperty('App::PropertyDistance','CentreHeightZ','Mounting');obj.CentreHeightZ=cz
        obj.addProperty('App::PropertyLinkGlobal','EndPlate','Mounting');obj.EndPlate=plate
        obj.addProperty('App::PropertyLinkGlobal','VerticalSupport','Mounting');obj.VerticalSupport=support
    document.recompute()
    return group
upper_wheel_plate_horizontal_braces_193=add_upper_wheel_plate_braces_193(doc)

# Version 194: Y-axis SHS50x50x6 tie, top face 15 mm below master frame underside.
def add_master_support_crossmember_194(document):
    left=document.MasterMountVerticalSHS;right=document.Duplicate_MasterMountVerticalSHS
    lb=left.Shape.BoundBox;rb=right.Shape.BoundBox
    if lb.Center.y>rb.Center.y:lb,rb=rb,lb
    underside=min(document.MasterSliderFrame.Shape.BoundBox.ZMin,document.Duplicate_MasterSliderFrame.Shape.BoundBox.ZMin)
    top=underside-15.0;bottom=top-50.0
    cx=(lb.Center.x+rb.Center.x)/2
    if abs(lb.Center.x-rb.Center.x)>1e-6:raise RuntimeError('Vertical supports must share X centre')
    y0=lb.YMax;length=rb.YMin-y0
    def wire(size,r,offset=0):
        def p(x,z):return V(x+offset,0,z+offset)
        def arc(x,z,a,b):
            def point(t):return p(x+r*math.cos(t),z+r*math.sin(t))
            return Part.Arc(point(a),point((a+b)/2),point(b)).toShape()
        return Part.Wire([Part.makeLine(p(r,0),p(size-r,0)),arc(size-r,r,-math.pi/2,0),
            Part.makeLine(p(size,r),p(size,size-r)),arc(size-r,size-r,0,math.pi/2),
            Part.makeLine(p(size-r,size),p(r,size)),arc(r,size-r,math.pi/2,math.pi),
            Part.makeLine(p(0,size-r),p(0,r)),arc(r,r,math.pi,3*math.pi/2)])
    section=Part.Face(wire(50,12)).cut(Part.Face(wire(38,6,6)))
    obj=document.addObject('Part::Feature','MasterSupportYCrossmember')
    obj.Label='cyan_50x50x6_master_support_Y_crossmember'
    obj.Shape=section.extrude(V(0,length,0));obj.Placement=App.Placement(V(cx-25,y0,bottom),App.Rotation())
    obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
    document.MasterMountVerticalSupports.addObject(obj)
    for key,value in [('SectionSize',50),('WallThickness',6),('OutsideCornerRadius',12),('InsideCornerRadius',6),('Length',length),('TopClearance',15)]:
        obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
    obj.addProperty('App::PropertyLinkListGlobal','JoinedSupports','Mounting');obj.JoinedSupports=[left,right]
    document.recompute()
    return obj
master_support_y_crossmember_194=add_master_support_crossmember_194(doc)

# Version 195: requested translation of the new Y-axis crossmember.
placement=doc.MasterSupportYCrossmember.Placement
placement.Base=placement.Base+V(65,0,-21.5)
doc.MasterSupportYCrossmember.Placement=placement
doc.MasterSupportYCrossmember.TopClearance=36.5
doc.MasterSupportYCrossmember.JoinedSupports=[]
doc.recompute()

# Version 198: second bearings remain 30 mm inward; both pairs rotated -90 degrees from v197 about global Y.
class TensionerShaftBearings196:
    def __init__(self,document):
        self.doc=document;self.sides=[]
        self.group=document.addObject('App::DocumentObjectGroup','TensionerShaftBearings')
        self.group.Label='blue_16mm orange tensioner shafts and ID16 bearing pairs'
        templates=[('Housing','UpperWheelPlummerHousing01',False),('OuterRace','UpperWheelPlummerOuterRace01',False),('Insert','UpperWheelPlummerInsert01',True),('GreaseNipple','UpperWheelPlummerGrease01',False),('GrubScrew1','UpperWheelPlummerGrub01_1',True),('GrubScrew2','UpperWheelPlummerGrub01_2',True)]
        for prefix,rail_name in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
            sprocket=document.getObject(prefix+'sprocket_15T_tensioner_01');rail=document.getObject(rail_name)
            world=sprocket.getGlobalPlacement();shape=self.world_shape(sprocket)
            sb=shape.BoundBox;rb=rail.Shape.BoundBox
            outer=rb.YMax if prefix else rb.YMin
            inner=sb.YMin if prefix else sb.YMax
            length=abs(inner-outer)
            # Open only this tensioner's original 10 mm bore to the requested 16 mm.
            cutter=Part.makeCylinder(8,sb.YLength+2,V(world.Base.x,sb.YMin-1,world.Base.z),V(0,1,0))
            cutter.Placement=world.inverse().multiply(cutter.Placement)
            local=sprocket.Shape.copy();local.Placement=App.Placement()
            enlarged=local.cut(cutter).removeSplitter()
            pose=sprocket.Placement;sprocket.Shape=enlarged;sprocket.Placement=pose
            if 'BoreDiameter' not in sprocket.PropertiesList:sprocket.addProperty('App::PropertyLength','BoreDiameter','Dimensions')
            sprocket.BoreDiameter=16
            shaft=document.addObject('Part::Feature',prefix+'OrangeTensionerShaft16')
            shaft.Label='blue_16mm_orange_tensioner_shaft'+('_duplicate' if prefix else '')
            shaft.Shape=Part.makeCylinder(8,length,V(0,0,0),V(0,1,0))
            shaft.ViewObject.ShapeColor=document.duck_bill_arm_one_shaft.ViewObject.ShapeColor
            shaft.ViewObject.Transparency=50;self.group.addObject(shaft)
            for key,value in [('Diameter',16),('Length',length)]:
                shaft.addProperty('App::PropertyLength',key,'Dimensions');setattr(shaft,key,value)
            shaft.addProperty('App::PropertyLinkGlobal','MotionDriver','Mounting');shaft.MotionDriver=sprocket
            shaft.addProperty('App::PropertyLinkGlobal','EndReferenceRail','Mounting');shaft.EndReferenceRail=rail
            bearing_pairs=[]
            for index in (1,2):
                unit=document.addObject('App::DocumentObjectGroup',prefix+'TensionerPlummerUnit%02d'%index)
                unit.Label='magenta_ID16_tensioner_bearing_%02d'%index+('_duplicate' if prefix else '')
                self.group.addObject(unit)
                for key,value in [('BoreDiameter',16),('CentreHeight',30.2),('BaseWidth',76),('BaseDepth',40),('BoltCentres',52),('BaseThickness',11),('MountHoleDepth',13),('InsertWidth',31)]:
                    unit.addProperty('App::PropertyLength',key,'Catalogue');setattr(unit,key,value)
                unit.addProperty('App::PropertyString','MountingThread','Catalogue');unit.MountingThread='2 x M10 blind, 13 mm depth; threads simplified'
                unit.addProperty('App::PropertyVector','MountingDirection','Mounting');unit.MountingDirection=App.Rotation(V(0,1,0),45).multVec(V(0,0,-1))
                unit.addProperty('App::PropertyVector','BearingCentre','Mounting')
                parts=[]
                for key,template,rotating in templates:
                    ref=document.getObject(template);obj=document.addObject('Part::Feature',prefix+'TensionerPlummer%02d'%index+key)
                    obj.Label='magenta_ID16_tensioner_%02d_'%index+key+('_duplicate' if prefix else '')
                    s=ref.Shape.copy();s.Placement=App.Placement();obj.Shape=s
                    obj.ViewObject.ShapeColor=ref.ViewObject.ShapeColor;obj.ViewObject.Transparency=50;unit.addObject(obj)
                    parts.append((obj,rotating))
                bearing_pairs.append((unit,parts,index))
            self.sides.append((prefix,sprocket,rail,shaft,outer,inner,bearing_pairs,world.Rotation))
        self.update()
    @staticmethod
    def world_shape(obj):
        s=obj.Shape.copy();s.Placement=obj.getGlobalPlacement().multiply(obj.Placement.inverse()).multiply(s.Placement);return s
    def update(self):
        mounting=App.Rotation(V(0,1,0),45)
        for prefix,sprocket,rail,shaft,outer,inner,bearings,rest in self.sides:
            pose=sprocket.getGlobalPlacement();axis=pose.Base
            shaft.Placement=App.Placement(V(axis.x,min(outer,inner),axis.z),App.Rotation())
            spin=pose.Rotation.multiply(rest.inverted())
            for unit,parts,index in bearings:
                centre=V(axis.x,outer+(-1 if prefix else 1)*(20+70*(index-1)),axis.z)
                unit.BearingCentre=centre
                unit.MountingDirection=mounting.multVec(V(0,0,-1))
                for obj,rotating in parts:
                    obj.Placement=App.Placement(centre,spin.multiply(mounting) if rotating else mounting)
                    obj.Visibility=not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH
            shaft.Visibility=not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH

tensioner_shaft_bearings_196=TensionerShaftBearings196(doc)
App.tensioner_shaft_bearings_196=tensioner_shaft_bearings_196
doc.recompute()

# Version 200: continuous extended slots and vertical rail mounting plates.
class TensionerBearingMounts199:
    def __init__(self,document):
        self.doc=document;self.sides=[]
        self.group=document.addObject('App::DocumentObjectGroup','TensionerBearingMounts')
        self.group.Label='cyan_ID16 tensioner slotted plates and M10 hardware'
        for prefix in ('','Duplicate_'):
            reference=document.getObject(prefix+'TensionerPlummer01Housing')
            direction=-1 if prefix else 1
            group=document.addObject('App::DocumentObjectGroup',prefix+'TensionerBearingPlateMount')
            group.Label='cyan_ID16 tensioner plate mount'+('_duplicate' if prefix else '')
            self.group.addObject(group);objects=[]
            def add(name,label,shape,colour):
                obj=document.addObject('Part::Feature',prefix+name)
                obj.Label=label+('_duplicate' if prefix else '')
                obj.Shape=shape;obj.ViewObject.ShapeColor=colour;group.addObject(obj);objects.append(obj)
                return obj
            centres=[(x,y) for y in (0,direction*70) for x in (-26,26)]
            plate=Part.makeBox(130,110,6,V(-38,min(0,direction*70)-20,-36.2))
            for y in (0,direction*70):
                slot=Part.makeCylinder(5.5,8,V(-26,y,-37.2)).fuse(Part.makeCylinder(5.5,8,V(80,y,-37.2))).fuse(Part.makeBox(106,11,8,V(-26,y-5.5,-37.2)))
                plate=plate.cut(slot)
            obj=add('TensionerSlottedPlate','cyan_ID16_tensioner_slotted_plate_6mm',plate.removeSplitter(),(0.0,1.0,1.0));obj.ViewObject.Transparency=50
            for key,value in [('Length',130),('Width',110),('Thickness',6),('SlotWidth',11),('SlotTravel',54),('SlotOverallLength',117),('BoltPitch',52),('BearingPitch',70)]:
                obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
            obj.addProperty('App::PropertyString','ExtensionDirection','Dimensions');obj.ExtensionDirection='Local +X, downward along mounting face at 45 degrees; length measured in plate plane'
            for i,(x,y) in enumerate(centres,1):
                obj=add('TensionerPlateStud%02d'%i,'grey_M10x30_tensioner_plate_stud_%02d'%i,Part.makeCylinder(5,30,V(x,y,-48.2)),(.65,.67,.7))
                for key,value in [('Diameter',10),('Length',30),('Engagement',12)]:
                    obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; simplified thread geometry'
                washer=Part.makeCylinder(10,2,V(x,y,-38.2)).cut(Part.makeCylinder(5.5,2,V(x,y,-38.2)))
                add('TensionerPlateWasher%02d'%i,'grey_M10_tensioner_plate_washer_%02d'%i,washer,(.75,.77,.8))
                radius=17/math.sqrt(3)
                points=[V(x+radius*math.cos(math.radians(30+60*j)),y+radius*math.sin(math.radians(30+60*j)),-46.2) for j in range(6)]
                nut=Part.Face(Part.makePolygon(points+[points[0]])).extrude(V(0,0,8)).cut(Part.makeCylinder(5,8,V(x,y,-46.2)))
                obj=add('TensionerPlateNut%02d'%i,'grey_M10_tensioner_plate_nut_%02d'%i,nut,(.7,.72,.75))
                obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; AF17 x 8 mm, simplified threads'
            self.sides.append((reference,objects))
        self.update()
    def update(self):
        for reference,objects in self.sides:
            for obj in objects:
                obj.Placement=reference.Placement
                obj.Visibility=reference.Visibility

tensioner_bearing_mounts_199=TensionerBearingMounts199(doc)
App.tensioner_bearing_mounts_199=tensioner_bearing_mounts_199
doc.recompute()

# Vertical 6 x 50 mm plates, against the inner rail faces, with 45-degree tops.
for prefix,railname in (('','Frame02Box02'),('Duplicate_','Frame02Box01')):
    plate=doc.getObject(prefix+'TensionerSlottedPlate');rail=doc.getObject(railname)
    pose=plate.Placement;rb=rail.Shape.BoundBox
    bottom_centre=pose.multVec(V(27,0,-36.2))
    x0=bottom_centre.x-25;x1=x0+50
    y0=rb.YMin-6 if prefix else rb.YMax
    normal=pose.Rotation.multVec(V(0,0,1))
    def top_z(x):
        return bottom_centre.z-(normal.x*(x-bottom_centre.x)+normal.y*(y0-bottom_centre.y))/normal.z
    points=[V(x0,y0,rb.ZMin),V(x1,y0,rb.ZMin),V(x1,y0,top_z(x1)),V(x0,y0,top_z(x0))]
    shape=Part.Face(Part.makePolygon(points+[points[0]])).extrude(V(0,6,0))
    obj=doc.addObject('Part::Feature',prefix+'TensionerVerticalRailPlate')
    obj.Label='cyan_ID16_tensioner_vertical_rail_plate_6mm'+('_duplicate' if prefix else '')
    obj.Shape=shape;obj.ViewObject.ShapeColor=(0.0,1.0,1.0);obj.ViewObject.Transparency=50
    for key,value in [('Thickness',6),('Width',50),('TallEdgeLength',top_z(x0)-rb.ZMin),('ShortEdgeLength',top_z(x1)-rb.ZMin)]:
        obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
    obj.addProperty('App::PropertyAngle','TopBevel','Dimensions');obj.TopBevel=45
    obj.addProperty('App::PropertyLinkGlobal','Rail','Mounting');obj.Rail=rail
    doc.getObject(prefix+'TensionerBearingPlateMount').addObject(obj)
    obj.Visibility=plate.Visibility
doc.recompute()

# Version 201: four yellow tensioner shafts and eight upright ID16 bearing units.
class YellowTensionerBearings201:
    @staticmethod
    def pose(obj):
        return obj.LinkPlacement if obj.TypeId=='App::Link' else obj.getGlobalPlacement()
    @staticmethod
    def world(obj):
        s=obj.Shape.copy()
        if obj.TypeId!='App::Link':s.Placement=obj.getGlobalPlacement().multiply(obj.Placement.inverse()).multiply(s.Placement)
        return s
    def __init__(self,document):
        self.doc=document;self.sides=[]
        self.group=document.addObject('App::DocumentObjectGroup','YellowTensionerShaftBearings')
        self.group.Label='blue_Yellow tensioner OD16 shafts and upright ID16 bearings'
        templates=[('Housing','UpperWheelPlummerHousing01',False),('OuterRace','UpperWheelPlummerOuterRace01',False),('Insert','UpperWheelPlummerInsert01',True),('GreaseNipple','UpperWheelPlummerGrease01',False),('GrubScrew1','UpperWheelPlummerGrub01_1',True),('GrubScrew2','UpperWheelPlummerGrub01_2',True)]
        for prefix in ('','Duplicate_'):
            for number in (2,3):
                sprocket=document.getObject(prefix+'sprocket_15T_tensioner_%02d'%number)
                pose=self.pose(sprocket);sb=self.world(sprocket).BoundBox
                if not prefix:
                    cutter=Part.makeCylinder(8,sb.YLength+2,V(pose.Base.x,sb.YMin-1,pose.Base.z),V(0,1,0))
                    cutter.Placement=pose.inverse().multiply(cutter.Placement)
                    local=sprocket.Shape.copy();local.Placement=App.Placement()
                    saved=sprocket.Placement;sprocket.Shape=local.cut(cutter).removeSplitter();sprocket.Placement=saved
                    if 'BoreDiameter' not in sprocket.PropertiesList:sprocket.addProperty('App::PropertyLength','BoreDiameter','Dimensions')
                    sprocket.BoreDiameter=16
                inner=sb.YMin if prefix else sb.YMax;direction=1 if prefix else -1;outer=inner+direction*90
                stem=prefix+'YellowTensioner%02d'%number
                shaft=document.addObject('Part::Feature',stem+'Shaft16')
                shaft.Label='blue_OD16x90_yellow_tensioner_%02d_shaft'%number+('_duplicate' if prefix else '')
                shaft.Shape=Part.makeCylinder(8,90,V(0,0,0),V(0,1,0))
                shaft.ViewObject.ShapeColor=document.duck_bill_arm_one_shaft.ViewObject.ShapeColor;shaft.ViewObject.Transparency=50;self.group.addObject(shaft)
                for key,value in [('Diameter',16),('Length',90)]:
                    shaft.addProperty('App::PropertyLength',key,'Dimensions');setattr(shaft,key,value)
                pairs=[]
                for index in (1,2):
                    unit=document.addObject('App::DocumentObjectGroup',stem+'Bearing%02d'%index)
                    unit.Label='magenta_ID16_yellow_tensioner_%02d_bearing_%02d'%(number,index)+('_duplicate' if prefix else '')
                    self.group.addObject(unit)
                    for key,value in [('BoreDiameter',16),('CentreHeight',30.2),('BaseWidth',76),('BaseDepth',40),('BoltCentres',52)]:
                        unit.addProperty('App::PropertyLength',key,'Catalogue');setattr(unit,key,value)
                    unit.addProperty('App::PropertyVector','BearingCentre','Mounting')
                    unit.addProperty('App::PropertyString','MountingThread','Catalogue');unit.MountingThread='2 x M10 blind, depth 13 mm; threads simplified'
                    parts=[]
                    for key,template,rotating in templates:
                        ref=document.getObject(template);obj=document.addObject('Part::Feature',stem+'Bearing%02d'%index+key)
                        obj.Label='magenta_ID16_yellow_tensioner_%02d_%02d_'%(number,index)+key+('_duplicate' if prefix else '')
                        shape=ref.Shape.copy();shape.Placement=App.Placement();obj.Shape=shape
                        obj.ViewObject.ShapeColor=ref.ViewObject.ShapeColor;obj.ViewObject.Transparency=50;unit.addObject(obj);parts.append((obj,rotating))
                    pairs.append((unit,parts,index))
                self.sides.append((prefix,sprocket,shaft,inner,outer,direction,pairs,pose.Rotation))
        self.update()
    def update(self):
        for prefix,sprocket,shaft,inner,outer,direction,pairs,rest in self.sides:
            pose=self.pose(sprocket);axis=pose.Base;spin=pose.Rotation.multiply(rest.inverted())
            shaft.Placement=App.Placement(V(axis.x,min(inner,outer),axis.z),App.Rotation())
            for unit,parts,index in pairs:
                centre=V(axis.x,outer-direction*(20+40*(index-1)),axis.z);unit.BearingCentre=centre
                for obj,rotating in parts:
                    obj.Placement=App.Placement(centre,spin if rotating else App.Rotation())
                    obj.Visibility=not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH
            shaft.Visibility=not prefix or not HIDE_DUPLICATE_DUCK_BILL_MECH

