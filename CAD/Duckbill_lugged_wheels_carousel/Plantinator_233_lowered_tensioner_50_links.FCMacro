                obj.Placement=App.Placement(anchor,App.Rotation());obj.ViewObject.Transparency=50
                for key,value in [('Length',130),('Width',80),('Thickness',6),('SlotWidth',11),('SlotOverallLength',117),('SlotTravel',54),('AdjustmentX',reference.Placement.Base.x-nominal_x)]:
                    obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                obj.addProperty('App::PropertyString','SlotDirection','Dimensions');obj.SlotDirection='Global +X'
                plate_obj=obj
                for i,(x,y) in enumerate([(x,y) for y in (0,direction*40) for x in (-26,26)],1):
                    obj=add('MountStud%02d'%i,'grey_M10x30_yellow_tensioner_%02d_stud_%02d'%(number,i),Part.makeCylinder(5,30,V(x,y,-48.2)),(.65,.67,.7));hardware.append(obj)
                    for key,value in [('Diameter',10),('Length',30),('Engagement',12)]:
                        obj.addProperty('App::PropertyLength',key,'Dimensions');setattr(obj,key,value)
                    obj.addProperty('App::PropertyString','Thread','Dimensions');obj.Thread='M10; simplified threads'
                    washer=Part.makeCylinder(10,2,V(x,y,-38.2)).cut(Part.makeCylinder(5.5,2,V(x,y,-38.2)))
                    hardware.append(add('MountWasher%02d'%i,'grey_M10_yellow_tensioner_%02d_washer_%02d'%(number,i),washer,(.75,.77,.8)))
                    radius=17/math.sqrt(3)
                    points=[V(x+radius*math.cos(math.radians(30+60*j)),y+radius*math.sin(math.radians(30+60*j)),-46.2) for j in range(6)]
                    nut=Part.Face(Part.makePolygon(points+[points[0]])).extrude(V(0,0,8)).cut(Part.makeCylinder(5,8,V(x,y,-46.2)))
                    hardware.append(add('MountNut%02d'%i,'grey_M10_yellow_tensioner_%02d_nut_%02d'%(number,i),nut,(.7,.72,.75)))
                self.items.append((reference,plate_obj,hardware))
        self.update()
