# UCFL201 supplied dimensions. Local Z extends away from the mounting face.
# Casting contour and unspecified race diameters simplified.
def ucfl201_shapes_222():
    flange=Part.makeCylinder(30,11)
    for side in (-1,1):
        pts=[V(side*0,-30,0),V(side*45,-11.5,0),V(side*45,11.5,0),V(side*0,30,0)]
        flange=flange.fuse(Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,11)))
        flange=flange.fuse(Part.makeCylinder(11.5,11,V(side*45,0,0)))
    housing=flange.fuse(Part.makeCone(28,24,14.5,V(0,0,11)))
    housing=housing.cut(Part.makeCylinder(20,27,V(0,0,-0.5)))
    for x in (-45,45):housing=housing.cut(Part.makeCylinder(6,13,V(x,0,-1)))
    housing=housing.removeSplitter()
    race=Part.makeCylinder(20,18,V(0,0,6)).cut(Part.makeCylinder(13,18,V(0,0,6)))
    insert=Part.makeCylinder(13,31,V(0,0,2.3)).cut(Part.makeCylinder(6,31,V(0,0,2.3)))
    return housing,race,insert
