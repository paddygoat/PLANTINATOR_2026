class ArmOneDriveShaft:
    """Red Y-axis shaft rigidly joining the arm-one pivot and its two sprockets."""
    def __init__(self, document):
        self.driver = document.sprocket_16T_01
        members = [document.duck_bill_arm_one, self.driver, document.sprocket_10T_02]
        bounds = []
        centre = self.driver.getGlobalPlacement().Base
        for member in members:
            pose = member.getGlobalPlacement()
            if math.hypot(pose.Base.x-centre.x, pose.Base.z-centre.z) > 1.0e-6:
                raise ValueError('Arm-one shaft members must share the Y axis.')
            shape = member.Shape.copy()
            shape.Placement = pose.multiply(member.Placement.inverse()).multiply(shape.Placement)
            bounds.append(shape.BoundBox)
        y0 = min(box.YMin for box in bounds) - ARM_ONE_SHAFT_SPROCKET_PROJECTION
        # Finish flush with arm one: arm two swings directly against this face.
        y1 = max(box.YMax for box in bounds)
        length = y1-y0
        self.obj = document.addObject('Part::Feature', 'duck_bill_arm_one_shaft')
        self.obj.Label = 'duck_bill_arm_one_shaft'
        self.obj.Shape = Part.makeCylinder(ARM_ONE_SHAFT_DIAMETER/2.0, length, V(0,0,0), V(0,1,0))
        rest = App.Placement(V(centre.x,y0,centre.z), App.Rotation())
        self.relative = self.driver.getGlobalPlacement().inverse().multiply(rest)
        for prop, value in (('Diameter',ARM_ONE_SHAFT_DIAMETER),('Length',length),
                            ('SprocketEndProjection',ARM_ONE_SHAFT_SPROCKET_PROJECTION),('ArmEndProjection',0.0)):
            self.obj.addProperty('App::PropertyLength',prop,'Dimensions')
            setattr(self.obj,prop,value)
        self.obj.addProperty('App::PropertyLink','MotionDriver','Drive')
        self.obj.MotionDriver = self.driver
        self.obj.addProperty('App::PropertyLinkList','JoinedParts','Drive')
        self.obj.JoinedParts = members
        self.obj.addProperty('App::PropertyString','Motion','Drive')
        self.obj.Motion = 'Rigid 1:1 rotation with arm one, orange 16T and yellow 10T; no axial sliding.'
        self.obj.ViewObject.ShapeColor = (1.0,0.0,0.0)
        self.obj.ViewObject.LineColor = (0.15,0.0,0.0)
        self.obj.ViewObject.Transparency = 0
        self.update()

    def update(self):
        self.obj.Placement = self.driver.getGlobalPlacement().multiply(self.relative)


arm_one_drive_shaft = ArmOneDriveShaft(doc)
App.arm_one_drive_shaft = arm_one_drive_shaft
doc.recompute()


class MovingSoilGround:
    """Scroll soil past a stationary machine at the wheel's rolling speed."""
    def __init__(self, document):
        import random
        self.doc = document
        self.wheel = document.getObject("GroundDriveWheel")
        self.axle = self.wheel.getGlobalPlacement().Base
        self.lug_tip_radius = FRONT_DISC_OD / 2.0 - LUG_WELD_OVERLAP + LUG_LENGTH
        self.group = document.addObject("App::DocumentObjectGroup", "MovingGround")
        self.group.Label = "Moving soil — stationary machine"
        for prop, value in (("LugPenetration", 40.0), ("RollingRadius", self.lug_tip_radius - 40.0),
                            ("Travel", 0.0), ("GroundHeight", self.axle.z - self.lug_tip_radius + 40.0)):
            self.group.addProperty("App::PropertyLength", prop, "Ground motion")
            setattr(self.group, prop, value)
        self.group.addProperty("App::PropertyFloat", "RoughnessMultiplier", "Ground motion")
        self.group.RoughnessMultiplier = 3.0
        self.group.setEditorMode("RoughnessMultiplier", 1)
        self.group.addProperty("App::PropertyBool", "Enabled", "Ground motion")
        self.group.Enabled = True
        self.group.addProperty("App::PropertyString", "MotionModel", "Ground motion")
        self.group.MotionModel = "No-slip visual rolling: ground travel = wheel angle (radians) x effective radius. Soil penetration is illustrative; no soil-force simulation."
        for prop in ("RollingRadius", "Travel", "GroundHeight", "MotionModel"):
            self.group.setEditorMode(prop, 1)
        # Size the visible field around the existing machine, not the camera.
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.tile_length = 300.0
        # Double the previous 3900 x 1922 mm soil footprint about its centre.
        self.x_min = -3450.0
        self.tile_count = 26
        self.field_length = 7800.0
        self.y_min, self.y_max = -2437.0, 1407.0
        self.field_width = 3844.0
        self.surface = document.addObject("Part::Feature", "SoilSurface")
        self.surface.Label = "Soil surface"
        self.surface.Shape = Part.makeBox(self.field_length, self.field_width, 150.0,
                                          V(self.x_min, self.y_min, -150.0))
        self.surface.ViewObject.ShapeColor = (0.28, 0.19, 0.11)
        self.surface.ViewObject.Transparency = 50
        self.surface.ViewObject.DisplayMode = "Flat Lines"
        self.surface.ViewObject.LineColor = (0.28, 0.19, 0.11)
        self.group.addObject(self.surface)
        self.tiles = []
        for index in range(self.tile_count):
            rng = random.Random(17041 + index)
            light, dark = [], []
            # Low soil clods and scattered grains supply clear motion cues.
            for j in range(24):
                x = rng.uniform(8.0, self.tile_length - 8.0)
                y = rng.uniform(self.y_min + 8.0, self.y_max - 8.0)
                radius = rng.uniform(2.0, 6.0)
                light.append(Part.makeCylinder(radius, rng.uniform(0.5, 1.8) * 3.0, V(x, y, 0.15)))
                dark.append(Part.makeBox(rng.uniform(8.0, 22.0), rng.uniform(2.0, 6.0), 0.36,
                                        V(rng.uniform(5.0, self.tile_length - 25.0), y, 0.06)))
            objects = []
            for suffix, shapes, colour in (("Clods", light, (0.40, 0.29, 0.18)),
                                            ("Grains", dark, (0.19, 0.125, 0.07))):
                obj = document.addObject("Part::Feature", "SoilTile_{:02d}_{}".format(index, suffix))
                obj.Label = "Moving soil {:02d} {}".format(index + 1, suffix.lower())
                obj.Shape = Part.makeCompound(shapes)
                obj.ViewObject.ShapeColor = colour
                obj.ViewObject.Transparency = 50
                obj.ViewObject.LineColor = colour
                obj.ViewObject.DisplayMode = "Flat Lines"
                self.group.addObject(obj)
                objects.append(obj)
            self.tiles.append(objects)
        self.last_travel = 0.0
        self.update()

    def update(self):
        penetration = max(0.0, min(40.0, self.group.LugPenetration.Value))
        radius = self.lug_tip_radius - penetration
        height = self.axle.z - radius
        # Wheel angle about global Y is -animation_offset/R1. Ground moves
        # opposite the machine's notional travel, along +X for forward playback.
        if self.group.Enabled:
            self.last_travel = animation_offset / (PITCH * T1 / (2 * math.pi)) * radius / 6.4
        travel = self.last_travel
        self.surface.Placement.Base = V(0, 0, height)
        self.group.RollingRadius = radius
        self.group.Travel = abs(travel)
        self.group.GroundHeight = height
        phase = travel % self.field_length
        for index, objects in enumerate(self.tiles):
            x = self.x_min + (index * self.tile_length + phase) % self.field_length
            for obj in objects:
                obj.Placement.Base = V(x, 0, height)


class DuckBillCycleReadout:
    """World-space ZX readout of net soil-relative advance per duck-bill cycle."""
    def __init__(self, document):
        self.doc = document
        self.group = document.addObject("App::DocumentObjectGroup", "DuckBillCycleReadout")
        self.group.Label = "Duck-bill cycle distance (ZX readout)"
        self.group.addProperty("App::PropertyLength", "DistancePerCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyFloat", "WheelTurnsPerDuckBillCycle", "Cycle measurement")
        self.group.addProperty("App::PropertyLink", "CycleDriver", "Cycle measurement")
        self.group.CycleDriver = document.sprocket_16T_03
        self.group.addProperty("App::PropertyString", "Definition", "Cycle measurement")
        self.group.Definition = "Net soil-relative advance per complete duck-bill cycle = 2*pi*T3/T1*(10/64)*rolling radius. Both 16T crank sprockets complete one revolution per cycle; the wheel completes 10/64 of a revolution."
        for prop in ("DistancePerCycle", "WheelTurnsPerDuckBillCycle", "CycleDriver", "Definition"):
            self.group.setEditorMode(prop, 1)
        bounds = App.BoundBox()
        for obj in document.Objects:
            if obj.isDerivedFrom("Part::Feature") and not obj.Shape.isNull():
                shape = obj.Shape.copy()
                shape.Placement = obj.getGlobalPlacement()
                bounds.add(shape.BoundBox)
        self.x = bounds.XMax - 470.0
        self.y = bounds.YMin - 40.0
        self.z = bounds.ZMax + 35.0
        width, height = 510.0, 145.0
        vertices = [V(self.x, self.y, self.z), V(self.x + width, self.y, self.z),
                    V(self.x + width, self.y, self.z + height), V(self.x, self.y, self.z + height)]
        wire = Part.makePolygon(vertices + [vertices[0]])
        background = document.addObject("Part::Feature", "CycleReadoutBackground")
        background.Shape = Part.Face(wire)
        background.ViewObject.ShapeColor = (0.065, 0.075, 0.085)
        background.ViewObject.LineColor = (0.065, 0.075, 0.085)
        background.ViewObject.DisplayMode = "Flat Lines"
        frame = document.addObject("Part::Feature", "CycleReadoutFrame")
        frame.Shape = wire
        frame.Placement.Base = V(0, -0.1, 0)
        frame.ViewObject.LineColor = (1.0, 1.0, 1.0)
        frame.ViewObject.LineWidth = 2.0
        self.group.addObject(background)
        self.group.addObject(frame)
        candidates = [
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation2/LiberationSans-Regular.ttf",
            "C:/Windows/Fonts/arial.ttf",
            "/System/Library/Fonts/Supplemental/Arial.ttf",
        ]
        self.font = next((path for path in candidates if os.path.isfile(path)), None)
        if self.font is None:
            raise RuntimeError("A DejaVu Sans, Liberation Sans or Arial font is required for the cycle display.")
        self.make_text("CycleReadoutTitle", "NET SOIL TRAVEL / DUCK-BILL CYCLE", 16.0, 108.0)
        self.value_text = self.make_text("CycleReadoutValue", "Calculating...", 33.0, 53.0)
        self.make_text("CycleReadoutNote", "1 cycle = one duck-bill crank revolution", 12.0, 20.0)
        self.last_text = None

    def text_shape(self, text, size):
        letters = Part.makeWireString(text, os.path.dirname(self.font) + os.sep,
                                      os.path.basename(self.font), size)
        faces = [Part.makeFace(wires, "Part::FaceMakerBullseye") for wires in letters if wires]
        return Part.makeCompound(faces)

    def make_text(self, name, text, size, height):
        obj = self.doc.addObject("Part::Feature", name)
        obj.Label = text
        obj.Shape = self.text_shape(text, size)
        # Font XY -> global XZ; front faces point towards -Y.
        obj.Placement = App.Placement(V(self.x + 20.0, self.y - 0.2, self.z + height),
                                      App.Rotation(V(1, 0, 0), 90.0))
        obj.ViewObject.ShapeColor = (1.0, 1.0, 1.0)
        obj.ViewObject.LineColor = (1.0, 1.0, 1.0)
        obj.ViewObject.DisplayMode = "Flat Lines"
        self.group.addObject(obj)
        return obj

    def update(self):
        if moving_ground is None:
            return
        # R3 is the duck-bill crank sprocket radius, regardless of its old object name.
        ratio = T3 / T1 / 6.4
        distance = 2.0 * math.pi * ratio * moving_ground.group.RollingRadius.Value
        if not moving_ground.group.Enabled:
            distance = 0.0
        self.group.WheelTurnsPerDuckBillCycle = ratio
        self.group.DistancePerCycle = distance
        text = "{:,.1f} mm / cycle".format(distance) if linkage_motion_available else "NO FULL CYCLE"
        if text != self.last_text:
            placement = self.value_text.Placement
            self.value_text.Shape = self.text_shape(text, 33.0)
            self.value_text.Placement = placement
            self.value_text.Label = text
            self.last_text = text


cycle_readout = DuckBillCycleReadout(doc) if DISPLAY_DISTANCE_READOUT else None
App.duck_bill_cycle_readout = cycle_readout
doc.recompute()


# Embedded Wilwood geometry: editable plain Python, ordinary construction functions.

def create_wilwood_260_1304(doc):
    """Wilwood 260-1304 -- standalone assembly-layout reference model.
    Source: user-supplied Wilwood 260-1304.png dimensioned side/end drawing.
    Millimetres. X along cylinder toward pushrod, Y transverse, Z upward.
    X=0 is rear housing datum, Z=0 is pushrod centreline.
    Edit parameters and rerun; each run creates a new document.
    Undimensioned geometry is estimated. Bore size and hydraulic internals are not supplied.
    Threads are nominal-diameter envelopes, not helical geometry.
    """
    import math
    import FreeCAD as App
    import Part
    V=App.Vector

    # Stated drawing values (metric callouts used, including their rounding).
    OVERALL_LENGTH=199.3
    REAR_TO_FLANGE_FACE=100.5
    BODY_AND_CAP_HEIGHT=86.4
    CAP_DIAMETER=51.2
    FLANGE_WIDTH=44.5
    MOUNT_HOLE_SPACING=57.1
    MOUNT_HOLE_DIAMETER=10.2
    BOOT_DIAMETER=35.6
    MAX_STROKE=31.8
    PUSHROD_THREAD_DIAMETER=5.0/16.0*25.4 # 5/16-24
    OUTLET_THREAD_DIAMETER=3.0/8.0*25.4  # 3/8-24
    STROKE_POSITION=0.0 # EDIT 0..31.8; positive values push the rod into the housing.

    # Estimated from the drawing; not manufacturer manufacturing dimensions.
    BODY_RADIUS=13.25
    RESERVOIR_DIAMETER=43.0
    RESERVOIR_X=21.5
    RESERVOIR_WALL=2.0
    CAP_HEIGHT=15.5
    FLANGE_THICKNESS=7.5
    FLANGE_TIP_RADIUS=11.7
    BOOT_END=158.5 # Original reference boot restored; separate slider replaces the old guide plate.
    BOOT_WALL=1.2
    BOOT_SMALL_RADIUS=6.5
    BOOT_FOLDS=3
    PUSHROD_DIAMETER=7.94
    OUTLET_BASE_X=45.5

    if not 0 <= STROKE_POSITION <= MAX_STROKE:
        raise ValueError('STROKE_POSITION must be between 0 and 31.8 mm.')
    assembly=doc.addObject('App::Part','Wilwood2601304')
    assembly.Label='Wilwood 260-1304 master cylinder'
    for name,val in [('OverallLength',OVERALL_LENGTH),('RearToFlangeFace',REAR_TO_FLANGE_FACE),
                     ('BodyAndCapHeight',BODY_AND_CAP_HEIGHT),('CapDiameter',CAP_DIAMETER),
                     ('FlangeWidth',FLANGE_WIDTH),('MountHoleSpacing',MOUNT_HOLE_SPACING),
                     ('MountHoleDiameter',MOUNT_HOLE_DIAMETER),('BootDiameter',BOOT_DIAMETER),
                     ('MaximumStroke',MAX_STROKE),('StrokePosition',STROKE_POSITION)]:
        assembly.addProperty('App::PropertyLength',name,'Drawing dimensions')
        setattr(assembly,name,val);assembly.setEditorMode(name,1)
    assembly.addProperty('App::PropertyString','Source','Reference')
    assembly.Source='User-supplied Wilwood 260-1304.png, dimensioned side/end views'
    assembly.addProperty('App::PropertyString','ModellingNotes','Reference')
    assembly.ModellingNotes='Reference exterior. Unspecified shapes estimated; no piston/seals or assumed bore. Threads simplified. Edit macro parameters and rerun; properties record generated geometry.'
    assembly.addProperty('App::PropertyString','MountHoleNote','Reference')
    assembly.MountHoleNote='Centres placed symmetrically at Z +/-28.55 for 57.1 spacing; drawing separately rounds centre-to-upper-hole to 28.6.'
    fixed=doc.addObject('App::DocumentObjectGroup','FixedParts');assembly.addObject(fixed)
    moving=doc.addObject('App::DocumentObjectGroup','MovingParts');assembly.addObject(moving)
    ALLOY=(0.55,0.57,0.59);STEEL=(0.75,0.76,0.78);RUBBER=(0.09,0.10,0.11);CAP=(0.15,0.16,0.18)
    def add(name,label,shape,colour=ALLOY,group=fixed,note='Estimated undimensioned exterior from supplied drawing'):
        if shape.isNull() or not shape.isValid() or shape.Volume<=0:raise RuntimeError('Invalid geometry: '+name)
        o=doc.addObject('Part::Feature','DustBoot001' if name=='DustBoot' else name);o.Label=label;o.Shape=shape;group.addObject(o)
        o.addProperty('App::PropertyString','GeometryBasis','Reference');o.GeometryBasis=note
        if App.GuiUp:
            o.ViewObject.ShapeColor=colour;o.ViewObject.LineColor=(0.12,0.12,0.12)
        return o

    def cx(r,length,x):return Part.makeCylinder(r,length,V(x,0,0),V(1,0,0))
    def hex_prism(af,length,origin,axis):
        r=af/math.sqrt(3)
        pts=[V(r*math.cos(i*math.pi/3),r*math.sin(i*math.pi/3),0) for i in range(6)]
        shape=Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(0,0,length))
        shape.Placement=App.Placement(origin,App.Rotation(V(0,0,1),axis))
        return shape

    # Rear housing and open reservoir. Hydraulic bore is intentionally not inferred.
    cap_top=BODY_AND_CAP_HEIGHT-BODY_RADIUS
    cap_bottom=cap_top-CAP_HEIGHT
    barrel=cx(BODY_RADIUS,REAR_TO_FLANGE_FACE,0)
    reservoir=Part.makeCylinder(RESERVOIR_DIAMETER/2,cap_bottom,V(RESERVOIR_X,0,0))
    housing=barrel.fuse(reservoir)
    housing=housing.cut(Part.makeCylinder(RESERVOIR_DIAMETER/2-RESERVOIR_WALL,cap_bottom,
                                        V(RESERVOIR_X,0,5)))
    # Small pushrod guide recess, external representation only.
    housing=housing.cut(cx(PUSHROD_DIAMETER/2+0.5,12,REAR_TO_FLANGE_FACE-10))
    axis=V(0.5,0,math.sqrt(3)/2)
    base=V(OUTLET_BASE_X,0,10)
    outlet_boss=Part.makeCylinder(8,14,base,axis)
    housing=housing.fuse(outlet_boss)
    outlet_drill=Part.makeCylinder(OUTLET_THREAD_DIAMETER/2,20,base+axis*2,axis)
    housing=housing.cut(outlet_drill).removeSplitter()
    add('Housing','Cylinder housing and reservoir',housing)

    # End-view mounting flange: width and hole positions specified; outline estimated.
    x=REAR_TO_FLANGE_FACE-FLANGE_THICKNESS
    half=MOUNT_HOLE_SPACING/2;r=FLANGE_TIP_RADIUS;wide=FLANGE_WIDTH/2
    p=lambda y,z:V(x,y,z)
    points=[p(-r,half),p(-wide,10),p(-wide,-10),p(-r,-half)]
    edges=[Part.makeLine(points[i],points[i+1]) for i in range(3)]
    edges.append(Part.Arc(p(-r,-half),p(0,-half-r),p(r,-half)).toShape())
    right=[p(r,-half),p(wide,-10),p(wide,10),p(r,half)]
    edges.extend(Part.makeLine(right[i],right[i+1]) for i in range(3))
    edges.append(Part.Arc(p(r,half),p(0,half+r),p(-r,half)).toShape())
    flange=Part.Face(Part.Wire(edges)).extrude(V(FLANGE_THICKNESS,0,0))
    for z in (-half,half):
        flange=flange.cut(Part.makeCylinder(MOUNT_HOLE_DIAMETER/2,FLANGE_THICKNESS+2,V(x-1,0,z),V(1,0,0)))
    flange=flange.cut(cx(PUSHROD_DIAMETER/2+0.5,FLANGE_THICKNESS+2,x-1))
    add('MountingFlange','Mounting flange - two diameter 10.2 holes at 57.1 centres',flange,
        note='Width 44.5, hole diameter 10.2 and spacing 57.1 stated. Thickness and outline estimated.')

    # Reservoir cap with simple raised ribs; exact outside diameter and total height.
    cap=Part.makeCylinder(CAP_DIAMETER/2-0.8,CAP_HEIGHT,V(RESERVOIR_X,0,cap_bottom))
    for i in range(32):
        a=2*math.pi*i/32;r=CAP_DIAMETER/2-0.8
        rib=Part.makeCylinder(0.8,CAP_HEIGHT-1,V(RESERVOIR_X+r*math.cos(a),r*math.sin(a),cap_bottom+0.5))
        cap=cap.fuse(rib)
    cap=cap.cut(Part.makeCylinder(RESERVOIR_DIAMETER/2-0.7,CAP_HEIGHT-3,V(RESERVOIR_X,0,cap_bottom-0.1)))
    add('ReservoirCap','Reservoir cap - diameter 51.2',cap.removeSplitter(),CAP,
        note='Diameter 51.2 and combined body/cap height 86.4 stated; ribbing and cap height estimated.')

    # Angled outlet represented as a bored hex adapter, not a plugged port.
    outlet=hex_prism(14,9,base+axis*14,axis)
    outlet=outlet.fuse(Part.makeCylinder(OUTLET_THREAD_DIAMETER/2+1,4,base+axis*23,axis))
    outlet=outlet.cut(Part.makeCylinder(OUTLET_THREAD_DIAMETER/2,29,base,axis))
    add('OutletFitting','3/8-24 outlet - simplified thread envelope',outlet,STEEL,
        note='3/8-24 outlet stated. Angle, boss and fitting exterior estimated.')

    # Revolved dust boot, compressed by selected pushrod travel.
    start=REAR_TO_FLANGE_FACE;end=BOOT_END-STROKE_POSITION
    shoulder=start+(end-start)*0.36
    profile=[(start,BOOT_DIAMETER/2),(shoulder,BOOT_DIAMETER/2)]
    for i in range(1,BOOT_FOLDS*2+1):
        t=i/(BOOT_FOLDS*2)
        radius=BOOT_DIAMETER/2 if i%2==0 else BOOT_DIAMETER/2-7
        if i==BOOT_FOLDS*2:radius=BOOT_SMALL_RADIUS
        profile.append((shoulder+(end-shoulder)*t,radius))
    outer=[V(xx,rr,0) for xx,rr in profile]
    inner=[V(xx,rr-BOOT_WALL,0) for xx,rr in reversed(profile)]
    loop=outer+inner
    boot=Part.Face(Part.makePolygon(loop+[loop[0]])).revolve(V(),V(1,0,0),360)
    add('DustBoot','Dust boot - maximum diameter 35.6',boot,RUBBER,
        note='Diameter 35.6 stated; fold profile estimated. Original boot length restored after replacing the pushrod guide plate with an independent slider.')
    rod_end=OVERALL_LENGTH-STROKE_POSITION
    rod=cx(PUSHROD_DIAMETER/2,rod_end-(REAR_TO_FLANGE_FACE-10),REAR_TO_FLANGE_FACE-10)
    add('Pushrod','5/16-24 pushrod (plain thread envelope)',rod,STEEL,moving,
        note='5/16-24 end thread and stroke 31.8 stated; unthreaded segment estimated.')
    nut_start=rod_end-15
    nut=hex_prism(12.7,5,V(nut_start,0,0),V(1,0,0)).cut(cx(PUSHROD_THREAD_DIAMETER/2,7,nut_start-1))
    add('PushrodLocknut','Pushrod locknut',nut,STEEL,moving)
    doc.recompute()
    return assembly

# Place the two reference components above the machine's left side in XZ.
# Their geometry is embedded as ordinary Python above; no external file is read.
_machine_bounds = App.BoundBox()
for _obj in list(doc.Objects):
    if _obj.isDerivedFrom('Part::Feature') and not _obj.Name.startswith('CycleReadout') and not _obj.Shape.isNull():
        _shape = _obj.Shape.copy()
        _parent = _obj.getGlobalPlacement().multiply(_obj.Placement.inverse())
        _shape.Placement = _parent.multiply(_shape.Placement)
        _machine_bounds.add(_shape.BoundBox)
wilwood_reference_parts = doc.addObject('App::Part','WilwoodReferenceParts')
wilwood_reference_parts.Label = 'Wilwood master cylinder - upper left reference part'
wilwood_master = create_wilwood_260_1304(doc)
wilwood_reference_parts.addObject(wilwood_master)
# Preserve the user's final master-cylinder position independently of new geometry.
wilwood_master.Placement = App.Placement(V(519.3,-725.0,293.59679878155),App.Rotation(V(0,0,1),180.0))
doc.recompute()


class MasterCylinderCamFollower:
    """X-only master follower with an optional roller and ideal spring return.

    Initial tracing uses the original flat tip. The roller installer then
    moves the whole cylinder back, attaches its fork and pin, and switches
    contact to the cam profile offset by the roller radius. Only the roller
    rotates; the pushrod and fork continue to translate along global X.
    """
    def __init__(self, document, master, cams):
        self.roller=None
        self.slider=None
        self.master,self.cams=master,list(cams)
        self.cam=cam=self.cams[0]
        self.moving=document.MovingParts
        self.parts=list(self.moving.Group)
        self.rest={obj.Name:obj.getGlobalPlacement() for obj in self.parts}
        self.tip=master.getGlobalPlacement().multVec(V(master.OverallLength.Value,0,0))
        direction=master.getGlobalPlacement().Rotation.multVec(V(-1,0,0))
        if (direction-V(1,0,0)).Length>1e-7:
            raise ValueError('Master cam follower expects the cylinder to retract along global +X.')
        self.rod_radius=7.94/2.0
        self.limit=master.MaximumStroke.Value
        self.state=document.addObject('App::FeaturePython','MasterCylinderCamMotion')
        self.state.Label='Wilwood master - X-only cam follower'
        for name,kind in [('Stroke','App::PropertyLength'),('MaximumStroke','App::PropertyLength'),
                          ('Contact','App::PropertyBool'),('ContactPoint','App::PropertyVector'),
                          ('ReturnPosition','App::PropertyVector'),('Cam','App::PropertyLink'),
                          ('MovingParts','App::PropertyLink'),('MotionModel','App::PropertyString')]:
            self.state.addProperty(kind,name,'Cam follower')
        self.state.MaximumStroke=self.limit
        self.state.ReturnPosition=self.tip
        self.state.Cam=cam;self.state.MovingParts=self.moving
        self.state.addProperty("App::PropertyLinkList","Cams","Cam follower");self.state.Cams=self.cams
        self.state.addProperty("App::PropertyLink","ActiveCam","Cam follower")
        self.state.MotionModel='Contact with the outer envelope of all fifteen OD100 cams (maximum displacement, never summed); flat rod end; global X translation only; ideal spring return to the original extension when clear. Hydraulic slave and opening linkage follow the master stroke.'
        for name in self.state.PropertiesList:
            if name in ('Stroke','Contact','ContactPoint','MaximumStroke','ReturnPosition','Cam','MovingParts','MotionModel'):
                self.state.setEditorMode(name,1)
        self.update()

    def contact_for_profile(self,cam):
        if self.roller is not None:return self.contact_for_roller(cam)
        placement=cam.getGlobalPlacement();m=placement.toMatrix()
        y=max(placement.Base.y-cam.Thickness.Value/2,min(self.tip.y,placement.Base.y+cam.Thickness.Value/2))
        dy=y-self.tip.y
        if abs(dy)>self.rod_radius:return 0.0,V(self.tip)
        hh=math.sqrt(max(0,self.rod_radius**2-dy**2))
        low,high=self.tip.z-hh,self.tip.z+hh
        best=-1e100;best_z=self.tip.z
        previous=None
        for x,z in self.profile_points:
            wx=m.A11*x+m.A13*z+m.A14;wz=m.A31*x+m.A33*z+m.A34
            if low<=wz<=high and wx>best:best,best_z=wx,wz
            if previous is not None:
                px,pz=previous
                for limit in (low,high):
                    if (pz-limit)*(wz-limit)<0:
                        ix=px+(wx-px)*(limit-pz)/(wz-pz)
                        if ix>best:best,best_z=ix,limit
            previous=(wx,wz)
        return max(0,best-self.tip.x),V(max(self.tip.x,best),y,best_z)

    def contact_for_roller(self,cam,placement=None):
        """Right-hand offset of the actual cam spline by the roller radius.

        The cached spline chords have 0.0001 mm deflection. Each chord is
        offset analytically: evaluate its ends and the interior tangent point.
        This avoids treating the roller as a flat face or moving it through
        the cam on steep parts of the profile.
        """
        placement=placement or cam.getGlobalPlacement();m=placement.toMatrix()
        centre=self.roller_centre;radius=self.roller_radius
        half_cam=cam.Thickness.Value/2
        if min(centre.y+self.roller_width/2,placement.Base.y+half_cam)<=max(centre.y-self.roller_width/2,placement.Base.y-half_cam):
            return 0.0,V(centre)
        best=-1e100;best_point=None;previous=None
        contact_y=max(centre.y-self.roller_width/2,min(placement.Base.y,centre.y+self.roller_width/2))
        def candidate(x,z):
            nonlocal best,best_point
            dz=centre.z-z
            if abs(dz)<=radius:
                required=x+math.sqrt(max(0,radius*radius-dz*dz))
                if required>best:
                    best=required;best_point=V(x,contact_y,z)
        for x,z in self.profile_points:
            wx=m.A11*x+m.A13*z+m.A14;wz=m.A31*x+m.A33*z+m.A34
            candidate(wx,wz)
            if previous is not None:
                px,pz=previous;dx=wx-px;dz=wz-pz
                if abs(dz)>1e-12 and max(pz,wz)>=centre.z-radius and min(pz,wz)<=centre.z+radius:
                    length=math.hypot(dx,dz)
                    tangent_z=centre.z+radius*dx*math.copysign(1.0,dz)/length
                    u=(tangent_z-pz)/dz
                    if 0<u<1:candidate(px+u*dx,tangent_z)
            previous=(wx,wz)
        if best_point is None:raise RuntimeError('Roller has no cam profile in its contact plane.')
        return max(0,best-centre.x),best_point

    def make_roller_spin_table(self,cam):
        """Integrate ideal rolling contact over one cycle; hold angle when clear."""
        pivot=cam.getGlobalPlacement().Base
        self.roller_spin_table=[0.0];previous_rate=None
        self.roller_spin_step=0.25
        for i in range(1441):
            phase=i*self.roller_spin_step
            placement=App.Placement(pivot,App.Rotation(V(0,1,0),-phase))
            stroke,point=self.contact_for_roller(cam,placement)
            centre_x=self.roller_centre.x+stroke
            # With a +X translating follower and cam angle = -cycle phase,
            # tangential no-slip gives d(roller angle)/d(phase) = qx/(R*nx).
            rate=(point.x-pivot.x)/(centre_x-point.x) if stroke>1e-8 else 0.0
            if previous_rate is not None:
                increment=(rate+previous_rate)*0.5*math.radians(self.roller_spin_step)
                self.roller_spin_table.append(self.roller_spin_table[-1]+increment)
            previous_rate=rate

    def update_roller_rotation(self,stroke):
        phase=-duck_bill_motion.state.DriverAngle.Value
        turns=math.floor(phase/360.0);fraction=(phase-turns*360.0)/self.roller_spin_step
        index=min(1439,int(fraction));weight=fraction-index
        table=self.roller_spin_table
        angle=turns*table[-1]+table[index]*(1-weight)+table[index+1]*weight
        centre=self.roller_centre+V(stroke,0,0)
        rotation=App.Rotation(V(0,1,0),math.degrees(angle))
        spin=App.Placement(centre-rotation.multVec(centre),rotation)
        translation=App.Placement(V(stroke,0,0),App.Rotation())
        for obj in (self.roller,self.roller_mark):
            world=spin.multiply(translation).multiply(self.rest[obj.Name])
            parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
            obj.Placement=parent.inverse().multiply(world)
        self.state.RollerCentre=centre
        self.state.RollerAngle=math.degrees(angle)

    def contact_for_cam(self, cam):
        if "ProfileOutline" in cam.PropertiesList:return self.contact_for_profile(cam)
        shape=cam.Shape
        parent=cam.getGlobalPlacement().multiply(cam.Placement.inverse())
        # Cam is a solid cylinder rotating in the XZ plane.
        centre=parent.multVec(shape.Solids[0].CenterOfMass)
        half_thickness=cam.Thickness.Value/2.0
        y=max(centre.y-half_thickness,min(self.tip.y,centre.y+half_thickness))
        dy=y-self.tip.y
        stroke=0.0
        contact_point=V(self.tip)
        if abs(dy)<=self.rod_radius:
            half_height=math.sqrt(max(0.0,self.rod_radius**2-dy**2))
            z=max(self.tip.z-half_height,min(centre.z,self.tip.z+half_height))
            dz=z-centre.z
            radius=cam.OutsideDiameter.Value/2.0
            if abs(dz)<=radius:
                x=centre.x+math.sqrt(max(0.0,radius**2-dz**2))
                stroke=max(0.0,x-self.tip.x)
                contact_point=V(x,y,z)
        return stroke, contact_point

    def update(self):
        contacts=[(self.contact_for_cam(cam),cam) for cam in self.cams]
        (stroke,contact_point),active=max(contacts,key=lambda item:item[0][0])
        self.state.ActiveCam=active if stroke>1e-8 else None
        if stroke>self.limit+1e-7:
            raise RuntimeError('Cam requires %.3f mm travel; master limit is %.3f mm.'%(stroke,self.limit))
        translation=App.Placement(V(stroke,0,0),App.Rotation())
        for obj in self.parts:
            parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
            obj.Placement=parent.inverse().multiply(translation).multiply(self.rest[obj.Name])
        self.master.StrokePosition=stroke
        self.state.Stroke=stroke
        self.state.Contact=stroke>1e-8
        self.state.ContactPoint=contact_point
        if self.roller is not None:self.update_roller_rotation(stroke)
        if self.slider is not None:self.slider.update(stroke)


master_cam_motion=MasterCylinderCamFollower(doc,wilwood_master,[doc.sprocket_16T_rim_disc,doc.sprocket_16T_rim_disc_02,doc.sprocket_16T_rim_disc_03,doc.sprocket_16T_rim_disc_04,doc.sprocket_16T_rim_disc_05,doc.sprocket_16T_rim_disc_06,doc.sprocket_16T_rim_disc_07,doc.sprocket_16T_rim_disc_08,doc.sprocket_16T_rim_disc_09,doc.sprocket_16T_rim_disc_10,doc.sprocket_16T_rim_disc_11,doc.sprocket_16T_rim_disc_12,doc.sprocket_16T_rim_disc_13,doc.sprocket_16T_rim_disc_14,doc.sprocket_16T_rim_disc_15])
App.master_cylinder_cam_motion=master_cam_motion
doc.recompute()


class SlaveCylinderHydraulicMotion:
    """Volume-driven jaws, fixed-length tie rods and a rear-pivoting pull cylinder."""
    def __init__(self, document, master_motion, mount):
        self.doc, self.master_motion, self.mount = document, master_motion, mount
        self.geometry = duck_bill_opening_geometry
        self.prefix = 'Closed_0deg_'
        self.parts = list(document.Closed_0deg_PullRodParts.Group)
        self.fixed = list(document.Closed_0deg_CylinderFixedParts.Group)
        self.frame = mount.relative[self.prefix+'CylinderBody']
        self.members = [o for o in mount.parts if o.Name.startswith(self.prefix)]
        self.relative = {o.Name:self.frame.inverse().multiply(mount.relative[o.Name]) for o in self.members}
        self.state = document.addObject('App::FeaturePython','SlaveHydraulicMotion')
        self.state.Label = 'Hydraulic duck-bill opening with swivelling rear cylinder mount'
        for name,value in (('MasterBore',19.05),('SlaveBore',22.225),('MaximumStroke',34.9),
                           ('MasterStroke',0),('SlaveStroke',0),('EyeAlignmentError',0),('TieRodClosureError',0)):
            self.state.addProperty('App::PropertyLength',name,'Hydraulics');setattr(self.state,name,value)
        for name in ('InputOpening','FollowerOpening','CylinderSwivel'):
            self.state.addProperty('App::PropertyAngle',name,'Kinematics')
        self.state.addProperty('App::PropertyFloat','SlaveToMasterRatio','Hydraulics')
        self.state.addProperty('App::PropertyString','Assumptions','Hydraulics')
        self.state.Assumptions='Ideal nominal full-bore volume ratio retained from v78. Fixed pivot centres and tie-rod lengths; rear swivel tube and threaded boss rotate with cylinder. Orange pose is a 20-degree reference.'
        self.state.addProperty('App::PropertyLinkList','DrivenParts','Hydraulics')
        self.state.DrivenParts=self.parts
        self.update()

    @staticmethod
    def about(pivot,rotation):
        return App.Placement(pivot-rotation.multVec(pivot),rotation)

    def pose_at_angle(self,degrees):
        g=self.geometry;a=math.radians(degrees);off=g['offset'];u=g['upper_arm'];l=g['lower_arm']
        y=2*(g['mount_y']+off)-off*math.cos(a)-u*math.sin(a)
        z=-off*math.sin(a)+u*math.cos(a)
        cc=off*y-l*z;ss=l*y+off*z
        rhs=(y*y+z*z+off*off+l*l-g['link_length']**2)/2
        phase=math.atan2(ss,cc);root=math.acos(max(-1,min(1,rhs/math.hypot(cc,ss))))
        candidates=[(v+math.pi)%(2*math.pi)-math.pi for v in (phase+root,phase-root)]
        follower=min(candidates,key=abs)
        first=self.about(g['pivot_original'],App.Rotation(V(1,0,0),degrees))
        second=self.about(g['pivot_rotated'],App.Rotation(V(1,0,0),math.degrees(follower)))
        eye=second.multVec(g['eye'])
        stroke=309.0-(eye-g['rear']).Length
        return stroke,first,second,eye,math.degrees(follower)

    def solve(self,stroke):
        lo,hi=0.0,25.0
        if stroke < -1e-8 or stroke > self.pose_at_angle(hi)[0]+1e-8:
            raise RuntimeError('Required hydraulic stroke exceeds the validated 0-25 degree opening range.')
        for _ in range(48):
            mid=(lo+hi)/2
            if self.pose_at_angle(mid)[0]<stroke:lo=mid
            else:hi=mid
        angle=(lo+hi)/2
        _,first,second,eye,follower=self.pose_at_angle(angle)
        axis=eye-self.geometry['rear'];axis.normalize()
        cylinder=self.about(self.geometry['rear'],App.Rotation(V(0,0,-1),axis))
        pull=App.Placement(-axis*stroke,App.Rotation()).multiply(cylinder)
        return angle,follower,first,second,eye,cylinder,pull

    def update(self):
        master=self.master_motion.state.Stroke.Value
        ratio=(self.state.MasterBore.Value/self.state.SlaveBore.Value)**2
        stroke=master*ratio
        if stroke>self.state.MaximumStroke.Value:raise RuntimeError('Slave stroke limit exceeded.')
        angle,follower,first,second,eye,cylinder,pull=self.solve(stroke)
        g=self.geometry;transforms={}
        for name in g['original']:transforms[name]=first
        for name in g['rotated']:transforms[name]=second
        for obj in self.fixed:transforms[obj.Name[len(self.prefix):]]=cylinder
        for obj in self.parts:
            transforms[obj.Name[len(self.prefix):]]=pull
            obj.PullStroke=stroke;obj.MountingSpan=309.0-stroke
        for name in ('WilwoodArmBush','WilwoodEyeSpacer','WilwoodRearWasher','WilwoodFrontWasher','WilwoodActuatingPin','WilwoodPinNut'):
            transforms[name]=second
        for name in ('WilwoodRearMountTube','WilwoodRearThreadBoss'):transforms[name]=cylinder
        error=0.0
        for side,(a0,b0) in zip(('Left','Right'),g['tie_endpoints']):
            a=first.multVec(a0);b=second.multVec(b0)
            rotation=App.Rotation(b0-a0,b-a)
            tie=App.Placement(a-rotation.multVec(a0),rotation)
            error=max(error,abs((b-a).Length-g['link_length']))
            transforms[side+'ThreadedTieRod']=tie
            for end,start,current in (('Upper',a0,a),('Lower',b0,b)):
                for suffix in ('RodEnd','JamNut'):transforms[side+end+suffix]=tie
                for suffix in ('Ball','Spacer','Washer','PivotBolt','PivotNut'):
                    transforms[side+end+suffix]=App.Placement(current-start,App.Rotation())
        frame=self.mount.arm.getGlobalPlacement().multiply(self.frame)
        for obj in self.members:
            delta=transforms.get(obj.Name[len(self.prefix):],App.Placement())
            desired=frame.multiply(delta).multiply(self.relative[obj.Name])
            parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
            obj.Placement=parent.inverse().multiply(desired)
        self.state.MasterStroke=master;self.state.SlaveStroke=stroke;self.state.SlaveToMasterRatio=ratio
        self.state.InputOpening=angle;self.state.FollowerOpening=abs(follower)
        self.state.CylinderSwivel=math.degrees(cylinder.Rotation.Angle)
        self.state.EyeAlignmentError=(pull.multVec(g['eye'])-eye).Length
        self.state.TieRodClosureError=error
        if max(error,self.state.EyeAlignmentError.Value)>1e-6:
            raise RuntimeError('Hydraulic opening linkage lost pin alignment.')


slave_hydraulic_motion=SlaveCylinderHydraulicMotion(doc,master_cam_motion,duck_bill_mount)
App.slave_hydraulic_motion=slave_hydraulic_motion

# Rebuild the tip path analytically, without repeatedly moving all CAD solids.
if duck_bill_tip_motion_outline is not None:
    outline=duck_bill_tip_motion_outline
    motion=duck_bill_motion;hydraulic=slave_hydraulic_motion;master=master_cam_motion
    saved_slot,saved_angle=motion.slot_x,motion.arm_angle
    raw_tip=hydraulic.relative['Closed_0deg_FoldedSheet'].multVec(outline.TipLocalPoint)
    # Track the same two material tip points throughout opening and closing.
    second_cone=doc.Closed_0deg_FoldedSheet_Rotated
    second_rest=duck_bill_mount.arm.getGlobalPlacement().multiply(duck_bill_mount.relative[second_cone.Name])
    second_shape=second_cone.Shape.copy();second_shape.Placement=second_rest
    vertices,_=second_shape.tessellate(0.05)
    second_tip=second_rest.inverse().multVec(min(vertices,key=lambda point:point.z))
    outline.addProperty('App::PropertyLink','SecondTipObject','Motion envelope')
    outline.SecondTipObject=second_cone
    outline.addProperty('App::PropertyVector','SecondTipLocalPoint','Motion envelope')
    outline.SecondTipLocalPoint=second_tip
    outline.addProperty('App::PropertyString','TrackingMode','Motion envelope')
    outline.TrackingMode='Midpoint of both CLOSED cone tips only; never include opening in this line'
    raw_tip_second=hydraulic.relative[second_cone.Name].multVec(second_tip)
    # Permanent user rule: this path uses CLOSED jaws only, independent of hydraulics.
    raw_midpoint=(raw_tip+raw_tip_second)*0.5
    def closed_tip_at_phase(phase):
        angle=-phase
        rot=App.Rotation(V(0,1,0),angle)
        target=motion.driver_rest.Base+rot.multVec(motion.d0-motion.driver_rest.Base)
        guide_rot=App.Rotation(V(0,1,0),angle*T3/T1)
        centre=motion.guide_driver_rest.Base
        guide=App.Placement(centre-guide_rot.multVec(centre),guide_rot).multiply(motion.guide_rest)
        motion.solve_follower(target,guide)
        arm_rot=App.Rotation(V(0,1,0),-math.degrees(motion.arm_angle))
        a=guide.multVec(V(motion.fixed_pin_x,6,0))
        arm=App.Placement(a-arm_rot.multVec(motion.a0),arm_rot).multiply(motion.rest['duck_bill_arm_two'])
        return arm.multiply(hydraulic.frame).multVec(raw_midpoint)
    try:
        samples=[(step*0.5,closed_tip_at_phase(step*0.5)) for step in range(721)]
        best=min(samples[:-1],key=lambda item:item[1].z)[0]
        lo,hi=best-0.5,best+0.5
        # Refine the lowest Z beyond the displayed half-degree sampling.
        for _ in range(55):
            left=lo+(hi-lo)/3;right=hi-(hi-lo)/3
            if closed_tip_at_phase(left).z<closed_tip_at_phase(right).z:hi=right
            else:lo=left
        bottom_phase=((lo+hi)/2)%360
        bottom_point=closed_tip_at_phase(bottom_phase)
        samples.append((bottom_phase,bottom_point));samples.sort(key=lambda item:item[0])
        points=[point for phase,point in samples]
    finally:
        motion.slot_x,motion.arm_angle=saved_slot,saved_angle
    if (points[-1]-points[0]).Length>1e-6:raise RuntimeError('Closed tip path did not close.')
    points[-1]=points[0]
    outline.Shape=Part.makePolygon(points)
    outline.Label='Closed cone-tip midpoint trajectory - opening excluded'
    outline.Description='Permanent rule: trace only the midpoint of both CLOSED cone tips. Jaw opening never changes this line. Equal blue dashes and gaps.'
    outline.addProperty('App::PropertyAngle','LowestCyclePhase','Timing');outline.LowestCyclePhase=bottom_phase
    outline.addProperty('App::PropertyVector','LowestPoint','Timing');outline.LowestPoint=bottom_point
    # Peak contact occurs when the cam centre is at +X from the shaft centre.
    # During a positive cycle phase the XZ cam angle increases by that phase.
    cam=master.cam
    initial_angle=(-bottom_phase)%360
    pivot=doc.sprocket_16T_shaft_disc.Shape.Solids[0].CenterOfMass
    a=math.radians(initial_angle);radius=cam.CentreRadius.Value
    world=cam.getGlobalPlacement()
    world.Base=pivot+V(radius*math.cos(a),0,radius*math.sin(a))
    parent=cam.getGlobalPlacement().multiply(cam.Placement.inverse())
    cam.Placement=parent.inverse().multiply(world)
    motion.rest[cam.Name]=world
    cam.InitialAngle=initial_angle
    cam.Label='16T rim disc - OD100 x6, maximum opening at closed-path bottom'
    for index,extra in enumerate(master.cams[1:],start=1):
        extra_angle=(initial_angle-10.0*index)%360
        a=math.radians(extra_angle)
        extra_world=extra.getGlobalPlacement()
        extra_world.Base=pivot+V(radius*math.cos(a),0,radius*math.sin(a))
        parent=extra.getGlobalPlacement().multiply(extra.Placement.inverse())
        extra.Placement=parent.inverse().multiply(extra_world)
        motion.rest[extra.Name]=extra_world
        extra.InitialAngle=extra_angle
        extra.Label='16T rim disc %02d - OD100 x6, minus %g degrees from first cam'%(index+1,10.0*index)

    reset_simulation()


def add_smooth_traced_cam(document, master, motion):
    """Trace the disc envelope, replacing scallops and end corners by C2 blends.

    The original lobe centres bound the full-lift circular arc. A two-stage
    quintic radial blend meets both the 90 mm no-stroke radius and the 88 mm
    shaft disc tangentially with zero first/second radial derivatives.
    """
    originals=[document.sprocket_16T_shaft_disc]+list(master.cams)
    first=master.cams[0];last=master.cams[-1]
    start=last.InitialAngle.Value
    sweep=10.0*(len(master.cams)-1)
    base=originals[0].OutsideDiameter.Value/2
    peak=first.CentreRadius.Value+first.OutsideDiameter.Value/2
    pivot=originals[0].Shape.Solids[0].CenterOfMass
    rest_radius=master.tip.x-pivot.x  # Existing 2 mm clearance above the base circle.
    def smoothstep(t):return t*t*t*(10+t*(-15+6*t))
    def radius_at(angle):
        phase=(angle-start)%360
        if phase<=sweep:return peak
        distance=min(phase-sweep,360-phase)
        if distance>=48:return base
        if distance<=35:
            t=1-(distance/35.0)**1.5
            return rest_radius+(peak-rest_radius)*smoothstep(t)
        return base+(rest_radius-base)*smoothstep((48-distance)/13.0)
    points=[]
    for i in range(720):
        angle=i*0.5;r=radius_at(angle);a=math.radians(angle)
        points.append(V(r*math.cos(a),-3,r*math.sin(a)))
    curve=Part.BSplineCurve();curve.interpolate(Points=points,PeriodicFlag=True)
    edge=curve.toShape();wire=Part.Wire([edge])
    solid=Part.Face(wire).extrude(V(0,6,0))
    solid=solid.cut(Part.makeCylinder(10,8,V(0,-4,0),V(0,1,0)))
    if not solid.isValid() or len(solid.Solids)!=1:raise RuntimeError('Invalid smooth cam solid.')
    cam=document.addObject('Part::Feature','sprocket_16T_smooth_cam_disc')
    cam.Label='Hydraulic master cylinder actuation cam'
    cam.Shape=solid;cam.Placement=App.Placement(pivot,App.Rotation())
    for name,value in [('Thickness',6.0),('BoreDiameter',20.0),('BaseDiameter',176.0),
                       ('MaximumRadius',peak),('RiseBlendAngle',35.0),('BaseBlendAngle',13.0)]:
        kind='App::PropertyAngle' if name.endswith('Angle') else 'App::PropertyLength'
        cam.addProperty(kind,name,'Cam profile');setattr(cam,name,value)
    cam.addProperty('Part::PropertyPartShape','ProfileOutline','Cam profile');cam.ProfileOutline=wire
    cam.addProperty('App::PropertyLinkList','OriginalDiscs','Cam profile');cam.OriginalDiscs=originals
    cam.addProperty('App::PropertyString','ProfileMethod','Cam profile')
    cam.ProfileMethod='Periodic C2 spline tracing the original envelope; scallops filled; quintic entry/exit blends through the no-stroke radius. Closed-tip trajectory is unchanged.'
    cam.ViewObject.ShapeColor=document.sprocket_16T_01.ViewObject.ShapeColor
    cam.ViewObject.Transparency=50
    motion.crank_names=motion.crank_names+(cam.Name,)
    motion.rest[cam.Name]=cam.getGlobalPlacement()
    motion.state.RigidCrank=[document.getObject(n) for n in motion.crank_names]
    # Cache points on the actual spline at <=0.0001 mm chordal deflection.
    samples=edge.discretize(Deflection=0.0001)
    if (samples[-1]-samples[0]).Length>1e-8:samples.append(samples[0])
    master.profile_points=[(p.x,p.z) for p in samples]
    master.cams=[cam];master.state.Cams=[cam];master.state.Cam=cam
    master.state.MotionModel='Finite flat rod end follows the actual smooth cam outline, sampled at 0.0001 mm chordal tolerance; X-only translation, ideal spring return.'
    for obj in originals:obj.ViewObject.Visibility=ORIGINAL_CAM_DISC_VISIBILTY
    master.update()
    return cam


smooth_cam_disc=add_smooth_traced_cam(doc,master_cam_motion,duck_bill_motion)
reset_simulation()


def install_master_roller_follower(document,master,motion,cam):
    """Threaded fork, bearing roller and transverse axle; all plain construction."""
    roller_radius=MASTER_ROLLER_DIAMETER/2.0
    roller_width=MASTER_ROLLER_WIDTH
    axle_radius=MASTER_ROLLER_PIN_DIAMETER/2.0
    ahead=MASTER_ROLLER_CENTRE_AHEAD_OF_ROD
    if roller_radius<=0 or roller_width<cam.Thickness.Value+2 or axle_radius>=roller_radius:
        raise ValueError('Invalid roller follower dimensions.')
    # Undo only the current rod stroke, so attachments are built at full extension.
    for obj in motion.parts:
        parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
        obj.Placement=parent.inverse().multiply(motion.rest[obj.Name])
    old_tip=V(motion.tip);pivot=cam.getGlobalPlacement().Base
    target_stroke=cam.MaximumRadius.Value-(old_tip.x-pivot.x)
    dz=old_tip.z-pivot.z
    # A small correction for the original 0.4032 mm Z offset keeps the same lift.
    peak_centre_x=pivot.x+math.sqrt((cam.MaximumRadius.Value+roller_radius)**2-dz*dz)
    rest_centre_x=peak_centre_x-target_stroke
    backwards=rest_centre_x+ahead-old_tip.x
    placement=master.getGlobalPlacement();placement.Base+=V(backwards,0,0)
    parent=master.getGlobalPlacement().multiply(master.Placement.inverse())
    master.Placement=parent.inverse().multiply(placement)
    master.addProperty('App::PropertyLength','RollerFollowerBackwardShift','Roller follower')
    master.RollerFollowerBackwardShift=backwards
    master.ModellingNotes+=' Roller fork attachment is editable reference geometry; cylinder moved backward along its own axis to preserve the existing maximum hydraulic stroke.'
    group=document.MovingParts
    def add(name,label,shape,colour):
        if not shape.isValid():raise RuntimeError('Invalid roller follower geometry: '+name)
        obj=document.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape;group.addObject(obj)
        obj.ViewObject.ShapeColor=colour;obj.ViewObject.LineColor=(0.12,0.12,0.12)
        return obj
    # Local +X points out of the cylinder; local Y is the transverse pin axis.
    end=master.OverallLength.Value;centre_x=end+ahead
    cheek_inner=roller_width/2+1.0;cheek_thickness=3.0;cheek_outer=cheek_inner+cheek_thickness
    # A 10 mm engagement on the existing 5/16-24 pushrod, with a blind end.
    boss=Part.makeCylinder(8,16,V(end-10,0,0),V(1,0,0))
    boss=boss.cut(Part.makeCylinder(7.9375/2,11,V(end-10.01,0,0),V(1,0,0)))
    fork=boss
    for y in (-cheek_outer,cheek_inner):
        cheek=Part.makeBox(ahead-3,cheek_thickness,10,V(end+3,y,-5))
        cheek=cheek.fuse(Part.makeCylinder(5,cheek_thickness,V(centre_x,y,0),V(0,1,0)))
        cheek=cheek.cut(Part.makeCylinder(axle_radius+0.05,cheek_thickness+2,V(centre_x,y-1,0),V(0,1,0)))
        fork=fork.fuse(cheek)
    fork=add('MasterFollowerFork','Master pushrod - threaded roller fork',fork.removeSplitter(),(0.42,0.46,0.51))
    fork.addProperty('App::PropertyString','Attachment','Roller follower')
    fork.Attachment='5/16-24 nominal blind thread, 10 mm rod engagement; two 3 mm cheeks; 1 mm end clearance on each side of roller. Threads shown as plain envelopes.'
    roller=Part.makeCylinder(roller_radius,roller_width,V(0,-roller_width/2,0),V(0,1,0))
    roller=roller.cut(Part.makeCylinder(axle_radius+0.1,roller_width+2,V(0,-roller_width/2-1,0),V(0,1,0)))
    roller=add('MasterCamFollowerRoller','Master cam follower - diameter 20 x10 roller',roller,(0.80,0.82,0.85))
    roller.Placement=App.Placement(V(centre_x,0,0),App.Rotation())
    for prop,val in [('OutsideDiameter',roller_radius*2),('Width',roller_width),('BoreDiameter',2*(axle_radius+0.1))]:
        roller.addProperty('App::PropertyLength',prop,'Roller follower');setattr(roller,prop,val)
    roller.addProperty('App::PropertyString','BearingModel','Roller follower')
    roller.BearingModel='Freely rotating reference roller on transverse pin; bearing internals omitted. Ideal no-slip rotation while in cam contact.'
    axle=Part.makeCylinder(axle_radius,2*(cheek_outer+1),V(centre_x,-cheek_outer-1,0),V(0,1,0))
    axle=axle.fuse(Part.makeCylinder(5,2,V(centre_x,-cheek_outer-3,0),V(0,1,0)))
    axle=axle.fuse(Part.makeCylinder(5,2,V(centre_x,cheek_outer+1,0),V(0,1,0)))
    pin=add('MasterFollowerAxle','Master follower - diameter 6 pin with retaining ends',axle,(0.62,0.65,0.69))
    # A painted radial marker makes roller rotation visible without altering contact.
    mark=add('MasterFollowerRollerMark','Roller rotation indicator',Part.makeLine(V(axle_radius+0.7,-roller_width/2-0.01,0),V(roller_radius-1,-roller_width/2-0.01,0)),(0.12,0.35,0.85))
    mark.ViewObject.LineColor=(0.12,0.35,0.85);mark.ViewObject.LineWidth=2.0
    mark.Placement=App.Placement(V(centre_x,0,0),App.Rotation())
    motion.parts=list(group.Group)
    motion.rest={obj.Name:obj.getGlobalPlacement() for obj in motion.parts}
    motion.tip=master.getGlobalPlacement().multVec(V(end,0,0))
    motion.roller_centre=master.getGlobalPlacement().multVec(V(centre_x,0,0))
    motion.roller_radius=roller_radius;motion.roller_width=roller_width
    motion.roller=roller;motion.roller_mark=mark
    motion.state.ReturnPosition=motion.tip
    for prop,kind,value in [('Roller','App::PropertyLink',roller),('Fork','App::PropertyLink',fork),('Axle','App::PropertyLink',pin),
                            ('RollerCentre','App::PropertyVector',motion.roller_centre),('RollerAngle','App::PropertyAngle',0.0),
                            ('RollerRestCentre','App::PropertyVector',motion.roller_centre)]:
        motion.state.addProperty(kind,prop,'Roller follower');setattr(motion.state,prop,value)
    motion.state.Label='Wilwood master - X-only roller cam follower'
    motion.state.MotionModel='Diameter 20 roller follows the actual smooth cam spline offset by its radius. Threaded fork, pin and pushrod translate along global X only. Roller rotates about Y with ideal no-slip contact; rotation integrated every 0.25 cycle degree and held while clear. Ideal spring return.'
    motion.make_roller_spin_table(cam)
    motion.update()
    return roller


master_roller_follower=install_master_roller_follower(doc,wilwood_master,master_cam_motion,smooth_cam_disc)
reset_simulation()


class MasterBushedSlider:
    """Two-bush cam carriage; spherical-to-flat contact transmits axial push only."""
    def __init__(self, document, master, motion):
        self.doc,self.master,self.motion=document,master,motion
        # Recover the uncompressed reference poses before changing parent groups.
        for obj in motion.parts:
            parent=obj.getGlobalPlacement().multiply(obj.Placement.inverse())
            obj.Placement=parent.inverse().multiply(motion.rest[obj.Name])
        self.origin=V(motion.roller_centre)
        self.frame=App.Placement(self.origin,App.Rotation())
        roller_rests={obj.Name:motion.rest[obj.Name] for obj in (motion.roller,motion.roller_mark)}
        roller_shape=motion.roller.Shape.copy();roller_shape.Placement=App.Placement()
        mark_shape=motion.roller_mark.Shape.copy();mark_shape.Placement=App.Placement()
        for old_name in ('MasterFollowerFork','MasterCamFollowerRoller','MasterFollowerRollerMark','MasterFollowerAxle'):
            document.removeObject(old_name)
        assembly=document.addObject('App::DocumentObjectGroup','MasterCamSlider')
        assembly.Label='Bushed cam slider and master mounting bracket'
        assembly.addProperty('App::PropertyPlacement','ReferenceFrame','Slider geometry');assembly.ReferenceFrame=self.frame
        fixed=document.addObject('App::DocumentObjectGroup','MasterSliderFixedParts')
        fixed.Label='Fixed bearing frame, bushes and stops';assembly.addObject(fixed)
        moving=document.addObject('App::DocumentObjectGroup','MasterSliderMovingParts')
        moving.Label='Slider ram, roller and axle';assembly.addObject(moving)
        self.assembly,self.fixed,self.moving=assembly,fixed,moving
        steel=(0.43,0.49,0.56);bronze=(0.70,0.46,0.20)
        def add(name,label,shape,colour,group=fixed):
            if shape.isNull() or not shape.isValid() or (not shape.Solids):
                raise RuntimeError('Invalid bushed slider component: '+name)
            o=document.addObject('Part::Feature',name);o.Label=label;o.Shape=shape;group.addObject(o);o.Placement=self.frame
            o.ViewObject.ShapeColor=colour;o.ViewObject.LineColor=(0.10,0.12,0.14)
            return o
        self.add=add
        # New plunger tip is 198 mm behind the unchanged roller rest centre.
        desired_tip=self.origin+V(198,0,0)
        shift=desired_tip-motion.tip
        if abs(shift.y)>1e-7 or abs(shift.z)>1e-7:raise RuntimeError('Slider must remain coaxial with master.')
        placement=master.getGlobalPlacement();placement.Base+=shift
        parent=master.getGlobalPlacement().multiply(master.Placement.inverse())
        master.Placement=parent.inverse().multiply(placement)
        master.addProperty('App::PropertyLength','BushedSliderBackwardShift','Bushed slider')
        master.BushedSliderBackwardShift=shift.x
        master.ModellingNotes+=' Version106: master moved backward for an independent bushed slider. Pushrod receives a centred axial push through a flat threaded pad; roller is carried by the slider, not the master rod.'
        # Recreate the roller in the independent group. Reparenting a linked Part
        # can move its dependency group; native copies keep the mechanism hierarchy fixed.
        roller=add('MasterCamFollowerRoller','Cam follower roller - diameter20 x10',roller_shape,(0.80,0.82,0.85),moving)
        roller.Placement=roller_rests['MasterCamFollowerRoller']
        for prop,val in [('OutsideDiameter',20.0),('Width',10.0),('BoreDiameter',8.2)]:
            roller.addProperty('App::PropertyLength',prop,'Roller follower');setattr(roller,prop,val)
        mark=document.addObject('Part::Feature','MasterFollowerRollerMark')
        mark.Label='Roller rotation indicator';mark.Shape=mark_shape;moving.addObject(mark)
        mark.Placement=roller_rests['MasterFollowerRollerMark']
        mark.ViewObject.LineColor=(0.12,0.35,0.85);mark.ViewObject.LineWidth=2.0
        pin_shape=Part.makeCylinder(4,24,V(0,-12,0),V(0,1,0)).fuse(
            Part.makeCylinder(6,2,V(0,-14,0),V(0,1,0))).fuse(
            Part.makeCylinder(6,2,V(0,12,0),V(0,1,0))).removeSplitter()
        pin=add('MasterFollowerAxle','Slider roller axle - diameter8, retained ends',pin_shape,(0.62,0.65,0.69),moving)
        motion.roller=roller;motion.roller_mark=mark
        motion.state.Roller=roller;motion.state.Axle=pin
        # One-piece reference ram/yoke: guide journal diameter20, no rod connection.
        ram=Part.makeCylinder(19.90711/2,165,V(25,0,0),V(1,0,0))
        ram=ram.fuse(Part.makeCylinder(14,12,V(18,0,0),V(1,0,0)))
        for y in (-11,6):
            cheek=Part.makeBox(25,5,14,V(0,y,-7)).fuse(Part.makeCylinder(7,5,V(0,y,0),V(0,1,0)))
            cheek=cheek.cut(Part.makeCylinder(4.05,7,V(0,y-1,0),V(0,1,0)))
            ram=ram.fuse(cheek)
        ram=ram.fuse(Part.makeCylinder(17,2,V(30,0,0),V(1,0,0)))
        ram=ram.fuse(Part.makeBox(6,8,16,V(108,-4,7)))
        crown=Part.makeSphere(30,V(164,0,0)).common(Part.makeCylinder(8,4.5,V(190,0,0),V(1,0,0)))
        ram=ram.fuse(crown).removeSplitter()
        self.ram=add('MasterSliderRam','Guided diameter20 ram, roller yoke and rounded thrust tip',ram,steel,moving)
        self.ram.addProperty('App::PropertyLength','GuideDiameter','Slider');self.ram.GuideDiameter=19.90711
        self.ram.addProperty('App::PropertyLength','GuideJournalLength','Slider');self.ram.GuideJournalLength=165
        self.ram.addProperty('App::PropertyLength','ThrustTipRadius','Slider');self.ram.ThrustTipRadius=30
        self.ram.addProperty('App::PropertyString','MaterialRequirement','Slider');self.ram.MaterialRequirement='Ground steel guide journal; minimum specified yield250 MPa for the nominal500 N static calculation. Harden/polish the R30 thrust crown and mating flat pad; verify contact fatigue for actual duty.'
        # Two 25 mm bushes, 60 mm between bearing centres. ID includes running clearance.
        self.bushes=[]
        for i,x in enumerate((80.0,140.0),1):
            shape=Part.makeCylinder(14,25,V(x,0,0),V(1,0,0)).cut(
                Part.makeCylinder(10,27,V(x-1,0,0),V(1,0,0)))
            b=add('MasterSliderBush%02d'%i,'Oil-impregnated bronze bush %02d - nominal ID20 OD28 x25'%i,shape,bronze)
            for prop,val in [('InsideDiameter',20.0),('OutsideDiameter',28.0),('Length',25.0)]:
                b.addProperty('App::PropertyLength',prop,'Bush');setattr(b,prop,val)
            b.addProperty('App::PropertyString','BearingReference','Bush');b.BearingReference='Oilite AAM2028-25, SAE841 bronze; nominal installed CAD envelope. Fit/tolerances must follow supplier data, not the nominal CAD bore.'
            b.addProperty('App::PropertyString','DataSheet','Bush');b.DataSheet='https://oilite.com/product/AAM2028-25'
            b.addProperty('App::PropertyLength','RecommendedHousingBore','Bush');b.RecommendedHousingBore=27.98956
            b.addProperty('App::PropertyLength','RecommendedShaftDiameter','Bush');b.RecommendedShaftDiameter=19.90711
            self.bushes.append(b)
        # Common frame supports both bushes and bolts directly to the cylinder flange.
        flange_x=master.getGlobalPlacement().multVec(V(master.RearToFlangeFace.Value,0,0)).x-self.origin.x
        base=Part.makeBox(flange_x+10-72,64,8,V(72,-32,-52))
        for x in (120,flange_x-20):
            for y in (-24,24):base=base.cut(Part.makeCylinder(4.5,10,V(x,y,-53),V(0,0,1)))
        frame=base
        for x in (80,140):
            block=Part.makeBox(25,54,64,V(x,-27,-44))
            block=block.cut(Part.makeCylinder(14,27,V(x-1,0,0),V(1,0,0)))
            frame=frame.fuse(block)
        # Anti-rotation cheeks and positive return/overtravel stops.
        for y in (-7,4.2):frame=frame.fuse(Part.makeBox(35,2.8,14,V(105,y,12)))
        frame=frame.fuse(Part.makeBox(2,14,14,V(106,-7,12)))
        frame=frame.fuse(Part.makeBox(1,14,14,V(139,-7,12)))
        mount=Part.makeBox(8,54,86,V(flange_x-8,-27,-44))
        mount=mount.cut(Part.makeCylinder(19,10,V(flange_x-9,0,0),V(1,0,0)))
        for z in (-28.55,28.55):mount=mount.cut(Part.makeCylinder(5.25,10,V(flange_x-9,0,z),V(1,0,0)))
        frame=frame.fuse(mount).removeSplitter()
        self.frame_object=add('MasterSliderFrame','Common bearing frame and master mounting plate',frame,steel)
        self.frame_object.addProperty('App::PropertyString','Mounting','Frame')
        self.frame_object.Mounting='Rigid machine-frame attachment required: four diameter9 base holes for M8 bolts. Rear plate bolts to the existing master flange at57.1 mm centres. Base/frame welds and chassis are not represented.'
        # Explicit fasteners into the master flange; threads remain simple envelopes.
        def hex_shape(af,length,x,z):
            rr=af/math.sqrt(3);pts=[V(x,rr*math.cos(i*math.pi/3),z+rr*math.sin(i*math.pi/3)) for i in range(6)]
            return Part.Face(Part.makePolygon(pts+[pts[0]])).extrude(V(length,0,0))
        for i,z in enumerate((-28.55,28.55),1):
            bolt=Part.makeCylinder(5,26,V(flange_x-8,0,z),V(1,0,0)).fuse(hex_shape(17,6,flange_x-14,z))
            add('MasterSliderMountBolt%02d'%i,'Master flange M10 bolt %02d'%i,bolt,(0.68,0.70,0.73))
            washer=Part.makeCylinder(9,1,V(flange_x+7.5,0,z),V(1,0,0)).cut(Part.makeCylinder(5.25,3,V(flange_x+6.5,0,z),V(1,0,0)))
            add('MasterSliderMountWasher%02d'%i,'Master flange washer %02d'%i,washer,(0.68,0.70,0.73))
            nut=hex_shape(17,8,flange_x+8.5,z).cut(Part.makeCylinder(5,10,V(flange_x+7.5,0,z),V(1,0,0)))
            add('MasterSliderMountNut%02d'%i,'Master flange M10 nut %02d'%i,nut,(0.68,0.70,0.73))
        seat=Part.makeCylinder(17,2,V(78,0,0),V(1,0,0)).cut(Part.makeCylinder(10.2,4,V(77,0,0),V(1,0,0)))
        self.spring_seat=add('MasterSliderSpringSeat','Fixed slider return-spring seat',seat,steel)
        # Flat thrust pad screws on to the master rod, with a 4 mm closed end wall.
        pad=Part.makeCylinder(8,12,V(194,0,0),V(1,0,0))
        pad=pad.cut(Part.makeCylinder(7.94/2,9,V(198,0,0),V(1,0,0)))
        # Express the pad in master-local coordinates and keep only it on the pushrod.
        world_pad=pad.copy();world_pad.Placement=self.frame
        self.pad=document.addObject('Part::Feature','MasterAxialThrustPad')
        self.pad.Label='Master pushrod - flat axial thrust pad (5/16-24)'
        self.pad.Shape=world_pad;document.MovingParts.addObject(self.pad)
        self.pad.Placement=master.getGlobalPlacement().inverse().multiply(self.frame)
        self.pad.ViewObject.ShapeColor=(0.75,0.77,0.80)
        self.pad.addProperty('App::PropertyString','ContactModel','Axial coupling')
        self.pad.ContactModel='Rounded slider tip against flat end pad, with coincident X axes. Compression-only contact; no rigid slider-to-pushrod joint. Ideal contact normal is global X. Friction and elastic deflection are not simulated.'
        # The two assemblies share displacement from contact, not a lateral constraint.
        motion.parts=list(document.MovingParts.Group)+list(moving.Group)
        motion.rest={obj.Name:obj.getGlobalPlacement() for obj in motion.parts}
        motion.tip=desired_tip;motion.state.ReturnPosition=desired_tip
        motion.state.Fork=self.ram
        motion.state.Label='Bushed slider cam follower - axial master-cylinder push'
        motion.state.MotionModel='Roller and diameter20 ram translate in two fixed bronze bushes; anti-rotation tongue and mechanical stops retain orientation/travel. Spherical-to-flat compression contact transfers only axial push to the master rod in the ideal model. Separate return spring; cam lift and roller phase unchanged.'
        for prop,val in [('BushCentreSpacing',60.0),('AvailableTravel',25.0),('RadialRunningClearance',(20.0-19.90711)/2),('MasterBackwardShift',shift.x)]:
            assembly.addProperty('App::PropertyLength',prop,'Slider geometry');setattr(assembly,prop,val)
        assembly.addProperty('App::PropertyString','LoadPath','Design')
        assembly.LoadPath='Cam -> roller/axle -> slider ram -> separated bushes -> common frame -> machine chassis. Axial ram-tip contact -> pushrod pad -> master piston. Bush spacing reacts lateral force and overturning moment.'
        assembly.addProperty('App::PropertyForce','DesignCamForce','Design');assembly.DesignCamForce=500.0
        assembly.addProperty('App::PropertyString','SizingStatus','Design')
        assembly.SizingStatus='User-specified cam-follower load500 N. Preliminary nominal static ram, bush and axle calculations are recorded with this revision; speed, impact/fatigue, chassis attachment, spring selection and bush pressure-velocity/lubrication remain application checks.'
        self.spring=document.addObject('Part::Feature','MasterSliderReturnSpring');self.spring.Label='Slider compression return spring - reference geometry'
        fixed.addObject(self.spring);self.spring.ViewObject.ShapeColor=(0.40,0.43,0.47)
        for prop,val in [('WireDiameter',2.0),('MeanDiameter',28.0),('Turns',9.0),('FreeLength',51.0)]:
            self.spring.addProperty('App::PropertyFloat',prop,'Spring reference');setattr(self.spring,prop,val)
        self.last_stroke=None
        motion.slider=self
        motion.update()

    def update(self,stroke):
        if stroke>25.0+1e-7:raise RuntimeError('Cam exceeds the slider mechanical travel.')
        if self.last_stroke is not None and abs(stroke-self.last_stroke)<1e-8:return
        # 46 mm installed span at zero stroke: moving seat X32, fixed seat X78.
        span=46.0-stroke;wire_radius=1.0;turns=9.0
        if span<=20.0:raise RuntimeError('Reference slider spring would become coil-bound.')
        height=span-2*wire_radius
        path=Part.makeHelix(height/turns,height,14.0)
        tangent=path.Edges[0].tangentAt(path.Edges[0].FirstParameter)
        section=Part.Wire([Part.makeCircle(wire_radius,V(14,0,0),tangent)])
        shape=Part.Wire(path.Edges).makePipeShell([section],True,True)
        shape.Placement=self.frame.multiply(App.Placement(V(32+stroke+wire_radius,0,0),App.Rotation(V(0,0,1),V(1,0,0))))
        self.spring.Shape=shape
        self.last_stroke=stroke


master_bushed_slider=MasterBushedSlider(doc,wilwood_master,master_cam_motion)
App.master_bushed_slider=master_bushed_slider
reset_simulation()


class FlexibleHydraulicHose:
    """Moving service loop with constant nominal centreline length; plain CAD geometry."""
    def __init__(self,doc):
        self.doc=doc;self.master=doc.Wilwood2601304;self.slave=doc.Closed_0deg_InletBoss
        self.hose=doc.addObject('Part::Feature','WilwoodFlexibleHose')
        self.hose.Label='Flexible hydraulic hose - master to moving slave'
        for name,value in [('OutsideDiameter',8.0),('InsideDiameter',4.0),('NominalLength',950.0),('CurrentLength',0.0),('MaximumOverallLength',1000.0)]:
            self.hose.addProperty('App::PropertyLength',name,'Hose');setattr(self.hose,name,value)
        self.hose.addProperty('App::PropertyString','Notes','Hose')
        self.hose.Notes='Reference hose OD8 ID4 with 3/8-24 end adapters; sizes and bend limits require confirmation for selected hose. 950 mm constant-length hose; 990 mm including two 20 mm adapters; direct loop between ports.'
        self.hose.ViewObject.ShapeColor=(0.07,0.07,0.08)
        self.hose.ViewObject.LineColor=(0.12,0.12,0.13)
        self.fittings=[]
        for name,label in [('MasterHoseAdapter','Master 3/8-24 hose adapter'),('SlaveHoseAdapter','Slave 3/8-24 inverted-flare hose adapter')]:
            o=doc.addObject('Part::Feature',name);o.Label=label
            o.Shape=Part.makeCylinder(6,12).fuse(Part.makeCylinder(5,8,V(0,0,12))).cut(Part.makeCylinder(2,22,V(0,0,-1)))
            o.ViewObject.ShapeColor=(0.72,0.74,0.78);self.fittings.append(o)
        self.target_length=950.0
        self.update()

    def ports(self):
        axis=V(0.5,0,math.sqrt(3)/2)
        master=self.master.getGlobalPlacement()
        first=master.multVec(V(45.5,0,10)+axis*27)
        first_axis=master.Rotation.multVec(axis)
        # Native inlet boss face: X=-10; centre is the transformed 170.75 mm port station.
        source=self.slave.getGlobalPlacement()
        local=V(-10,-130,self.slave.RearMountPoint.z-12.0-170.75)
        last=source.multVec(local)
        last_axis=source.Rotation.multVec(V(-1,0,0))
        return first,first_axis,last,last_axis

    @staticmethod
    def bezier(points):
        c=Part.BezierCurve();c.setPoles(points);return c.toShape()

    def route(self,first,fa,last,la,height):
        start=first+fa*20;end=last+la*20
        middle=(start+end)*0.5+V(0,-50,height)
        edges=[self.bezier([start,start+fa*170,middle-V(160,0,0),middle]),
               self.bezier([middle,middle+V(160,0,0),end+la*170,end])]
        return Part.Wire(edges)

    def update(self):
        first,fa,last,la=self.ports()
        for obj,point,axis in zip(self.fittings,(first,last),(fa,la)):
            obj.Placement=App.Placement(point,App.Rotation(V(0,0,1),axis))
        wire=self.route(first,fa,last,la,0)
        if wire.Length>self.target_length:raise RuntimeError("Direct hose route exceeds the 950 mm hose length.")
        lo,hi=0.0,1000.0
        for _ in range(24):
            mid=(lo+hi)/2;wire=self.route(first,fa,last,la,mid)
            if wire.Length<self.target_length:lo=mid
            else:hi=mid
        wire=self.route(first,fa,last,la,(lo+hi)/2)
        self.wire=wire
        if abs(wire.Length-self.target_length)>0.01:raise RuntimeError('Hydraulic hose slack exhausted.')
        origin=first+fa*20
        ro=self.hose.OutsideDiameter.Value/2;ri=self.hose.InsideDiameter.Value/2
        outer=Part.Wire([Part.makeCircle(ro,origin,fa)])
        inner=Part.Wire([Part.makeCircle(ri,origin,fa)])
        faces=list(wire.makePipeShell([outer],False,False).Faces)
        for face in wire.makePipeShell([inner],False,False).Faces:
            face.reverse();faces.append(face)
        for centre,normal,reverse in [(origin,fa,True),(last+la*20,-la,False)]:
            outer_ring=Part.Wire([Part.makeCircle(ro,centre,normal)])
            inner_ring=Part.Wire([Part.makeCircle(ri,centre,normal)])
            cap=Part.Face(outer_ring).cut(Part.Face(inner_ring))
            if reverse:cap.reverse()
            faces.extend(cap.Faces)
        shell=Part.makeShell(faces);shell.sewShape()
        self.hose.Shape=Part.makeSolid(shell)
        self.hose.NominalLength=self.target_length;self.hose.CurrentLength=wire.Length
        if wire.Length+40>self.hose.MaximumOverallLength.Value:raise RuntimeError('Hose assembly exceeds 1 metre.')


flexible_hydraulic_hose=FlexibleHydraulicHose(doc)
App.flexible_hydraulic_hose=flexible_hydraulic_hose




class DuckBillConeReturnSprings:
    """Four flange eyes and tension springs, anchored to the fixed hopper band.

    Spring OD is 10 mm and closed-state overall length is 50 mm including eyes.
    Wire, turns and spring rate are reference geometry, not a selected spring rating.
    """
    def __init__(self, document, hydraulic):
        self.doc,self.hydraulic=document,hydraulic
        self.band=document.Closed_0deg_SteelOuterBand
        self.group=document.addObject('App::DocumentObjectGroup','DuckBillConeReturnSprings')
        self.group.Label='Duck-bill cone return springs - four flange loops'
        self.loops=[];self.springs=[];self.supports=[];self.items=[]
        self.steel=(0.64,0.67,0.71);self.spring_colour=(0.76,0.79,0.83)
        self.closed_axis=self.band.getGlobalPlacement().Rotation.inverted().multVec(V(0,0,1))
        band_relative=hydraulic.relative[self.band.Name]
        # Each half-ring has its own two outer ends. The feet lie completely
        # on the flange top, clear of the existing bracket slots and butt seam.
        for half,flange in enumerate((document.Closed_0deg_ContinuousFlange,document.Closed_0deg_ContinuousFlange_Rotated)):
            closed=band_relative.inverse().multiply(hydraulic.relative[flange.Name])
            for side,x in enumerate((-84.0,84.0)):
                index=2*half+side+1
                centre=V(x,10.0,9.0) # 7 mm above the 2 mm thick flange top
                shape=Part.makeBox(3,12,7,V(x-1.5,4,2)).fuse(
                    Part.makeCylinder(6,3,V(x-1.5,10,9),V(1,0,0)))
                shape=shape.cut(Part.makeCylinder(2.5,5,V(x-2.5,10,9),V(1,0,0))).removeSplitter()
                loop=self.add('DuckBillReturnLoop%02d'%index,'Cone return spring loop %02d - hole diameter5'%index,shape,self.steel)
                for name,value in [('HoleDiameter',5),('Thickness',3),('Width',12),('HeightAboveFlange',13)]:
                    loop.addProperty('App::PropertyLength',name,'Loop');setattr(loop,name,value)
                loop.addProperty('App::PropertyLink','Flange','Attachment');loop.Flange=flange
                loop.addProperty('App::PropertyVector','HoleCentreOnFlange','Attachment');loop.HoleCentreOnFlange=centre
                loop.addProperty('App::PropertyString','Attachment','Attachment');loop.Attachment='Welded foot on the upper flange face, near its outer end; moves rigidly with this cone.'
                spring=self.add('DuckBillReturnSpring%02d'%index,'Cone return spring %02d - OD10 x50 closed overall'%index,Part.makeCylinder(.5,1),self.spring_colour)
                for name,value in [('OutsideDiameter',10),('ClosedOverallLength',50),('WireDiameter',1),('ClosedAnchorSpacing',49),('CurrentAnchorSpacing',49),('CurrentOverallLength',50),('Extension',0)]:
                    spring.addProperty('App::PropertyLength',name,'Spring reference');setattr(spring,name,value)
                spring.addProperty('App::PropertyInteger','Turns','Spring reference');spring.Turns=25
                spring.addProperty('App::PropertyLink','LowerLoop','Attachment');spring.LowerLoop=loop
                spring.addProperty('App::PropertyVector','UpperAnchorOnBand','Attachment')
                anchor=closed.multVec(centre)+self.closed_axis*49.0
                spring.UpperAnchorOnBand=anchor
                spring.addProperty('App::PropertyString','Notes','Spring reference')
                spring.Notes='OD10 and 50 mm overall at CLOSED jaws, including both end eyes. 1 mm wire and 25 turns are illustrative; actual spring rate, initial tension and allowable extension require selection. Lower eye passes through diameter5 flange loop; upper eye through fixed support hole. End eyes are simplified open formed hooks with a 3.5 mm clear mouth.'
                self.loops.append(loop);self.springs.append(spring)
                self.items.append(dict(loop=loop,spring=spring,flange=flange,centre=centre,anchor=anchor,last=None))
        # Two fixed radial brackets: each carries two spring holes. They are
        # coped to the fixed steel band and clear the tapered hopper above it.
        band_shape=self.band.Shape.copy();band_shape.Placement=App.Placement()
        bb=band_shape.BoundBox
        z0,z1=bb.ZMin,bb.ZMax
        envelope=Part.makeCylinder(55,z1-z0,V(0,0,z0)).fuse(Part.makeCone(53,75,110,V(0,0,z1)))
        for side in (-1,1):
            items=[item for item in self.items if item['anchor'].x*side>0]
            a=items[0]['anchor'];tab_x=a.x;top=a.z+11
            root_x=53 if side>0 else -61
            root=Part.makeBox(8,36,top-(z0+10),V(root_x,-18,z0+10))
            outer=tab_x+1.5*side
            lo,hi=sorted((side*53,outer))
            shelf=Part.makeBox(hi-lo,36,4,V(lo,-18,a.z+7))
            tab=Part.makeBox(3,36,17,V(tab_x-1.5,-18,a.z-6))
            bracket=root.fuse(shelf).fuse(tab)
            for item in items:
                p=item['anchor'];bracket=bracket.cut(Part.makeCylinder(2.5,5,p+V(-2.5,0,0),V(1,0,0)))
            bracket=bracket.cut(envelope).removeSplitter()
            support=self.add('DuckBillReturnUpperSupport%02d'%(1 if side<0 else 2),'Fixed cone-spring upper support - '+('left' if side<0 else 'right'),bracket,(0.20,0.65,0.45))
            support.addProperty('App::PropertyLink','FixedBand','Attachment');support.FixedBand=self.band
            support.addProperty('App::PropertyString','Attachment','Attachment');support.Attachment='Coped/welded to the existing fixed steel outer band; carries two diameter5 anchor holes. Moves with the hopper/arm, independently of jaw opening. Weld beads omitted.'
            support.addProperty('App::PropertyLength','AnchorHoleDiameter','Support');support.AnchorHoleDiameter=5
            self.supports.append(support)
            for item in items:
                item['spring'].addProperty('App::PropertyLink','UpperSupport','Attachment');item['spring'].UpperSupport=support
        self.group.addProperty('App::PropertyString','Motion','Design')
        self.group.Motion='Four tension springs pull the moving flanges toward their closed positions. Upper supports follow the fixed hopper band. Springs are vertical at closed jaws in the initial carrier pose, then stretch/tilt with actual jaw and carrier motion. Geometry only; no dynamic force simulation.'
        self.group.addProperty('App::PropertyInteger','SpringCount','Design');self.group.SpringCount=4
        # Build reference coils once; disabled animation never regenerates them.
        self.update(force_springs=True)

    def add(self,name,label,shape,colour):
        if shape.isNull() or not shape.isValid() or len(shape.Solids)!=1:raise RuntimeError('Invalid cone spring component: '+name)
        obj=self.doc.addObject('Part::Feature',name);obj.Label=label;obj.Shape=shape;self.group.addObject(obj)
        obj.ViewObject.ShapeColor=colour;obj.ViewObject.LineColor=(.15,.17,.19)
        return obj

    _terminal_eye=None

    @staticmethod
    def spring_shape(distance):
        # Eye-centre spacing is 1 mm less than the true overall wire envelope.
        # Each eye has mean radius4.5 and wire radius0.5. Its terminal wire runs
        # along X through the attachment hole. The overlapping wire sections are
        # kept as three native solids in one spring feature for fast animation.
        height=distance-18.0
        if height<=25.0:raise RuntimeError('Cone return spring coils would overlap.')
        path=Part.makeHelix(height/25.0,height,4.5)
        tangent=path.Edges[0].tangentAt(path.Edges[0].FirstParameter)
        profile=Part.Wire([Part.makeCircle(.5,V(4.5,0,0),tangent)])
        coil=Part.Wire(path.Edges).makePipeShell([profile],True,True);coil.translate(V(0,0,9))
        if DuckBillConeReturnSprings._terminal_eye is None:
            # A 300-degree formed hook leaves a 3.5 mm clear mouth to fit
            # over the 3 mm loop/support plate before seating in its hole.
            arc=Part.Arc(V(4.5,0,4.5),V(-4.5,0,4.5),V(2.25,0,4.5-4.5*math.sqrt(3)/2)).toShape()
            profile=Part.Wire([Part.makeCircle(.5,V(4.5,0,4.5),arc.tangentAt(arc.FirstParameter))])
            eye=Part.Wire([arc]).makePipeShell([profile],True,True)
            stem=Part.makeCylinder(.5,4.5,V(4.25,0,4.5))
            DuckBillConeReturnSprings._terminal_eye=eye.fuse(stem).removeSplitter()
        lower=DuckBillConeReturnSprings._terminal_eye.copy()
        upper=lower.copy();upper.rotate(V(0,0,0),V(1,0,0),180);upper.translate(V(0,0,distance))
        shape=Part.makeCompound([coil,lower,upper])
        if not shape.isValid() or len(shape.Solids)!=3:raise RuntimeError('Invalid extension spring wire sections.')
        return shape

    def update(self, force_springs=False):
        band_pose=self.band.getGlobalPlacement();shape_cache={}
        for support in self.supports:support.Placement=band_pose
        for item in self.items:
            loop,spring=item['loop'],item['spring'];pose=item['flange'].getGlobalPlacement();loop.Placement=pose
            if spring.ViewObject.Visibility != bool(ANIMATE_SPRINGS):
                spring.ViewObject.Visibility = bool(ANIMATE_SPRINGS)
            if not ANIMATE_SPRINGS and not force_springs:
                continue
            lower=pose.multVec(item['centre']);upper=band_pose.multVec(item['anchor'])
            axis=upper-lower;distance=axis.Length;axis.normalize()
            if distance<49-1e-6:raise RuntimeError('Cone spring shortened below its closed return length.')
            x=band_pose.Rotation.multVec(V(1,0,0));x=x-axis*x.dot(axis);x.normalize();y=axis.cross(x)
            rotation=App.Rotation(x,y,axis,'ZXY')
            if item['last'] is None or abs(item['last']-distance)>1e-7:
                key=round(distance,7)
                if key not in shape_cache:shape_cache[key]=self.spring_shape(distance)
                spring.Shape=shape_cache[key].copy();item['last']=distance
            spring.Placement=App.Placement(lower,rotation)
            spring.CurrentAnchorSpacing=distance;spring.CurrentOverallLength=distance+1;spring.Extension=distance-49


cone_return_springs=DuckBillConeReturnSprings(doc,slave_hydraulic_motion)
App.cone_return_springs=cone_return_springs



def synchronize_drive_inventory(document):
    """Use physical tooth-tip faces and link objects to label the current drives."""
    import re
    chain_sets=(
        (document.PrimaryChainDrive,list(document.PrimaryChainDrive.Links),
         [document.sprocket_16T_01,document.sprocket_15T_tensioner_01,document.sprocket_16T_03]),
        (document.WheelShaftDriveChain,
         [o for o in document.WheelShaftDriveChain.Group if o.Name.startswith('WheelDriveChainLink_')],
         list(document.WheelShaftDriveChain.Sprockets)),
        (document.UpperWheelChainDrive,
         [o for o in document.UpperWheelChainDrive.Group if o.Name.startswith('UpperWheelChainLink_')],
         list(document.UpperWheelChainDrive.Sprockets)),
        (document.CentreGreenChainDrive,
         [o for o in document.CentreGreenChainDrive.Group if o.Name.startswith('UpperWheelChainLink_')],
         list(document.CentreGreenChainDrive.Sprockets)),
        (document.CarouselChainDrive,
         [o for o in document.CarouselChainDrive.Group if o.Name.startswith('CarouselChainLink_')],
         list(document.CarouselChainDrive.Sprockets)))
    seen=set()
    for group,chain_links,gears in chain_sets:
        if 'LinkCount' not in group.PropertiesList:group.addProperty('App::PropertyInteger','LinkCount','Chain')
        group.LinkCount=len(chain_links)
        if 'Pitch' not in group.PropertiesList:group.addProperty('App::PropertyLength','Pitch','Chain')
        group.Pitch=PITCH
        for gear in gears:
            if gear.Name in seen:continue
            seen.add(gear.Name)
            shape=gear.Shape.copy();shape.Placement=App.Placement()
            radii=[]
            for face in shape.Faces:
                surface=face.Surface
                if isinstance(surface,Part.Cylinder) and abs(surface.Axis.z)>1-1e-7 and math.hypot(surface.Center.x,surface.Center.y)<1e-6:
                    radii.append(surface.Radius)
            if not radii:raise RuntimeError('Cannot verify tooth count for '+gear.Name)
            outside=max(radii)
            # This native profile has one original outside-cylinder tip face per tooth.
            teeth=sum(1 for radius in radii if abs(radius-outside)<1e-6)
            if teeth<8:raise RuntimeError('Unrecognised sprocket tooth profile: '+gear.Name)
            if 'Teeth' not in gear.PropertiesList:gear.addProperty('App::PropertyInteger','Teeth','Dimensions')
            gear.Teeth=teeth
            token=re.compile(r'(?<![0-9])[0-9]+T(?![0-9])',re.IGNORECASE)
            gear.Label=token.sub(str(teeth)+'T',gear.Label) if token.search(gear.Label) else gear.Label+' - '+str(teeth)+'T'
    document.AdditionalDriveSprockets.Label='Wheel drive sprockets and 15T tensioners'
    return chain_sets


synchronize_drive_inventory(doc)

# Apply the display choice after all assembly groups have been populated.
# Group additions may restore visibility during construction.
if not DISPLAY_DUCK_BILL_OPEN_20DEG:
    doc.Opened_20deg.ViewObject.Visibility = False
    for obj in doc.Objects:
        if obj.Name.startswith("Opened_20deg_"):
            obj.ViewObject.Visibility = False


for original_cam in smooth_cam_disc.OriginalDiscs:
    original_cam.ViewObject.Visibility = ORIGINAL_CAM_DISC_VISIBILTY

# Frame the machine once, BEFORE adding the larger ground field. The animation
# never calls ViewFit or modifies the camera, so the machine remains central.
view = Gui.activeDocument().activeView()
view.setCameraType("Orthographic")
view.viewAxonometric()
view.fitAll()
try:
    camera_node = view.getCameraNode()
    camera_node.height.setValue(camera_node.height.getValue() * 1.20)
except (AttributeError, RuntimeError):
    pass
# Bake the enlarged dash pattern into geometry so the saved FCStd preserves it.
# FreeCAD's Dashed pattern is 0xF00F: eight lit pixels and eight gap pixels.
# Equal 10-pixel dashes and gaps at this initial camera framing.
if duck_bill_tip_motion_outline is not None:
    outline = duck_bill_tip_motion_outline
    outline.addProperty("Part::PropertyPartShape", "FullTrajectory", "Motion envelope")
    outline.FullTrajectory = outline.Shape.copy()
    outline.addProperty("App::PropertyFloat", "DashScaleFactor", "Motion envelope")
    outline.DashScaleFactor = 1.25
    outline.addProperty("App::PropertyFloat", "GapScaleFactor", "Motion envelope")
    outline.GapScaleFactor = outline.DashScaleFactor
    screen_to_world = view.getCameraNode().height.getValue() / max(1, view.getSize()[1])
    dash_length = 8.0 * outline.DashScaleFactor * screen_to_world
    gap_length = dash_length  # Persistent requirement: equal dash and gap lengths.
    camera_inverse = view.getCameraOrientation()
    camera_inverse.invert()
    # Fit a whole number of equal dash-gap pairs around the closed trajectory,
    # avoiding a shortened final dash or an oversized closing gap.
    projected_length = 0.0
    for edge in outline.FullTrajectory.Edges:
        delta = camera_inverse.multVec(edge.Vertexes[-1].Point - edge.Vertexes[0].Point)
        projected_length += math.hypot(delta.x, delta.y)
    pair_count = max(1, int(round(projected_length / (2.0 * dash_length))))
    dash_length = gap_length = projected_length / (2.0 * pair_count)
    pieces, current = [], []
    remaining, visible = dash_length, True
    for edge in outline.FullTrajectory.Edges:
        a, b = edge.Vertexes[0].Point, edge.Vertexes[-1].Point
        projected = camera_inverse.multVec(b - a)
        length = math.hypot(projected.x, projected.y)
        if length < 1e-12:
            continue
        offset = 0.0
        while offset < length - 1e-10:
            take = min(remaining, length - offset)
            first = a + (b-a) * (offset / length)
            last = a + (b-a) * ((offset+take) / length)
            if visible:
                if not current:
                    current.append(first)
                current.append(last)
            offset += take
            remaining -= take
            if remaining < 1e-9:
                if visible and len(current) > 1:
                    pieces.append(Part.makePolygon(current))
                current = []
                visible = not visible
                remaining = dash_length if visible else gap_length
    if len(current) > 1:
        pieces.append(Part.makePolygon(current))
    outline.Shape = Part.makeCompound(pieces)
    outline.ViewObject.DrawStyle = "Solid"  # Gaps are explicit geometry.
    outline.ViewObject.LineWidth = 3.0
    outline.Description += " Blue dashes and gaps are equal at 1.25x the original pattern; line width remains 3. Always keep dash and gap lengths equal."

moving_ground = MovingSoilGround(doc)
App.moving_soil_ground = moving_ground
if cycle_readout is not None:
    cycle_readout.update()
# Re-running fitAll after creating ground would frame the field, not the machine.
doc.recompute()




# Stop timers left behind by an earlier execution before making a new one.
# The public handle is deliberately App.sim_timer, so the console command
# ``App.sim_timer.stop()`` always addresses the timer driving this macro.
for timer_name in ("sim_timer", "lugged_wheel_chain_timer"):
    old_timer = getattr(App, timer_name, None)
    if old_timer is not None:
        old_timer.stop()

App.sim_timer = QtCore.QTimer()
App.sim_timer.timeout.connect(update_simulation)
if linkage_motion_available:
    App.sim_timer.start(100)

# Backward-compatible alias for the stop command printed by older versions.
App.lugged_wheel_chain_timer = App.sim_timer
App.Console.PrintMessage(
    ("Stationary machine with wheel-synchronized moving soil running. Stop with: " if linkage_motion_available else "Animation paused: fixed-pin linkage cannot complete a cycle. Timer handle: ") +
    "App.sim_timer.stop()\n"
)
