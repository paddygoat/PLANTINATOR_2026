# Catalogue: TransDev SRB45/2, module 4.5, 20-degree pressure angle.
# https://www.transdev.co.uk/gears/metric-and-imperial-bevel-gears/metric-bevel-gears-21-ratio/
# Native spherical-involute reference teeth; not manufacturer Gleason tooling surfaces.
# All profiles, hubs, bores and mounting positions are constructed here in Python.
def carousel_bevel_shape(teeth, mate_teeth, outside, mounting, overall, hub_diameter, hub_length, mate_outside):
    module, face_width = 4.5, 26.0
    delta = math.atan(float(teeth)/mate_teeth)
    alpha = math.radians(20)
    pitch_radius = module*teeth/2
    cone_distance = math.hypot(module*teeth/2, module*mate_teeth/2)
    z_pitch = cone_distance*math.cos(delta)
    r_tip = outside/2
    z_tip = z_pitch-(r_tip-pitch_radius)*math.tan(delta)
    theta_tip = math.atan2(r_tip,z_tip)
    mate_delta = math.pi/2-delta
    mate_addendum = (mate_outside/2-module*mate_teeth/2)/math.cos(mate_delta)
    dedendum = mate_addendum+0.25*module
    r_root = pitch_radius-dedendum*math.cos(delta)
    z_root = z_pitch+dedendum*math.sin(delta)
    theta_root = math.atan2(r_root,z_root)
    beta = math.asin(math.sin(delta)*math.cos(alpha))
    def spherical_involute(theta):
        if theta <= beta: return 0.0
        roll = math.acos(max(-1.0,min(1.0,math.cos(theta)/math.cos(beta))))
        return roll/math.sin(beta)-math.atan2(math.sin(roll),math.sin(beta)*math.cos(roll))
    addendum = (r_tip-pitch_radius)/math.cos(delta)
    profile_shift = addendum/module-1.0
    half_pitch = (math.pi/2+2*profile_shift*math.tan(alpha))/teeth-0.10/(2*pitch_radius)
    def half_width(theta):
        return half_pitch+spherical_involute(delta)-spherical_involute(theta)
    def ring(z):
        edges=[]
        def point(theta,angle):
            r=z*math.tan(theta)
            return V(r*math.cos(angle),r*math.sin(angle),z)
        for i in range(teeth):
            centre=2*math.pi*i/teeth
            flank=[]
            for j in range(17):
                theta=theta_root+(theta_tip-theta_root)*j/16
                flank.append(point(theta,centre-half_width(theta)))
            c=Part.BSplineCurve();c.interpolate(flank);edges.append(c.toShape())
            edges.append(Part.Arc(flank[-1],point(theta_tip,centre),point(theta_tip,centre+half_width(theta_tip))).toShape())
            flank=[]
            for j in range(17):
                theta=theta_tip-(theta_tip-theta_root)*j/16
                flank.append(point(theta,centre+half_width(theta)))
            c=Part.BSplineCurve();c.interpolate(flank);edges.append(c.toShape())
            a=centre+half_width(theta_root);b=centre+2*math.pi/teeth-half_width(theta_root)
            edges.append(Part.Arc(point(theta_root,a),point(theta_root,(a+b)/2),point(theta_root,b)).toShape())
        return Part.Wire(edges)
    front=mounting-overall
    teeth_blank=Part.makeLoft([ring(front),ring(mounting)],True,True)
    # Trim toe and heel perpendicular to the pitch cone, face width 26 mm.
    def heel(r):return (cone_distance-r*math.sin(delta))/math.cos(delta)
    def toe(r):return (cone_distance-face_width-r*math.sin(delta))/math.cos(delta)
    rmax=outside
    rz=[(0,toe(0)),(rmax,toe(rmax)),(rmax,heel(rmax)),(0,heel(0))]
    wire=Part.makePolygon([V(r,0,z) for r,z in rz+[rz[0]]])
    mask=Part.Face(wire).revolve(V(),V(0,0,1),360)
    toothed_rim=teeth_blank.common(mask)
    # Catalogue hub and body envelope. Bore is the 20 mm catalogue option.
    rz=[(10,front),(front*math.tan(theta_root),front),(r_root,z_root),
        (hub_diameter/2,mounting-hub_length),(hub_diameter/2,mounting),(10,mounting)]
    core=Part.Face(Part.makePolygon([V(r,0,z) for r,z in rz+[rz[0]]])).revolve(V(),V(0,0,1),360)
    result=core.fuse(toothed_rim).cut(Part.makeCylinder(10,mounting+2)).removeSplitter()
    if not result.isValid() or len(result.Solids)!=1:
        raise RuntimeError('Carousel bevel gear construction failed: {} teeth'.format(teeth))
    return result


class CarouselBevelDrive:
    def __init__(self, document, shaft):
        self.driver=shaft
        self.rotation_tracker=ShaftRotationTracker(shaft)
        self.group=document.addObject('App::DocumentObjectGroup','CarouselDrive')
        self.group.Label='Carousel bevel drive - 30T to 15T'
        self.group.addProperty('App::PropertyString','ValidationScope','Validation')
        self.group.ValidationScope='Driver-linked rotation, chain pitch and reduction ratios verified. Interference not checked, as requested.'
        self.group.addProperty('App::PropertyFloat','OverallRatioToUpperWheelShaft','Motion')
        self.group.OverallRatioToUpperWheelShaft=-0.8
        # Centre the vertical shaft axis directly above the horizontal shaft midpoint.
        midpoint=shaft.getGlobalPlacement().multVec(V(0,0,shaft.Length.Value/2))
        self.apex=midpoint
        self.pinion=document.addObject('Part::Feature','carousel_horiz_bevel_gear_30T')
        self.gear=document.addObject('Part::Feature','carousel_bevel_gear_15T')
        for obj,n,mate,od,mount,total,hub,hub_len,mate_od in (
            (self.pinion,30,15,137.6,81.0,60.3,80.3,35.0,78.3),
            (self.gear,15,30,78.3,94.0,51.4,60.3,24.7,137.6)):
            obj.Shape=carousel_bevel_shape(n,mate,od,mount,total,hub,hub_len,mate_od)
            obj.Label='Carousel horizontal bevel gear 30T' if obj is self.pinion else 'Carousel bevel gear 15T'
            for prop,value in [('Module',4.5),('PitchDiameter',4.5*n),('OutsideDiameter',od),('BoreDiameter',20),('FaceWidth',26),('MountingDistance',mount),('OverallLength',total),('HubDiameter',hub),('HubLength',hub_len)]:
                obj.addProperty('App::PropertyLength',prop,'Catalogue');setattr(obj,prop,value)
            obj.addProperty('App::PropertyInteger','Teeth','Catalogue');obj.Teeth=n
            obj.addProperty('App::PropertyAngle','PressureAngle','Catalogue');obj.PressureAngle=20
            obj.addProperty('App::PropertyAngle','PitchConeAngle','Catalogue');obj.PitchConeAngle=math.degrees(math.atan(n/mate))
            obj.addProperty('App::PropertyString','GeometryDescription','Catalogue');obj.GeometryDescription='SRB45/2 reference envelope; spherical-involute approximation, not exact manufactured Gleason flanks.'
            obj.addProperty('App::PropertyString','CatalogueURL','Catalogue');obj.CatalogueURL='https://www.transdev.co.uk/gears/metric-and-imperial-bevel-gears/metric-bevel-gears-21-ratio/'
            obj.addProperty('App::PropertyLink','MotionDriver','Motion')
            obj.ViewObject.ShapeColor=(0.20,0.75,0.40);obj.ViewObject.Transparency=50
            self.group.addObject(obj)
        self.pinion.MotionDriver=shaft;self.gear.MotionDriver=self.pinion
        # Axes point away from the common pitch apex: +Y and +Z.
        self.pinion_rest=App.Rotation(V(1,0,0),-90).multiply(App.Rotation(V(0,0,1),270))
        self.pinion_relative=shaft.getGlobalPlacement().inverse().multiply(App.Placement(self.apex,self.pinion_rest))
        self.gear_rest=App.Rotation(V(0,0,1),102)  # tooth faces a mating space
        self.shaft=document.addObject('Part::Feature','Carousel_vert_shaft');self.shaft.Label='Carousel vert shaft'
        self.shaft.Shape=Part.makeCylinder(10,500)
        self.shaft.addProperty('App::PropertyLength','Diameter','Dimensions');self.shaft.Diameter=20
        self.shaft.addProperty('App::PropertyLength','Length','Dimensions');self.shaft.Length=500
        self.shaft.addProperty('App::PropertyLink','MotionDriver','Motion');self.shaft.MotionDriver=self.gear
        # Preserve the shaft and disc elevations; shaft still spans the entire new gear bore.
        self.shaft_base=self.apex+V(0,0,20.7)
        self.disc=document.addObject('Part::Feature','Carousel_disc');self.disc.Label='Carousel_disc'
        if not isinstance(NUM_CAROUSEL_HOLES,int) or NUM_CAROUSEL_HOLES<1:raise ValueError('NUM_CAROUSEL_HOLES must be a positive integer')
        if CAROUSEL_HOLE_DIAMETER<=0 or CAROUSEL_DISC_OD<=275+CAROUSEL_HOLE_DIAMETER:raise ValueError('Carousel holes must fit inside disc')
        if NUM_CAROUSEL_HOLES>1 and CAROUSEL_HOLE_DIAMETER>=275*math.sin(math.pi/NUM_CAROUSEL_HOLES):raise ValueError('Carousel holes overlap')
        disc=Part.makeCylinder(CAROUSEL_DISC_OD/2,6)
        for i in range(NUM_CAROUSEL_HOLES):
            angle=2*math.pi*i/NUM_CAROUSEL_HOLES
            disc=disc.cut(Part.makeCylinder(CAROUSEL_HOLE_DIAMETER/2,8,V(137.5*math.cos(angle),137.5*math.sin(angle),-1)))
        self.disc.Shape=disc
        for prop,value in [('Diameter',CAROUSEL_DISC_OD),('Thickness',6),('HoleDiameter',CAROUSEL_HOLE_DIAMETER),('HolePCD',275)]:
            self.disc.addProperty('App::PropertyLength',prop,'Dimensions');setattr(self.disc,prop,value)
        self.disc.addProperty('App::PropertyInteger','HoleCount','Dimensions');self.disc.HoleCount=NUM_CAROUSEL_HOLES
        self.disc.addProperty('App::PropertyAngle','InitialRotation','Motion');self.disc.InitialRotation=CAROUSEL_DISC_INIT_ROTATION%360.0
        self.disc.addProperty('App::PropertyLink','MotionDriver','Motion');self.disc.MotionDriver=self.shaft
        for obj in (self.shaft,self.disc):
            obj.ViewObject.ShapeColor=(0.20,0.75,0.40);obj.ViewObject.Transparency=50;self.group.addObject(obj)
        self.group.addProperty('App::PropertyFloat','OutputToInputRatio','Motion');self.group.OutputToInputRatio=-2.0
        self.group.addProperty('App::PropertyAngle','InputAngle','Motion')
        self.group.addProperty('App::PropertyAngle','OutputAngle','Motion')
        self.update()

    def update(self):
        # The 16T-to-40T chain gives 0.4 upper-wheel-shaft speed before this bevel pair.
        angle=self.rotation_tracker.read()
        output=-angle*self.pinion.Teeth/float(self.gear.Teeth)
        self.pinion.Placement=self.driver.getGlobalPlacement().multiply(self.pinion_relative)
        rotation=App.Rotation(V(0,0,1),output)
        self.gear.Placement=App.Placement(self.apex,rotation.multiply(self.gear_rest))
        self.shaft.Placement=App.Placement(self.shaft_base,rotation)
        self.disc.Placement=App.Placement(self.shaft_base+V(0,0,500),App.Rotation(V(0,0,1),output+CAROUSEL_DISC_INIT_ROTATION))
        self.group.InputAngle=angle%360.0;self.group.OutputAngle=output%360.0


