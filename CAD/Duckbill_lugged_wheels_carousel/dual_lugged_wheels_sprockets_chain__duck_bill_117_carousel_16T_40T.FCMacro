def add_sprocket_rim_disc(doc, name="sprocket_16T_rim_disc", initial_angle=25.0):
    parent_disc = doc.sprocket_16T_shaft_disc
    # Angle in the XZ view: zero at +X, positive toward +Z.
    radius = 63.9291692265395  # Calculated for 20-degree input-jaw opening.
    a = math.radians(initial_angle)
    centre = parent_disc.Shape.Solids[0].CenterOfMass + V(radius*math.cos(a),0,radius*math.sin(a))
    disc = doc.addObject("Part::Feature",name)
    disc.Label = "16T rim disc - OD100 x6 at %g degrees" % initial_angle
    disc.Shape = Part.makeCylinder(50.0,6.0,V(0,-3,0),V(0,1,0))
    disc.Placement = App.Placement(centre,App.Rotation())
    for prop,value in (("OutsideDiameter",100.0),("Thickness",6.0),("CentreRadius",63.9291692265395)):
        disc.addProperty("App::PropertyLength",prop,"Dimensions");setattr(disc,prop,value)
    disc.addProperty("App::PropertyAngle","InitialAngle","Attachment");disc.InitialAngle=initial_angle
    disc.addProperty("App::PropertyLink","MotionDriver","Attachment");disc.MotionDriver=parent_disc
    disc.ViewObject.ShapeColor=parent_disc.ViewObject.ShapeColor
    return disc


