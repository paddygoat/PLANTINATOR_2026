0459]], 'Opened_20deg_HopperBaseBand': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_SteelOuterBand': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedSupportBracketLeftA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedBearingSleeveLeftA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedGreaseNippleLeftA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedSupportBracketLeftB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedBearingSleeveLeftB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedGreaseNippleLeftB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedSupportBracketRightA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedBearingSleeveRightA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedGreaseNippleRightA': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedSupportBracketRightB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedBearingSleeveRightB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]], 'Opened_20deg_FixedGreaseNippleRightB': [[900.5435013682023, 0.0, -270.1000828268723], [2.2204449250008326e-16, 0.001006296999943232, 2.234428197896392e-19, -0.9999994936830459]]}
        self.relative = {}
        for obj in self.parts:
            prefix='Closed_0deg_' if obj.Name.startswith('Closed_0deg_') else 'Opened_20deg_'
            values=attachment_data.get(obj.Name,attachment_data[prefix+'DetailedCylinderBody'])
            self.relative[obj.Name]=App.Placement(V(*values[0]),App.Rotation(*values[1]))
        self.mount_local = V(*[900.5435013682022, 0.0, -270.1000828268724])
        self.state = document.addObject("App::FeaturePython", "DuckBillArmMount")
        self.state.Label = "Duck bill rigidly follows arm two at its preserved mounting offset"
        self.state.addProperty("App::PropertyLink", "Arm", "Attachment")
        self.state.Arm = self.arm
        self.state.addProperty("App::PropertyLink", "Assembly", "Attachment")
        self.state.Assembly = document.getObject("DuckBillAssembly")
        self.state.addProperty("App::PropertyLength", "BeyondArmEnd", "Attachment")
        self.state.BeyondArmEnd = self.axis_position - self.arm.LengthX.Value
        self.state.addProperty("App::PropertyLength", "ArmAxisPosition", "Attachment")
        self.state.ArmAxisPosition = self.axis_position
        self.state.addProperty("App::PropertyDistance", "InitialGlobalZOffset", "Attachment")
        self.state.InitialGlobalZOffset = -270.0
        self.state.addProperty("App::PropertyDistance", "InitialGlobalXOffset", "Attachment")
        self.state.InitialGlobalXOffset = -50.0
        self.state.setEditorMode("InitialGlobalXOffset", 1)
        self.state.setEditorMode("InitialGlobalZOffset", 1)
        self.state.addProperty("App::PropertyVector", "MountPoint", "Attachment")
        self.state.addProperty("App::PropertyString", "Motion", "Attachment")
        self.state.Motion = "Rigid attachment to arm two; both closed and open duck-bill configurations follow the arm."
        for prop in ("Arm", "Assembly", "BeyondArmEnd", "ArmAxisPosition", "MountPoint", "Motion"):
            self.state.setEditorMode(prop, 1)
        self.update()

    def update(self):
        arm_placement = self.arm.getGlobalPlacement()
        for obj in self.parts:
            parent = obj.getGlobalPlacement().multiply(obj.Placement.inverse())
            obj.Placement = parent.inverse().multiply(arm_placement).multiply(self.relative[obj.Name])
        self.state.MountPoint = arm_placement.multVec(self.mount_local)


duck_bill_mount = ArmTwoDuckBillMount(doc)
App.duck_bill_arm_mount = duck_bill_mount
doc.recompute()


def add_duck_bill_tip_motion_outline(doc):
    """Trace the actual closed tip orbit of the fixed-pin linkage, without fill."""
    motion = duck_bill_motion
    cone = doc.getObject("Closed_0deg_FoldedSheet")
    shape = cone.Shape.copy()
    shape.Placement = cone.getGlobalPlacement()
    vertices, _ = shape.tessellate(0.05)
    tip = min(vertices, key=lambda point: point.z)
    tip_local = cone.getGlobalPlacement().inverse().multVec(tip)
    tip_in_arm = motion.doc.duck_bill_arm_two.getGlobalPlacement().inverse().multVec(tip)
    saved_slot, saved_angle = motion.slot_x, motion.arm_angle
    points = []
    try:
        for step in range(721):
            angle = -step * 0.5
            rotation = App.Rotation(V(0, 1, 0), angle)
            target = motion.driver_rest.Base + rotation.multVec(motion.d0 - motion.driver_rest.Base)
            guide_rotation = App.Rotation(V(0, 1, 0), angle * T3 / T1)
            centre = motion.guide_driver_rest.Base
            guide_delta = App.Placement(centre - guide_rotation.multVec(centre), guide_rotation)
            frame = guide_delta.multiply(motion.guide_rest)
            motion.solve_follower(target, frame)
            follower_rotation = App.Rotation(V(0, 1, 0), -math.degrees(motion.arm_angle))
            a = frame.multVec(V(motion.fixed_pin_x, 6.0, 0))
            follower_delta = App.Placement(a - follower_rotation.multVec(motion.a0), follower_rotation)
            arm = follower_delta.multiply(motion.rest["duck_bill_arm_two"])
            points.append(arm.multVec(tip_in_arm))
    finally:
        motion.slot_x, motion.arm_angle = saved_slot, saved_angle
    if (points[-1] - points[0]).Length > 1.0e-6:
        raise RuntimeError("Fixed-pin tip trajectory did not close after one revolution.")
    points[-1] = points[0]
    outline = doc.addObject("Part::Feature", "DuckBillTipMotionOutline")
    outline.Label = "Demi-cone tip trajectory (ZX, fixed inward pin)"
    outline.Shape = Part.makePolygon(points)
    outline.ViewObject.DisplayMode = "Wireframe"
    outline.ViewObject.LineColor = (0.0, 0.0, 1.0)
    outline.ViewObject.DrawStyle = "Dashed"
    outline.ViewObject.PointColor = (0.0, 0.0, 1.0)
    outline.ViewObject.LineWidth = 3.0
    outline.ViewObject.Selectable = False
    outline.addProperty("App::PropertyString", "Description", "Motion envelope")
    outline.Description = "Actual closed XZ tip trajectory, sampled every 0.5 degree; pin rigidly fixed at 70 mm along arm one, 65 mm inward from the far slot end. No filled face."
    outline.addProperty("App::PropertyLink", "TipObject", "Motion envelope")
    outline.TipObject = cone
    outline.addProperty("App::PropertyVector", "TipLocalPoint", "Motion envelope")
    outline.TipLocalPoint = tip_local
    return outline


linkage_motion_available = True
try:
    duck_bill_tip_motion_outline = add_duck_bill_tip_motion_outline(doc)
except RuntimeError as error:
    linkage_motion_available = False
    duck_bill_tip_motion_outline = None
    doc.DuckBillMotion.addProperty("App::PropertyString", "MotionLimitation", "Motion")
    doc.DuckBillMotion.MotionLimitation = str(error)
    App.Console.PrintWarning("Resized gearing: " + str(error) + " Animation is paused.\n")
doc.recompute()


class AdditionalDriveSprockets:
    """Axial drive copies; maintain their explicit rigid motion relationships."""
    def __init__(self, document):
        self.doc = document
        self.source = document.getObject("sprocket_16T_01")
        self.wheel = document.getObject("GroundDriveWheel")
        self.group = document.addObject("App::DocumentObjectGroup", "AdditionalDriveSprockets")
        self.group.Label = "Wheel drive sprockets and spare 15T"
        self.copies, self.attachments = [], []
        specifications = (
            ("wheel_shaft_sprocket_64T", self.source, V(620, -30 + YELLOW_DRIVE_Y_SHIFT, 0), self.wheel, 64),
            ("sprocket_10T_02", self.source, V(0, -30 + YELLOW_DRIVE_Y_SHIFT, 0), self.source, 10),
            ("sprocket_15T_tensioner_02", document.sprocket_15T_tensioner_01, V(193.89230174733 - upper_right_x, -30 + YELLOW_DRIVE_Y_SHIFT, -100.0), document.sprocket_15T_tensioner_01, T2),
        )
        for name, source, offset, driver, teeth in specifications:
            bore = (SHAFT_OD if name == "wheel_shaft_sprocket_64T" else
                    ARM_ONE_SHAFT_DIAMETER if name == "sprocket_10T_02" else SPROCKET_BORE_DIAMETER)
            obj = create_sprocket(document, name, teeth, PITCH / (2 * math.sin(math.pi / teeth)), PITCH / (2 * math.sin(math.pi / teeth)) - ROLLER_DIAMETER / 2, bore_diameter=bore)
            obj.addProperty("App::PropertyLength", "BoreDiameter", "Dimensions");obj.BoreDiameter=bore
            if name == "wheel_shaft_sprocket_64T":
                obj.addProperty("App::PropertyLink", "SharedShaft", "Drive");obj.SharedShaft=document.WheelShaft02
            shape = obj.Shape.copy()
            shape.Placement = App.Placement()
            obj.Shape = shape
            obj.Label = "sprocket 15T tensioner 02" if name == "sprocket_15T_tensioner_02" else name
            placement = source.getGlobalPlacement()
            placement.Base = placement.Base + offset
            obj.Placement = placement
            relative = driver.getGlobalPlacement().inverse().multiply(placement)
            obj.addProperty("App::PropertyLink", "MotionDriver", "Drive")
            obj.MotionDriver = driver
            obj.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
            obj.Teeth = teeth
            obj.addProperty("App::PropertyDistance", "SourceYOffset", "Dimensions")
            obj.SourceYOffset = -30.0 + YELLOW_DRIVE_Y_SHIFT
            obj.ViewObject.ShapeColor = source.ViewObject.ShapeColor
            obj.ViewObject.LineColor = source.ViewObject.LineColor
            self.group.addObject(obj)
            self.copies.append(obj)
            self.attachments.append((driver, relative))
        self.update()

    def update(self):
        # Only the shaft sprocket is rigidly attached to the wheel. Other copies
        # receive their motion from the wheel chain in WheelShaftDriveChain.update.
        obj = self.copies[0]
        driver, relative = self.attachments[0]
        obj.Placement = driver.getGlobalPlacement().multiply(relative)


additional_drive_sprockets = AdditionalDriveSprockets(doc)
doc.wheel_shaft_sprocket_64T.ViewObject.Transparency = 75
App.additional_drive_sprockets = additional_drive_sprockets
doc.recompute()


def create_offset_chain_link():
    """Visual one-pitch offset link: inner end at X=0, outer end at X=pitch."""
    plates = []
    for inner_z, outer_z in ((inner_plate_z1, outer_plate_z1),
                              (inner_plate_z2, outer_plate_z2)):
        plate = create_link_plate(LINK_PLATE_THICKNESS, inner_z)
        shear = App.Matrix()
        shear.A31 = (outer_z-inner_z) / PITCH
        plates.append(plate.transformGeometry(shear))
    roller = Part.makeCylinder(ROLLER_DIAMETER / 2.0, INNER_WIDTH,
        V(0, 0, SPROCKET_PLATE_THICKNESS / 2.0 - INNER_WIDTH / 2.0))
    pin = Part.makeCylinder(PIN_DIAMETER / 2.0, pin_length,
        V(PITCH, 0, outer_plate_z2 - 0.5))
    return plates[0].fuse(plates[1]).fuse(roller).fuse(pin)


class WheelShaftDriveChain:
    """Pitch-correct chain around the 64T driver, 10T follower and 15T tensioner."""
    def __init__(self, document):
        self.doc = document
        self.left = document.sprocket_10T_02
        self.right = document.wheel_shaft_sprocket_64T
        left, right = self.left.getGlobalPlacement().Base, self.right.getGlobalPlacement().Base
        if abs(left.y - right.y) > 1.0e-6 or abs(left.z - right.z) > 1.0e-6:
            raise ValueError("Wheel-drive sprockets must share a chain plane and height.")
        self.spacing = right.x - left.x
        self.frame = App.Placement(left, App.Rotation(V(1, 0, 0), -90.0))
        radius = PITCH / (2 * math.sin(math.pi / 10))
        if self.spacing <= 2.0 * radius:
            raise ValueError("Wheel-drive sprockets overlap.")
        self.idler = document.sprocket_15T_tensioner_02
        self.idler_x = self.idler.Placement.Base.x - left.x
        self.radius = radius
        self.right_radius = PITCH / (2 * math.sin(math.pi / 64))
        self.idler_radius = PITCH / (2 * math.sin(math.pi / 15))
        self.idler_x = 393.89230174733
        self.idler_height = 143.20924277481575
        self.external_x = self.idler_x - 200.0
        self.external = document.addObject("Part::Feature", "sprocket_15T_tensioner_03")
        self.external.Label = "sprocket 15T tensioner 03"
        shape = self.idler.Shape.copy()
        shape.Placement = App.Placement()
        self.external.Shape = shape
        self.external.Placement = self.idler.Placement
        self.external.ViewObject.ShapeColor = self.idler.ViewObject.ShapeColor
        self.external.ViewObject.LineColor = self.idler.ViewObject.LineColor
        self.external.addProperty("App::PropertyInteger", "Teeth", "Dimensions")
        self.external.Teeth = 15
        self.external.addProperty("App::PropertyString", "ContactSide", "Drive")
        self.external.ContactSide = "Outer surface; reverse-bending tensioner"
        self.external.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.external.WheelSpeedRatio = -64.0 / 15.0
        self.external.addProperty("App::PropertyLink", "MotionDriver", "Drive")
        self.count = 138  # Even count: regular alternating inner and outer links.
        self.external_height = 51.85947458001749  # Preserve tensioner 03.
        low, high = 70.0, 126.87383101592361
        for _ in range(44):
            self.idler_height = (low + high) / 2
            route, distances = make_chain_route(self.build_path(self.idler_height), 0.0)
            _, residual = walk_chain_route(route, distances, 0.0, self.count)
            if residual > 0:
                low = self.idler_height
            else:
                high = self.idler_height
        self.rest = {obj.Name: obj.Placement for obj in (self.left, self.idler, self.external)}
        self.path = self.build_path(self.idler_height)
        self.idler.Placement.Base = self.frame.multVec(V(self.idler_x, self.idler_height, 0))
        self.external.Placement.Base = self.frame.multVec(V(self.external_x, self.external_height, 0))
        self.rest[self.idler.Name] = self.idler.Placement
        self.rest[self.external.Name] = self.external.Placement
        document.AdditionalDriveSprockets.addObject(self.external)
        self.group = document.addObject("App::DocumentObjectGroup", "WheelShaftDriveChain")
        self.group.Label = "Wheel shaft 64T to sprocket 10T_02 chain"
        self.group.addProperty("App::PropertyInteger", "LinkCount", "Chain")
        self.group.LinkCount = self.count
        self.group.addProperty("App::PropertyLength", "Pitch", "Chain")
        self.group.Pitch = PITCH
        self.group.addProperty("App::PropertyLength", "ReturnSpanSag", "Chain")
        self.group.addProperty("App::PropertyLinkList", "Sprockets", "Chain")
        self.group.Sprockets = [self.left, self.external, self.idler, self.right]
        self.external.MotionDriver = self.group
        self.group.addProperty("App::PropertyLink", "MotionDriver", "Drive")
        self.group.MotionDriver = self.right
        self.group.addProperty("App::PropertyLength", "TensionerZShift", "Chain")
        self.group.TensionerZShift = self.idler_height
        self.left.MotionDriver = self.group
        self.idler.MotionDriver = self.group
        self.left.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.left.WheelSpeedRatio = 6.4
        self.idler.addProperty("App::PropertyFloat", "WheelSpeedRatio", "Drive")
        self.idler.WheelSpeedRatio = 64.0 / 15.0
        self.links = []
        for index in range(self.count):
            link = document.addObject("Part::Feature", "WheelDriveChainLink_{:03d}".format(index))
            if index == self.count - 1 and self.count % 2:
                link.Shape = create_offset_chain_link()
                link.Label = "Wheel drive chain offset link (one pitch)"
                link.addProperty("App::PropertyString", "LinkType", "Chain")
                link.LinkType = "Offset link (half link)"
                self.group.addProperty("App::PropertyLink", "OffsetLink", "Chain")
                self.group.OffsetLink = link
            else:
                link.Shape = (inner_link if index % 2 == 0 else outer_link).copy()
            link.ViewObject.ShapeColor = (0.72, 0.72, 0.72) if index % 2 == 0 else (0.48, 0.48, 0.48)
            self.group.addObject(link)
            self.links.append(link)
        self.update()

    def build_path(self, height, correction=0.0):
        centres = [V(0, 0, 0), V(self.external_x, self.external_height, 0),
                   V(self.idler_x, height, 0), V(self.spacing, 0, 0)]
        radii = [self.radius + correction, self.idler_radius + correction,
                 self.idler_radius + correction, self.right_radius + correction]
        sides = [1, -1, 1, 1]  # Negative signed radius selects backside tangency.
        tangents = [make_left_outer_tangent(centres[i], centres[(i+1)%4],
                    sides[i]*radii[i], sides[(i+1)%4]*radii[(i+1)%4]) for i in range(4)]
        segments, cursor = [], 0.0
        for i in range(4):
            incoming, outgoing = tangents[(i-1)%4], tangents[i]
            direction = -sides[i]
            start = incoming['normal_angle'] + (math.pi if sides[i]<0 else 0)
            end = outgoing['normal_angle'] + (math.pi if sides[i]<0 else 0)
            sweep = ((end-start)*direction) % (2*math.pi)
            length = radii[i]*sweep
            segments.append(dict(kind='arc', centre=centres[i], radius=radii[i],
                                 start_angle=start, direction=direction, sprocket_index=i,
                                 length=length, start=cursor, end=cursor+length))
            cursor += length
            length = outgoing['length']
            segments.append(dict(kind='straight', start_point=outgoing['start_point'],
                                 end_point=outgoing['end_point'], length=length,
                                 start=cursor, end=cursor+length))
            cursor += length
        return dict(segments=segments, length=cursor)

    def rollers(self, offset):
        # Keep straight spans taut with a tiny polygonal route correction.
        low, high = -0.1, 0.1
        for _ in range(40):
            correction = (low + high) / 2
            route, cumulative = make_chain_route(self.build_path(self.idler_height, correction), 0.0)
            points, residual = walk_chain_route(route, cumulative, offset, self.count)
            if abs(residual) < 1e-8:
                return [V(x, y, 0) for x, y in points[:-1]], correction
            if residual > 0:
                low = correction
            else:
                high = correction
        raise RuntimeError("Unable to close the tensioned wheel chain.")

    def update(self):
        points, sag = self.rollers(animation_offset * 10.0 / T1)
        self.group.ReturnSpanSag = 0.0
        wheel_angle = -360.0 * animation_offset / (PITCH * T1) / 6.4
        for obj, teeth in ((self.left, 10), (self.idler, 15), (self.external, -15)):
            rest = self.rest[obj.Name]
            rotation = App.Rotation(V(0, 1, 0), wheel_angle * 64.0 / teeth)
            obj.Placement = App.Placement(rest.Base, rotation.multiply(rest.Rotation))
        for index, link in enumerate(self.links):
            a, b = points[index], points[(index + 1) % self.count]
            angle = math.degrees(math.atan2(b.y - a.y, b.x - a.x))
            link.Placement = self.frame.multiply(App.Placement(a, App.Rotation(V(0, 0, 1), angle)))


wheel_drive_chain = WheelShaftDriveChain(doc)
App.wheel_drive_chain = wheel_drive_chain
# Consistent colours identify the two complete chain drives.
primary_drive_colour = (1.0, 0.45, 0.0)
wheel_drive_colour = (1.0, 0.85, 0.0)
for obj in links + sprockets:
    obj.ViewObject.ShapeColor = primary_drive_colour
for obj in wheel_drive_chain.links + list(wheel_drive_chain.group.Sprockets):
    obj.ViewObject.ShapeColor = wheel_drive_colour

primary_chain_drive = doc.addObject("App::FeaturePython", "PrimaryChainDrive")
primary_chain_drive.addProperty("App::PropertyLinkList", "Links", "Drive")
primary_chain_drive.Links = links
primary_chain_drive.addProperty("App::PropertyLink", "MotionDriver", "Drive")
primary_chain_drive.MotionDriver = doc.sprocket_16T_01
for obj, driver in ((doc.sprocket_16T_01, doc.sprocket_10T_02), (doc.sprocket_15T_tensioner_01, primary_chain_drive), (doc.sprocket_16T_03, primary_chain_drive)):
    obj.addProperty("App::PropertyLink", "MotionDriver", "Drive")
    obj.MotionDriver = driver
doc.recompute()


class UpperWheelChainDrive:
    """Separate 32T/32T drive with a 12T adjustable idler at global Z=50."""
    def __init__(self, document, upper_dx, upper_dz):
        self.doc = document
        self.source = document.wheel_shaft_sprocket_64T
        source_pose = self.source.getGlobalPlacement()
        # Keep the green drive's requested shift independent of the yellow drive.
        self.origin = source_pose.Base + V(0, -100.0 - GREEN_DRIVE_OUTWARD_SHIFT - YELLOW_DRIVE_Y_SHIFT, 0)
        self.frame = App.Placement(self.origin, App.Rotation(V(1, 0, 0), -90))
        self.upper_dx, self.upper_dz = upper_dx, upper_dz
        self.radii = [PITCH/(2*math.sin(math.pi/n)) for n in (32,32,12)]
        self.group = document.addObject('App::DocumentObjectGroup', 'UpperWheelChainDrive')
        self.group.Label = 'Upper wheel 32T chain drive'
        self.sprockets = []
        for name,label,teeth,bore in (
            ('wheel_shaft_sprocket_32T_01','wheel shaft sprocket 32T 01',32,30),
            ('upper_wheel_sprocket_32T_01','upper wheel sprocket 32T 01',32,20),
            ('upper_wheel_tensioner_12T_01','upper wheel tensioner 12T 01',12,10)):
            radius=PITCH/(2*math.sin(math.pi/teeth))
            obj=create_sprocket(document,name,teeth,radius,radius-ROLLER_DIAMETER/2,bore_diameter=bore)
            obj.Label=label
            obj.addProperty('App::PropertyInteger','Teeth','Dimensions');obj.Teeth=teeth
            obj.addProperty('App::PropertyLength','BoreDiameter','Dimensions');obj.BoreDiameter=bore
            obj.addProperty('App::PropertyLink','MotionDriver','Drive')
            obj.ViewObject.ShapeColor=(0.20,0.75,0.40)
            self.group.addObject(obj);self.sprockets.append(obj)
        # Choose the closest even link count and set tension with the idler X.
        self.idler_x=-120.0
        target_length=self.build_path()['length']
        self.count=int(round(target_length/PITCH/2))*2
        low,high=-260.0,-80.0
        for _ in range(44):
            self.idler_x=(low+high)/2
            route,distances=make_chain_route(self.build_path(),0)
            _,residual=walk_chain_route(route,distances,0,self.count)
            if residual>0:
                high=self.idler_x
            else:
                low=self.idler_x
        self.path=self.build_path()
        self.centres=[self.origin,self.origin+V(upper_dx,0,upper_dz),self.origin+V(self.idler_x,0,50)]
        # Index the sprocket root pockets to rollers on the newly routed chain.
        initial_rollers=self.rollers(0.0)
        planar_centres=[V(0,0,0),V(upper_dx,-upper_dz,0),V(self.idler_x,-50,0)]
        for i,(obj,centre) in enumerate(zip(self.sprockets,self.centres)):
            local=planar_centres[i]
            roller=min(initial_rollers,key=lambda p:abs((p-local).Length-self.radii[i]))
            root_angle=math.degrees(math.atan2(roller.y-local.y,roller.x-local.x))
            obj.Placement=App.Placement(centre,self.frame.Rotation.multiply(App.Rotation(V(0,0,1),root_angle)))
        self.driver_relative=self.source.getGlobalPlacement().inverse().multiply(self.sprockets[0].Placement)
        self.rest_rotations=[obj.Placement.Rotation for obj in self.sprockets]
        self.sprockets[0].MotionDriver=document.GroundDriveWheel
        self.sprockets[0].addProperty('App::PropertyLink','SharedShaft','Drive')
        self.sprockets[0].SharedShaft=document.WheelShaft02
        for obj in self.sprockets[1:]:obj.MotionDriver=self.group
        self.group.addProperty('App::PropertyLink','MotionDriver','Drive');self.group.MotionDriver=self.sprockets[0]
        self.group.addProperty('App::PropertyLinkList','Sprockets','Chain');self.group.Sprockets=self.sprockets
        self.group.addProperty('App::PropertyInteger','LinkCount','Chain');self.group.LinkCount=self.count
        self.group.addProperty('App::PropertyLength','Pitch','Chain');self.group.Pitch=PITCH
        self.group.addProperty('App::PropertyLength','ReturnSpanSag','Chain');self.group.ReturnSpanSag=0
        self.links=[]
        for i in range(self.count):
            obj=document.addObject('Part::Feature','UpperWheelChainLink_{:03d}'.format(i))
            obj.Shape=(inner_link if i%2==0 else outer_link).copy()
            obj.ViewObject.ShapeColor=(0.20,0.75,0.40)
            self.group.addObject(obj);self.links.append(obj)
        self.update()

    def build_path(self,correction=0.0):
        centres=[V(0,0,0),V(self.upper_dx,-self.upper_dz,0),V(self.idler_x,-50,0)]
        radii=[r+correction for r in self.radii]
        tangents=[make_left_outer_tangent(centres[i],centres[(i+1)%3],radii[i],radii[(i+1)%3]) for i in range(3)]
        segments=[];cursor=0.0
        for i in range(3):
            incoming,outgoing=tangents[(i-1)%3],tangents[i]
            sweep=(incoming['normal_angle']-outgoing['normal_angle'])%(2*math.pi)
            length=radii[i]*sweep
            segments.append(dict(kind='arc',centre=centres[i],radius=radii[i],start_angle=incoming['normal_angle'],length=length,start=cursor,end=cursor+length))
            cursor+=length;length=outgoing['length']
            segments.append(dict(kind='straight',start_point=outgoing['start_point'],end_point=outgoing['end_point'],length=length,start=cursor,end=cursor+length))
            cursor+=length
        return dict(segments=segments,length=cursor)

    def rollers(self,offset):
        low,high=-0.1,0.1
        for _ in range(40):
            correction=(low+high)/2
            route,distances=make_chain_route(self.build_path(correction),0)
            points,residual=walk_chain_route(route,distances,offset,self.count)
            if abs(residual)<1e-8:return [V(x,y,0) for x,y in points[:-1]]
            if residual>0:low=correction
            else:high=correction
        raise RuntimeError('Upper wheel chain closure failed.')

    def update(self):
        self.sprockets[0].Placement=self.source.getGlobalPlacement().multiply(self.driver_relative)
        wheel_angle=-360*animation_offset/(PITCH*T1)/6.4
        for i,teeth in ((1,32),(2,12)):
            rotation=App.Rotation(V(0,1,0),wheel_angle*32/teeth)
            self.sprockets[i].Placement=App.Placement(self.centres[i],rotation.multiply(self.rest_rotations[i]))
        points=self.rollers(animation_offset*(10.0/16.0)*(32.0/64.0))
        for i,obj in enumerate(self.links):
            a,b=points[i],points[(i+1)%self.count]
            yaw=math.degrees(math.atan2(b.y-a.y,b.x-a.x))
            obj.Placement=self.frame.multiply(App.Placement(a,App.Rotation(V(0,0,1),yaw)))


upper_wheel_drive = UpperWheelChainDrive(doc, upper_dx=0.0, upper_dz=300.0)
App.upper_wheel_chain_drive = upper_wheel_drive
doc.recompute()


class CentreGreenDriveCopy:
    """Mirror the green drive plane about the fixed midpoint between the wheels."""
    def __init__(self, document, original):
        shaft = document.WheelShaft
        parent = shaft.getGlobalPlacement().multiply(shaft.Placement.inverse())
        self.shaft_centre = parent.multVec(shaft.Shape.CenterOfMass)
        # Preserve the established drive plane when the original shaft is shortened.
        self.translation = App.Placement(V(0, 630.0 + 2.0 * GREEN_DRIVE_OUTWARD_SHIFT, 0), App.Rotation())
        self.group = document.addObject('App::DocumentObjectGroup', 'CentreGreenChainDrive')
        self.group.Label = 'Green chain drive copy, midpoint +%g mm Y' % (315.0 + GREEN_DRIVE_OUTWARD_SHIFT)
        self.group.addProperty('App::PropertyLink','OriginalDrive','Drive')
        self.group.OriginalDrive = original.group
        self.group.addProperty('App::PropertyLink','SharedShaft','Drive')
        self.group.SharedShaft = shaft
        self.group.addProperty('App::PropertyInteger','LinkCount','Chain')
        self.group.LinkCount = original.count
        self.group.addProperty('App::PropertyLength','Pitch','Chain')
        self.group.Pitch = PITCH
        self.pairs = []
        self.sprockets, self.links = [], []
        for source in original.sprockets + original.links:
            name = 'upper_wheel_sprocket_32T_02' if source.Name == 'upper_wheel_sprocket_32T_01' else source.Name + '_copy'
            obj = document.addObject('Part::Feature', name)
            obj.Label = 'upper wheel sprocket 32T 02' if source.Name == 'upper_wheel_sprocket_32T_01' else source.Label + ' copy'
            obj.Shape = source.Shape.copy()
            obj.ViewObject.ShapeColor = (0.20, 0.75, 0.40)
            obj.ViewObject.LineColor = source.ViewObject.LineColor
            obj.ViewObject.Transparency = source.ViewObject.Transparency
            obj.addProperty('App::PropertyLink','MotionDriver','Drive')
            obj.MotionDriver = source
            if source in original.sprockets:
                obj.addProperty('App::PropertyInteger','Teeth','Dimensions');obj.Teeth=source.Teeth
                obj.addProperty('App::PropertyLength','BoreDiameter','Dimensions');obj.BoreDiameter=source.BoreDiameter
                self.sprockets.append(obj)
            else:
                self.links.append(obj)
            self.group.addObject(obj)
            self.pairs.append((source,obj))
        self.sprockets[0].addProperty('App::PropertyLink','SharedShaft','Drive')
        self.sprockets[0].SharedShaft = shaft
        self.group.addProperty('App::PropertyLinkList','Sprockets','Chain')
        self.group.Sprockets = self.sprockets
        self.update()

    def update(self):
        for source,obj in self.pairs:
            obj.Placement = self.translation.multiply(source.getGlobalPlacement())


centre_green_drive = CentreGreenDriveCopy(doc, upper_wheel_drive)
App.centre_green_chain_drive = centre_green_drive
doc.recompute()


class UpperWheelShaft:
    """Solid bore-matched shaft, rigidly rotating with both upper sprockets."""
    def __init__(self, document, first, second):
        self.driver = first
        span = (second.Placement.Base-first.Placement.Base).Length + SPROCKET_PLATE_THICKNESS
        length = math.ceil((span + 10.0)/10.0)*10.0
        overhang = (length-span)/2.0
        self.relative = App.Placement(V(0,0,-overhang),App.Rotation())
        self.obj = document.addObject('Part::Feature','upper_wheel_shaft')
        self.obj.Label = 'upper wheel shaft'
        self.obj.Shape = Part.makeCylinder(first.BoreDiameter.Value/2.0,length)
        self.obj.addProperty('App::PropertyLength','Diameter','Dimensions');self.obj.Diameter=first.BoreDiameter
        self.obj.addProperty('App::PropertyLength','Length','Dimensions');self.obj.Length=length
        self.obj.addProperty('App::PropertyLink','MotionDriver','Drive');self.obj.MotionDriver=first
        self.obj.addProperty('App::PropertyLinkList','JoinedSprockets','Drive');self.obj.JoinedSprockets=[first,second]
        self.obj.ViewObject.ShapeColor=(0.65,0.67,0.70)
        self.update()

    def update(self):
        self.obj.Placement=self.driver.getGlobalPlacement().multiply(self.relative)


upper_wheel_shaft = UpperWheelShaft(doc,upper_wheel_drive.sprockets[1],centre_green_drive.sprockets[1])
App.upper_wheel_shaft = upper_wheel_shaft
doc.recompute()



class ShaftRotationTracker:
    """Unwrap actual driver rotation about global Y; reset with the simulation.

    Incremental updates must be less than 180 degrees, as in the animation.
    """
    def __init__(self, driver):
        self.driver=driver
        self.rest=driver.getGlobalPlacement().Rotation
        self.reset()
    def reset(self):
        self.previous=0.0
        self.angle=0.0
    def read(self):
        delta=self.driver.getGlobalPlacement().Rotation.multiply(self.rest.inverted())
        radial=delta.multVec(V(1,0,0))
        wrapped=math.degrees(math.atan2(-radial.z,radial.x))
        self.angle+=(wrapped-self.previous+180.0)%360.0-180.0
        self.previous=wrapped
        return self.angle


class CarouselChainDrive(UpperWheelChainDrive):
    """Half-inch-pitch 16T to 40T reduction with an adjustable 10T idler."""
    def __init__(self,document,upper_shaft):
        self.doc=document;self.source=upper_shaft
        self.rotation_tracker=ShaftRotationTracker(upper_shaft)
        midpoint=upper_shaft.getGlobalPlacement().multVec(V(0,0,upper_shaft.Length.Value/2))
        # The centre plane of the sprocket is exactly 80 mm along -Y.
        self.origin=midpoint-V(0,80+SPROCKET_PLATE_THICKNESS/2,0)
        self.frame=App.Placement(self.origin,App.Rotation(V(1,0,0),-90))
        self.radii=[PITCH/(2*math.sin(math.pi/n)) for n in (16,40,10)]
        self.group=document.addObject('App::DocumentObjectGroup','CarouselChainDrive')
        self.group.Label='Carousel horizontal chain drive - 16T to 40T'
        self.sprockets=[]
        for name,label,teeth,bore in (
            ('upper_wheel_carousel_sprocket_16T','Upper wheel carousel sprocket 16T',16,20),
            ('carousel_horiz_sprocket_40T','Carousel horizontal sprocket 40T',40,20),
            ('carousel_chain_tensioner_10T','Carousel chain tensioner 10T',10,10)):
            radius=PITCH/(2*math.sin(math.pi/teeth))
            o=create_sprocket(document,name,teeth,radius,radius-ROLLER_DIAMETER/2,bore_diameter=bore);o.Label=label
            o.addProperty('App::PropertyInteger','Teeth','Dimensions');o.Teeth=teeth
            o.addProperty('App::PropertyLength','BoreDiameter','Dimensions');o.BoreDiameter=bore
            o.addProperty('App::PropertyLink','MotionDriver','Motion')
            o.MotionDriver=upper_shaft if not self.sprockets else self.sprockets[0]
            o.ViewObject.ShapeColor=(.20,.75,.40);o.ViewObject.Transparency=50
            self.sprockets.append(o);self.group.addObject(o)
        self.idler_z=100.0
        self.count=int(round(self.build_path()['length']/PITCH/2))*2
        lo,hi=35.0,220.0
        for _ in range(44):
            self.idler_z=(lo+hi)/2
            route,distances=make_chain_route(self.build_path(),0)
            _,residual=walk_chain_route(route,distances,0,self.count)
            if residual>0:lo=self.idler_z
            else:hi=self.idler_z
        self.path=self.build_path()
        self.centres=[self.origin,self.origin+V(195,0,0),self.origin+V(97.5,0,self.idler_z)]
        planar=[V(),V(195,0,0),V(97.5,-self.idler_z,0)]
        initial=self.rollers(0)
        for i,(obj,centre) in enumerate(zip(self.sprockets,self.centres)):
            local=planar[i];p=min(initial,key=lambda p:abs((p-local).Length-self.radii[i]))
            angle=math.degrees(math.atan2(p.y-local.y,p.x-local.x))
            obj.Placement=App.Placement(centre,self.frame.Rotation.multiply(App.Rotation(V(0,0,1),angle)))
        self.rest_rotations=[o.Placement.Rotation for o in self.sprockets]
        self.driver_relative=upper_shaft.getGlobalPlacement().inverse().multiply(self.sprockets[0].Placement)
        for kind,name,value in [('App::PropertyInteger','LinkCount',self.count),('App::PropertyLength','Pitch',PITCH),('App::PropertyFloat','OutputToInputRatio',0.4),('App::PropertyLength','ReturnSpanSag',0)]:
            self.group.addProperty(kind,name,'Chain');setattr(self.group,name,value)
        self.group.addProperty('App::PropertyLinkList','Sprockets','Chain');self.group.Sprockets=self.sprockets
        self.group.addProperty('App::PropertyLink','MotionDriver','Motion');self.group.MotionDriver=upper_shaft
        self.links=[]
        for i in range(self.count):
            o=document.addObject('Part::Feature','CarouselChainLink_{:03d}'.format(i))
            o.Shape=(inner_link if i%2==0 else outer_link).copy()
            o.ViewObject.ShapeColor=(.20,.75,.40);o.ViewObject.Transparency=50
            self.links.append(o);self.group.addObject(o)
        self.update()

    def build_path(self,correction=0.0):
        centres=[V(),V(195,0,0),V(97.5,-self.idler_z,0)]
        radii=[r+correction for r in self.radii]
        tangents=[make_left_outer_tangent(centres[i],centres[(i+1)%3],radii[i],radii[(i+1)%3]) for i in range(3)]
        segments=[];cursor=0.0
        for i in range(3):
            incoming,outgoing=tangents[(i-1)%3],tangents[i]
            sweep=(incoming['normal_angle']-outgoing['normal_angle'])%(2*math.pi)
            length=radii[i]*sweep
            segments.append(dict(kind='arc',centre=centres[i],radius=radii[i],start_angle=incoming['normal_angle'],length=length,start=cursor,end=cursor+length))
            cursor+=length;length=outgoing['length']
            segments.append(dict(kind='straight',start_point=outgoing['start_point'],end_point=outgoing['end_point'],length=length,start=cursor,end=cursor+length))
            cursor+=length
        return dict(segments=segments,length=cursor)

    def update(self):
        angle=self.rotation_tracker.read()
        self.sprockets[0].Placement=self.source.getGlobalPlacement().multiply(self.driver_relative)
        for i,teeth in ((1,40),(2,10)):
            self.sprockets[i].Placement=App.Placement(self.centres[i],App.Rotation(V(0,1,0),angle*self.sprockets[0].Teeth/teeth).multiply(self.rest_rotations[i]))
        points=self.rollers(-angle/360.0*PITCH*self.sprockets[0].Teeth)
        for i,o in enumerate(self.links):
            a,b=points[i],points[(i+1)%self.count]
            o.Placement=self.frame.multiply(App.Placement(a,App.Rotation(V(0,0,1),math.degrees(math.atan2(b.y-a.y,b.x-a.x)))))


class CarouselHorizontalShaft:
    def __init__(self,document,drive):
        self.driver=drive.sprockets[1]
        self.obj=document.addObject('Part::Feature','Carousel_horiz_shaft')
        self.obj.Label='Carousel horiz shaft'
        # Extend 20 mm at each end; retain the previous shaft midpoint.
        self.relative=App.Placement(V(0,0,-20),App.Rotation())
        self.obj.Shape=Part.makeCylinder(10,200)
        self.obj.addProperty('App::PropertyLength','Diameter','Dimensions');self.obj.Diameter=20
        self.obj.addProperty('App::PropertyLength','Length','Dimensions');self.obj.Length=200
        self.obj.addProperty('App::PropertyLink','MotionDriver','Motion');self.obj.MotionDriver=self.driver
        self.obj.ViewObject.ShapeColor=(.20,.75,.40);self.obj.ViewObject.Transparency=50
        drive.group.addObject(self.obj);self.update()
    def update(self):
        self.obj.Placement=self.driver.getGlobalPlacement().multiply(self.relative)


